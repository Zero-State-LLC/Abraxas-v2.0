{
  "schema_version": "AbraxasVisualAssetRegistry.v1",
  "name": "abraxas-visual-os",
  "version": "0.1.0",
  "updated": "2026-07-19",
  "authority": "Visual identity only — no production activation or deploy authority.",
  "packages": {
    "tokens": {
      "path": "design-system/tokens/",
      "files": [
        "color.tokens.json",
        "semantic.tokens.json",
        "typography.tokens.json",
        "spacing.tokens.json",
        "motion.tokens.json",
        "abraxas.tokens.css"
      ]
    },
    "brand": {
      "path": "design-system/brand/",
      "assets": [
        {"id": "logo_mark", "path": "design-system/brand/logo-mark.svg", "roles": ["app_icon_source", "mark"]},
        {"id": "logo_horizontal", "path": "design-system/brand/logo-horizontal.svg", "roles": ["header", "docs"]},
        {"id": "logo_mono", "path": "design-system/brand/logo-mono.svg", "roles": ["print", "emboss"]},
        {"id": "favicon", "path": "design-system/brand/favicon.svg", "roles": ["favicon", "pwa"]}
      ]
    },
    "icons_system": {
      "path": "design-system/icons/system/",
      "count": 44,
      "sizes_px": [16, 24, 48],
      "maps_to_domains": ["git", "artifacts", "runtime", "operator", "knowledge", "governance"]
    },
    "runes": {
      "path": "design-system/runes/glyphs/",
      "map": "design-system/runes/glyph_map.v1.json",
      "count": 24,
      "contract_catalog": "contracts/runes/catalog.v1.json"
    },
    "components": {
      "path": "design-system/components/primitives.css",
      "consumers": ["apps/aal-viz-live-console", "docs", "future web"]
    },
    "illustrations_docs_media": {
      "path": "docs/media/",
      "legacy_readme": "docs/media/README_VISUAL_SYSTEM.md",
      "assets": [
        {"file": "atlas.svg", "surface": "system_topology", "tier": "tier1_routing_runtime"},
        {"file": "oracle-signal-layer.svg", "surface": "oracle", "tier": "tier3_research_projection", "domain": "oracle"},
        {"file": "governance-promotion.svg", "surface": "governance", "tier": "tier2_governance_continuity"},
        {"file": "temporal-continuity-spine.svg", "surface": "continuity", "tier": "tier2_governance_continuity"},
        {"file": "yggdrasil-routing.svg", "surface": "routing", "tier": "tier1_routing_runtime"},
        {"file": "abx-runes.svg", "surface": "runes_catalog", "tier": "advisory_formalized"},
        {"file": "aal-core.svg", "surface": "projection", "tier": "tier3_research_projection", "domain": "projection"},
        {"file": "runtime-map.svg", "surface": "runtime", "tier": "tier1_routing_runtime"}
      ]
    },
    "console": {
      "path": "apps/aal-viz-live-console/",
      "token_bridge": "design-system/tokens/abraxas.tokens.css",
      "styles": "apps/aal-viz-live-console/src/styles.css"
    },
    "readiness": {
      "path": "out/production_readiness/",
      "semantic_binding": "design-system/tokens/semantic.tokens.json",
      "states": ["Missing", "Partial", "Verified", "NOT_COMPUTABLE", "DENIED", "NO_GO", "CANDIDATE_APPROVED"]
    }
  },
  "semantic_index": {
    "registers": ["observation", "inference", "speculation", "unknown"],
    "authority": ["canonical", "advisory", "experimental", "shadow", "denied", "held"],
    "domains": ["operator", "runtime", "engineering", "validation", "oracle", "projection", "execution", "forecast"]
  },
  "phases": "design-system/docs/PHASES.md"
}
