# ABRAXAS v2.0 Environment Configuration
# Copy to .env and fill in values as needed.

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# API (fail-closed unless explicitly enabled)
ABRAXAS_API_PUBLIC_READONLY=false

# Paths (relative to repo root unless an override is provided)
CONTRACTS_DIR=contracts
OUT_DIR=out
