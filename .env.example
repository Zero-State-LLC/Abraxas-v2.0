# ABRAXAS v2.0 Environment Configuration
# Copy to .env and fill in values as needed.

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Paths (relative to repo root)
CONTRACTS_DIR=contracts
OUT_DIR=out

# API access control
# Set to "true" to allow unauthenticated read-only access to registry,
# validation, and projection endpoints.  Default is fail-closed (403).
ABRAXAS_API_PUBLIC_READONLY=false
