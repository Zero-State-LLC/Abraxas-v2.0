{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/oracle/oracle_candidate_signal_packet.v1.schema.json",
  "title": "OracleCandidateSignalPacket.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signal_id",
    "signal_status",
    "payload_ref",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "forecast_authority",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "source_ref",
    "signal_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleCandidateSignalPacket.v1" },
    "signal_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "signal_status": { "const": "CANDIDATE_SHADOW_ONLY" },
    "payload_ref": { "const": "SOURCE_URI_ONLY_NO_FETCH" },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "non_authoritative": { "const": true },
    "forecast_authority": { "const": false },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_entry_id", "source_pull_receipt_id", "source_uri"],
      "properties": {
        "queue_entry_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_pull_receipt_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_uri": { "type": "string", "minLength": 1 }
      }
    },
    "signal_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
