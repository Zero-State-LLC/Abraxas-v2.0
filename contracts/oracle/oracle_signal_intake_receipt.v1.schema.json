{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/oracle/oracle_signal_intake_receipt.v1.schema.json",
  "title": "OracleSignalIntakeReceipt.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "receipt_status",
    "patch_id",
    "authority",
    "source_spec_hash",
    "source_queue_hash",
    "candidate_signal_count",
    "input_envelope_ref_count",
    "candidate_signals",
    "input_envelope_refs",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "forecast_authority",
    "canon_mutation",
    "runtime_mutation",
    "scheduler_mutation",
    "queue_mutation",
    "pipeline_or_route_mutation",
    "execution_authority",
    "valid_for_execution",
    "authority_locks",
    "recommended_next_patch",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleSignalIntakeReceipt.v1" },
    "receipt_status": { "const": "ORACLE_SIGNAL_INTAKE_RECEIPT_EMITTED_ADVISORY_ONLY" },
    "patch_id": { "const": "PATCH-ABX-GLOBAL-INGEST-ADDITIVE-SHADOW-CONTRACTS-001" },
    "authority": { "const": "SHADOW_INTAKE_BOUNDARY_ONLY" },
    "source_spec_hash": { "type": "string" },
    "source_queue_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_signal_count": { "type": "integer", "minimum": 0 },
    "input_envelope_ref_count": { "type": "integer", "minimum": 0 },
    "candidate_signals": { "type": "array", "items": { "type": "object" } },
    "input_envelope_refs": { "type": "array", "items": { "type": "object" } },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "non_authoritative": { "const": true },
    "forecast_authority": { "const": false },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "scheduler_mutation": { "const": false },
    "queue_mutation": { "const": false },
    "pipeline_or_route_mutation": { "const": false },
    "execution_authority": { "const": false },
    "valid_for_execution": { "const": false },
    "authority_locks": { "type": "object", "additionalProperties": { "const": false } },
    "recommended_next_patch": { "const": "NOT_COMPUTABLE" },
    "receipt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
