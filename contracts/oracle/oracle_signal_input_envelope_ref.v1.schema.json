{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/oracle/oracle_signal_input_envelope_ref.v1.schema.json",
  "title": "OracleSignalInputEnvelopeRef.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "envelope_ref_id",
    "envelope_status",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "forecast_authority",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "candidate_signal_id",
    "candidate_signal_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleSignalInputEnvelopeRef.v1" },
    "envelope_ref_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "envelope_status": { "const": "REFERENCE_ONLY_NOT_BOUND" },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "non_authoritative": { "const": true },
    "forecast_authority": { "const": false },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false },
    "candidate_signal_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_signal_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
