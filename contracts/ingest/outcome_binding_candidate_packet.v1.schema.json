{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/ingest/outcome_binding_candidate_packet.v1.schema.json",
  "title": "OutcomeBindingCandidatePacket.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patch_id",
    "builder_id",
    "source_queue_hash",
    "candidate_id",
    "candidate_type",
    "candidate_status",
    "source_receipt_hashes",
    "source_domains",
    "required_resolution_sources",
    "candidate_window",
    "cross_domain_receipt_count",
    "brier_ready",
    "activation_status",
    "authority",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "forecast_authority",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority"
  ],
  "properties": {
    "schema_version": { "const": "OutcomeBindingCandidatePacket.v1" },
    "patch_id": { "const": "PATCH-ABX-AUTO-INGEST-004" },
    "builder_id": { "const": "abx_outcome_binding_candidate_builder_v1" },
    "source_queue_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_type": {
      "enum": [
        "policy_market_attention",
        "market_volatility_anomaly",
        "social_market_coupling",
        "news_market_coupling",
        "geopolitical_context_support",
        "NOT_COMPUTABLE"
      ]
    },
    "candidate_status": {
      "enum": [
        "CANDIDATE_READY_ADVISORY_ONLY",
        "NOT_COMPUTABLE_CROSS_DOMAIN_EVIDENCE_REQUIRED"
      ]
    },
    "source_receipt_hashes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "source_domains": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "required_resolution_sources": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "candidate_window": { "type": "string", "minLength": 1 },
    "cross_domain_receipt_count": { "type": "integer", "minimum": 0 },
    "brier_ready": { "const": false },
    "activation_status": {
      "enum": [
        "OPERATOR_REQUIRED",
        "BLOCKED_PENDING_CROSS_DOMAIN_EVIDENCE"
      ]
    },
    "authority": { "const": "FORECAST_CANDIDATE_ONLY" },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "non_authoritative": { "const": true },
    "forecast_authority": { "const": false },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false }
  }
}
