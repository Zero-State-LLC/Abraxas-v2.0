{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/ingest/shadow_anomaly_state.v1.schema.json",
  "title": "ShadowAnomalyState.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "domain_scores"],
  "properties": {
    "schema_version": { "const": "ShadowAnomalyState.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "domain_scores": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["z_score", "source"],
        "properties": {
          "z_score": { "type": "number" },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
