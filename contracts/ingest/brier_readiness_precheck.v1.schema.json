{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/ingest/brier_readiness_precheck.v1.schema.json",
  "title": "BrierReadinessPrecheck.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patch_id",
    "candidate_id",
    "precheck_status",
    "brier_ready",
    "missing_requirements",
    "authority",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "forecast_authority",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "precheck_hash"
  ],
  "properties": {
    "schema_version": { "const": "BrierReadinessPrecheck.v1" },
    "patch_id": { "const": "PATCH-ABX-AUTO-INGEST-004" },
    "candidate_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "precheck_status": { "const": "NOT_READY_OPERATOR_REVIEW_REQUIRED" },
    "brier_ready": { "const": false },
    "missing_requirements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "authority": { "const": "FORECAST_CANDIDATE_ONLY" },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "non_authoritative": { "const": true },
    "forecast_authority": { "const": false },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false },
    "precheck_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
