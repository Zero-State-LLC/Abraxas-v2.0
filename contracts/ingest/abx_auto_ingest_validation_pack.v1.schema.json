{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/ingest/abx_auto_ingest_validation_pack.v1.schema.json",
  "title": "ABXAutoIngestValidationPack.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patch_id",
    "validation_id",
    "patches",
    "checks",
    "authority",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "forecast_authority",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "pass_required_for_next_stage",
    "check_results",
    "success_criteria",
    "evidence",
    "final_status",
    "validation_hash"
  ],
  "properties": {
    "schema_version": { "const": "ABXAutoIngestValidationPack.v1" },
    "patch_id": { "const": "PATCH-ABX-AUTO-INGEST-006" },
    "validation_id": { "const": "abx_auto_ingest_full_stack_validation_v1" },
    "patches": {
      "type": "array",
      "items": { "enum": ["001", "002", "003", "004", "005"] }
    },
    "checks": {
      "type": "array",
      "items": {
        "enum": [
          "schema_validation",
          "canonical_json_hashing",
          "12_run_invariance",
          "authority_leakage_scan",
          "not_computable_behavior",
          "empty_queue_behavior",
          "operator_window_gate",
          "cooldown_gate",
          "viz_projection_only"
        ]
      }
    },
    "authority": { "const": "VALIDATION_ONLY" },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "non_authoritative": { "const": true },
    "forecast_authority": { "const": false },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false },
    "pass_required_for_next_stage": { "const": true },
    "check_results": { "type": "object" },
    "success_criteria": { "type": "object" },
    "evidence": { "type": "object" },
    "final_status": { "enum": ["PASS", "FAIL"] },
    "validation_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
