{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/ingest/scheduled_ingest_run_manifest.v1.schema.json",
  "title": "ScheduledIngestRunManifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scheduler_id",
    "run_id",
    "generated_at",
    "eligible_adapters",
    "blocked_adapters",
    "max_concurrent_adapters",
    "handoff",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "forecast_authority",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority"
  ],
  "properties": {
    "schema_version": { "const": "ScheduledIngestRunManifest.v1" },
    "scheduler_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generated_at": { "type": "string", "minLength": 1 },
    "eligible_adapters": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "blocked_adapters": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "max_concurrent_adapters": { "type": "integer", "minimum": 1 },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_pipeline", "target_patch", "authority"],
      "properties": {
        "target_pipeline": { "type": "string", "minLength": 1 },
        "target_patch": { "const": "PATCH-ABX-AUTO-INGEST-002" },
        "authority": { "const": "SHADOW_ONLY" },
        "controlled_handoff_eligibility": {
          "type": "object",
          "required": ["schema_version", "status", "controlled_handoff_eligible", "advisory_only", "execution_authority"],
          "properties": {
            "schema_version": { "const": "ControlledHandoffEligibility.v1" },
            "status": { "type": "string" },
            "controlled_handoff_eligible": { "type": "boolean" },
            "lane": { "type": "string" },
            "advisory_only": { "const": true },
            "execution_authority": { "const": false },
            "runtime_mutation": { "const": false }
          },
          "additionalProperties": true
        }
      }
    },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "non_authoritative": { "const": true },
    "forecast_authority": { "const": false },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false }
  }
}
