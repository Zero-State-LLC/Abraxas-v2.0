{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/ingest/source_adapter_config_set.v1.schema.json",
  "title": "SourceAdapterConfigSet.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_id",
    "adapters",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "forecast_authority",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority"
  ],
  "properties": {
    "schema_version": { "const": "SourceAdapterConfigSet.v1" },
    "config_id": { "type": "string", "minLength": 1 },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter_id", "domain", "enabled", "source_kind", "source_uri", "pull_mode"],
        "properties": {
          "adapter_id": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "source_kind": { "enum": ["filesystem", "json", "audit_artifact"] },
          "source_uri": { "type": "string", "minLength": 1 },
          "pull_mode": { "const": "SHADOW_PULL" }
        }
      }
    },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "non_authoritative": { "const": true },
    "forecast_authority": { "const": false },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false }
  }
}
