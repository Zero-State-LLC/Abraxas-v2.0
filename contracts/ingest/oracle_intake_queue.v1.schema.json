{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/ingest/oracle_intake_queue.v1.schema.json",
  "title": "OracleIntakeQueue.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patch_id",
    "scheduler_id",
    "run_id",
    "authority",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "forecast_authority",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "queue_entries",
    "queue_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleIntakeQueue.v1" },
    "patch_id": { "const": "PATCH-ABX-AUTO-INGEST-003" },
    "scheduler_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority": { "const": "SHADOW_HANDOFF_ONLY" },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "non_authoritative": { "const": true },
    "forecast_authority": { "const": false },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false },
    "queue_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "queue_entry_id",
          "handoff_receipt_id",
          "source_pull_receipt_id",
          "adapter_id",
          "domain",
          "source_kind",
          "source_uri",
          "intake_mode",
          "queue_status",
          "advisory_only",
          "projection_only",
          "non_authoritative",
          "forecast_authority",
          "canon_mutation",
          "runtime_mutation",
          "execution_authority"
        ],
        "properties": {
          "queue_entry_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "handoff_receipt_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "source_pull_receipt_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "adapter_id": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 },
          "source_kind": { "enum": ["filesystem", "json", "audit_artifact"] },
          "source_uri": { "type": "string", "minLength": 1 },
          "intake_mode": { "const": "SHADOW_PULL" },
          "queue_status": { "const": "READY_FOR_ORACLE_INTAKE" },
          "advisory_only": { "const": true },
          "projection_only": { "const": true },
          "non_authoritative": { "const": true },
          "forecast_authority": { "const": false },
          "canon_mutation": { "const": false },
          "runtime_mutation": { "const": false },
          "execution_authority": { "const": false }
        }
      }
    },
    "queue_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
