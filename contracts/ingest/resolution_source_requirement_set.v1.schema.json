{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/ingest/resolution_source_requirement_set.v1.schema.json",
  "title": "ResolutionSourceRequirementSet.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patch_id",
    "candidate_id",
    "candidate_type",
    "requirement_status",
    "requirements",
    "authority",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "forecast_authority",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "requirement_set_hash"
  ],
  "properties": {
    "schema_version": { "const": "ResolutionSourceRequirementSet.v1" },
    "patch_id": { "const": "PATCH-ABX-AUTO-INGEST-004" },
    "candidate_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_type": {
      "enum": [
        "policy_market_attention",
        "market_volatility_anomaly",
        "social_market_coupling",
        "news_market_coupling",
        "geopolitical_context_support",
        "NOT_COMPUTABLE"
      ]
    },
    "requirement_status": {
      "enum": [
        "REQUIREMENTS_DECLARED",
        "NOT_COMPUTABLE_CANDIDATE_NOT_READY"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_status", "required"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "source_status": { "const": "REQUIRED_UNVERIFIED" },
          "required": { "const": true }
        }
      }
    },
    "authority": { "const": "FORECAST_CANDIDATE_ONLY" },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "non_authoritative": { "const": true },
    "forecast_authority": { "const": false },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false },
    "requirement_set_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
