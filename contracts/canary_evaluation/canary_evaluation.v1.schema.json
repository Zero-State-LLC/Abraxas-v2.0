{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/canary_evaluation/canary_evaluation.v1.schema.json",
  "title": "CanaryEvaluation.v1",
  "type": "object",
  "required": ["schema_version", "evaluation_id", "activation_id", "activation_hash", "accumulation_id", "accumulation_hash", "input_refs", "metrics", "decision", "recommendations", "review_summary", "evaluation_status", "created_by_lane", "promotion_allowed", "rollback_allowed", "mutation_allowed", "evaluation_hash"],
  "properties": {
    "schema_version": {"const": "CanaryEvaluation.v1"},
    "evaluation_id": {"type": "string"},
    "activation_id": {"type": "string"},
    "activation_hash": {"type": "string"},
    "accumulation_id": {"type": "string"},
    "accumulation_hash": {"type": "string"},
    "input_refs": {"type": "array"},
    "metrics": {"type": "array"},
    "decision": {"type": "object", "required": ["decision", "reason"], "properties": {"decision": {"enum": ["PASS", "FAIL", "REVIEW_REQUIRED", "INSUFFICIENT_EVIDENCE", "GUARDRAIL_BREACH", "VOID", "NOT_COMPUTABLE"]}, "reason": {"type": "string"}}},
    "recommendations": {"type": "array", "items": {"type": "object", "required": ["recommendation_type", "summary"], "properties": {"recommendation_type": {"enum": ["RECOMMEND_OPERATOR_REVIEW", "RECOMMEND_PROMOTION_PROPOSAL", "RECOMMEND_ROLLBACK_PROPOSAL", "RECOMMEND_HOLD", "RECOMMEND_VOID", "NOT_COMPUTABLE"]}, "summary": {"type": "string"}}}},
    "review_summary": {"type": "object", "required": ["summary_id", "operator_review_required", "promotion_proposal_allowed", "rollback_proposal_allowed", "execution_allowed", "summary_text"], "properties": {"summary_id": {"type": "string"}, "operator_review_required": {"const": true}, "promotion_proposal_allowed": {"const": false}, "rollback_proposal_allowed": {"const": false}, "execution_allowed": {"const": false}, "summary_text": {"type": "string"}}},
    "evaluation_status": {"enum": ["DRAFT", "EVALUATION_READY", "PASSED", "FAILED", "REVIEW_REQUIRED", "VOID", "NOT_COMPUTABLE"]},
    "created_by_lane": {"type": "string"},
    "authority_ref": {"type": ["object", "null"]},
    "promotion_allowed": {"const": false},
    "rollback_allowed": {"const": false},
    "mutation_allowed": {"const": false},
    "evaluation_hash": {"type": "string"}
  }
}
