{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/runtime/runtime_spine.v1.schema.json",
  "title": "Runtime Spine Invocation",
  "type": "object",
  "required": ["route", "payload"],
  "properties": {
    "route": {
      "type": "object",
      "required": ["subsystem_id", "lane", "promotion_state", "authority_scope"],
      "properties": {
        "subsystem_id": {"type": "string"},
        "lane": {
          "type": "string",
          "enum": ["SHADOW", "FORECAST", "PROJECTION", "CANON", "OPERATOR", "GOVERNANCE"]
        },
        "promotion_state": {
          "type": "string",
          "enum": ["SHADOW_ONLY", "CANARY", "LIMITED_PROMOTION", "CANON_ACTIVE", "ARCHIVED", "NOT_COMPUTABLE"]
        },
        "authority_scope": {
          "type": "string",
          "enum": [
            "OBSERVATION", "DIAGNOSE", "ANNOTATE",
            "FORECAST", "INFERENCE", "RENDER",
            "DOCTRINE", "REGISTRY", "CANON",
            "APPROVE", "DENY", "MANUAL_OVERRIDE", "OPERATOR",
            "GOVERNANCE", "NOT_COMPUTABLE"
          ]
        }
      }
    },
    "payload": {"type": "object"},
    "canon_attestation": {"type": ["string", "null"]},
    "outcome_binding": {"type": ["string", "null"]}
  }
}
