{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/services/artifact_provenance_service.response.v1.schema.json",
  "title": "ArtifactProvenanceServiceResponse.v1",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "status",
        "service_id",
        "service_version",
        "execution_id",
        "operation",
        "result",
        "provenance"
      ],
      "properties": {
        "status": { "const": "OK" },
        "service_id": { "const": "artifact_and_provenance_service" },
        "service_version": { "type": "string" },
        "execution_id": { "type": "string" },
        "operation": { "type": "string" },
        "result": {
          "type": "object",
          "properties": {
            "canonical_hash": { "type": "string" },
            "canonical_json": { "type": "string" },
            "path": { "type": "string" },
            "written": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "required": ["implementation", "path_policy"],
          "properties": {
            "implementation": { "const": "core.canonical.json" },
            "path_policy": { "const": "out/_only_no_traversal" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "status",
        "error_class",
        "message",
        "retryable",
        "operator_action_required",
        "execution_id",
        "service_id",
        "service_version",
        "evidence"
      ],
      "properties": {
        "status": { "const": "ERROR" },
        "error_class": {
          "type": "string",
          "enum": [
            "REQUEST_INVALID",
            "PATH_DENIED",
            "PAYLOAD_MISSING",
            "WRITE_FAILED",
            "INTERNAL_ERROR"
          ]
        },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "operator_action_required": { "type": "boolean" },
        "execution_id": { "type": "string" },
        "service_id": { "const": "artifact_and_provenance_service" },
        "service_version": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  ]
}
