{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.dev/contracts/canon/abx_artifact_lineage_registry_repair_plan.v1.schema.json",
  "title": "AbxArtifactLineageRegistryRepairPlan",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "artifact_type",
    "plan_id",
    "generated_at",
    "source_traceability_audit",
    "source_traceability_audit_path",
    "source_traceability_audit_hash",
    "source_traceability_audit_observed",
    "repair_phases",
    "repair_batches",
    "direct_repairable_batches",
    "operator_review_batches",
    "external_evidence_batches",
    "forbidden_actions",
    "governance_locks",
    "unresolved_items",
    "recommended_next_plan",
    "downstream",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": { "const": "AbxArtifactLineageRegistryRepairPlan.v1" },
    "plan_id": { "const": "ABX_ARTIFACT_LINEAGE_REGISTRY_REPAIR_PLAN_001" },
    "generated_at": { "const": "2026-06-05T00:00:00Z" },
    "source_traceability_audit": { "const": "ABX_ARTIFACT_LINEAGE_REGISTRY_TRACEABILITY_AUDIT_001" },
    "source_traceability_audit_path": { "const": "out/sync/abx_artifact_lineage_registry_traceability_audit/latest.json" },
    "source_traceability_audit_hash": { "type": "string" },
    "source_traceability_audit_observed": { "const": true },
    "repair_phases": { "type": "array", "minItems": 5, "items": { "type": "string" } },
    "repair_batches": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "batch_id",
          "batch_status",
          "repair_mode",
          "source_finding_id",
          "impacted_count",
          "sample_impacted",
          "proposed_actions"
        ]
      }
    },
    "direct_repairable_batches": { "type": "array", "minItems": 3, "items": { "type": "string" } },
    "operator_review_batches": { "type": "array", "items": { "type": "string" } },
    "external_evidence_batches": { "type": "array", "items": { "type": "string" } },
    "forbidden_actions": {
      "type": "array",
      "contains": { "const": "normalize_runner_casing_without_operator_review" },
      "items": { "type": "string" }
    },
    "governance_locks": {
      "type": "object",
      "required": [
        "governance_status",
        "canon_status",
        "execution_authority",
        "canon_mutation_allowed",
        "runtime_mutation_allowed",
        "research_candidates_canonized",
        "downstream",
        "operator_review_required"
      ],
      "properties": {
        "governance_status": { "const": "FROZEN" },
        "canon_status": { "const": "ADVISORY_ONLY" },
        "execution_authority": { "const": false },
        "canon_mutation_allowed": { "const": false },
        "runtime_mutation_allowed": { "const": false },
        "research_candidates_canonized": { "const": false },
        "downstream": { "const": "NOT_COMPUTABLE" },
        "operator_review_required": { "const": true }
      }
    },
    "unresolved_items": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["item_id", "status", "reason"],
        "properties": {
          "status": { "const": "NOT_COMPUTABLE" }
        }
      }
    },
    "recommended_next_plan": { "const": "ABX_ARTIFACT_LINEAGE_REGISTRY_REPAIR_EXECUTION_PLAN_001" },
    "downstream": { "const": "NOT_COMPUTABLE" },
    "packet_hash": { "type": "string" }
  }
}
