{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/canon/heavy_tail_fixture_corpus_creation_receipt.v1.schema.json",
  "title": "HeavyTailFixtureCorpusCreationReceipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version","receipt_id","receipt_type","receipt_status","operator_id",
    "source_authorization_binding","schema_plan_binding","fixture_corpus_plan_binding",
    "fixture_file_manifest","valid_fixture_receipt","invalid_fixture_receipt",
    "not_computable_fixture_receipt","fixture_hash_manifest",
    "corpus_creation_scope_review","authority_lock_review","blocked_scope_review",
    "recommended_next_step","provenance","created_at_utc","canonical_hash"
  ],
  "properties": {
    "schema_version": {"const": "HeavyTailFixtureCorpusCreationReceipt.v1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "receipt_type": {"const": "HEAVY_TAIL_FIXTURE_CORPUS_CREATION_RECEIPT"},
    "receipt_status": {"const": "HEAVY_TAIL_FIXTURE_CORPUS_CREATION_RECEIPT_COMPLETE"},
    "operator_id": {"const": "HEAVY_TAIL"},
    "source_authorization_binding": {
      "type": "object", "additionalProperties": true,
      "required": ["authorization_artifact_id","authorization_canonical_hash","hash_confirmed"],
      "properties": {
        "authorization_artifact_id": {"type": "string"},
        "authorization_canonical_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hash_confirmed": {"const": true}
      }
    },
    "schema_plan_binding": {
      "type": "object", "additionalProperties": true,
      "required": ["schema_plan_artifact_id","schema_plan_canonical_hash","hash_confirmed"],
      "properties": {
        "schema_plan_artifact_id": {"type": "string"},
        "schema_plan_canonical_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hash_confirmed": {"const": true}
      }
    },
    "fixture_corpus_plan_binding": {
      "type": "object", "additionalProperties": true,
      "required": ["fixture_corpus_plan_artifact_id","fixture_corpus_plan_canonical_hash","hash_confirmed"],
      "properties": {
        "fixture_corpus_plan_artifact_id": {"type": "string"},
        "fixture_corpus_plan_canonical_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hash_confirmed": {"const": true}
      }
    },
    "fixture_file_manifest": {
      "type": "array", "minItems": 16, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fixture_id","fixture_group","fixture_path","fixture_hash","fixture_created"],
        "properties": {
          "fixture_id": {"type": "string", "minLength": 1},
          "fixture_group": {"enum": ["valid","invalid","not_computable"]},
          "fixture_path": {"type": "string", "minLength": 1},
          "fixture_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "fixture_created": {"const": true}
        }
      }
    },
    "valid_fixture_receipt": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fixture_id","fixture_group","fixture_path","fixture_hash","fixture_created","expected_outcome_reason"],
        "properties": {
          "fixture_id": {"type": "string"},
          "fixture_group": {"const": "valid"},
          "fixture_path": {"type": "string"},
          "fixture_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "fixture_created": {"const": true},
          "expected_outcome_reason": {"type": "string"}
        }
      }
    },
    "invalid_fixture_receipt": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fixture_id","fixture_group","fixture_path","fixture_hash","fixture_created","expected_outcome_reason"],
        "properties": {
          "fixture_id": {"type": "string"},
          "fixture_group": {"const": "invalid"},
          "fixture_path": {"type": "string"},
          "fixture_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "fixture_created": {"const": true},
          "expected_outcome_reason": {"type": "string"}
        }
      }
    },
    "not_computable_fixture_receipt": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fixture_id","fixture_group","fixture_path","fixture_hash","fixture_created","expected_outcome_reason"],
        "properties": {
          "fixture_id": {"type": "string"},
          "fixture_group": {"const": "not_computable"},
          "fixture_path": {"type": "string"},
          "fixture_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "fixture_created": {"const": true},
          "expected_outcome_reason": {"type": "string"}
        }
      }
    },
    "fixture_hash_manifest": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "minProperties": 16
    },
    "corpus_creation_scope_review": {"type": "object", "additionalProperties": true, "minProperties": 1},
    "authority_lock_review": {
      "type": "object", "additionalProperties": false,
      "required": [
        "advisory_only","shadow_lane_only","fixture_corpus_creation_receipt_only",
        "fixture_creation_authorized","fixture_files_created",
        "computation_executed","baseline_pack_updated","emits_metric_values",
        "forecast_influence","p43_surface_lanes_authorized","production_activation",
        "canon_promotion","runtime_mutation","execution_authority","inference_authority"
      ],
      "properties": {
        "advisory_only": {"const": true},
        "shadow_lane_only": {"const": true},
        "fixture_corpus_creation_receipt_only": {"const": true},
        "fixture_creation_authorized": {"const": true},
        "fixture_files_created": {"const": true},
        "computation_executed": {"const": false},
        "baseline_pack_updated": {"const": false},
        "emits_metric_values": {"const": false},
        "forecast_influence": {"const": false},
        "p43_surface_lanes_authorized": {"const": false},
        "production_activation": {"const": false},
        "canon_promotion": {"const": false},
        "runtime_mutation": {"const": false},
        "execution_authority": {"const": false},
        "inference_authority": {"const": false}
      }
    },
    "blocked_scope_review": {"type": "object", "additionalProperties": true, "minProperties": 1},
    "recommended_next_step": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object", "additionalProperties": true,
      "required": ["source","evidence_refs","generated_by","upstream_schema_refs"],
      "properties": {
        "source": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "generated_by": {"type": "string"},
        "upstream_schema_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "created_at_utc": {"type": "string", "minLength": 1},
    "canonical_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
