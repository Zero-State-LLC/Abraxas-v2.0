{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/research_canary_activation_package_draft.v1.schema.json",
  "title": "Research Canary Activation Package Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "canonical_status",
    "advisory_only",
    "projection_only",
    "lane_id",
    "status",
    "upstream_lane_id",
    "upstream_status",
    "upstream_lane_status",
    "lane_status",
    "stabilized_candidates",
    "held_candidates",
    "repair_candidates",
    "rejected_candidates",
    "analyzed_candidates",
    "activation_package_draft_complete_candidates",
    "activation_package_draft_incomplete_candidates",
    "candidate_statuses",
    "missing_requirements",
    "authority_locks",
    "recommended_next_lane",
    "recommended_next_lane_reason",
    "not_computable_reasons",
    "provenance",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {"const": "ResearchCanaryActivationPackageDraft.v1"},
    "canonical_status": {"const": "ADVISORY_ONLY"},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "lane_id": {"const": "P122_RESEARCH_CANARY_ACTIVATION_PACKAGE_DRAFT"},
    "status": {
      "enum": [
        "CANARY_ACTIVATION_PACKAGE_DRAFT_EMITTED",
        "NOT_COMPUTABLE",
        "REJECTED_AUTHORITY_DRIFT"
      ]
    },
    "upstream_lane_id": {"const": "P121_RESEARCH_CANARY_OPERATOR_GO_NO_GO_REVIEW"},
    "upstream_status": {"type": ["string", "null"]},
    "upstream_lane_status": {"type": ["string", "null"]},
    "lane_status": {
      "enum": [
        "CANARY_ACTIVATION_PACKAGE_DRAFT_INCOMPLETE",
        "CANARY_ACTIVATION_PACKAGE_DRAFT_COMPLETE",
        "CANARY_ACTIVATION_PACKAGE_DRAFT_REJECTED_AUTHORITY_DRIFT"
      ]
    },
    "stabilized_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "held_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "repair_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "rejected_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "analyzed_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "activation_package_draft_complete_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "activation_package_draft_incomplete_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "candidate_statuses": {"$ref": "#/$defs/candidateStatuses"},
    "missing_requirements": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "authority_locks": {
      "$ref": "#/$defs/authorityLocks"
    },
    "recommended_next_lane": {"type": "string"},
    "recommended_next_lane_reason": {"type": "string"},
    "not_computable_reasons": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object"},
    "packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "authorityLocks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_activation",
        "canon_promotion",
        "runtime_mutation",
        "forecast_influence",
        "forecast_weight_allowed",
        "shadow_to_forecast_leakage",
        "scheduler_mutation",
        "autonomous_execution",
        "operator_bypass",
        "hidden_intent_claim_authority",
        "canary_activation",
        "canary_authority",
        "canary_plan_execution",
        "canary_authorization",
        "canary_authorization_execution",
        "canary_final_precheck_authority",
        "canary_package_authority",
        "canary_package_execution",
        "canary_runtime_envelope_authority",
        "canary_runtime_execution",
        "canary_runtime_control",
        "rollback_execution_authority",
        "termination_execution_authority",
        "activation_package_authority",
        "activation_package_execution",
        "activation_decision_authority"
      ],
      "properties": {
        "production_activation": {"const": false},
        "canon_promotion": {"const": false},
        "runtime_mutation": {"const": false},
        "forecast_influence": {"const": false},
        "forecast_weight_allowed": {"const": false},
        "shadow_to_forecast_leakage": {"const": false},
        "scheduler_mutation": {"const": false},
        "autonomous_execution": {"const": false},
        "operator_bypass": {"const": false},
        "hidden_intent_claim_authority": {"const": false},
        "canary_activation": {"const": false},
        "canary_authority": {"const": false},
        "canary_plan_execution": {"const": false},
        "canary_authorization": {"const": false},
        "canary_authorization_execution": {"const": false},
        "canary_final_precheck_authority": {"const": false},
        "canary_package_authority": {"const": false},
        "canary_package_execution": {"const": false},
        "canary_runtime_envelope_authority": {"const": false},
        "canary_runtime_execution": {"const": false},
        "canary_runtime_control": {"const": false},
        "rollback_execution_authority": {"const": false},
        "termination_execution_authority": {"const": false},
        "activation_package_authority": {"const": false},
        "activation_package_execution": {"const": false},
        "activation_decision_authority": {"const": false}
      }
    },
    "candidateStatuses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "go_for_activation_package_planning_observed",
          "activation_scope_attached",
          "activation_conditions_attached",
          "runtime_boundary_attached",
          "observation_plan_attached",
          "rollback_plan_attached",
          "termination_plan_attached",
          "operator_activation_review_required",
          "activation_disabled_confirmed",
          "runtime_control_disabled_confirmed",
          "provenance_bundle_attached",
          "authority_drift_observed",
          "missing_requirements",
          "canary_activation_package_draft_status"
        ],
        "properties": {
          "candidate_id": {"type": "string"},
          "go_for_activation_package_planning_observed": {"type": "boolean"},
          "activation_scope_attached": {"type": "boolean"},
          "activation_conditions_attached": {"type": "boolean"},
          "runtime_boundary_attached": {"type": "boolean"},
          "observation_plan_attached": {"type": "boolean"},
          "rollback_plan_attached": {"type": "boolean"},
          "termination_plan_attached": {"type": "boolean"},
          "operator_activation_review_required": {"type": "boolean"},
          "activation_disabled_confirmed": {"type": "boolean"},
          "runtime_control_disabled_confirmed": {"type": "boolean"},
          "provenance_bundle_attached": {"type": "boolean"},
          "authority_drift_observed": {"type": "boolean"},
          "missing_requirements": {"type": "array", "items": {"type": "string"}},
          "canary_activation_package_draft_status": {
            "enum": [
              "CANARY_ACTIVATION_PACKAGE_DRAFT_INCOMPLETE",
              "CANARY_ACTIVATION_PACKAGE_DRAFT_COMPLETE",
              "CANARY_ACTIVATION_PACKAGE_DRAFT_REJECTED_AUTHORITY_DRIFT"
            ]
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
