{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/abx_codegen_intelligence_spine_module_surface_plan.v1.schema.json",
  "title": "ABX Codegen Intelligence Spine Module Surface Plan",
  "type": "object",
  "required": [
    "artifact_type",
    "plan_id",
    "module_surface_plan_status",
    "source_object_model_schema_plan",
    "planned_module_namespace",
    "planned_modules",
    "planned_scripts",
    "planned_tests",
    "validation_groups",
    "implementation_blockers",
    "recommended_next_lane",
    "safe_to_auto_continue",
    "advisory_only",
    "shadow_only",
    "projection_only",
    "non_authoritative",
    "execution_authority",
    "valid_for_execution",
    "valid_for_implementation",
    "authority_locks",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {
      "const": "AbxCodegenIntelligenceSpineModuleSurfacePlan.v1"
    },
    "plan_id": {
      "const": "ABX_CODEGEN_INTELLIGENCE_SPINE_MODULE_SURFACE_PLAN_001"
    },
    "module_surface_plan_status": {
      "enum": [
        "ABX_CODEGEN_MODULE_SURFACE_PLAN_HELD_FOR_OPERATOR",
        "NOT_COMPUTABLE"
      ]
    },
    "source_object_model_schema_plan": {"type": "object"},
    "planned_module_namespace": {"type": "object"},
    "planned_modules": {
      "type": "array",
      "items": {"type": "object"}
    },
    "planned_scripts": {
      "type": "array",
      "items": {"type": "object"}
    },
    "planned_tests": {
      "type": "array",
      "items": {"type": "object"}
    },
    "validation_groups": {
      "type": "array",
      "items": {"type": "object"}
    },
    "implementation_blockers": {
      "type": "array",
      "items": {"type": "string"}
    },
    "recommended_next_lane": {"const": "NOT_COMPUTABLE"},
    "safe_to_auto_continue": {"const": false},
    "advisory_only": {"const": true},
    "shadow_only": {"const": true},
    "projection_only": {"const": true},
    "non_authoritative": {"const": true},
    "execution_authority": {"const": false},
    "valid_for_execution": {"const": false},
    "valid_for_implementation": {"const": false},
    "authority_locks": {
      "type": "object",
      "additionalProperties": {"const": false}
    },
    "packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
