{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/v2_hygiene_loop_awareness_audit.v1.schema.json",
  "title": "v2.0 Hygiene Loop-Awareness Audit",
  "type": "object",
  "required": [
    "artifact_type",
    "audit_id",
    "audit_status",
    "notion_source",
    "source_mode",
    "evidence_paths",
    "observed_evidence_paths",
    "missing_evidence_paths",
    "source_artifact_hashes",
    "check_results",
    "passed_checks",
    "partial_checks",
    "missing_checks",
    "recommended_next_patch",
    "recommended_next_action",
    "safe_to_auto_continue",
    "safe_to_prepare_patch",
    "advisory_only",
    "projection_only",
    "evidence_only",
    "non_authoritative",
    "notion_writeback_allowed",
    "github_writeback_allowed",
    "canon_mutation",
    "runtime_mutation",
    "queue_mutation",
    "scheduler_mutation",
    "execution_authority",
    "valid_for_execution",
    "blocked_actions",
    "authority_locks",
    "audit_hash"
  ],
  "properties": {
    "artifact_type": { "const": "V2HygieneLoopAwarenessAudit.v1" },
    "audit_id": { "const": "V2_HYGIENE_LOOP_AWARENESS_AUDIT_001" },
    "audit_status": {
      "enum": [
        "V2_HYGIENE_LOOP_AWARENESS_AUDIT_READY",
        "V2_HYGIENE_LOOP_AWARENESS_AUDIT_DEGRADED",
        "NOT_COMPUTABLE"
      ]
    },
    "notion_source": { "type": "string", "minLength": 1 },
    "source_mode": { "const": "repo_visible_evidence_only" },
    "evidence_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "observed_evidence_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "missing_evidence_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "source_artifact_hashes": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "check_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "requirement",
          "status",
          "observed_term_count",
          "required_term_count",
          "observed_terms",
          "missing_terms"
        ],
        "properties": {
          "check_id": { "type": "string", "minLength": 1 },
          "requirement": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASSED", "PARTIAL", "MISSING"] },
          "observed_term_count": { "type": "integer", "minimum": 0 },
          "required_term_count": { "type": "integer", "minimum": 1 },
          "observed_terms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["term", "paths"],
              "properties": {
                "term": { "type": "string", "minLength": 1 },
                "paths": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "missing_terms": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "passed_checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "partial_checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "missing_checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "recommended_next_patch": { "const": "NOT_COMPUTABLE" },
    "recommended_next_action": { "type": "string", "minLength": 1 },
    "safe_to_auto_continue": { "const": false },
    "safe_to_prepare_patch": { "const": false },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "evidence_only": { "const": true },
    "non_authoritative": { "const": true },
    "notion_writeback_allowed": { "const": false },
    "github_writeback_allowed": { "const": false },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "queue_mutation": { "const": false },
    "scheduler_mutation": { "const": false },
    "execution_authority": { "const": false },
    "valid_for_execution": { "const": false },
    "blocked_actions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "authority_locks": {
      "type": "object",
      "additionalProperties": { "const": false },
      "minProperties": 1
    },
    "audit_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
