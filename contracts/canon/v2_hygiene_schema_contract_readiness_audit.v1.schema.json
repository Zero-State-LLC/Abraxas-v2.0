    "notion_schema_contract_source": {"type": "object"},
    "source_paths": {"type": "object"},
    "source_hashes": {"type": "object"},
    "source_ready": {"type": "boolean"},
    "contract_records": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "contract_id",
          "notion_status",
          "repo_path",
          "required_fields",
          "repo_observed",
          "readiness_status",
          "schema_file_creation_authorized",
          "implementation_authorized",
          "authority_granted"
        ],
        "additionalProperties": false,
        "properties": {
          "contract_id": {"type": "string"},
          "notion_status": {"type": "string"},
          "repo_path": {"type": "string"},
          "required_fields": {"type": "string"},
          "repo_observed": {"type": "boolean"},
          "readiness_status": {"type": "string"},
          "schema_file_creation_authorized": {"const": false},
          "implementation_authorized": {"const": false},
          "authority_granted": {"const": false}
        }
      }
    },
    "contract_summary": {
      "type": "object",
      "required": [
        "expected_contract_count",
        "repo_observed_count",
        "missing_contract_count",
        "missing_contract_ids"
      ],
      "properties": {
        "expected_contract_count": {"type": "integer", "minimum": 5},
        "repo_observed_count": {"type": "integer", "minimum": 0},
        "missing_contract_count": {"type": "integer", "minimum": 0},
        "missing_contract_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "readiness_findings": {"type": "array", "minItems": 1},
    "recommended_next_action": {"type": "string", "minLength": 1},
    "recommended_next_lane": {"const": "NOT_COMPUTABLE"},
    "recommended_next_patch": {"const": "NOT_COMPUTABLE"},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "evidence_only": {"const": true},
    "non_authoritative": {"const": true},
    "operator_review_required": {"const": true},
    "operator_input_required": {"const": true},
    "operator_attestation_created": {"const": false},
    "authorization_record_created": {"const": false},
    "schema_file_creation_authorized": {"const": false},
    "schema_mutation_authorized": {"const": false},
    "implementation_authorized": {"const": false},
    "hygiene_code_creation_authorized": {"const": false},
    "v2_module_registration_authorized": {"const": false},
    "rune_registration_authorized": {"const": false},
    "strict_mode_enablement_authorized": {"const": false},
    "execution_authority": {"const": false},
    "valid_for_execution": {"const": false},
    "valid_for_implementation": {"const": false},
    "safe_to_auto_continue": {"const": false},
    "safe_to_prepare_patch": {"const": false},
    "notion_writeback_allowed": {"const": false},
    "github_writeback_allowed": {"const": false},
    "canon_mutation": {"const": false},
    "runtime_mutation": {"const": false},
    "queue_mutation": {"const": false},
    "scheduler_mutation": {"const": false},
    "authority_locks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"const": false}
    },
    "audit_hash": {"type": "string", "minLength": 64, "maxLength": 64}
  }
