      "enum": ["SEAL_RECURSIVE_AUTHORIZATION_CHAIN", "NOT_COMPUTABLE"]
    },
    "compression_recommendation": {
      "enum": ["COMPRESS_TO_GENERIC_TEMPLATE", "NOT_COMPUTABLE"]
    },
    "recommended_next_lane": {
      "enum": [
        "BELIEF_GRAPH_ENGINE_ADVISORY_RECEIPT_AUTHORIZATION_CHAIN_SEAL_RECEIPT_PLAN",
        "NOT_COMPUTABLE"
      ]
    },
    "recommended_next_action": {"type": "string"},
    "terminality_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "finding_status", "summary", "authority_granted"],
        "properties": {
          "finding_id": {"type": "string"},
          "finding_status": {"enum": ["OBSERVED", "APPLIED", "NOT_COMPUTABLE"]},
          "summary": {"type": "string"},
          "authority_granted": {"const": false}
        },
        "additionalProperties": false
      }
    },
    "denied_authority": {"type": "array", "items": {"type": "string"}},
    "receipt_code_creation_authorized": {"const": false},
    "receipt_implementation_authorized": {"const": false},
    "receipt_implementation_performed": {"const": false},
    "belief_graph_engine_implementation_authorized": {"const": false},
    "belief_graph_engine_implementation_performed": {"const": false},
    "authorization_chain_continuation_allowed": {"const": false},
    "authorization_record_creation_record_creation_allowed": {"const": false},
    "authorization_record_creation_record_created": {"const": false},
    "authorization_record_creation_allowed": {"const": false},
    "authorization_record_created": {"const": false},
    "authorization_token_created": {"const": false},
    "operator_approved": {"const": false},
    "authorization_granted": {"const": false},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "non_authoritative": {"const": true},
    "execution_authority": {"const": false},
    "valid_for_execution": {"const": false},
    "valid_for_implementation": {"const": false},
    "runtime_mutation_allowed": {"const": false},
    "canon_mutation_allowed": {"const": false},
    "queue_mutation_allowed": {"const": false},
    "scheduler_mutation_allowed": {"const": false},
    "forecast_routing_allowed": {"const": false},
    "notion_writeback_allowed": {"const": false},
    "github_writeback_allowed": {"const": false},
    "authority_locks": {"type": "object"},
    "packet_hash": {"type": "string"}
