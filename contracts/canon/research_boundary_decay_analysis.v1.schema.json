{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/research_boundary_decay_analysis.v1.schema.json",
  "title": "Research Boundary Decay Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "canonical_status",
    "advisory_only",
    "projection_only",
    "lane_id",
    "status",
    "upstream_lane_id",
    "upstream_shadow_replay_audit_status",
    "boundary_decay_analysis_status",
    "stabilized_candidates",
    "held_candidates",
    "repair_candidates",
    "rejected_candidates",
    "analyzed_candidates",
    "boundary_stable_candidates",
    "boundary_decay_candidates",
    "boundary_incomplete_candidates",
    "candidate_boundary_statuses",
    "missing_boundary_requirements",
    "authority_locks",
    "recommended_next_lane",
    "recommended_next_lane_reason",
    "not_computable_reasons",
    "provenance",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {"const": "ResearchBoundaryDecayAnalysis.v1"},
    "canonical_status": {"const": "ADVISORY_ONLY"},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "lane_id": {"const": "P104_RESEARCH_BOUNDARY_DECAY_ANALYSIS"},
    "status": {
      "enum": [
        "BOUNDARY_DECAY_ANALYSIS_EMITTED",
        "NOT_COMPUTABLE",
        "REJECTED_AUTHORITY_DRIFT"
      ]
    },
    "upstream_lane_id": {"const": "P103_RESEARCH_SHADOW_REPLAY_AUDIT"},
    "upstream_shadow_replay_audit_status": {"type": ["string", "null"]},
    "boundary_decay_analysis_status": {
      "enum": [
        "BOUNDARY_STABLE",
        "BOUNDARY_DECAY_DETECTED",
        "BOUNDARY_DECAY_INCOMPLETE",
        "BOUNDARY_DECAY_IN_PROGRESS",
        "NOT_COMPUTABLE",
        "REJECTED_AUTHORITY_DRIFT"
      ]
    },
    "stabilized_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "held_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "repair_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "rejected_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "analyzed_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "boundary_stable_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "boundary_decay_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "boundary_incomplete_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "candidate_boundary_statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "boundary_definition_present",
          "overlap_with_other_candidates",
          "semantic_drift_score",
          "authority_boundary_leakage_observed",
          "forecast_boundary_leakage_observed",
          "runtime_boundary_leakage_observed",
          "aal_viz_projection_only_observed",
          "operator_review_observed",
          "decay_window_cycles_observed",
          "missing_boundary_requirements",
          "boundary_decay_status"
        ],
        "properties": {
          "candidate_id": {"type": "string"},
          "boundary_definition_present": {"type": ["boolean", "null"]},
          "overlap_with_other_candidates": {
            "type": "array",
            "items": {"type": "string"}
          },
          "semantic_drift_score": {"type": ["number", "null"]},
          "authority_boundary_leakage_observed": {"type": ["boolean", "null"]},
          "forecast_boundary_leakage_observed": {"type": ["boolean", "null"]},
          "runtime_boundary_leakage_observed": {"type": ["boolean", "null"]},
          "aal_viz_projection_only_observed": {"type": ["boolean", "null"]},
          "operator_review_observed": {"type": ["boolean", "null"]},
          "decay_window_cycles_observed": {"type": ["integer", "null"], "minimum": 0},
          "missing_boundary_requirements": {
            "type": "array",
            "items": {"type": "string"}
          },
          "boundary_decay_status": {
            "enum": [
              "BOUNDARY_DECAY_NOT_OBSERVED",
              "BOUNDARY_DECAY_IN_PROGRESS",
              "BOUNDARY_STABLE",
              "BOUNDARY_DECAY_DETECTED",
              "BOUNDARY_DECAY_BLOCKED_MISSING_OBSERVATIONS",
              "BOUNDARY_REJECTED_AUTHORITY_DRIFT"
            ]
          }
        }
      }
    },
    "missing_boundary_requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_activation",
        "canon_promotion",
        "runtime_mutation",
        "forecast_influence",
        "forecast_weight_allowed",
        "shadow_to_forecast_leakage",
        "scheduler_mutation",
        "autonomous_execution",
        "operator_bypass",
        "hidden_intent_claim_authority"
      ],
      "properties": {
        "production_activation": {"const": false},
        "canon_promotion": {"const": false},
        "runtime_mutation": {"const": false},
        "forecast_influence": {"const": false},
        "forecast_weight_allowed": {"const": false},
        "shadow_to_forecast_leakage": {"const": false},
        "scheduler_mutation": {"const": false},
        "autonomous_execution": {"const": false},
        "operator_bypass": {"const": false},
        "hidden_intent_claim_authority": {"const": false}
      }
    },
    "recommended_next_lane": {"type": "string"},
    "recommended_next_lane_reason": {"type": "string"},
    "not_computable_reasons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "mapping_method",
        "semantic_drift_max_stable",
        "minimum_decay_window_cycles",
        "required_boundary_fields",
        "boundary_rules",
        "gated_recommendation_rule",
        "p103_status",
        "p103_artifact_type"
      ],
      "properties": {
        "source": {"type": "string"},
        "mapping_method": {"type": "string"},
        "semantic_drift_max_stable": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_decay_window_cycles": {"type": "integer", "minimum": 0},
        "required_boundary_fields": {
          "type": "array",
          "items": {"type": "string"}
        },
        "boundary_rules": {
          "type": "array",
          "items": {"type": "string"}
        },
        "gated_recommendation_rule": {"type": "string"},
        "p103_status": {"type": ["string", "null"]},
        "p103_artifact_type": {"type": ["string", "null"]}
      }
    },
    "packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
