{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/abx_codegen_intelligence_spine_gap_analysis_plan.v1.schema.json",
  "title": "ABX Codegen Intelligence Spine Gap Analysis Plan",
  "type": "object",
  "required": [
    "artifact_type",
    "plan_id",
    "plan_status",
    "target_surface",
    "target_surface_status",
    "notion_source",
    "patch_id",
    "source_paths",
    "source_hashes",
    "required_source_statuses",
    "notion_gap_evidence",
    "generated_artifact_control_evidence",
    "spine_required_path_records",
    "generated_artifact_control_path_records",
    "gap_summary",
    "planning_phases",
    "blocked_actions",
    "continuity_boundary",
    "recommended_next_lane",
    "recommended_next_action",
    "codegen_spine_implementation_performed",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "execution_authority",
    "valid_for_execution",
    "valid_for_implementation",
    "code_generation_allowed",
    "code_mutation_allowed",
    "file_writeback_allowed",
    "runtime_mutation_allowed",
    "canon_mutation_allowed",
    "queue_mutation_allowed",
    "scheduler_mutation_allowed",
    "forecast_routing_allowed",
    "notion_writeback_allowed",
    "github_writeback_allowed",
    "authority_locks",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {"const": "AbxCodegenIntelligenceSpineGapAnalysisPlan.v1"},
    "plan_id": {"const": "ABX_CODEGEN_INTELLIGENCE_SPINE_GAP_ANALYSIS_PLAN_001"},
    "plan_status": {"enum": ["ABX_CODEGEN_INTELLIGENCE_SPINE_GAP_ANALYSIS_PLAN_READY", "NOT_COMPUTABLE"]},
    "target_surface": {"const": "ABX_CODEGEN_INTELLIGENCE_SPINE_001"},
    "target_surface_status": {"const": "SPINE_MISSING_GENERATED_ARTIFACT_CONTROLS_OBSERVED"},
    "notion_source": {"const": "ABRAXAS_REPO_NOTION_DIFF_001"},
    "patch_id": {"const": "PATCH-ABX-CODEGEN-INTELLIGENCE-SPINE-GAP-ANALYSIS-PLAN-001"},
    "source_paths": {
      "type": "object",
      "required": ["repo_notion_diff", "canon_resume_state"],
      "properties": {
        "repo_notion_diff": {"type": "string"},
        "canon_resume_state": {"type": "string"}
      },
      "additionalProperties": false
    },
    "source_hashes": {
      "type": "object",
      "required": ["repo_notion_diff", "canon_resume_state"],
      "properties": {
        "repo_notion_diff": {"type": "string"},
        "canon_resume_state": {"type": "string"}
      },
      "additionalProperties": false
    },
    "required_source_statuses": {
      "type": "object",
      "additionalProperties": {"enum": ["OBSERVED", "MISSING"]}
    },
    "notion_gap_evidence": {
      "type": "object",
      "required": [
        "repo_equivalent_found",
        "implementation_status",
        "match_strength",
        "recommended_action",
        "missing_elements"
      ],
      "properties": {
        "repo_equivalent_found": {"type": "boolean"},
        "implementation_status": {"type": "string"},
        "match_strength": {"type": "string"},
        "recommended_action": {"type": "string"},
        "missing_elements": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "generated_artifact_control_evidence": {
      "type": "object",
      "required": [
        "control_paths_observed",
        "control_paths_total",
        "policy_control_surface",
        "regeneration_policy_is_advisory_only",
        "regeneration_policy_grants_code_mutation"
      ],
      "properties": {
        "control_paths_observed": {"type": "integer", "minimum": 0},
        "control_paths_total": {"type": "integer", "minimum": 0},
        "policy_control_surface": {"const": "GENERATED_ARTIFACT_POLICY_V1"},
        "regeneration_policy_is_advisory_only": {"const": true},
        "regeneration_policy_grants_code_mutation": {"const": false}
      },
      "additionalProperties": false
    },
    "spine_required_path_records": {"$ref": "#/$defs/path_records"},
    "generated_artifact_control_path_records": {"$ref": "#/$defs/path_records"},
    "gap_summary": {
      "type": "object",
      "required": [
        "spine_required_paths",
        "spine_missing_paths",
        "control_required_paths",
        "control_observed_paths"
      ],
      "properties": {
        "spine_required_paths": {"type": "integer", "minimum": 0},
        "spine_missing_paths": {"type": "integer", "minimum": 0},
        "control_required_paths": {"type": "integer", "minimum": 0},
        "control_observed_paths": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "planning_phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase_id", "phase_status", "required_input", "exit_condition"],
        "properties": {
          "phase_id": {"type": "string"},
          "phase_status": {"const": "PLANNED_ONLY"},
          "required_input": {"type": "string"},
          "exit_condition": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "blocked_actions": {"type": "array", "items": {"type": "string"}},
    "continuity_boundary": {
      "type": "object",
      "required": [
        "canon_resume_recommended_resume_lane",
        "preflight_sources_are_advisory_only",
        "preflight_grants_execution_authority"
      ],
      "properties": {
        "canon_resume_recommended_resume_lane": {"type": "string"},
        "preflight_sources_are_advisory_only": {"const": true},
        "preflight_grants_execution_authority": {"const": false}
      },
      "additionalProperties": false
    },
    "recommended_next_lane": {"const": "ABX_CODEGEN_INTELLIGENCE_SPINE_ADVISORY_SPEC_PLAN"},
    "recommended_next_action": {"type": "string"},
    "codegen_spine_implementation_performed": {"const": false},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "non_authoritative": {"const": true},
    "execution_authority": {"const": false},
    "valid_for_execution": {"const": false},
    "valid_for_implementation": {"const": false},
    "code_generation_allowed": {"const": false},
    "code_mutation_allowed": {"const": false},
    "file_writeback_allowed": {"const": false},
    "runtime_mutation_allowed": {"const": false},
    "canon_mutation_allowed": {"const": false},
    "queue_mutation_allowed": {"const": false},
    "scheduler_mutation_allowed": {"const": false},
    "forecast_routing_allowed": {"const": false},
    "notion_writeback_allowed": {"const": false},
    "github_writeback_allowed": {"const": false},
    "authority_locks": {
      "type": "object",
      "required": [
        "auto_approval",
        "canon_mutation",
        "code_generation",
        "code_mutation",
        "execution_authority",
        "file_writeback",
        "forecast_routing",
        "github_writeback",
        "notion_writeback",
        "queue_mutation",
        "runtime_mutation",
        "scheduler_mutation"
      ],
      "properties": {
        "auto_approval": {"const": false},
        "canon_mutation": {"const": false},
        "code_generation": {"const": false},
        "code_mutation": {"const": false},
        "execution_authority": {"const": false},
        "file_writeback": {"const": false},
        "forecast_routing": {"const": false},
        "github_writeback": {"const": false},
        "notion_writeback": {"const": false},
        "queue_mutation": {"const": false},
        "runtime_mutation": {"const": false},
        "scheduler_mutation": {"const": false}
      },
      "additionalProperties": false
    },
    "packet_hash": {"type": "string"}
  },
  "$defs": {
    "path_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "status", "source_hash"],
        "properties": {
          "path": {"type": "string"},
          "status": {"enum": ["OBSERVED", "MISSING"]},
          "source_hash": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
