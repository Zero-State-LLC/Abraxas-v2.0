{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/canon/geodesic_distance_implementation_readiness_dossier.v1.schema.json",
  "title": "GeodesicDistanceImplementationReadinessDossier.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","dossier_id","dossier_type","selected_operator","dossier_status","readiness_scope","intended_lane","implementation_scope","mathematical_requirements","input_shape_requirements","determinism_requirements","numerical_constraints","numerical_stability_requirements","dependency_inventory","implementation_prerequisites","implementation_risks","validation_requirements","blocked_scopes","authority_locks","output_contract","governance_flags","provenance","created_at_utc","canonical_hash"],
  "properties": {
    "schema_version": {"const": "GeodesicDistanceImplementationReadinessDossier.v1"},
    "dossier_id": {"type": "string", "minLength": 1},
    "dossier_type": {"const": "GEODESIC_DISTANCE_IMPLEMENTATION_READINESS_DOSSIER"},
    "selected_operator": {"const": "GEODESIC"},
    "dossier_status": {"const": "GEODESIC_READINESS_DOSSIER_DEFINED"},
    "readiness_scope": {"const": "IMPLEMENTATION_READINESS_ONLY"},
    "intended_lane": {"const": "SHADOW"},
    "implementation_scope": {
      "type": "object", "additionalProperties": true,
      "required": ["mode","planning_lane","readiness_status"],
      "properties": {
        "mode": {"type": "string", "minLength": 1},
        "planning_lane": {"type": "string", "minLength": 1},
        "readiness_status": {"type": "string", "minLength": 1}
      }
    },
    "mathematical_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "input_shape_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "determinism_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "numerical_constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "numerical_stability_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dependency_inventory": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "implementation_prerequisites": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "implementation_risks": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "validation_requirements": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": true}},
    "blocked_scopes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "authority_locks": {"type": "object", "additionalProperties": false,
      "required": ["advisory_only","shadow_lane_only","readiness_dossier_only","geodesic_computation_authorized","emits_metric_values","forecast_influence","p43_surface_lanes_authorized","production_activation","canon_promotion","runtime_mutation","execution_authority","inference_authority"],
      "properties": {
        "advisory_only": {"const": true}, "shadow_lane_only": {"const": true},
        "readiness_dossier_only": {"const": true},
        "geodesic_computation_authorized": {"const": false},
        "emits_metric_values": {"const": false}, "forecast_influence": {"const": false},
        "p43_surface_lanes_authorized": {"const": false},
        "production_activation": {"const": false}, "canon_promotion": {"const": false},
        "runtime_mutation": {"const": false}, "execution_authority": {"const": false},
        "inference_authority": {"const": false}
      }
    },
    "output_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation_completed","runtime_enabled","scheduler_enabled","renderer_enabled","oracle_enabled","forecast_enabled","production_ready"],
      "properties": {
        "implementation_completed": {"const": false}, "runtime_enabled": {"const": false},
        "scheduler_enabled": {"const": false}, "renderer_enabled": {"const": false},
        "oracle_enabled": {"const": false}, "forecast_enabled": {"const": false},
        "production_ready": {"const": false}
      }
    },
    "governance_flags": {
      "type": "object", "additionalProperties": false,
      "required": ["production_activation","canon_promotion","scheduler_mutation","runtime_authority","runtime_mutation","forecast_influence","execution_authority","token_minting_allowed","valid_for_execution","activation_approved","authorization_granted"],
      "properties": {
        "production_activation": {"const": false}, "canon_promotion": {"const": false},
        "scheduler_mutation": {"const": false}, "runtime_authority": {"const": false},
        "runtime_mutation": {"const": false}, "forecast_influence": {"const": false},
        "execution_authority": {"const": false}, "token_minting_allowed": {"const": false},
        "valid_for_execution": {"const": false}, "activation_approved": {"const": false},
        "authorization_granted": {"const": false}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": true,
      "required": ["source","evidence_refs","generated_by","upstream_schema_refs"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "generated_by": {"type": "string", "minLength": 1},
        "upstream_schema_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "created_at_utc": {"type": "string", "minLength": 1},
    "canonical_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
