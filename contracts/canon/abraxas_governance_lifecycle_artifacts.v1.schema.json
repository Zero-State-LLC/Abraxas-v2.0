{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Abraxas Governance Lifecycle Artifacts v1",
  "type": "object",
  "properties": {
    "result_class": {"type": "string"},
    "governance_layer": {"type": "integer", "minimum": 0, "maximum": 3},
    "implementation_allowed": {"type": "boolean"},
    "automatic_under_engineering_approval": {"type": "boolean"},
    "engineering_implementation_complete": {"type": "boolean"},
    "all_system_authority_false": {"type": "boolean"},
    "status": {"type": "string"},
    "continuous_engineering_eligible": {"type": "boolean"}
  },
  "required": ["governance_layer", "implementation_allowed"]
}