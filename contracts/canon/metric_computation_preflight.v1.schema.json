{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/canon/metric_computation_preflight.v1.schema.json",
  "title": "MetricComputationPreflight.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preflight_id",
    "preflight_type",
    "preflight_status",
    "source_webgl_renderer_boundary_hash",
    "source_metric_registry_hash",
    "source_baseline_vector_pack_hash",
    "source_operator_decision_ref",
    "preflight_projection",
    "preflight_governance_acknowledgements",
    "metric_intake_record",
    "renderer_output_declaration",
    "validation_rules",
    "blocked_scopes",
    "authority_locks",
    "governance_flags",
    "recommended_next_step",
    "provenance",
    "created_at_utc",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": {"const": "MetricComputationPreflight.v1"},
    "preflight_id": {"type": "string", "minLength": 1},
    "preflight_type": {"const": "METRIC_COMPUTATION_PREFLIGHT_BOUNDARY"},
    "preflight_status": {"const": "METRIC_COMPUTATION_PREFLIGHT_DEFINED"},
    "source_webgl_renderer_boundary_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_metric_registry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_baseline_vector_pack_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_operator_decision_ref": {"type": "string", "minLength": 1},
    "preflight_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_only",
        "data_source_hash",
        "emits_metric_values",
        "execution_authority",
        "forecast_influence",
        "metric_computation_status",
        "preflight_only",
        "projection_only",
        "registered_operator_count",
        "schema_version",
        "title"
      ],
      "properties": {
        "advisory_only": {"const": true},
        "data_source_hash": {"type": "string"},
        "emits_metric_values": {"const": false},
        "execution_authority": {"const": false},
        "forecast_influence": {"const": false},
        "metric_computation_status": {"const": "PREFLIGHT_BOUNDARY_ONLY"},
        "preflight_only": {"const": true},
        "projection_only": {"const": true},
        "registered_operator_count": {"type": "integer", "minimum": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "title": {"type": "string"}
      }
    },
    "preflight_governance_acknowledgements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_twelve_operators_remain_not_implemented",
        "emits_metric_values_is_false",
        "metric_computation_authorized_does_not_grant_forecast_authority",
        "metric_computation_authorized_does_not_grant_inference_authority",
        "p43_surface_lanes_remain_blocked",
        "production_activation_remains_false"
      ],
      "properties": {
        "all_twelve_operators_remain_not_implemented": {"const": true},
        "emits_metric_values_is_false": {"const": true},
        "metric_computation_authorized_does_not_grant_forecast_authority": {"const": true},
        "metric_computation_authorized_does_not_grant_inference_authority": {"const": true},
        "p43_surface_lanes_remain_blocked": {"const": true},
        "production_activation_remains_false": {"const": true}
      }
    },
    "metric_intake_record": {"type": "object", "additionalProperties": true},
    "renderer_output_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emits_canvas",
        "emits_forecast_inputs",
        "emits_metric_values",
        "emits_planning_metadata",
        "emits_rendered_output",
        "emits_runtime_controls",
        "emits_svg",
        "emits_ui_controls",
        "emits_webgl",
        "execution_authority",
        "forecast_influence"
      ],
      "properties": {
        "emits_canvas": {"const": false},
        "emits_forecast_inputs": {"const": false},
        "emits_metric_values": {"const": false},
        "emits_planning_metadata": {"const": true},
        "emits_rendered_output": {"const": false},
        "emits_runtime_controls": {"const": false},
        "emits_svg": {"const": false},
        "emits_ui_controls": {"const": false},
        "emits_webgl": {"const": false},
        "execution_authority": {"const": false},
        "forecast_influence": {"const": false}
      }
    },
    "validation_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "AUTHORITY_LOCK_SCAN",
          "GOVERNANCE_FALSE_FLAG_SCAN",
          "NO_RUNTIME_MUTATION_SCAN",
          "OUTPUT_DECLARATION_COMPLIANCE",
          "PREFLIGHT_GOVERNANCE_ACKNOWLEDGEMENT_CHECK",
          "PREFLIGHT_PROJECTION_COMPLIANCE",
          "RENDERER_BOUNDARY_CHAIN_CHECK",
          "SCHEMA_VALIDATION",
          "SOURCE_REF_PRESERVATION_CHECK"
        ]
      }
    },
    "blocked_scopes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_only",
        "baseline_mutation",
        "canon_promotion",
        "canvas_renderer_implementation_authorized",
        "governance_authority_mutation",
        "metric_computation_authorized",
        "p43_surface_lanes_authorized",
        "production_activation",
        "projection_only",
        "renderer_boundary_implementation",
        "runtime_mutation",
        "scheduler_mutation",
        "svg_renderer_implementation_authorized",
        "webgl_renderer_implementation_authorized",
        "work_package_definition_only"
      ],
      "properties": {
        "advisory_only": {"const": true},
        "projection_only": {"const": true},
        "renderer_boundary_implementation": {"const": true},
        "metric_computation_authorized": {"const": true},
        "webgl_renderer_implementation_authorized": {"const": true},
        "canvas_renderer_implementation_authorized": {"const": true},
        "svg_renderer_implementation_authorized": {"const": true},
        "work_package_definition_only": {"const": false},
        "p43_surface_lanes_authorized": {"const": false},
        "production_activation": {"const": false},
        "canon_promotion": {"const": false},
        "scheduler_mutation": {"const": false},
        "baseline_mutation": {"const": false},
        "runtime_mutation": {"const": false},
        "governance_authority_mutation": {"const": false}
      }
    },
    "governance_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_approved",
        "authorization_granted",
        "canon_promotion",
        "execution_authority",
        "forecast_influence",
        "production_activation",
        "runtime_authority",
        "runtime_mutation",
        "scheduler_mutation",
        "token_minting_allowed",
        "valid_for_execution"
      ],
      "properties": {
        "activation_approved": {"const": false},
        "authorization_granted": {"const": false},
        "canon_promotion": {"const": false},
        "execution_authority": {"const": false},
        "forecast_influence": {"const": false},
        "production_activation": {"const": false},
        "runtime_authority": {"const": false},
        "runtime_mutation": {"const": false},
        "scheduler_mutation": {"const": false},
        "token_minting_allowed": {"const": false},
        "valid_for_execution": {"const": false}
      }
    },
    "recommended_next_step": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "evidence_refs", "generated_by", "upstream_schema_refs"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "generated_by": {"type": "string", "minLength": 1},
        "upstream_schema_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "created_at_utc": {"type": "string", "minLength": 1},
    "canonical_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
