{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/notion_operator_decision_backlog.v1.schema.json",
  "title": "Notion Operator Decision Backlog",
  "type": "object",
  "required": [
    "artifact_type",
    "backlog_id",
    "backlog_status",
    "notion_source",
    "depends_on_artifacts",
    "source_artifact_hashes",
    "queue_observed",
    "queue_terminal",
    "blocked_surface_count",
    "decision_backlog",
    "top_priority_surface",
    "top_priority_required_inputs",
    "recommended_next_patch",
    "recommended_next_action",
    "safe_to_prepare_planning_pr",
    "safe_to_auto_continue",
    "auto_patch_generation_allowed",
    "notion_writeback_allowed",
    "github_writeback_allowed",
    "advisory_only",
    "projection_only",
    "evidence_only",
    "non_authoritative",
    "forecast_routing",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "valid_for_execution",
    "blocked_actions",
    "authority_locks",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {"const": "NotionOperatorDecisionBacklog.v1"},
    "backlog_id": {"const": "NOTION_OPERATOR_DECISION_BACKLOG_001"},
    "backlog_status": {
      "enum": ["OPERATOR_DECISION_BACKLOG_EMITTED_ADVISORY_ONLY", "NOT_COMPUTABLE"]
    },
    "notion_source": {"const": "ABRAXAS_PATCH_QUEUE_REVISED_001"},
    "depends_on_artifacts": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "source_artifact_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "queue_observed": {"type": "boolean"},
    "queue_terminal": {"type": "boolean"},
    "blocked_surface_count": {"type": "integer", "minimum": 0},
    "decision_backlog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "backlog_rank",
          "queue_rank",
          "notion_surface",
          "decision_scope",
          "source_completion_status",
          "source_match_strength",
          "queue_action",
          "hold_reason",
          "required_inputs",
          "recommended_action",
          "observed_paths",
          "missing_paths"
        ],
        "properties": {
          "backlog_rank": {"type": "integer", "minimum": 1},
          "queue_rank": {"type": "integer", "minimum": 1},
          "notion_surface": {"type": "string"},
          "decision_scope": {
            "enum": [
              "IMPLEMENTATION_SPEC_DECISION_REQUIRED",
              "GOVERNED_OPERATOR_DECISION_REQUIRED",
              "NOTION_SPEC_REFRESH_REQUIRED"
            ]
          },
          "source_completion_status": {"enum": ["BLOCKED", "GOVERNED_HOLD"]},
          "source_match_strength": {"enum": ["EXACT", "PARTIAL", "MISSING"]},
          "queue_action": {"const": "HOLD_FOR_GOVERNED_OPERATOR_DECISION"},
          "hold_reason": {"type": "string"},
          "required_inputs": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "recommended_action": {"type": "string"},
          "observed_paths": {"type": "array", "items": {"type": "string"}},
          "missing_paths": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "top_priority_surface": {"type": "string"},
    "top_priority_required_inputs": {"type": "array", "items": {"type": "string"}},
    "recommended_next_patch": {"const": "NOT_COMPUTABLE"},
    "recommended_next_action": {"type": "string"},
    "safe_to_prepare_planning_pr": {"const": false},
    "safe_to_auto_continue": {"const": false},
    "auto_patch_generation_allowed": {"const": false},
    "notion_writeback_allowed": {"const": false},
    "github_writeback_allowed": {"const": false},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "evidence_only": {"const": true},
    "non_authoritative": {"const": true},
    "forecast_routing": {"const": false},
    "canon_mutation": {"const": false},
    "runtime_mutation": {"const": false},
    "execution_authority": {"const": false},
    "valid_for_execution": {"const": false},
    "blocked_actions": {"type": "array", "items": {"type": "string"}},
    "authority_locks": {
      "type": "object",
      "required": [
        "auto_patch_generation",
        "canon_mutation",
        "execution_authority",
        "forecast_routing",
        "github_writeback",
        "notion_writeback",
        "runtime_mutation",
        "scheduler_mutation",
        "token_minting"
      ],
      "properties": {
        "auto_patch_generation": {"const": false},
        "canon_mutation": {"const": false},
        "execution_authority": {"const": false},
        "forecast_routing": {"const": false},
        "github_writeback": {"const": false},
        "notion_writeback": {"const": false},
        "runtime_mutation": {"const": false},
        "scheduler_mutation": {"const": false},
        "token_minting": {"const": false}
      },
      "additionalProperties": false
    },
    "packet_hash": {"type": "string"}
  },
  "additionalProperties": false
}
