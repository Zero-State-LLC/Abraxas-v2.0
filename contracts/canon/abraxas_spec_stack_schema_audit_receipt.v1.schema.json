{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/abraxas_spec_stack_schema_audit_receipt.v1.schema.json",
  "title": "AbraxasSpecStackSchemaAuditReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "status",
    "advisory_only",
    "execution_allowed",
    "authority_granted",
    "runtime_mutation_allowed",
    "canon_mutation_allowed",
    "scheduler_allowed",
    "queue_mutation_allowed",
    "notion_writeback_allowed",
    "github_writeback_allowed",
    "downstream_status",
    "domain_audits",
    "stack_summary",
    "recommended_next_lane",
    "authority_locks",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": { "const": "AbraxasSpecStackSchemaAuditReceipt.v1" },
    "receipt_id": { "const": "ABRAXAS_SPEC_STACK_SCHEMA_AUDIT_RECEIPT_001" },
    "status": { "const": "ABRAXAS_SPEC_STACK_SCHEMA_AUDIT_RECEIPT_EMITTED_ADVISORY_ONLY" },
    "advisory_only": { "const": true },
    "execution_allowed": { "const": false },
    "authority_granted": { "const": false },
    "runtime_mutation_allowed": { "const": false },
    "canon_mutation_allowed": { "const": false },
    "scheduler_allowed": { "const": false },
    "queue_mutation_allowed": { "const": false },
    "notion_writeback_allowed": { "const": false },
    "github_writeback_allowed": { "const": false },
    "downstream_status": { "const": "NOT_COMPUTABLE" },
    "domain_audits": { "type": "array", "minItems": 5, "maxItems": 5 },
    "stack_summary": {
      "type": "object",
      "required": [
        "domain_count",
        "total_expected_contract_count",
        "total_repo_observed_count",
        "total_missing_contract_count"
      ],
      "properties": {
        "domain_count": { "const": 5 },
        "total_expected_contract_count": { "type": "integer" },
        "total_repo_observed_count": { "type": "integer" },
        "total_missing_contract_count": { "type": "integer" }
      }
    },
    "recommended_next_lane": { "const": "NOT_COMPUTABLE" },
    "authority_locks": { "type": "object" },
    "receipt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
