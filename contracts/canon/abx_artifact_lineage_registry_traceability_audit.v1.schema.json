{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.dev/contracts/canon/abx_artifact_lineage_registry_traceability_audit.v1.schema.json",
  "title": "AbxArtifactLineageRegistryTraceabilityAudit",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "artifact_type",
    "audit_id",
    "generated_at",
    "source_completion_plan",
    "source_completion_plan_path",
    "source_completion_plan_hash",
    "source_completion_plan_observed",
    "research_sources",
    "artifact_lineage_record_shape",
    "scan_scope",
    "registry_findings",
    "runner_findings",
    "schema_findings",
    "output_findings",
    "test_findings",
    "docs_findings",
    "notion_mapping_findings",
    "target_cluster_results",
    "unresolved_cases",
    "forbidden_actions",
    "governance_locks",
    "recommended_next_plan",
    "downstream",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": { "const": "AbxArtifactLineageRegistryTraceabilityAudit.v1" },
    "audit_id": { "const": "ABX_ARTIFACT_LINEAGE_REGISTRY_TRACEABILITY_AUDIT_001" },
    "generated_at": { "const": "2026-06-05T00:00:00Z" },
    "source_completion_plan": { "const": "ABX_ARTIFACT_LINEAGE_REGISTRY_COMPLETION_PLAN_001" },
    "source_completion_plan_path": { "const": "out/sync/abx_artifact_lineage_registry_completion_plan/latest.json" },
    "source_completion_plan_hash": { "type": "string" },
    "source_completion_plan_observed": { "const": true },
    "research_sources": { "type": "array", "minItems": 3, "items": { "type": "object" } },
    "artifact_lineage_record_shape": {
      "type": "object",
      "required": [
        "artifact_id",
        "artifact_family",
        "producer_module",
        "runner_path",
        "schema_path",
        "output_json_path",
        "output_md_path",
        "registry_entry",
        "parent_artifacts",
        "child_artifacts",
        "provenance_hash",
        "drift_status",
        "replay_status",
        "notion_surface",
        "not_computable_reason"
      ]
    },
    "scan_scope": {
      "type": "object",
      "required": ["required_repo_scans", "repo_scan_counts"],
      "properties": {
        "required_repo_scans": { "type": "array", "minItems": 11, "items": { "type": "string" } },
        "repo_scan_counts": { "type": "object" }
      }
    },
    "registry_findings": { "type": "array", "minItems": 2, "items": { "type": "object" } },
    "runner_findings": { "type": "array", "minItems": 2, "items": { "type": "object" } },
    "schema_findings": { "type": "array", "minItems": 2, "items": { "type": "object" } },
    "output_findings": { "type": "array", "minItems": 2, "items": { "type": "object" } },
    "test_findings": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "docs_findings": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "notion_mapping_findings": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "target_cluster_results": { "type": "array", "minItems": 8, "items": { "type": "object" } },
    "unresolved_cases": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "forbidden_actions": {
      "type": "array",
      "contains": { "const": "infer_missing_artifacts_as_present" },
      "items": { "type": "string" }
    },
    "governance_locks": {
      "type": "object",
      "required": [
        "governance_status",
        "canon_status",
        "execution_authority",
        "canon_mutation_allowed",
        "runtime_mutation_allowed",
        "research_candidates_canonized",
        "downstream",
        "operator_review_required"
      ],
      "properties": {
        "governance_status": { "const": "FROZEN" },
        "canon_status": { "const": "ADVISORY_ONLY" },
        "execution_authority": { "const": false },
        "canon_mutation_allowed": { "const": false },
        "runtime_mutation_allowed": { "const": false },
        "research_candidates_canonized": { "const": false },
        "downstream": { "const": "NOT_COMPUTABLE" },
        "operator_review_required": { "const": true }
      }
    },
    "recommended_next_plan": { "const": "ABX_ARTIFACT_LINEAGE_REGISTRY_REPAIR_PLAN_001" },
    "downstream": { "const": "NOT_COMPUTABLE" },
    "packet_hash": { "type": "string" }
  }
}
