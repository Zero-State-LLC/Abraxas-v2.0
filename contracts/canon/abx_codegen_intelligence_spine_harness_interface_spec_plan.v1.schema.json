    "proof_flags": {"type": "object"},
    "meta_gate_handling_rules": {
      "type": "array",
      "items": {"type": "object"}
    },
    "failure_modes": {
      "type": "array",
      "items": {"type": "object"}
    },
    "integration_guidance": {"type": "object"},
    "output_requirements": {"type": "object"},
