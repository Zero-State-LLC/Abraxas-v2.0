{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/continuity_namespace_readiness_review.v1.schema.json",
  "title": "Continuity Namespace Readiness Review",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "advisory_only",
    "artifact_type",
    "authority_locks",
    "authorization_authority",
    "authorization_granted",
    "authorization_record_created",
    "authorization_record_creation_authority",
    "canon_promotion",
    "composite_id_format",
    "consumed_audit_artifact_path",
    "consumed_migration_plan_artifact_path",
    "consumed_stabilization_receipt_artifact_path",
    "denied_authority",
    "execution_authority",
    "forecast_influence",
    "packet_hash",
    "packet_source_inputs",
    "production_activation",
    "projection_only",
    "readiness_blockers",
    "readiness_status",
    "recommended_next_action",
    "recommended_next_lane",
    "record_creation_authority",
    "required_evidence_for_activation",
    "review_id",
    "runtime_authority",
    "safe_next_surface_recommendation",
    "scheduler_mutation",
    "selected_policy",
    "source_state",
    "token_minting_allowed",
    "token_minting_authority",
    "unsafe_actions",
    "unresolved_collision_summary",
    "unresolved_orphan_summary",
    "valid_for_execution"
  ],
  "properties": {
    "advisory_only": { "const": true },
    "artifact_type": { "const": "ContinuityNamespaceReadinessReview.v1" },
    "authority_locks": {
      "type": "object",
      "required": [
        "authorization_authority",
        "authorization_record_creation_authority",
        "canon_promotion",
        "execution_authority",
        "forecast_influence",
        "production_activation",
        "record_creation_authority",
        "runtime_authority",
        "scheduler_mutation",
        "token_minting_authority"
      ],
      "additionalProperties": { "const": false }
    },
    "authorization_authority": { "const": false },
    "authorization_granted": { "const": false },
    "authorization_record_created": { "const": false },
    "authorization_record_creation_authority": { "const": false },
    "canon_promotion": { "const": false },
    "composite_id_format": { "const": "<NAMESPACE_ID>.<P_LANE_ID>" },
    "consumed_audit_artifact_path": { "const": "out/continuity_namespace_audit/latest.json" },
    "consumed_migration_plan_artifact_path": { "const": "out/continuity_namespace_migration_plan/latest.json" },
    "consumed_stabilization_receipt_artifact_path": { "const": "out/continuity_namespace_stabilization_receipt/latest.json" },
    "denied_authority": { "type": "array", "items": { "type": "string" } },
    "execution_authority": { "const": false },
    "forecast_influence": { "const": false },
    "packet_hash": { "type": "string" },
    "packet_source_inputs": { "type": "array", "minItems": 6 },
    "production_activation": { "const": false },
    "projection_only": { "const": true },
    "readiness_blockers": { "type": "array" },
    "readiness_status": {
      "enum": ["READY_FOR_ADDITIVE_ALIAS_PLAN", "HOLD_REQUIRED", "NOT_COMPUTABLE"]
    },
    "recommended_next_action": { "type": "string" },
    "recommended_next_lane": { "const": "NOT_COMPUTABLE" },
    "record_creation_authority": { "const": false },
    "required_evidence_for_activation": { "type": "array", "minItems": 1 },
    "review_id": { "const": "CONTINUITY_NAMESPACE_READINESS_REVIEW_001" },
    "runtime_authority": { "const": false },
    "safe_next_surface_recommendation": { "const": "CONTINUITY_NAMESPACE_ADDITIVE_ALIAS_PLAN_001_ADVISORY_ONLY" },
    "scheduler_mutation": { "const": false },
    "selected_policy": { "const": "D_HYBRID_CANONICAL_GLOBAL_IDS_WITH_BRANCH_LOCAL_ALIASES" },
    "source_state": {
      "type": "object",
      "required": ["canon", "downstream", "governance", "highest_observed_lane", "lane_count"],
      "properties": {
        "canon": { "const": "ADVISORY_ONLY" },
        "downstream": { "const": "NOT_COMPUTABLE" },
        "governance": { "const": "FROZEN" },
        "highest_observed_lane": { "const": "P102G" },
        "lane_count": { "const": 58 }
      }
    },
    "token_minting_allowed": { "const": false },
    "token_minting_authority": { "const": false },
    "unsafe_actions": { "type": "array", "minItems": 1 },
    "unresolved_collision_summary": {
      "type": "object",
      "required": ["critical_ambiguity", "critical_p_numbers", "resolution_posture", "total_collision_count"],
      "properties": {
        "critical_ambiguity": { "const": "P103_TO_P107_RESEARCH_BRANCH_NAME_COLLISION" },
        "total_collision_count": { "const": 62 }
      }
    },
    "unresolved_orphan_summary": {
      "type": "object",
      "required": ["resolution_posture", "total_orphaned_recommended_next_lane_references"],
      "properties": {
        "total_orphaned_recommended_next_lane_references": { "const": 25 }
      }
    },
    "valid_for_execution": { "const": false }
  }
}
