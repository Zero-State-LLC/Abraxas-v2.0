{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/reservoir_geometry_diagnostic.v1.schema.json",
  "title": "Reservoir Geometry Diagnostic v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagnostic_id", "diagnostic_type", "source_attachment_refs", "source_signal_packet_refs", "source_metric_registry_refs", "source_projection_refs", "source_route_metadata_refs", "diagnostic_scope", "reservoir_declarations", "state_space_policy", "spectral_policy", "krylov_policy", "forecasting_policy", "output_contract", "computation_status", "governance_flags", "provenance", "created_at_utc", "canonical_hash"],
  "properties": {
    "schema_version": {"const": "ReservoirGeometryDiagnostic.v1"},
    "diagnostic_id": {"type": "string", "minLength": 1},
    "diagnostic_type": {"const": "RESERVOIR_GEOMETRY_DIAGNOSTIC"},
    "source_attachment_refs": {"type": "array", "items": {"type": "string"}},
    "source_signal_packet_refs": {"type": "array", "items": {"type": "string"}},
    "source_metric_registry_refs": {"type": "array", "items": {"type": "string"}},
    "source_projection_refs": {"type": "array", "items": {"type": "string"}},
    "source_route_metadata_refs": {"type": "array", "items": {"type": "string"}},
    "diagnostic_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "observation_window", "reservoir_family", "intended_lane"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "observation_window": {"type": "string", "minLength": 1},
        "reservoir_family": {"enum": ["ECHO_STATE", "RANDOM_FEATURE_RESERVOIR", "KERNEL_RESERVOIR", "STATE_SPACE_RESERVOIR", "GEOMETRIC_RESERVOIR", "NOT_COMPUTABLE_RESERVOIR"]},
        "intended_lane": {"enum": ["SHADOW", "REPLAY", "PROJECTION", "OBSERVATION_ONLY"]}
      }
    },
    "reservoir_declarations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reservoir_id", "reservoir_type", "description", "declared_use", "evidence_required", "implementation_status"],
        "properties": {
          "reservoir_id": {"type": "string", "minLength": 1},
          "reservoir_type": {"enum": ["STATE_SPACE_REFERENCE", "SPECTRAL_DIAGNOSTIC_REFERENCE", "KRYLOV_ALIGNMENT_REFERENCE", "CONCENTRATION_DIAGNOSTIC_REFERENCE", "GEOMETRY_CONDITIONED_REFERENCE", "BASELINE_RESERVOIR_REFERENCE", "NOT_COMPUTABLE_REFERENCE"]},
          "description": {"type": "string", "minLength": 1},
          "declared_use": {"enum": ["STATE_SPACE_CONTEXT", "SPECTRAL_CONTEXT", "KRYLOV_CONTEXT", "CONCENTRATION_CONTEXT", "GEOMETRY_CONDITIONED_CONTEXT", "BASELINE_COMPARISON_CONTEXT", "NOT_COMPUTABLE_CONTEXT"]},
          "evidence_required": {
            "type": "array",
            "items": {"enum": ["BASELINE_COMPARATOR_REQUIRED", "SOURCE_PACKET_REF_REQUIRED", "REPLAY_VALIDATION_REQUIRED", "PROVENANCE_REF_REQUIRED", "SHADOW_OBSERVATION_REQUIRED", "NO_RUNTIME_EFFECT_REQUIRED"]}
          },
          "implementation_status": {"enum": ["DECLARED_ONLY", "METADATA_ONLY", "NOT_IMPLEMENTED", "SHADOW_STUB_ONLY"]}
        }
      }
    },
    "state_space_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_space_declared", "state_space_computed", "state_space_simulated", "state_space_affects_runtime", "state_space_affects_forecast"],
      "properties": {
        "state_space_declared": {"const": true},
        "state_space_computed": {"const": false},
        "state_space_simulated": {"const": false},
        "state_space_affects_runtime": {"const": false},
        "state_space_affects_forecast": {"const": false}
      }
    },
    "spectral_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spectral_declared", "spectral_computed", "spectral_pollution_diagnostic_computed", "spectral_affects_routing", "spectral_affects_forecast"],
      "properties": {
        "spectral_declared": {"const": true},
        "spectral_computed": {"const": false},
        "spectral_pollution_diagnostic_computed": {"const": false},
        "spectral_affects_routing": {"const": false},
        "spectral_affects_forecast": {"const": false}
      }
    },
    "krylov_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["krylov_declared", "krylov_alignment_computed", "krylov_chain_generated", "krylov_affects_runtime", "krylov_affects_scheduler"],
      "properties": {
        "krylov_declared": {"const": true},
        "krylov_alignment_computed": {"const": false},
        "krylov_chain_generated": {"const": false},
        "krylov_affects_runtime": {"const": false},
        "krylov_affects_scheduler": {"const": false}
      }
    },
    "forecasting_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry_conditioned_forecasting_declared", "forecast_generated", "forecast_probability_updated", "forecast_lane_influence", "pse_output_influence"],
      "properties": {
        "geometry_conditioned_forecasting_declared": {"const": true},
        "forecast_generated": {"const": false},
        "forecast_probability_updated": {"const": false},
        "forecast_lane_influence": {"const": false},
        "pse_output_influence": {"const": false}
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emits_diagnostic_scores", "emits_state_space_outputs", "emits_spectral_outputs", "emits_krylov_outputs", "emits_forecast_outputs", "emits_context_labels", "emits_observation_notes", "emits_runtime_controls", "emits_authority_tokens"],
      "properties": {
        "emits_diagnostic_scores": {"const": false},
        "emits_state_space_outputs": {"const": false},
        "emits_spectral_outputs": {"const": false},
        "emits_krylov_outputs": {"const": false},
        "emits_forecast_outputs": {"const": false},
        "emits_context_labels": {"const": true},
        "emits_observation_notes": {"const": true},
        "emits_runtime_controls": {"const": false},
        "emits_authority_tokens": {"const": false}
      }
    },
    "computation_status": {"enum": ["DECLARED_ONLY", "METADATA_ONLY", "NOT_IMPLEMENTED", "SHADOW_STUB_ONLY"]},
    "governance_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_activation", "canon_promotion", "scheduler_mutation", "runtime_authority", "runtime_mutation", "forecast_influence", "execution_authority", "token_minting_allowed", "valid_for_execution", "activation_approved", "authorization_granted"],
      "properties": {
        "production_activation": {"const": false}, "canon_promotion": {"const": false}, "scheduler_mutation": {"const": false}, "runtime_authority": {"const": false}, "runtime_mutation": {"const": false}, "forecast_influence": {"const": false}, "execution_authority": {"const": false}, "token_minting_allowed": {"const": false}, "valid_for_execution": {"const": false}, "activation_approved": {"const": false}, "authorization_granted": {"const": false}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "evidence_refs", "generated_by", "upstream_schema_refs"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "generated_by": {"type": "string", "minLength": 1},
        "upstream_schema_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "created_at_utc": {"type": "string", "minLength": 1},
    "canonical_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
