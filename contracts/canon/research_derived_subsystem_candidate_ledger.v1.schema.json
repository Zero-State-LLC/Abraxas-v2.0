{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/research_derived_subsystem_candidate_ledger.v1.schema.json",
  "title": "Research Derived Subsystem Candidate Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lane_id",
    "artifact_type",
    "candidate_ledger_status",
    "candidates_ready",
    "derived_candidates",
    "missing_or_invalid_inputs",
    "provenance",
    "recommended_next_lane",
    "authority_locks",
    "packet_hash"
  ],
  "properties": {
    "lane_id": { "const": "P97_RESEARCH_DERIVED_SUBSYSTEM_CANDIDATE_LEDGER" },
    "artifact_type": { "const": "ResearchDerivedSubsystemCandidateLedger.v1" },
    "candidate_ledger_status": { "enum": ["PASS", "NOT_COMPUTABLE"] },
    "candidates_ready": { "type": "boolean" },
    "derived_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "source_validation_id",
          "source_spec_id",
          "source_surface_id",
          "research_fold_family",
          "proposed_subsystem_name",
          "subsystem_scope",
          "candidate_status",
          "governance_posture",
          "authority_class"
        ],
        "properties": {
          "candidate_id": { "type": "string" },
          "source_validation_id": { "type": "string" },
          "source_spec_id": { "type": "string" },
          "source_surface_id": { "type": "string" },
          "research_fold_family": { "type": "string" },
          "proposed_subsystem_name": { "type": "string" },
          "subsystem_scope": { "const": "advisory_shadow_research_candidate_only" },
          "candidate_status": { "const": "CANDIDATE_ONLY" },
          "governance_posture": { "const": "ADVISORY_ONLY" },
          "authority_class": { "const": "NON_OPERATIVE" }
        }
      }
    },
    "missing_or_invalid_inputs": { "type": "array", "items": { "type": "string" } },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "upstream_lane_id", "expected_validation_ids", "deterministic_ordering"],
      "properties": {
        "source": { "const": "p96_research_fold_validation_plan" },
        "upstream_lane_id": { "const": "P96_RESEARCH_FOLD_VALIDATION_PLAN" },
        "expected_validation_ids": { "type": "array", "items": { "type": "string" } },
        "deterministic_ordering": { "const": "candidate_id_ascending" }
      }
    },
    "recommended_next_lane": { "type": "string" },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_only",
        "projection_only",
        "planning_only",
        "evidence_only",
        "candidate_only",
        "production_activation",
        "canon_promotion",
        "scheduler_mutation",
        "runtime_authority",
        "forecast_influence",
        "execution_authority",
        "repair_execution_authority",
        "regeneration_execution_authority",
        "token_minting_allowed",
        "valid_for_execution",
        "canonical_status"
      ],
      "properties": {
        "advisory_only": { "const": true },
        "projection_only": { "const": true },
        "planning_only": { "const": true },
        "evidence_only": { "const": true },
        "candidate_only": { "const": true },
        "production_activation": { "const": false },
        "canon_promotion": { "const": false },
        "scheduler_mutation": { "const": false },
        "runtime_authority": { "const": false },
        "forecast_influence": { "const": false },
        "execution_authority": { "const": false },
        "repair_execution_authority": { "const": false },
        "regeneration_execution_authority": { "const": false },
        "token_minting_allowed": { "const": false },
        "valid_for_execution": { "const": false },
        "canonical_status": { "const": "ADVISORY_ONLY" }
      }
    },
    "packet_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
