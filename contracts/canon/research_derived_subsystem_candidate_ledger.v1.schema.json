{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/research_derived_subsystem_candidate_ledger.v1.schema.json",
  "title": "Research Derived Subsystem Candidate Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "canonical_status",
    "advisory_only",
    "projection_only",
    "lane_id",
    "status",
    "upstream_lane_id",
    "upstream_validation_plan_status",
    "candidate_ledger_status",
    "subsystem_candidates",
    "target_subsystems",
    "authority_locks",
    "stabilization_requirements",
    "recommended_next_lane",
    "recommended_next_lane_reason",
    "not_computable_reasons",
    "provenance",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {"const": "ResearchDerivedSubsystemCandidateLedger.v1"},
    "canonical_status": {"const": "ADVISORY_ONLY"},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "lane_id": {"const": "P97_RESEARCH_DERIVED_SUBSYSTEM_CANDIDATE_LEDGER"},
    "status": {"enum": ["PASS", "NOT_COMPUTABLE"]},
    "upstream_lane_id": {"const": "P96_RESEARCH_FOLD_VALIDATION_PLAN"},
    "upstream_validation_plan_status": {"type": ["string", "null"]},
    "candidate_ledger_status": {"enum": ["READY", "NOT_COMPUTABLE"]},
    "subsystem_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "drop_id",
          "candidate_id",
          "status",
          "primary_targets",
          "candidate_contracts"
        ],
        "properties": {
          "drop_id": {"enum": ["DROP006", "DROP007"]},
          "candidate_id": {"type": "string"},
          "status": {"const": "SHADOW_CANDIDATE_ONLY"},
          "primary_targets": {
            "type": "array",
            "items": {"type": "string"}
          },
          "candidate_contracts": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "target_subsystems": {
      "type": "array",
      "items": {"type": "string"}
    },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_activation",
        "canon_promotion",
        "runtime_mutation",
        "forecast_influence",
        "forecast_weight_allowed",
        "shadow_to_forecast_leakage",
        "scheduler_mutation",
        "autonomous_execution",
        "operator_bypass",
        "hidden_intent_claim_authority"
      ],
      "properties": {
        "production_activation": {"const": false},
        "canon_promotion": {"const": false},
        "runtime_mutation": {"const": false},
        "forecast_influence": {"const": false},
        "forecast_weight_allowed": {"const": false},
        "shadow_to_forecast_leakage": {"const": false},
        "scheduler_mutation": {"const": false},
        "autonomous_execution": {"const": false},
        "operator_bypass": {"const": false},
        "hidden_intent_claim_authority": {"const": false}
      }
    },
    "stabilization_requirements": {
      "type": "array",
      "items": {"type": "string"}
    },
    "recommended_next_lane": {"type": "string"},
    "recommended_next_lane_reason": {"type": "string"},
    "not_computable_reasons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "mapping_method",
        "drop_order",
        "candidate_ordering",
        "p96_status",
        "p96_artifact_type",
        "boundary_rules",
        "gated_recommendation_rule"
      ],
      "properties": {
        "source": {"type": "string"},
        "mapping_method": {"type": "string"},
        "drop_order": {"type": "array", "items": {"type": "string"}},
        "candidate_ordering": {"type": "string"},
        "p96_status": {"type": ["string", "null"]},
        "p96_artifact_type": {"type": ["string", "null"]},
        "boundary_rules": {
          "type": "array",
          "items": {"type": "string"}
        },
        "gated_recommendation_rule": {"type": "string"}
      }
    },
    "packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
