    },
    "analyzed_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "authorization_package_draft_complete_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "authorization_package_draft_incomplete_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "candidate_authorization_package_draft_statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "final_precheck_complete_observed",
          "authorization_package_scope_attached",
          "authorization_package_conditions_attached",
          "rollback_binding_attached",
          "monitoring_binding_attached",
          "blast_radius_binding_attached",
          "exit_criteria_binding_attached",
          "provenance_bundle_attached",
          "safety_notes_attached",
          "execution_disabled_confirmed",
