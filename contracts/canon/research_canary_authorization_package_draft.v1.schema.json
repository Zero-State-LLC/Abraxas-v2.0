          "candidate_id": {"type": "string"},
          "final_precheck_complete_observed": {"type": "boolean"},
          "authorization_package_scope_attached": {"type": "boolean"},
          "authorization_package_conditions_attached": {"type": "boolean"},
          "rollback_binding_attached": {"type": "boolean"},
          "monitoring_binding_attached": {"type": "boolean"},
          "blast_radius_binding_attached": {"type": "boolean"},
          "exit_criteria_binding_attached": {"type": "boolean"},
          "provenance_bundle_attached": {"type": "boolean"},
          "safety_notes_attached": {"type": "boolean"},
          "execution_disabled_confirmed": {"type": "boolean"},
          "operator_review_required": {"type": "boolean"},
          "authority_drift_observed": {"type": "boolean"},
