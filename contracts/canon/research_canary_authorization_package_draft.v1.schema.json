  "properties": {
    "artifact_type": {"const": "ResearchCanaryAuthorizationPackageDraft.v1"},
    "canonical_status": {"const": "ADVISORY_ONLY"},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "lane_id": {"const": "P114_RESEARCH_CANARY_AUTHORIZATION_PACKAGE_DRAFT"},
