        "CANARY_AUTHORIZATION_PACKAGE_DRAFT_COMPLETE",
        "CANARY_AUTHORIZATION_PACKAGE_DRAFT_REJECTED_AUTHORITY_DRIFT"
      ]
    },
    "stabilized_candidates": {
