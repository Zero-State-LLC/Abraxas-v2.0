{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/transport_computation_implementation_gate.v1.schema.json",
  "title": "Transport Computation Implementation Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "operator_id",
    "gate_status",
    "gate_stage",
    "created_at_utc",
    "intended_lane",
    "source_decision_record_hash",
    "source_operator_decision_hash",
    "locked_constants_binding",
    "authorized_implementation_scope",
    "no_metric_emission_block",
    "no_forecast_influence_block",
    "no_p43_surface_lane_block",
    "blocked_scopes",
    "authority_locks",
    "recommended_next_step",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "TransportComputationImplementationGate.v1" },
    "gate_id": { "type": "string" },
    "operator_id": { "const": "TRANSPORT" },
    "gate_status": { "const": "TRANSPORT_COMPUTATION_IMPLEMENTATION_GATE_READY" },
    "gate_stage": { "const": "COMPUTATION_IMPLEMENTATION_GATE_ONLY" },
    "created_at_utc": { "type": "string" },
    "intended_lane": { "type": "string" },
    "source_decision_record_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_operator_decision_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "locked_constants_binding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["all_constants_locked", "constants_count"],
      "properties": {
        "all_constants_locked": { "const": true },
        "constants_count": { "const": 7 }
      }
    },
    "authorized_implementation_scope": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "transport_computation_implementation_authorized",
        "lp_solver_invocation_authorized_for_test_vectors",
        "authorized_computation_type",
        "bounded_scope_only"
      ],
      "properties": {
        "transport_computation_implementation_authorized": { "const": true },
        "lp_solver_invocation_authorized_for_test_vectors": { "const": true },
        "authorized_computation_type": { "const": "TEST_VECTOR_COMPUTATION_ONLY" },
        "bounded_scope_only": { "const": true }
      }
    },
    "no_metric_emission_block": {
      "type": "object",
      "additionalProperties": true,
      "required": ["emits_metric_values", "block_confirmed"],
      "properties": {
        "emits_metric_values": { "const": false },
        "block_confirmed": { "const": true }
      }
    },
    "no_forecast_influence_block": {
      "type": "object",
      "additionalProperties": true,
      "required": ["forecast_influence", "block_confirmed"],
      "properties": {
        "forecast_influence": { "const": false },
        "block_confirmed": { "const": true }
      }
    },
    "no_p43_surface_lane_block": {
      "type": "object",
      "additionalProperties": true,
      "required": ["p43_surface_lanes_authorized", "block_confirmed"],
      "properties": {
        "p43_surface_lanes_authorized": { "const": false },
        "block_confirmed": { "const": true }
      }
    },
    "blocked_scopes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emits_metric_values", "forecast_influence", "p43_surface_lanes_authorized",
        "production_activation", "canon_promotion", "runtime_mutation",
        "execution_authority", "inference_authority"
      ],
      "properties": {
        "emits_metric_values": { "const": false },
        "forecast_influence": { "const": false },
        "p43_surface_lanes_authorized": { "const": false },
        "production_activation": { "const": false },
        "canon_promotion": { "const": false },
        "runtime_mutation": { "const": false },
        "execution_authority": { "const": false },
        "inference_authority": { "const": false }
      }
    },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_only",
        "shadow_lane_only",
        "implementation_gate_only",
        "transport_computation_implementation_authorized",
        "lp_solver_invocation_authorized_for_test_vectors",
        "emits_metric_values",
        "forecast_influence",
        "p43_surface_lanes_authorized",
        "production_activation",
        "canon_promotion",
        "runtime_mutation",
        "execution_authority",
        "inference_authority"
      ],
      "properties": {
        "advisory_only": { "const": true },
        "shadow_lane_only": { "const": true },
        "implementation_gate_only": { "const": true },
        "transport_computation_implementation_authorized": { "const": true },
        "lp_solver_invocation_authorized_for_test_vectors": { "const": true },
        "emits_metric_values": { "const": false },
        "forecast_influence": { "const": false },
        "p43_surface_lanes_authorized": { "const": false },
        "production_activation": { "const": false },
        "canon_promotion": { "const": false },
        "runtime_mutation": { "const": false },
        "execution_authority": { "const": false },
        "inference_authority": { "const": false }
      }
    },
    "recommended_next_step": { "type": "string" },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
