{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/research_stabilization_window_monitor.v1.schema.json",
  "title": "Research Stabilization Window Monitor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "canonical_status",
    "advisory_only",
    "projection_only",
    "lane_id",
    "status",
    "upstream_lane_id",
    "upstream_stabilization_receipt_status",
    "stabilization_window_monitor_status",
    "stabilized_candidates",
    "held_candidates",
    "repair_candidates",
    "rejected_candidates",
    "minimum_shadow_cycles_required",
    "candidate_window_statuses",
    "window_complete_candidates",
    "window_incomplete_candidates",
    "missing_proof_flags",
    "authority_locks",
    "recommended_next_lane",
    "recommended_next_lane_reason",
    "not_computable_reasons",
    "provenance",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {"const": "ResearchStabilizationWindowMonitor.v1"},
    "canonical_status": {"const": "ADVISORY_ONLY"},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "lane_id": {"const": "P102_RESEARCH_STABILIZATION_WINDOW_MONITOR"},
    "status": {
      "enum": [
        "STABILIZATION_WINDOW_MONITOR_EMITTED",
        "NOT_COMPUTABLE",
        "REJECTED_AUTHORITY_DRIFT"
      ]
    },
    "upstream_lane_id": {"const": "P101_RESEARCH_SHADOW_STABILIZATION_RECEIPT"},
    "upstream_stabilization_receipt_status": {"type": ["string", "null"]},
    "stabilization_window_monitor_status": {
      "enum": ["EMITTED", "NOT_COMPUTABLE", "REJECTED_AUTHORITY_DRIFT"]
    },
    "stabilized_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "held_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "repair_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "rejected_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "minimum_shadow_cycles_required": {"type": "integer", "minimum": 0},
    "candidate_window_statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "current_shadow_cycles_observed",
          "minimum_shadow_cycles_required",
          "cycle_requirement_satisfied",
          "proof_flags",
          "missing_proof_flags",
          "stabilization_window_status"
        ],
        "properties": {
          "candidate_id": {"type": "string"},
          "current_shadow_cycles_observed": {"type": "integer", "minimum": 0},
          "minimum_shadow_cycles_required": {"type": "integer", "minimum": 0},
          "cycle_requirement_satisfied": {"type": "boolean"},
          "proof_flags": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "authority_lock_invariance_observed",
              "deterministic_replay_observed",
              "not_computable_failure_proof_observed",
              "aal_viz_projection_only_observed",
              "operator_review_observed",
              "no_runtime_mutation_observed",
              "no_canon_promotion_observed",
              "no_forecast_weight_mutation_observed"
            ],
            "properties": {
              "authority_lock_invariance_observed": {"type": "boolean"},
              "deterministic_replay_observed": {"type": "boolean"},
              "not_computable_failure_proof_observed": {"type": "boolean"},
              "aal_viz_projection_only_observed": {"type": "boolean"},
              "operator_review_observed": {"type": "boolean"},
              "no_runtime_mutation_observed": {"type": "boolean"},
              "no_canon_promotion_observed": {"type": "boolean"},
              "no_forecast_weight_mutation_observed": {"type": "boolean"}
            }
          },
          "missing_proof_flags": {
            "type": "array",
            "items": {"type": "string"}
          },
          "stabilization_window_status": {
            "enum": [
              "WINDOW_NOT_STARTED",
              "WINDOW_IN_PROGRESS",
              "WINDOW_COMPLETE",
              "WINDOW_BLOCKED_MISSING_PROOFS"
            ]
          }
        }
      }
    },
    "window_complete_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "window_incomplete_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "missing_proof_flags": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_activation",
        "canon_promotion",
        "runtime_mutation",
        "forecast_influence",
        "forecast_weight_allowed",
        "shadow_to_forecast_leakage",
        "scheduler_mutation",
        "autonomous_execution",
        "operator_bypass",
        "hidden_intent_claim_authority"
      ],
      "properties": {
        "production_activation": {"const": false},
        "canon_promotion": {"const": false},
        "runtime_mutation": {"const": false},
        "forecast_influence": {"const": false},
        "forecast_weight_allowed": {"const": false},
        "shadow_to_forecast_leakage": {"const": false},
        "scheduler_mutation": {"const": false},
        "autonomous_execution": {"const": false},
        "operator_bypass": {"const": false},
        "hidden_intent_claim_authority": {"const": false}
      }
    },
    "recommended_next_lane": {"type": "string"},
    "recommended_next_lane_reason": {"type": "string"},
    "not_computable_reasons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "mapping_method",
        "required_proof_flags",
        "boundary_rules",
        "gated_recommendation_rule",
        "p101_status",
        "p101_artifact_type"
      ],
      "properties": {
        "source": {"type": "string"},
        "mapping_method": {"type": "string"},
        "required_proof_flags": {"type": "array", "items": {"type": "string"}},
        "boundary_rules": {"type": "array", "items": {"type": "string"}},
        "gated_recommendation_rule": {"type": "string"},
        "p101_status": {"type": ["string", "null"]},
        "p101_artifact_type": {"type": ["string", "null"]}
      }
    },
    "packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
