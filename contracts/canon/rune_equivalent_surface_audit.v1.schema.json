{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/rune_equivalent_surface_audit.v1.schema.json",
  "title": "Rune Equivalent Surface Audit",
  "type": "object",
  "required": [
    "artifact_type",
    "audit_id",
    "audit_status",
    "notion_source",
    "patch_id",
    "depends_on_patch",
    "route_namespace_mapping_path",
    "route_namespace_mapping_hash",
    "catalog_rune_count",
    "pipeline_count",
    "route_count",
    "required_rune_count",
    "unrequired_rune_count",
    "surface_records",
    "unrequired_runes",
    "rune_registration_performed",
    "execution_dispatch_changed",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "forecast_routing",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "valid_for_execution",
    "recommended_next_patch",
    "authority_locks",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {"const": "RuneEquivalentSurfaceAudit.v1"},
    "audit_id": {"const": "RUNE_EQUIVALENT_SURFACE_AUDIT_001"},
    "audit_status": {"enum": ["EMITTED_ADVISORY_ONLY", "NOT_COMPUTABLE"]},
    "notion_source": {"const": "ABRAXAS_PATCH_QUEUE_REVISED_001"},
    "patch_id": {"const": "PATCH-ABX-RUNE-EQUIVALENT-SURFACE-AUDIT-001"},
    "depends_on_patch": {"const": "PATCH-ABX-YGGDRASIL-ROUTE-NAMESPACE-MAPPING-001"},
    "route_namespace_mapping_path": {"type": "string"},
    "route_namespace_mapping_hash": {"type": "string"},
    "catalog_rune_count": {"type": "integer", "minimum": 0},
    "pipeline_count": {"type": "integer", "minimum": 0},
    "route_count": {"type": "integer", "minimum": 0},
    "required_rune_count": {"type": "integer", "minimum": 0},
    "unrequired_rune_count": {"type": "integer", "minimum": 0},
    "surface_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rune_id",
          "surface_family",
          "lane",
          "catalog_contract_observed",
          "catalog_authority_locked",
          "required_by_pipelines",
          "pipeline_requirement_count",
          "route_namespace_evidence",
          "route_namespace_count",
          "equivalence_status",
          "candidate_only",
          "duplicate_risk",
          "recommended_action"
        ],
        "properties": {
          "rune_id": {"type": "string"},
          "surface_family": {"type": "string"},
          "lane": {"type": "string"},
          "catalog_contract_observed": {"type": "boolean"},
          "catalog_authority_locked": {"type": "boolean"},
          "required_by_pipelines": {"type": "array", "items": {"type": "string"}},
          "pipeline_requirement_count": {"type": "integer", "minimum": 0},
          "route_namespace_evidence": {"type": "array", "items": {"type": "string"}},
          "route_namespace_count": {"type": "integer", "minimum": 0},
          "equivalence_status": {"enum": ["OBSERVED_REQUIRED", "OBSERVED_CANDIDATE_ONLY"]},
          "candidate_only": {"type": "boolean"},
          "duplicate_risk": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "recommended_action": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "unrequired_runes": {"type": "array", "items": {"type": "string"}},
    "rune_registration_performed": {"const": false},
    "execution_dispatch_changed": {"const": false},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "non_authoritative": {"const": true},
    "forecast_routing": {"const": false},
    "canon_mutation": {"const": false},
    "runtime_mutation": {"const": false},
    "execution_authority": {"const": false},
    "valid_for_execution": {"const": false},
    "recommended_next_patch": {"const": "PATCH-ABX-BELIEF-GRAPH-GAP-VERIFICATION-001"},
    "authority_locks": {
      "type": "object",
      "required": ["canon_mutation", "execution_authority", "forecast_routing", "runtime_mutation", "scheduler_mutation", "token_minting"],
      "properties": {
        "canon_mutation": {"const": false},
        "execution_authority": {"const": false},
        "forecast_routing": {"const": false},
        "runtime_mutation": {"const": false},
        "scheduler_mutation": {"const": false},
        "token_minting": {"const": false}
      },
      "additionalProperties": false
    },
    "packet_hash": {"type": "string"}
  },
  "additionalProperties": false
}
