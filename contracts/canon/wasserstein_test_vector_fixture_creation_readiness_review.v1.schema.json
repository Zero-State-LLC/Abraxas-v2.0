{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WassersteinTestVectorFixtureCreationReadinessReview.v1",
  "description": "SHADOW-lane readiness review gating fixture file creation for Wasserstein test vectors. Verifies plan triad presence, 14-group coverage, authority lock satisfaction, and operator review requirement. No fixture files generated; no Wasserstein computation authorized.",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "review_type",
    "operator_id",
    "source_fixture_plan_hash",
    "source_schema_plan_hash",
    "source_dossier_hash",
    "intended_lane",
    "review_stage",
    "plan_triad_presence_check",
    "fixture_coverage_check",
    "authority_lock_check",
    "operator_review_requirement",
    "blocked_scopes",
    "authority_locks",
    "recommended_next_step",
    "provenance",
    "created_at_utc",
    "canonical_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "WassersteinTestVectorFixtureCreationReadinessReview.v1" },
    "review_id": { "type": "string" },
    "review_type": { "type": "string", "const": "WASSERSTEIN_TEST_VECTOR_FIXTURE_CREATION_READINESS_REVIEW" },
    "operator_id": { "type": "string", "const": "WASSERSTEIN" },
    "source_fixture_plan_hash": { "type": "string" },
    "source_schema_plan_hash": { "type": "string" },
    "source_dossier_hash": { "type": "string" },
    "intended_lane": { "type": "string", "enum": ["SHADOW", "PROJECTION", "OBSERVATION_ONLY"] },
    "review_stage": { "type": "string", "enum": ["FIXTURE_CREATION_READINESS_REVIEW_ONLY", "BLOCKED_PENDING_OPERATOR_REVIEW"] },
    "plan_triad_presence_check": {
      "type": "object",
      "required": ["valid_fixture_plan_present", "invalid_fixture_plan_present", "not_computable_fixture_plan_present", "triad_complete", "valid_fixture_plan_status", "invalid_fixture_plan_status", "not_computable_fixture_plan_status", "source_fixture_plan_hash_verified", "finding_status"],
      "additionalProperties": false,
      "properties": {
        "valid_fixture_plan_present": { "type": "boolean", "const": true },
        "invalid_fixture_plan_present": { "type": "boolean", "const": true },
        "not_computable_fixture_plan_present": { "type": "boolean", "const": true },
        "triad_complete": { "type": "boolean", "const": true },
        "valid_fixture_plan_status": { "type": "string", "enum": ["PRESENT_AND_VALIDATED", "MISSING", "INCOMPLETE"] },
        "invalid_fixture_plan_status": { "type": "string", "enum": ["PRESENT_AND_VALIDATED", "MISSING", "INCOMPLETE"] },
        "not_computable_fixture_plan_status": { "type": "string", "enum": ["PRESENT_AND_VALIDATED", "MISSING", "INCOMPLETE"] },
        "source_fixture_plan_hash_verified": { "type": "boolean", "const": true },
        "finding_status": { "type": "string", "enum": ["SATISFIED", "ACTIVE_BLOCKER", "HELD_FOR_REVIEW"] }
      }
    },
    "fixture_coverage_check": {
      "type": "object",
      "required": ["valid_groups_covered", "invalid_groups_covered", "not_computable_groups_covered", "total_groups_covered", "expected_valid_groups", "expected_invalid_groups", "expected_not_computable_groups", "expected_total_groups", "coverage_complete", "coverage_status", "finding_status"],
      "additionalProperties": false,
      "properties": {
        "valid_groups_covered": { "type": "integer", "const": 5 },
        "invalid_groups_covered": { "type": "integer", "const": 5 },
        "not_computable_groups_covered": { "type": "integer", "const": 4 },
        "total_groups_covered": { "type": "integer", "const": 14 },
        "expected_valid_groups": { "type": "integer", "const": 5 },
        "expected_invalid_groups": { "type": "integer", "const": 5 },
        "expected_not_computable_groups": { "type": "integer", "const": 4 },
        "expected_total_groups": { "type": "integer", "const": 14 },
        "coverage_complete": { "type": "boolean", "const": true },
        "coverage_status": { "type": "string", "enum": ["COMPLETE", "INCOMPLETE", "NOT_VERIFIED"] },
        "finding_status": { "type": "string", "enum": ["SATISFIED", "ACTIVE_BLOCKER", "HELD_FOR_REVIEW"] }
      }
    },
    "authority_lock_check": {
      "type": "object",
      "required": ["fixture_files_generated_locked_false", "wasserstein_computation_locked_false", "emits_metric_values_locked_false", "expected_wasserstein_distances_locked_false", "forecast_influence_locked_false", "p43_surface_lanes_locked_false", "production_activation_locked_false", "canon_promotion_locked_false", "runtime_mutation_locked_false", "execution_authority_locked_false", "inference_authority_locked_false", "all_locks_satisfied", "lock_status", "finding_status"],
      "additionalProperties": false,
      "properties": {
        "fixture_files_generated_locked_false": { "type": "boolean", "const": true },
        "wasserstein_computation_locked_false": { "type": "boolean", "const": true },
        "emits_metric_values_locked_false": { "type": "boolean", "const": true },
        "expected_wasserstein_distances_locked_false": { "type": "boolean", "const": true },
        "forecast_influence_locked_false": { "type": "boolean", "const": true },
        "p43_surface_lanes_locked_false": { "type": "boolean", "const": true },
        "production_activation_locked_false": { "type": "boolean", "const": true },
        "canon_promotion_locked_false": { "type": "boolean", "const": true },
        "runtime_mutation_locked_false": { "type": "boolean", "const": true },
        "execution_authority_locked_false": { "type": "boolean", "const": true },
        "inference_authority_locked_false": { "type": "boolean", "const": true },
        "all_locks_satisfied": { "type": "boolean", "const": true },
        "lock_status": { "type": "string", "enum": ["ALL_LOCKS_SATISFIED", "LOCK_VIOLATION_DETECTED", "NOT_VERIFIED"] },
        "finding_status": { "type": "string", "enum": ["SATISFIED", "ACTIVE_BLOCKER", "HELD_FOR_REVIEW"] }
      }
    },
    "operator_review_requirement": {
      "type": "object",
      "required": ["operator_review_required", "fixture_file_creation_authorized", "review_status", "reason", "finding_status"],
      "additionalProperties": false,
      "properties": {
        "operator_review_required": { "type": "boolean", "const": true },
        "fixture_file_creation_authorized": { "type": "boolean", "const": false },
        "review_status": { "type": "string", "enum": ["REQUIRED", "SATISFIED", "WAIVED"] },
        "reason": { "type": "string" },
        "finding_status": { "type": "string", "enum": ["SATISFIED", "ACTIVE_BLOCKER", "HELD_FOR_REVIEW"] }
      }
    },
    "blocked_scopes": {
      "type": "object",
      "required": ["fixture_files_generated", "wasserstein_computation", "emits_metric_values", "expected_wasserstein_distances_added", "forecast_influence", "p43_surface_lanes", "production_activation", "canon_promotion", "runtime_mutation", "execution_authority", "inference_authority"],
      "additionalProperties": false,
      "properties": {
        "fixture_files_generated": { "type": "boolean", "const": false },
        "wasserstein_computation": { "type": "boolean", "const": false },
        "emits_metric_values": { "type": "boolean", "const": false },
        "expected_wasserstein_distances_added": { "type": "boolean", "const": false },
        "forecast_influence": { "type": "boolean", "const": false },
        "p43_surface_lanes": { "type": "boolean", "const": false },
        "production_activation": { "type": "boolean", "const": false },
        "canon_promotion": { "type": "boolean", "const": false },
        "runtime_mutation": { "type": "boolean", "const": false },
        "execution_authority": { "type": "boolean", "const": false },
        "inference_authority": { "type": "boolean", "const": false }
      }
    },
    "authority_locks": {
      "type": "object",
      "required": ["advisory_only", "shadow_lane_only", "fixture_creation_readiness_review_only", "fixture_files_generated", "fixture_file_creation_authorized", "wasserstein_computation_authorized", "emits_metric_values", "expected_wasserstein_distances_added", "forecast_influence", "p43_surface_lanes_authorized", "production_activation", "canon_promotion", "runtime_mutation", "execution_authority", "inference_authority"],
      "additionalProperties": false,
      "properties": {
        "advisory_only": { "type": "boolean", "const": true },
        "shadow_lane_only": { "type": "boolean", "const": true },
        "fixture_creation_readiness_review_only": { "type": "boolean", "const": true },
        "fixture_files_generated": { "type": "boolean", "const": false },
        "fixture_file_creation_authorized": { "type": "boolean", "const": false },
        "wasserstein_computation_authorized": { "type": "boolean", "const": false },
        "emits_metric_values": { "type": "boolean", "const": false },
        "expected_wasserstein_distances_added": { "type": "boolean", "const": false },
        "forecast_influence": { "type": "boolean", "const": false },
        "p43_surface_lanes_authorized": { "type": "boolean", "const": false },
        "production_activation": { "type": "boolean", "const": false },
        "canon_promotion": { "type": "boolean", "const": false },
        "runtime_mutation": { "type": "boolean", "const": false },
        "execution_authority": { "type": "boolean", "const": false },
        "inference_authority": { "type": "boolean", "const": false }
      }
    },
    "recommended_next_step": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["source", "evidence_refs", "generated_by", "upstream_schema_refs"],
      "additionalProperties": true,
      "properties": {
        "source": { "type": "string" },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "generated_by": { "type": "string" },
        "upstream_schema_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "created_at_utc": { "type": "string" },
    "canonical_hash": { "type": "string" }
  }
}
