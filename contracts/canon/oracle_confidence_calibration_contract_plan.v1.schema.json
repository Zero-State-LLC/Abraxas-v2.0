    "contract_specs",
    "planned_contract_paths",
    "planned_phases",
    "acceptance_gates",
    "blocked_actions",
    "required_operator_actions",
    "recommended_next_action",
    "recommended_next_patch",
    "safe_to_prepare_planning_pr",
    "safe_to_prepare_implementation_pr",
    "safe_to_auto_continue",
    "implementation_authorized",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "execution_authority",
    "forecast_routing",
    "canon_mutation",
    "runtime_mutation",
    "queue_mutation",
    "valid_for_execution",
    "governance_locks",
    "not_computable_reasons",
    "downstream",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": { "const": "OracleConfidenceCalibrationContractPlan.v1" },
    "plan_id": { "const": "ORACLE_CONFIDENCE_CALIBRATION_CONTRACT_PLAN_001" },
    "plan_status": { "enum": ["CONTRACT_PLAN_EMITTED_ADVISORY_ONLY", "NOT_COMPUTABLE"] },
    "target_candidate_id": { "const": "ORACLE_CONFIDENCE_CALIBRATION" },
    "implementation_patch_id": { "const": "PATCH-ABX-ORACLE-CONFIDENCE-CALIBRATION-001" },
    "depends_on_artifacts": { "type": "array", "items": { "type": "string" } },
    "source_artifact_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "out/sync/oracle_confidence_calibration_plan/latest.json",
        "out/operator_review/global_ingest_operator_decision_request_001.latest.json"
      ],
      "properties": {
        "out/sync/oracle_confidence_calibration_plan/latest.json": { "type": "string" },
        "out/operator_review/global_ingest_operator_decision_request_001.latest.json": { "type": "string" }
      }
    },
    "calibration_plan_ready": { "type": "boolean" },
    "operator_hold_active": { "type": "boolean" },
    "missing_contract_paths": { "type": "array", "items": { "type": "string" } },
    "contract_specs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract_id", "path", "purpose", "required_fields"],
        "properties": {
          "contract_id": { "type": "string" },
          "path": { "type": "string" },
          "purpose": { "type": "string" },
          "required_fields": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "planned_contract_paths": { "type": "array", "items": { "type": "string" } },
    "planned_phases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase_id", "phase_status", "title", "planned_outputs", "boundary_guard"],
        "properties": {
          "phase_id": { "type": "string" },
          "phase_status": { "const": "PLANNED_ADVISORY_ONLY" },
          "title": { "type": "string" },
          "planned_outputs": { "type": "array", "items": { "type": "string" } },
          "boundary_guard": { "type": "string" }
        }
      }
    },
    "acceptance_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "required_before", "status"],
        "properties": {
          "gate_id": { "type": "string" },
          "required_before": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "blocked_actions": { "type": "array", "items": { "type": "string" } },
    "required_operator_actions": { "type": "array", "items": { "type": "string" } },
    "recommended_next_action": { "type": "string" },
    "recommended_next_patch": { "const": "NOT_COMPUTABLE" },
    "safe_to_prepare_planning_pr": { "const": false },
    "safe_to_prepare_implementation_pr": { "const": false },
    "safe_to_auto_continue": { "const": false },
    "implementation_authorized": { "const": false },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "non_authoritative": { "const": true },
    "execution_authority": { "const": false },
    "forecast_routing": { "const": false },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "queue_mutation": { "const": false },
    "valid_for_execution": { "const": false },
    "governance_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governance_status",
        "canon_status",
        "execution_authority",
        "canon_mutation_allowed",
        "runtime_mutation_allowed",
        "research_candidates_canonized",
        "downstream"
      ],
      "properties": {
        "governance_status": { "const": "FROZEN" },
        "canon_status": { "const": "ADVISORY_ONLY" },
        "execution_authority": { "const": false },
        "canon_mutation_allowed": { "const": false },
        "runtime_mutation_allowed": { "const": false },
        "research_candidates_canonized": { "const": false },
        "downstream": { "const": "NOT_COMPUTABLE" }
      }
    },
    "not_computable_reasons": { "type": "array", "items": { "type": "string" } },
    "downstream": { "const": "NOT_COMPUTABLE" },
    "packet_hash": { "type": "string" }
