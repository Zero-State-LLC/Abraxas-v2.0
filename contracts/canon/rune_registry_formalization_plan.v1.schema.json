{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/rune_registry_formalization_plan.v1.schema.json",
  "title": "Rune Registry Formalization Plan",
  "type": "object",
  "required": [
    "artifact_type",
    "plan_id",
    "plan_status",
    "notion_source",
    "patch_id",
    "depends_on_patch",
    "rune_equivalent_surface_audit_path",
    "rune_equivalent_surface_audit_hash",
    "belief_graph_gap_verification_path",
    "belief_graph_gap_verification_hash",
    "belief_graph_equivalent_observed",
    "catalog_rune_count",
    "required_rune_count",
    "candidate_hold_count",
    "plan_records",
    "candidate_holds",
    "required_runes_preserved",
    "formalization_summary",
    "rune_registration_performed",
    "catalog_mutation_performed",
    "pipeline_mutation_performed",
    "route_mutation_performed",
    "execution_dispatch_changed",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "forecast_routing",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "valid_for_execution",
    "recommended_next_patch",
    "authority_locks",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {"const": "RuneRegistryFormalizationPlan.v1"},
    "plan_id": {"const": "RUNE_REGISTRY_FORMALIZATION_PLAN_001"},
    "plan_status": {"enum": ["PLAN_EMITTED_ADVISORY_ONLY", "NOT_COMPUTABLE"]},
    "notion_source": {"const": "ABRAXAS_PATCH_QUEUE_REVISED_001"},
    "patch_id": {"const": "PATCH-ABX-RUNE-REGISTRY-FORMALIZATION-PLAN-001"},
    "depends_on_patch": {"const": "PATCH-ABX-BELIEF-GRAPH-GAP-VERIFICATION-001"},
    "rune_equivalent_surface_audit_path": {"type": "string"},
    "rune_equivalent_surface_audit_hash": {"type": "string"},
    "belief_graph_gap_verification_path": {"type": "string"},
    "belief_graph_gap_verification_hash": {"type": "string"},
    "belief_graph_equivalent_observed": {"type": "boolean"},
    "catalog_rune_count": {"type": "integer", "minimum": 0},
    "required_rune_count": {"type": "integer", "minimum": 0},
    "candidate_hold_count": {"type": "integer", "minimum": 0},
    "plan_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rune_id",
          "surface_family",
          "lane",
          "source_equivalence_status",
          "candidate_only",
          "pipeline_requirement_count",
          "duplicate_risk",
          "formalization_action",
          "catalog_change_required",
          "pipeline_change_required",
          "route_change_required",
          "dispatch_change_required",
          "operator_authorization_required",
          "recommended_action"
        ],
        "properties": {
          "rune_id": {"type": "string"},
          "surface_family": {"type": "string"},
          "lane": {"type": "string"},
          "source_equivalence_status": {"type": "string"},
          "candidate_only": {"type": "boolean"},
          "pipeline_requirement_count": {"type": "integer", "minimum": 0},
          "duplicate_risk": {"enum": ["LOW", "MEDIUM", "HIGH", "NOT_COMPUTABLE"]},
          "formalization_action": {"enum": ["PRESERVE_REQUIRED_RUNE", "HOLD_CANDIDATE_ONLY"]},
          "catalog_change_required": {"const": false},
          "pipeline_change_required": {"const": false},
          "route_change_required": {"const": false},
          "dispatch_change_required": {"const": false},
          "operator_authorization_required": {"type": "boolean"},
          "recommended_action": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "candidate_holds": {"type": "array", "items": {"type": "string"}},
    "required_runes_preserved": {"type": "array", "items": {"type": "string"}},
    "formalization_summary": {
      "type": "object",
      "required": [
        "total_plan_records",
        "preserve_required_runes",
        "hold_candidate_only_runes",
        "catalog_changes_planned",
        "pipeline_changes_planned",
        "route_changes_planned",
        "dispatch_changes_planned"
      ],
      "properties": {
        "total_plan_records": {"type": "integer", "minimum": 0},
        "preserve_required_runes": {"type": "integer", "minimum": 0},
        "hold_candidate_only_runes": {"type": "integer", "minimum": 0},
        "catalog_changes_planned": {"const": 0},
        "pipeline_changes_planned": {"const": 0},
        "route_changes_planned": {"const": 0},
        "dispatch_changes_planned": {"const": 0}
      },
      "additionalProperties": false
    },
    "rune_registration_performed": {"const": false},
    "catalog_mutation_performed": {"const": false},
    "pipeline_mutation_performed": {"const": false},
    "route_mutation_performed": {"const": false},
    "execution_dispatch_changed": {"const": false},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "non_authoritative": {"const": true},
    "forecast_routing": {"const": false},
    "canon_mutation": {"const": false},
    "runtime_mutation": {"const": false},
    "execution_authority": {"const": false},
    "valid_for_execution": {"const": false},
    "recommended_next_patch": {"const": "NOT_COMPUTABLE"},
    "authority_locks": {
      "type": "object",
      "required": [
        "canon_mutation",
        "execution_authority",
        "forecast_routing",
        "runtime_mutation",
        "scheduler_mutation",
        "token_minting",
        "rune_registration",
        "dispatch_mutation"
      ],
      "properties": {
        "canon_mutation": {"const": false},
        "execution_authority": {"const": false},
        "forecast_routing": {"const": false},
        "runtime_mutation": {"const": false},
        "scheduler_mutation": {"const": false},
        "token_minting": {"const": false},
        "rune_registration": {"const": false},
        "dispatch_mutation": {"const": false}
      },
      "additionalProperties": false
    },
    "packet_hash": {"type": "string"}
  },
  "additionalProperties": false
}
