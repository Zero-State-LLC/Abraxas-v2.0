{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/research_operator_stabilization_decision_record.v1.schema.json",
  "title": "Research Operator Stabilization Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lane_id",
    "artifact_type",
    "stabilization_decision_status",
    "decision_record_ready",
    "decision_record",
    "missing_or_invalid_inputs",
    "provenance",
    "recommended_next_lane",
    "authority_locks",
    "packet_hash"
  ],
  "properties": {
    "lane_id": { "const": "P100_RESEARCH_OPERATOR_STABILIZATION_DECISION_RECORD" },
    "artifact_type": { "const": "ResearchOperatorStabilizationDecisionRecord.v1" },
    "stabilization_decision_status": { "enum": ["PASS", "NOT_COMPUTABLE"] },
    "decision_record_ready": { "type": "boolean" },
    "decision_record": {
      "type": "object",
      "additionalProperties": true
    },
    "missing_or_invalid_inputs": { "type": "array", "items": { "type": "string" } },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "upstream_lane_id", "required_finding_id", "deterministic_ordering"],
      "properties": {
        "source": { "const": "p99_research_cross_drop_conflict_scan" },
        "upstream_lane_id": { "const": "P99_RESEARCH_CROSS_DROP_CONFLICT_SCAN" },
        "required_finding_id": { "const": "DROP006_DROP007_CROSS_DROP_CONFLICT_SCAN" },
        "deterministic_ordering": { "const": "single_decision_record" }
      }
    },
    "recommended_next_lane": { "type": "string" },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_only",
        "projection_only",
        "planning_only",
        "evidence_only",
        "decision_record_only",
        "operator_review_required",
        "shadow_only",
        "production_activation",
        "canon_promotion",
        "scheduler_mutation",
        "runtime_authority",
        "forecast_influence",
        "execution_authority",
        "repair_execution_authority",
        "regeneration_execution_authority",
        "token_minting_allowed",
        "valid_for_execution",
        "activation_approved",
        "authorization_granted",
        "canonical_status"
      ],
      "properties": {
        "advisory_only": { "const": true },
        "projection_only": { "const": true },
        "planning_only": { "const": true },
        "evidence_only": { "const": true },
        "decision_record_only": { "const": true },
        "operator_review_required": { "const": true },
        "shadow_only": { "const": true },
        "production_activation": { "const": false },
        "canon_promotion": { "const": false },
        "scheduler_mutation": { "const": false },
        "runtime_authority": { "const": false },
        "forecast_influence": { "const": false },
        "execution_authority": { "const": false },
        "repair_execution_authority": { "const": false },
        "regeneration_execution_authority": { "const": false },
        "token_minting_allowed": { "const": false },
        "valid_for_execution": { "const": false },
        "activation_approved": { "const": false },
        "authorization_granted": { "const": false },
        "canonical_status": { "const": "ADVISORY_ONLY" }
      }
    },
    "packet_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
