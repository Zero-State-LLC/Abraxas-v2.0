{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/research_operator_stabilization_decision_record.v1.schema.json",
  "title": "Research Operator Stabilization Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "canonical_status",
    "advisory_only",
    "projection_only",
    "lane_id",
    "status",
    "upstream_lane_id",
    "upstream_conflict_scan_status",
    "operator_decision_record_status",
    "operator_decision",
    "decision_reason",
    "candidate_decisions",
    "stabilized_candidates",
    "held_candidates",
    "repair_candidates",
    "rejected_candidates",
    "unresolved_conflicts",
    "authority_locks",
    "recommended_next_lane",
    "recommended_next_lane_reason",
    "not_computable_reasons",
    "provenance",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {
      "const": "ResearchOperatorStabilizationDecisionRecord.v1"
    },
    "canonical_status": {
      "const": "ADVISORY_ONLY"
    },
    "advisory_only": {
      "const": true
    },
    "projection_only": {
      "const": true
    },
    "lane_id": {
      "const": "P100_RESEARCH_OPERATOR_STABILIZATION_DECISION_RECORD"
    },
    "status": {
      "enum": [
        "OPERATOR_DECISION_RECORD_EMITTED",
        "NOT_COMPUTABLE",
        "REJECTED_AUTHORITY_DRIFT"
      ]
    },
    "upstream_lane_id": {
      "const": "P99_RESEARCH_CROSS_DROP_CONFLICT_SCAN"
    },
    "upstream_conflict_scan_status": {
      "type": ["string", "null"]
    },
    "operator_decision_record_status": {
      "type": "string"
    },
    "operator_decision": {
      "type": "string"
    },
    "decision_reason": {
      "type": "string"
    },
    "candidate_decisions": {
      "type": "object",
      "additionalProperties": {
        "enum": ["hold", "repair", "reject", "advance_to_shadow_stabilization"]
      }
    },
    "stabilized_candidates": {
      "type": "array",
      "maxItems": 0,
      "items": {"type": "string"}
    },
    "held_candidates": {
      "type": "array",
      "items": {"type": "string"}
    },
    "repair_candidates": {
      "type": "array",
      "items": {"type": "string"}
    },
    "rejected_candidates": {
      "type": "array",
      "items": {"type": "string"}
    },
    "unresolved_conflicts": {
      "type": "array",
      "items": {"type": "string"}
    },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_activation",
        "canon_promotion",
        "runtime_mutation",
        "forecast_influence",
        "forecast_weight_allowed",
        "shadow_to_forecast_leakage",
        "scheduler_mutation",
        "autonomous_execution",
        "operator_bypass",
        "hidden_intent_claim_authority"
      ],
      "properties": {
        "production_activation": {"const": false},
        "canon_promotion": {"const": false},
        "runtime_mutation": {"const": false},
        "forecast_influence": {"const": false},
        "forecast_weight_allowed": {"const": false},
        "shadow_to_forecast_leakage": {"const": false},
        "scheduler_mutation": {"const": false},
        "autonomous_execution": {"const": false},
        "operator_bypass": {"const": false},
        "hidden_intent_claim_authority": {"const": false}
      }
    },
    "recommended_next_lane": {
      "type": "string"
    },
    "recommended_next_lane_reason": {
      "type": "string"
    },
    "not_computable_reasons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "mapping_method",
        "candidate_ids",
        "allowed_decisions",
        "forbidden_decisions",
        "boundary_rules",
        "gated_recommendation_rule"
      ],
      "properties": {
        "source": {"type": "string"},
        "mapping_method": {"type": "string"},
        "candidate_ids": {"type": "array", "items": {"type": "string"}},
        "allowed_decisions": {"type": "array", "items": {"type": "string"}},
        "forbidden_decisions": {"type": "array", "items": {"type": "string"}},
        "boundary_rules": {"type": "array", "items": {"type": "string"}},
        "gated_recommendation_rule": {"type": "string"}
      }
    },
    "packet_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
