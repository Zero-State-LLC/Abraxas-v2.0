{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/canon/wasserstein_cpu_baseline_actual_pr_gate_review.v1.schema.json",
  "title": "WassersteinCpuBaselineActualPrGateReview.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","review_id","review_type","operator_id","review_status","plans_reviewed","gate_conditions","implementation_recommendation","required_operator_decision","stop_boundary_reason","output_contract","governance_flags","provenance","created_at_utc","canonical_hash"],
  "properties": {
    "schema_version": {"const": "WassersteinCpuBaselineActualPrGateReview.v1"},
    "review_id": {"type": "string", "minLength": 1},
    "review_type": {"const": "WASSERSTEIN_CPU_BASELINE_ACTUAL_PR_GATE_REVIEW"},
    "operator_id": {"const": "WASSERSTEIN"},
    "review_status": {
      "type": "string",
      "enum": ["PLANS_COMPLETE_PENDING_OPERATOR_DECISION","PLANS_INCOMPLETE","BLOCKED"]
    },
    "plans_reviewed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "gate_conditions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["condition_id","condition_description","condition_met"],
        "properties": {
          "condition_id": {"type": "string", "minLength": 1},
          "condition_description": {"type": "string", "minLength": 1},
          "condition_met": {"type": "boolean"}
        }
      }
    },
    "implementation_recommendation": {
      "type": "string",
      "enum": ["ADVISORY_REVIEW_ONLY","NOT_AUTHORIZED","BLOCKED"]
    },
    "required_operator_decision": {"const": true},
    "stop_boundary_reason": {"type": "string", "minLength": 1},
    "output_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["emits_metric_values","emits_scores","emits_forecast_inputs","emits_runtime_controls","emits_authority_tokens","emits_gate_review"],
      "properties": {
        "emits_metric_values": {"const": false},
        "emits_scores": {"const": false},
        "emits_forecast_inputs": {"const": false},
        "emits_runtime_controls": {"const": false},
        "emits_authority_tokens": {"const": false},
        "emits_gate_review": {"const": true}
      }
    },
    "governance_flags": {
      "type": "object", "additionalProperties": false,
      "required": ["production_activation","canon_promotion","scheduler_mutation","runtime_authority","runtime_mutation","forecast_influence","execution_authority","token_minting_allowed","valid_for_execution","activation_approved","authorization_granted"],
      "properties": {
        "production_activation": {"const": false}, "canon_promotion": {"const": false},
        "scheduler_mutation": {"const": false}, "runtime_authority": {"const": false},
        "runtime_mutation": {"const": false}, "forecast_influence": {"const": false},
        "execution_authority": {"const": false}, "token_minting_allowed": {"const": false},
        "valid_for_execution": {"const": false}, "activation_approved": {"const": false},
        "authorization_granted": {"const": false}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": true,
      "required": ["source","evidence_refs","generated_by","upstream_schema_refs"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "generated_by": {"type": "string", "minLength": 1},
        "upstream_schema_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "created_at_utc": {"type": "string", "minLength": 1},
    "canonical_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
