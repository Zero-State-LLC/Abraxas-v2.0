          "gate_id": {"type": "string"},
          "required_evidence": {"type": "array", "items": {"type": "string"}},
          "pass_condition": {"type": "string"},
          "failure_route": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "blocked_patch_classes": {"type": "array", "items": {"type": "string"}},
    "authority_locks": {
      "type": "object",
      "required": [
        "advisory_only",
        "projection_only",
        "non_authoritative",
        "valid_for_execution",
        "valid_for_runtime_wiring",
