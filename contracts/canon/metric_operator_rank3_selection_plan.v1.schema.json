{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/canon/metric_operator_rank3_selection_plan.v1.schema.json",
  "title": "MetricOperatorRank3SelectionPlan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","plan_id","plan_type","selected_operator_id","selection_scope","source_audit_refs","source_registry_stabilization_refs","source_frontier_recommendation_refs","implementation_gates","output_contract","governance_flags","provenance","created_at_utc","canonical_hash"],
  "properties": {
    "schema_version": {"const": "MetricOperatorRank3SelectionPlan.v1"},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_type": {"const": "METRIC_OPERATOR_RANK3_SELECTION_PLAN"},
    "selected_operator_id": {"type": "string", "minLength": 1},
    "selection_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["intended_lane","selection_family","selection_stage"],
      "properties": {
        "intended_lane": {"enum": ["SHADOW","PROJECTION","OBSERVATION_ONLY"]},
        "selection_family": {"enum": ["RANK3_OPERATOR_SELECTION","BASELINE_OPERATOR_SELECTION","LOW_RISK_OPERATOR_SELECTION"]},
        "selection_stage": {"enum": ["SELECTION_PLAN_ONLY","READINESS_REVIEW","SCHEMA_PLAN_READY"]}
      }
    },
    "source_audit_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_registry_stabilization_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_frontier_recommendation_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "implementation_gates": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation_blocked","fixture_creation_blocked","planning_only","requires_dedicated_tests","requires_new_operator_plan"],
      "properties": {
        "implementation_blocked": {"const": true},
        "fixture_creation_blocked": {"const": true},
        "planning_only": {"const": true},
        "requires_dedicated_tests": {"const": true},
        "requires_new_operator_plan": {"const": true}
      }
    },
    "output_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["emits_metric_values","emits_scores","emits_forecast_inputs","emits_runtime_controls","emits_authority_tokens","emits_selection_metadata"],
      "properties": {
        "emits_metric_values": {"const": false},
        "emits_scores": {"const": false},
        "emits_forecast_inputs": {"const": false},
        "emits_runtime_controls": {"const": false},
        "emits_authority_tokens": {"const": false},
        "emits_selection_metadata": {"const": true}
      }
    },
    "governance_flags": {
      "type": "object", "additionalProperties": false,
      "required": ["production_activation","canon_promotion","scheduler_mutation","runtime_authority","runtime_mutation","forecast_influence","execution_authority","token_minting_allowed","valid_for_execution","activation_approved","authorization_granted"],
      "properties": {
        "production_activation": {"const": false}, "canon_promotion": {"const": false},
        "scheduler_mutation": {"const": false}, "runtime_authority": {"const": false},
        "runtime_mutation": {"const": false}, "forecast_influence": {"const": false},
        "execution_authority": {"const": false}, "token_minting_allowed": {"const": false},
        "valid_for_execution": {"const": false}, "activation_approved": {"const": false},
        "authorization_granted": {"const": false}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": true,
      "required": ["source","evidence_refs","generated_by","upstream_schema_refs"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "generated_by": {"type": "string", "minLength": 1},
        "upstream_schema_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "created_at_utc": {"type": "string", "minLength": 1},
    "canonical_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
