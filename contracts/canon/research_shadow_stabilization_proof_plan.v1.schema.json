{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/research_shadow_stabilization_proof_plan.v1.schema.json",
  "title": "Research Shadow Stabilization Proof Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lane_id",
    "artifact_type",
    "stabilization_proof_plan_status",
    "stabilization_proof_plan_ready",
    "stabilization_proof_records",
    "missing_or_invalid_inputs",
    "provenance",
    "recommended_next_lane",
    "authority_locks",
    "packet_hash"
  ],
  "properties": {
    "lane_id": { "const": "P98_RESEARCH_SHADOW_STABILIZATION_PROOF_PLAN" },
    "artifact_type": { "const": "ResearchShadowStabilizationProofPlan.v1" },
    "stabilization_proof_plan_status": { "enum": ["PASS", "NOT_COMPUTABLE"] },
    "stabilization_proof_plan_ready": { "type": "boolean" },
    "stabilization_proof_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proof_id",
          "candidate_id",
          "source_surface_id",
          "research_fold_family",
          "stabilization_scope",
          "required_proofs",
          "expected_evidence",
          "status"
        ],
        "properties": {
          "proof_id": { "type": "string" },
          "candidate_id": { "type": "string" },
          "source_surface_id": { "type": "string" },
          "research_fold_family": { "type": "string" },
          "stabilization_scope": { "const": "advisory_shadow_stabilization_proof_only" },
          "required_proofs": { "type": "array", "items": { "type": "string" } },
          "expected_evidence": { "type": "array", "items": { "type": "string" } },
          "status": { "const": "PLANNED" }
        }
      }
    },
    "missing_or_invalid_inputs": { "type": "array", "items": { "type": "string" } },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "upstream_lane_id", "expected_candidate_ids", "deterministic_ordering"],
      "properties": {
        "source": { "const": "p97_research_derived_subsystem_candidate_ledger" },
        "upstream_lane_id": { "const": "P97_RESEARCH_DERIVED_SUBSYSTEM_CANDIDATE_LEDGER" },
        "expected_candidate_ids": { "type": "array", "items": { "type": "string" } },
        "deterministic_ordering": { "const": "proof_id_ascending" }
      }
    },
    "recommended_next_lane": { "type": "string" },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_only",
        "projection_only",
        "planning_only",
        "evidence_only",
        "proof_only",
        "shadow_only",
        "production_activation",
        "canon_promotion",
        "scheduler_mutation",
        "runtime_authority",
        "forecast_influence",
        "execution_authority",
        "repair_execution_authority",
        "regeneration_execution_authority",
        "token_minting_allowed",
        "valid_for_execution",
        "canonical_status"
      ],
      "properties": {
        "advisory_only": { "const": true },
        "projection_only": { "const": true },
        "planning_only": { "const": true },
        "evidence_only": { "const": true },
        "proof_only": { "const": true },
        "shadow_only": { "const": true },
        "production_activation": { "const": false },
        "canon_promotion": { "const": false },
        "scheduler_mutation": { "const": false },
        "runtime_authority": { "const": false },
        "forecast_influence": { "const": false },
        "execution_authority": { "const": false },
        "repair_execution_authority": { "const": false },
        "regeneration_execution_authority": { "const": false },
        "token_minting_allowed": { "const": false },
        "valid_for_execution": { "const": false },
        "canonical_status": { "const": "ADVISORY_ONLY" }
      }
    },
    "packet_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
