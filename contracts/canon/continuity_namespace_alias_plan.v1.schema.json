{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/continuity_namespace_alias_plan.v1.schema.json",
  "title": "Continuity Namespace Alias Plan",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "additive_metadata_strategy",
    "advisory_only",
    "alias_collision_handling",
    "alias_lookup_precedence",
    "alias_manifest_shape",
    "artifact_type",
    "authority_locks",
    "authorization_authority",
    "authorization_granted",
    "authorization_record_created",
    "authorization_record_creation_authority",
    "canon_promotion",
    "compatibility_with_existing_generated_artifacts",
    "composite_id_format",
    "consumed_audit_artifact_path",
    "consumed_migration_plan_artifact_path",
    "consumed_readiness_review_artifact_path",
    "consumed_stabilization_receipt_artifact_path",
    "denied_authority",
    "execution_authority",
    "forecast_influence",
    "legacy_id_rewrite_rule",
    "no_path_rename_rule",
    "packet_hash",
    "packet_source_inputs",
    "plan_blockers",
    "plan_checks",
    "plan_id",
    "plan_status",
    "production_activation",
    "projection_only",
    "recommended_next_action",
    "recommended_next_lane",
    "record_creation_authority",
    "registry_binding",
    "required_evidence_for_activation",
    "runtime_authority",
    "scheduler_mutation",
    "selected_policy",
    "source_state",
    "stabilization_receipt_requirement_before_implementation",
    "status_surface_additive_fields",
    "token_minting_allowed",
    "token_minting_authority",
    "unsafe_actions",
    "valid_for_execution",
    "validation_gates"
  ],
  "properties": {
    "advisory_only": { "const": true },
    "artifact_type": { "const": "ContinuityNamespaceAliasPlan.v1" },
    "authority_locks": {
      "type": "object",
      "required": [
        "authorization_authority",
        "authorization_record_creation_authority",
        "canon_promotion",
        "execution_authority",
        "forecast_influence",
        "production_activation",
        "record_creation_authority",
        "runtime_authority",
        "scheduler_mutation",
        "token_minting_authority"
      ],
      "additionalProperties": { "const": false }
    },
    "authorization_authority": { "const": false },
    "authorization_granted": { "const": false },
    "authorization_record_created": { "const": false },
    "authorization_record_creation_authority": { "const": false },
    "canon_promotion": { "const": false },
    "composite_id_format": { "const": "<NAMESPACE_ID>.<P_LANE_ID>" },
    "consumed_audit_artifact_path": { "const": "out/continuity_namespace_audit/latest.json" },
    "consumed_migration_plan_artifact_path": { "const": "out/continuity_namespace_migration_plan/latest.json" },
    "consumed_readiness_review_artifact_path": { "const": "out/continuity_namespace_readiness_review/latest.json" },
    "consumed_stabilization_receipt_artifact_path": { "const": "out/continuity_namespace_stabilization_receipt/latest.json" },
    "execution_authority": { "const": false },
    "forecast_influence": { "const": false },
    "legacy_id_rewrite_rule": { "const": "FORBIDDEN" },
    "no_path_rename_rule": { "const": "FORBIDDEN" },
    "packet_hash": { "type": "string" },
    "packet_source_inputs": { "type": "array", "minItems": 10 },
    "plan_blockers": { "type": "array" },
    "plan_checks": {
      "type": "object",
      "required": [
        "all_required_json_sources_well_formed",
        "all_required_sources_observed",
        "composite_id_format_selected",
        "prior_surfaces_non_executable",
        "readiness_review_authorizes_plan_only",
        "registry_binding_bound",
        "selected_policy_matches",
        "source_state_constants_match"
      ]
    },
    "plan_id": { "const": "CONTINUITY_NAMESPACE_ALIAS_PLAN_001" },
    "plan_status": {
      "enum": ["ADDITIVE_ALIAS_PLAN_EMITTED", "HOLD_REQUIRED", "NOT_COMPUTABLE"]
    },
    "production_activation": { "const": false },
    "projection_only": { "const": true },
    "recommended_next_lane": { "const": "NOT_COMPUTABLE" },
    "record_creation_authority": { "const": false },
    "runtime_authority": { "const": false },
    "scheduler_mutation": { "const": false },
    "selected_policy": { "const": "D_HYBRID_CANONICAL_GLOBAL_IDS_WITH_BRANCH_LOCAL_ALIASES" },
    "source_state": {
      "type": "object",
      "required": ["canon", "downstream", "governance", "highest_observed_lane", "lane_count"],
      "properties": {
        "canon": { "const": "ADVISORY_ONLY" },
        "downstream": { "const": "NOT_COMPUTABLE" },
        "governance": { "const": "FROZEN" },
        "highest_observed_lane": { "const": "P102G" },
        "lane_count": { "const": 58 }
      }
    },
    "stabilization_receipt_requirement_before_implementation": {
      "type": "object",
      "required": ["required", "required_status", "valid_for_implementation_until_receipt"],
      "properties": {
        "required": { "const": true },
        "valid_for_implementation_until_receipt": { "const": false }
      }
    },
    "token_minting_allowed": { "const": false },
    "token_minting_authority": { "const": false },
    "valid_for_execution": { "const": false }
  }
}
