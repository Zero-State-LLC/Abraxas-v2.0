{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/yggdrasil_route_namespace_mapping.v1.schema.json",
  "title": "YGGDRASIL Route Namespace Mapping",
  "type": "object",
  "required": [
    "artifact_type",
    "mapping_id",
    "mapping_status",
    "notion_source",
    "patch_id",
    "depends_on_patch",
    "repo_notion_diff_path",
    "repo_notion_diff_hash",
    "route_count",
    "pipeline_count",
    "mapped_count",
    "unmapped_routes",
    "missing_routes_for_pipelines",
    "namespace_records",
    "existing_routes_preserved",
    "new_route_authority_created",
    "runtime_dispatch_mutation",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "forecast_routing",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "valid_for_execution",
    "recommended_next_patch",
    "authority_locks",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {"const": "YggdrasilRouteNamespaceMapping.v1"},
    "mapping_id": {"const": "YGGDRASIL_ROUTE_NAMESPACE_MAPPING_001"},
    "mapping_status": {"enum": ["EMITTED_ADVISORY_ONLY", "NOT_COMPUTABLE"]},
    "notion_source": {"const": "ABRAXAS_PATCH_QUEUE_REVISED_001"},
    "patch_id": {"const": "PATCH-ABX-YGGDRASIL-ROUTE-NAMESPACE-MAPPING-001"},
    "depends_on_patch": {"const": "PATCH-ABX-REPO-NOTION-DIFF-001"},
    "repo_notion_diff_path": {"type": "string"},
    "repo_notion_diff_hash": {"type": "string"},
    "route_count": {"type": "integer", "minimum": 0},
    "pipeline_count": {"type": "integer", "minimum": 0},
    "mapped_count": {"type": "integer", "minimum": 0},
    "unmapped_routes": {"type": "array", "items": {"type": "string"}},
    "missing_routes_for_pipelines": {"type": "array", "items": {"type": "string"}},
    "namespace_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pipeline_id",
          "notion_namespace",
          "route_file",
          "pipeline_contract",
          "route_node_namespace",
          "route_observed",
          "pipeline_observed",
          "node_count",
          "edge_count",
          "lane_set",
          "authority_boundary_count",
          "required_rune_count",
          "mapping_strength",
          "duplicate_risk",
          "route_authority_locked",
          "pipeline_authority_locked",
          "recommended_action"
        ],
        "properties": {
          "pipeline_id": {"type": "string"},
          "notion_namespace": {"type": "string"},
          "route_file": {"type": "string"},
          "pipeline_contract": {"type": "string"},
          "route_node_namespace": {"type": "string"},
          "route_observed": {"type": "boolean"},
          "pipeline_observed": {"type": "boolean"},
          "node_count": {"type": "integer", "minimum": 0},
          "edge_count": {"type": "integer", "minimum": 0},
          "lane_set": {"type": "array", "items": {"type": "string"}},
          "authority_boundary_count": {"type": "integer", "minimum": 0},
          "required_rune_count": {"type": "integer", "minimum": 0},
          "mapping_strength": {"enum": ["EXACT", "PARTIAL", "MISSING"]},
          "duplicate_risk": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "route_authority_locked": {"type": "boolean"},
          "pipeline_authority_locked": {"type": "boolean"},
          "recommended_action": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "existing_routes_preserved": {"const": true},
    "new_route_authority_created": {"const": false},
    "runtime_dispatch_mutation": {"const": false},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "non_authoritative": {"const": true},
    "forecast_routing": {"const": false},
    "canon_mutation": {"const": false},
    "runtime_mutation": {"const": false},
    "execution_authority": {"const": false},
    "valid_for_execution": {"const": false},
    "recommended_next_patch": {"const": "PATCH-ABX-RUNE-EQUIVALENT-SURFACE-AUDIT-001"},
    "authority_locks": {
      "type": "object",
      "required": [
        "canon_mutation",
        "execution_authority",
        "forecast_routing",
        "runtime_mutation",
        "scheduler_mutation",
        "token_minting"
      ],
      "properties": {
        "canon_mutation": {"const": false},
        "execution_authority": {"const": false},
        "forecast_routing": {"const": false},
        "runtime_mutation": {"const": false},
        "scheduler_mutation": {"const": false},
        "token_minting": {"const": false}
      },
      "additionalProperties": false
    },
    "packet_hash": {"type": "string"}
  },
  "additionalProperties": false
}
