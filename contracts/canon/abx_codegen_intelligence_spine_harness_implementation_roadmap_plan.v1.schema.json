{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/abx_codegen_intelligence_spine_harness_implementation_roadmap_plan.v1.schema.json",
  "title": "ABX Codegen Intelligence Spine Harness Implementation Roadmap Plan",
  "type": "object",
  "required": [
    "artifact_type",
    "plan_id",
    "harness_implementation_roadmap_plan_status",
    "source_notion_spec",
    "source_testing_validation_strategy_plan",
    "implementation_authorization_source",
    "phases",
    "recommended_starting_point",
    "roadmap_blockers",
    "recommended_next_lane",
    "safe_to_auto_continue",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "execution_authority",
    "valid_for_execution",
    "valid_for_implementation",
    "authority_locks",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {
      "const": "AbxCodegenIntelligenceSpineHarnessImplementationRoadmapPlan.v1"
    },
    "plan_id": {
      "const": "ABX_CODEGEN_INTELLIGENCE_SPINE_HARNESS_IMPLEMENTATION_ROADMAP_PLAN_001"
    },
    "harness_implementation_roadmap_plan_status": {
      "enum": [
        "ABX_CODEGEN_HARNESS_IMPLEMENTATION_ROADMAP_PLAN_HELD_FOR_OPERATOR",
        "ABX_CODEGEN_HARNESS_IMPLEMENTATION_ROADMAP_PLAN_AUTHORIZED",
        "NOT_COMPUTABLE"
      ]
    },
    "source_notion_spec": {"type": "object"},
    "source_testing_validation_strategy_plan": {"type": "object"},
    "implementation_authorization_source": {"type": "object"},
    "phases": {
      "type": "array",
      "items": {"type": "object"}
    },
    "recommended_starting_point": {"type": "object"},
    "roadmap_blockers": {
      "type": "array",
      "items": {"type": "string"}
    },
    "recommended_next_lane": {"type": "string"},
    "safe_to_auto_continue": {"const": false},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "non_authoritative": {"const": true},
    "execution_authority": {"const": false},
    "valid_for_execution": {"const": false},
    "valid_for_implementation": {"type": "boolean"},
    "authority_locks": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
