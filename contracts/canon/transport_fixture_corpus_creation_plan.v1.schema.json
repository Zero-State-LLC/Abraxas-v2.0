{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/transport_fixture_corpus_creation_plan.v1.schema.json",
  "title": "Transport Fixture Corpus Creation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "operator_id",
    "plan_status",
    "plan_stage",
    "created_at_utc",
    "intended_lane",
    "source_implementation_gate_hash",
    "source_decision_record_hash",
    "valid_fixture_plan",
    "invalid_fixture_plan",
    "not_computable_fixture_plan",
    "fixture_path_plan",
    "expected_value_policy",
    "deterministic_ordering_policy",
    "locked_constants_binding",
    "blocked_scopes",
    "authority_locks",
    "recommended_next_step",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "TransportFixtureCorpusCreationPlan.v1" },
    "plan_id": { "type": "string" },
    "operator_id": { "const": "TRANSPORT" },
    "plan_status": { "const": "TRANSPORT_FIXTURE_CORPUS_CREATION_PLAN_DEFINED" },
    "plan_stage": { "const": "FIXTURE_CORPUS_CREATION_PLAN_ONLY" },
    "created_at_utc": { "type": "string" },
    "intended_lane": { "type": "string" },
    "source_implementation_gate_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_decision_record_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "valid_fixture_plan": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "type": "object", "additionalProperties": true }
    },
    "invalid_fixture_plan": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "object", "additionalProperties": true }
    },
    "not_computable_fixture_plan": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "object", "additionalProperties": true }
    },
    "fixture_path_plan": {
      "type": "object",
      "additionalProperties": true,
      "required": ["base_path", "fixture_count"],
      "properties": {
        "fixture_count": { "const": 15 }
      }
    },
    "expected_value_policy": { "type": "object", "additionalProperties": true },
    "deterministic_ordering_policy": { "type": "object", "additionalProperties": true },
    "locked_constants_binding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["all_constants_locked", "constants_count"],
      "properties": {
        "all_constants_locked": { "const": true },
        "constants_count": { "const": 7 }
      }
    },
    "blocked_scopes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_files_created", "computation_executed", "emits_metric_values",
        "forecast_influence", "p43_surface_lanes_authorized",
        "production_activation", "canon_promotion", "runtime_mutation",
        "execution_authority", "inference_authority"
      ],
      "properties": {
        "fixture_files_created": { "const": false },
        "computation_executed": { "const": false },
        "emits_metric_values": { "const": false },
        "forecast_influence": { "const": false },
        "p43_surface_lanes_authorized": { "const": false },
        "production_activation": { "const": false },
        "canon_promotion": { "const": false },
        "runtime_mutation": { "const": false },
        "execution_authority": { "const": false },
        "inference_authority": { "const": false }
      }
    },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_only",
        "shadow_lane_only",
        "fixture_corpus_creation_plan_only",
        "transport_computation_implementation_authorized",
        "lp_solver_invocation_authorized_for_test_vectors",
        "fixture_files_created",
        "computation_executed",
        "emits_metric_values",
        "forecast_influence",
        "p43_surface_lanes_authorized",
        "production_activation",
        "canon_promotion",
        "runtime_mutation",
        "execution_authority",
        "inference_authority"
      ],
      "properties": {
        "advisory_only": { "const": true },
        "shadow_lane_only": { "const": true },
        "fixture_corpus_creation_plan_only": { "const": true },
        "transport_computation_implementation_authorized": { "const": true },
        "lp_solver_invocation_authorized_for_test_vectors": { "const": true },
        "fixture_files_created": { "const": false },
        "computation_executed": { "const": false },
        "emits_metric_values": { "const": false },
        "forecast_influence": { "const": false },
        "p43_surface_lanes_authorized": { "const": false },
        "production_activation": { "const": false },
        "canon_promotion": { "const": false },
        "runtime_mutation": { "const": false },
        "execution_authority": { "const": false },
        "inference_authority": { "const": false }
      }
    },
    "recommended_next_step": { "type": "string" },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
