{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WassersteinBaselinePromotionComplete.v1",
  "description": "Baseline promotion completion artifact for WASSERSTEIN. Binds the review, decision, and pack vector update, records no-op parity closure, and closes the WASSERSTEIN baseline promotion review phase. Shadow-only. Does not modify baseline pack, pack vector, or any runtime surface.",
  "type": "object",
  "required": [
    "schema_version", "completion_id", "completion_type", "operator_id",
    "completion_status",
    "source_review_hash", "source_decision_hash", "source_pack_vector_update_hash",
    "intended_lane", "completion_stage",
    "review_binding", "decision_binding", "pack_vector_update_binding",
    "no_op_parity_completion", "baseline_state_completion",
    "cpu_baseline_chain_completion", "authority_lock_completion",
    "blocked_scope_completion",
    "blocked_scopes", "authority_locks",
    "recommended_next_step", "provenance", "created_at_utc", "canonical_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "WassersteinBaselinePromotionComplete.v1" },
    "completion_id": { "type": "string" },
    "completion_type": { "type": "string", "const": "WASSERSTEIN_BASELINE_PROMOTION_COMPLETE" },
    "operator_id": { "type": "string", "const": "WASSERSTEIN" },
    "completion_status": { "type": "string", "const": "WASSERSTEIN_BASELINE_PROMOTION_COMPLETE" },
    "source_review_hash": { "type": "string" },
    "source_decision_hash": { "type": "string" },
    "source_pack_vector_update_hash": { "type": "string" },
    "intended_lane": { "type": "string", "enum": ["SHADOW"] },
    "completion_stage": { "type": "string", "enum": ["BASELINE_PROMOTION_COMPLETE_ONLY"] },
    "review_binding": {
      "type": "object",
      "required": ["review_id", "review_hash", "review_status_observed", "hash_match", "binding_status"],
      "additionalProperties": false,
      "properties": {
        "review_id": { "type": "string" },
        "review_hash": { "type": "string" },
        "review_status_observed": { "type": "string", "const": "WASSERSTEIN_BASELINE_PROMOTION_REVIEW_COMPLETE" },
        "hash_match": { "type": "boolean", "const": true },
        "binding_status": { "type": "string", "const": "REVIEW_BOUND" }
      }
    },
    "decision_binding": {
      "type": "object",
      "required": ["decision_id", "decision_hash", "decision_observed", "baseline_promotion_review_authorized_observed", "authorized_scope_observed", "hash_match", "binding_status"],
      "additionalProperties": false,
      "properties": {
        "decision_id": { "type": "string" },
        "decision_hash": { "type": "string" },
        "decision_observed": { "type": "string", "const": "approve_wasserstein_shadow_stub_baseline_promotion_review" },
        "baseline_promotion_review_authorized_observed": { "type": "boolean", "const": true },
        "authorized_scope_observed": { "type": "string", "const": "BASELINE_PROMOTION_REVIEW_ONLY" },
        "hash_match": { "type": "boolean", "const": true },
        "binding_status": { "type": "string", "const": "DECISION_BOUND" }
      }
    },
    "pack_vector_update_binding": {
      "type": "object",
      "required": ["pack_vector_update_id", "pack_vector_update_hash", "update_status_observed", "cpu_baseline_phase_status_observed", "hash_match", "binding_status"],
      "additionalProperties": false,
      "properties": {
        "pack_vector_update_id": { "type": "string" },
        "pack_vector_update_hash": { "type": "string" },
        "update_status_observed": { "type": "string", "const": "WASSERSTEIN_CPU_BASELINE_PACK_VECTOR_UPDATE_COMPLETE" },
        "cpu_baseline_phase_status_observed": { "type": "string", "const": "COMPUTATION_PHASE_CLOSED" },
        "hash_match": { "type": "boolean", "const": true },
        "binding_status": { "type": "string", "const": "PACK_VECTOR_UPDATE_BOUND" }
      }
    },
    "no_op_parity_completion": {
      "type": "object",
      "required": ["no_op_parity_confirmed", "pack_vector_modified", "vector_type_promoted", "runtime_mutated", "shadow_stub_posture_preserved", "advisory_only_posture_preserved", "completion_status"],
      "additionalProperties": false,
      "properties": {
        "no_op_parity_confirmed": { "type": "boolean", "const": true },
        "pack_vector_modified": { "type": "boolean", "const": false },
        "vector_type_promoted": { "type": "boolean", "const": false },
        "runtime_mutated": { "type": "boolean", "const": false },
        "shadow_stub_posture_preserved": { "type": "boolean", "const": true },
        "advisory_only_posture_preserved": { "type": "boolean", "const": true },
        "completion_status": { "type": "string", "const": "NO_OP_PARITY_COMPLETE" }
      }
    },
    "baseline_state_completion": {
      "type": "object",
      "required": ["current_vector_type", "current_computation_status", "current_authority_state", "baseline_promotion_phase_complete", "completion_status"],
      "additionalProperties": false,
      "properties": {
        "current_vector_type": { "type": "string", "const": "VALID_SHADOW_ONLY_VECTOR" },
        "current_computation_status": { "type": "string", "const": "SHADOW_STUB_ONLY" },
        "current_authority_state": { "type": "string", "const": "ADVISORY_ONLY" },
        "baseline_promotion_phase_complete": { "type": "boolean", "const": true },
        "completion_status": { "type": "string", "const": "BASELINE_STATE_COMPLETE" }
      }
    },
    "cpu_baseline_chain_completion": {
      "type": "object",
      "required": ["cpu_baseline_computation_phase_closed", "cpu_baseline_pack_vector_update_complete", "cpu_baseline_operator_closure_complete", "baseline_promotion_review_complete", "completion_status"],
      "additionalProperties": false,
      "properties": {
        "cpu_baseline_computation_phase_closed": { "type": "boolean", "const": true },
        "cpu_baseline_pack_vector_update_complete": { "type": "boolean", "const": true },
        "cpu_baseline_operator_closure_complete": { "type": "boolean", "const": true },
        "baseline_promotion_review_complete": { "type": "boolean", "const": true },
        "completion_status": { "type": "string", "const": "CPU_BASELINE_CHAIN_COMPLETE" }
      }
    },
    "authority_lock_completion": {
      "type": "object",
      "required": ["advisory_only", "shadow_lane_only", "baseline_promotion_complete_only", "no_op_parity_confirmed", "baseline_promotion_phase_complete", "emits_metric_values", "forecast_influence", "p43_surface_lanes_authorized", "production_activation", "canon_promotion", "runtime_mutation", "execution_authority", "inference_authority", "all_locks_intact", "completion_status"],
      "additionalProperties": false,
      "properties": {
        "advisory_only": { "type": "boolean", "const": true },
        "shadow_lane_only": { "type": "boolean", "const": true },
        "baseline_promotion_complete_only": { "type": "boolean", "const": true },
        "no_op_parity_confirmed": { "type": "boolean", "const": true },
        "baseline_promotion_phase_complete": { "type": "boolean", "const": true },
        "emits_metric_values": { "type": "boolean", "const": false },
        "forecast_influence": { "type": "boolean", "const": false },
        "p43_surface_lanes_authorized": { "type": "boolean", "const": false },
        "production_activation": { "type": "boolean", "const": false },
        "canon_promotion": { "type": "boolean", "const": false },
        "runtime_mutation": { "type": "boolean", "const": false },
        "execution_authority": { "type": "boolean", "const": false },
        "inference_authority": { "type": "boolean", "const": false },
        "all_locks_intact": { "type": "boolean", "const": true },
        "completion_status": { "type": "string", "const": "AUTHORITY_LOCKS_COMPLETE" }
      }
    },
    "blocked_scope_completion": {
      "type": "object",
      "required": ["all_blocked_scopes_false", "scopes_verified", "completion_status"],
      "additionalProperties": false,
      "properties": {
        "all_blocked_scopes_false": { "type": "boolean", "const": true },
        "scopes_verified": { "type": "array" },
        "completion_status": { "type": "string", "const": "BLOCKED_SCOPES_COMPLETE" }
      }
    },
    "blocked_scopes": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "authority_locks": { "type": "object", "additionalProperties": true },
    "recommended_next_step": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["source", "evidence_refs", "generated_by", "upstream_schema_refs"],
      "additionalProperties": true,
      "properties": {
        "source": { "type": "string" },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "generated_by": { "type": "string" },
        "upstream_schema_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "created_at_utc": { "type": "string" },
    "canonical_hash": { "type": "string" }
  }
}
