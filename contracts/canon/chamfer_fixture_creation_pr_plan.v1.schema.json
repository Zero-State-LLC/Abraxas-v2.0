    "constraints": {"type": "object", "additionalProperties": false, "required": ["fixture_creation_authorized", "fixture_files_added", "manifest_file_added", "expected_distances_added", "tolerance_values_added", "chamfer_math_added", "metric_values_emitted"], "properties": {"fixture_creation_authorized": {"const": false}, "fixture_files_added": {"const": false}, "manifest_file_added": {"const": false}, "expected_distances_added": {"const": false}, "tolerance_values_added": {"const": false}, "chamfer_math_added": {"const": false}, "metric_values_emitted": {"const": false}}},
