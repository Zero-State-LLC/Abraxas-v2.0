{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/continuation_frontier_reconciliation.v1.schema.json",
  "title": "ContinuationFrontierReconciliation.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "artifact_type",
    "receipt_id",
    "receipt_status",
    "frontier_records",
    "stale_notion_records",
    "missing_artifact_records",
    "authority_locks",
    "recommended_next_action",
    "recommended_next_lane",
    "safe_to_auto_continue",
    "valid_for_execution",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {
      "const": "ContinuationFrontierReconciliation.v1"
    },
    "receipt_id": {
      "const": "ABRAXAS_CONTINUATION_FRONTIER_RECONCILIATION_001"
    },
    "receipt_status": {
      "const": "CONTINUATION_FRONTIER_RECONCILIATION_EMITTED_ADVISORY_ONLY"
    },
    "frontier_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/frontier_record"
      }
    },
    "stale_notion_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stale_notion_record"
      }
    },
    "missing_artifact_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/missing_artifact_record"
      }
    },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_authority",
        "activation",
        "canon_mutation",
        "runtime_mutation",
        "scheduler_mutation",
        "queue_mutation",
        "notion_writeback",
        "github_writeback",
        "operator_attestation",
        "decision_record_creation",
        "token_minting"
      ],
      "properties": {
        "execution_authority": { "const": false },
        "activation": { "const": false },
        "canon_mutation": { "const": false },
        "runtime_mutation": { "const": false },
        "scheduler_mutation": { "const": false },
        "queue_mutation": { "const": false },
        "notion_writeback": { "const": false },
        "github_writeback": { "const": false },
        "operator_attestation": { "const": false },
        "decision_record_creation": { "const": false },
        "token_minting": { "const": false }
      }
    },
    "recommended_next_action": {
      "type": "string"
    },
    "recommended_next_lane": {
      "const": "NOT_COMPUTABLE"
    },
    "safe_to_auto_continue": {
      "const": false
    },
    "valid_for_execution": {
      "const": false
    },
    "packet_hash": {
      "type": "string"
    }
  },
  "$defs": {
    "classification": {
      "enum": [
        "OBSERVED",
        "HELD_FOR_OPERATOR",
        "MISSING_ARTIFACT",
        "STALE_NOTION_SPEC",
        "NOT_COMPUTABLE"
      ]
    },
    "frontier_record": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "frontier_id",
        "path",
        "path_observed",
        "classification",
        "observed_status",
        "authority_summary",
        "authority_drift_observed"
      ],
      "properties": {
        "frontier_id": { "type": "string" },
        "path": { "type": "string" },
        "path_observed": { "type": "boolean" },
        "classification": { "$ref": "#/$defs/classification" },
        "observed_status": { "type": "string" },
        "authority_summary": { "type": "object" },
        "authority_drift_observed": { "type": "boolean" }
      }
    },
    "stale_notion_record": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "lane_id",
        "source",
        "classification",
        "repo_authorization_observed",
        "reason"
      ],
      "properties": {
        "lane_id": { "type": "string" },
        "source": { "type": "string" },
        "classification": { "const": "STALE_NOTION_SPEC" },
        "repo_authorization_observed": { "const": false },
        "reason": { "type": "string" }
      }
    },
    "missing_artifact_record": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "frontier_id",
        "path",
        "classification",
        "observed_status"
      ],
      "properties": {
        "frontier_id": { "type": "string" },
        "path": { "type": "string" },
        "classification": { "const": "MISSING_ARTIFACT" },
        "observed_status": { "type": "string" }
      }
    }
  }
}
