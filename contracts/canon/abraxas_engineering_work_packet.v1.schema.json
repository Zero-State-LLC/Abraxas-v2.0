{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/abraxas_engineering_work_packet.v1.schema.json",
  "title": "Abraxas Engineering Work Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "objective", "observed_problem", "supporting_evidence",
    "affected_paths", "dependency_chain", "implementation_phases",
    "prohibited_actions", "completion_criteria", "exact_verification_commands",
    "receipt_schema"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "objective": { "type": "string" },
    "observed_problem": { "type": "string" },
    "supporting_evidence": { "type": "array", "items": { "type": "string" } },
    "affected_paths": { "type": "array", "items": { "type": "string" } },
    "dependency_chain": { "type": "array", "items": { "type": "string" } },
    "implementation_phases": { "type": "array", "items": { "type": "string" } },
    "prohibited_actions": { "type": "array", "items": { "type": "string" } },
    "completion_criteria": { "type": "array", "items": { "type": "string" } },
    "exact_verification_commands": { "type": "array", "items": { "type": "string" } },
    "receipt_schema": { "type": "string" }
  }
}