    "deterministic_selection_criteria": { "type": "object" },
    "candidate_scoring_matrix": { "type": "object" },
    "selected_rank6_operator": { "type": "object" },
    "rejection_summary": { "type": "object" },
    "selected_operator_readiness_summary": { "type": "object" },
    "blocked_scope_review": { "type": "object" },
    "authority_lock_review": { "type": "object" },
    "authority_locks": { "type": "object" },
    "blocked_scopes": { "type": "object" },
    "all_confirmations_passed": { "type": "boolean" },
    "recommended_next_step": { "type": "string" },
