    "schema_version": { "type": "string", "enum": ["Rank6OperatorSelection.v1"] },
    "selection_id": { "type": "string" },
    "selection_status": { "type": "string", "enum": ["RANK6_OPERATOR_SELECTION_COMPLETE"] },
