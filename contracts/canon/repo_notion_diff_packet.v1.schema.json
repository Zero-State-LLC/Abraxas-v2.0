{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/repo_notion_diff_packet.v1.schema.json",
  "title": "Repo Notion Diff Packet",
  "type": "object",
  "required": [
    "artifact_type",
    "diff_id",
    "diff_status",
    "notion_source",
    "patch_id",
    "depends_on_patch",
    "runtime_inventory_path",
    "runtime_inventory_hash",
    "match_strength_recorded",
    "duplicate_risk_recorded",
    "summary",
    "diff_records",
    "blocked_implementation_surfaces",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "repo_mutation",
    "forecast_routing",
    "canon_mutation",
    "runtime_activation",
    "execution_authority",
    "valid_for_execution",
    "recommended_next_patch",
    "authority_locks",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {"const": "RepoNotionDiffPacket.v1"},
    "diff_id": {"const": "REPO_NOTION_DIFF_001"},
    "diff_status": {"enum": ["EMITTED_ADVISORY_ONLY", "NOT_COMPUTABLE"]},
    "notion_source": {"const": "ABRAXAS_PATCH_QUEUE_REVISED_001"},
    "patch_id": {"const": "PATCH-ABX-REPO-NOTION-DIFF-001"},
    "depends_on_patch": {"const": "PATCH-ABX-RUNTIME-INVENTORY-001"},
    "runtime_inventory_path": {"type": "string"},
    "runtime_inventory_hash": {"type": "string"},
    "match_strength_recorded": {"const": true},
    "duplicate_risk_recorded": {"const": true},
    "summary": {
      "type": "object",
      "required": ["total_targets", "observed", "partial", "missing", "blocked"],
      "properties": {
        "total_targets": {"type": "integer", "minimum": 0},
        "observed": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "diff_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "notion_surface",
          "target_paths",
          "observed_paths",
          "missing_paths",
          "match_strength",
          "duplicate_risk",
          "implementation_blocked",
          "recommended_action"
        ],
        "properties": {
          "notion_surface": {"type": "string"},
          "target_paths": {"type": "array", "items": {"type": "string"}},
          "observed_paths": {"type": "array", "items": {"type": "string"}},
          "missing_paths": {"type": "array", "items": {"type": "string"}},
          "match_strength": {"enum": ["EXACT", "PARTIAL", "MISSING"]},
          "duplicate_risk": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "implementation_blocked": {"type": "boolean"},
          "recommended_action": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "blocked_implementation_surfaces": {"type": "array", "items": {"type": "string"}},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "non_authoritative": {"const": true},
    "repo_mutation": {"const": false},
    "forecast_routing": {"const": false},
    "canon_mutation": {"const": false},
    "runtime_activation": {"const": false},
    "execution_authority": {"const": false},
    "valid_for_execution": {"const": false},
    "recommended_next_patch": {"const": "PATCH-ABX-YGGDRASIL-ROUTE-NAMESPACE-MAPPING-001"},
    "authority_locks": {
      "type": "object",
      "required": [
        "canon_mutation",
        "execution_authority",
        "forecast_routing",
        "runtime_mutation",
        "scheduler_mutation",
        "token_minting"
      ],
      "properties": {
        "canon_mutation": {"const": false},
        "execution_authority": {"const": false},
        "forecast_routing": {"const": false},
        "runtime_mutation": {"const": false},
        "scheduler_mutation": {"const": false},
        "token_minting": {"const": false}
      },
      "additionalProperties": false
    },
    "packet_hash": {"type": "string"}
  },
  "additionalProperties": false
}
