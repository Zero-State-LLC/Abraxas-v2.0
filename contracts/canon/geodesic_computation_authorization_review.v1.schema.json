{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "GeodesicComputationAuthorizationReview.v1",
    "description": "Advisory-only authorization review determining whether the verified GEODESIC fixture corpus and expected values support moving toward bounded SHADOW computation implementation. Does not grant computation authority.",
    "type": "object",
    "required": [
        "schema_version",
        "review_id",
        "operator_id",
        "review_status",
        "review_stage",
        "intended_lane",
        "source_expected_values_complete_review_hash",
        "source_expected_values_addition_receipt_hash",
        "source_expected_values_gate_hash",
        "fixture_corpus_readiness_review",
        "expected_values_readiness_review",
        "computation_scope_review",
        "authority_lock_review",
        "operator_authorization_requirement",
        "authorization_recommendation",
        "blocked_scopes",
        "authority_locks",
        "recommended_next_step",
        "canonical_hash"
    ],
    "properties": {
        "schema_version": {"type": "string", "enum": ["GeodesicComputationAuthorizationReview.v1"]},
        "review_id": {"type": "string"},
        "operator_id": {"type": "string", "enum": ["GEODESIC"]},
        "review_status": {"type": "string", "enum": ["GEODESIC_COMPUTATION_AUTHORIZATION_REVIEW_READY"]},
        "review_stage": {"type": "string", "enum": ["COMPUTATION_AUTHORIZATION_REVIEW_ONLY"]},
        "intended_lane": {"type": "string", "enum": ["SHADOW", "PROJECTION", "OBSERVATION_ONLY"]},
        "source_expected_values_complete_review_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "source_expected_values_addition_receipt_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "source_expected_values_gate_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "fixture_corpus_readiness_review": {"type": "object"},
        "expected_values_readiness_review": {"type": "object"},
        "computation_scope_review": {"type": "object"},
        "authority_lock_review": {"type": "object"},
        "operator_authorization_requirement": {"type": "object"},
        "authorization_recommendation": {"type": "object"},
        "blocked_scopes": {"type": "object"},
        "authority_locks": {"type": "object"},
        "recommended_next_step": {"type": "string"},
        "canonical_hash": {"type": "string", "minLength": 64, "maxLength": 64}
    },
    "additionalProperties": false
}
