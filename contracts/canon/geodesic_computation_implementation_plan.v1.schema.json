{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "GeodesicComputationImplementationPlan.v1",
    "description": "Implementation plan defining bounded SHADOW test-vector GEODESIC computation design. IMPLEMENTATION_PLAN_ONLY: no code written, no metric emission, no execution authority.",
    "type": "object",
    "required": [
        "schema_version",
        "plan_id",
        "operator_id",
        "plan_status",
        "implementation_stage",
        "intended_lane",
        "source_operator_decision_hash",
        "source_computation_authorization_review_hash",
        "source_expected_values_complete_review_hash",
        "algorithm_plan",
        "supported_fixture_scope",
        "valid_fixture_computation_plan",
        "invalid_fixture_rejection_plan",
        "not_computable_fixture_rejection_plan",
        "deterministic_ordering_policy",
        "numerical_policy",
        "comparison_policy",
        "blocked_scopes",
        "authority_locks",
        "recommended_next_step",
        "canonical_hash"
    ],
    "properties": {
        "schema_version": {"type": "string", "enum": ["GeodesicComputationImplementationPlan.v1"]},
        "plan_id": {"type": "string"},
        "operator_id": {"type": "string", "enum": ["GEODESIC"]},
        "plan_status": {"type": "string", "enum": ["GEODESIC_COMPUTATION_IMPLEMENTATION_PLAN_DEFINED"]},
        "implementation_stage": {"type": "string", "enum": ["IMPLEMENTATION_PLAN_ONLY"]},
        "intended_lane": {"type": "string", "enum": ["SHADOW", "PROJECTION", "OBSERVATION_ONLY"]},
        "source_operator_decision_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "source_computation_authorization_review_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "source_expected_values_complete_review_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "algorithm_plan": {"type": "object"},
        "supported_fixture_scope": {"type": "object"},
        "valid_fixture_computation_plan": {"type": "object"},
        "invalid_fixture_rejection_plan": {"type": "object"},
        "not_computable_fixture_rejection_plan": {"type": "object"},
        "deterministic_ordering_policy": {"type": "object"},
        "numerical_policy": {"type": "object"},
        "comparison_policy": {"type": "object"},
        "blocked_scopes": {"type": "object"},
        "authority_locks": {"type": "object"},
        "recommended_next_step": {"type": "string"},
        "canonical_hash": {"type": "string", "minLength": 64, "maxLength": 64}
    },
    "additionalProperties": false
}
