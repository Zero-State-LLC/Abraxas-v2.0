{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_measurement_authorization_decision_review_candidate.v1.schema.json",
  "title": "OracleMeasurementAuthorizationDecisionReviewCandidate.v1",
  "description": "Advisory authorization decision review candidate schema under contracts/canon/oracle only. This prepares a non-recording operator review candidate and does not authorize measurement, record attestation, execute runs, call external oracles, or mutate canon. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_review_candidate_id",
    "candidate_status",
    "timestamp",
    "source_packet_hashes",
    "decision_review_scope",
    "operator_review_template",
    "decision_options",
    "required_review_evidence",
    "denial_locks",
    "version_metadata",
    "provenance",
    "authority_locks",
    "advisory_only",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleMeasurementAuthorizationDecisionReviewCandidate.v1" },
    "decision_review_candidate_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_status": { "const": "ORACLE_MEASUREMENT_AUTHORIZATION_DECISION_REVIEW_CANDIDATE_READY_ADVISORY_ONLY" },
    "timestamp": { "type": "string", "minLength": 1 },
    "source_packet_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracle_measurement_authorization_proposal",
        "oracle_measurement_authorization_proposal_receipt",
        "oracle_measurement_proposal",
        "oracle_shadow_measurement",
        "oracle_schema_validation_receipt"
      ],
      "properties": {
        "oracle_measurement_authorization_proposal": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_measurement_authorization_proposal_receipt": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_measurement_proposal": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_shadow_measurement": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_schema_validation_receipt": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "decision_review_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "scope_status",
        "summary",
        "operator_gate_required",
        "records_authorization_decision",
        "authorizes_measurement",
        "records_operator_attestation",
        "brier_score"
      ],
      "properties": {
        "scope_id": { "const": "ORACLE_MEASUREMENT_AUTHORIZATION_DECISION_REVIEW_SCOPE_001" },
        "scope_status": { "const": "REVIEW_CANDIDATE_ONLY_NOT_DECIDED" },
        "summary": { "type": "string", "minLength": 1 },
        "operator_gate_required": { "const": true },
        "records_authorization_decision": { "const": false },
        "authorizes_measurement": { "const": false },
        "records_operator_attestation": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "operator_review_template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "exact_confirmation_required",
        "attestation_note_required",
        "records_operator_attestation",
        "records_authorization_decision",
        "authorizes_measurement",
        "review_statement",
        "brier_score"
      ],
      "properties": {
        "template_id": { "const": "ORACLE_MEASUREMENT_AUTHORIZATION_DECISION_REVIEW_TEMPLATE" },
        "exact_confirmation_required": { "const": "yes" },
        "attestation_note_required": { "const": true },
        "records_operator_attestation": { "const": false },
        "records_authorization_decision": { "const": false },
        "authorizes_measurement": { "const": false },
        "review_statement": { "type": "string", "minLength": 1 },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "decision_options": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "option_status",
          "operator_meaning",
          "selected_by_this_packet",
          "valid_for_measurement_authorization",
          "brier_score"
        ],
        "properties": {
          "option_id": { "type": "string", "minLength": 1 },
          "option_status": { "const": "AVAILABLE_FOR_FUTURE_OPERATOR_REVIEW_ONLY" },
          "operator_meaning": { "type": "string", "minLength": 1 },
          "selected_by_this_packet": { "const": false },
          "valid_for_measurement_authorization": { "const": false },
          "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "required_review_evidence": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "evidence_ref",
          "review_status",
          "required_before_any_future_authorization",
          "brier_score"
        ],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "evidence_ref": { "type": "string", "minLength": 1 },
          "review_status": { "const": "HELD_FOR_OPERATOR_REVIEW_ONLY" },
          "required_before_any_future_authorization": { "const": true },
          "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "denial_locks": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lock_id", "locked", "brier_score"],
        "properties": {
          "lock_id": { "type": "string", "minLength": 1 },
          "locked": { "const": false },
          "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "version_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_family", "schema_name", "schema_version", "registry_path", "brier_score"],
      "properties": {
        "schema_family": { "const": "oracle_signal_layer" },
        "schema_name": { "const": "oracle_measurement_authorization_decision_review_candidate" },
        "schema_version": { "const": "v1" },
        "registry_path": { "const": "contracts/canon/oracle/oracle_schema_registry.v1.schema.json" },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "sprint_spine", "canon_extension_only", "root_canon_mutated", "brier_score"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "sprint_spine": { "type": "string", "minLength": 1 },
        "canon_extension_only": { "const": true },
        "root_canon_mutated": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "authority_locks": { "type": "object", "additionalProperties": { "const": false } },
    "advisory_only": { "const": true },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
