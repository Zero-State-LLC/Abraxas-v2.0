{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_schema_registry.v1.schema.json",
  "title": "OracleSchemaRegistry.v1",
  "description": "Central advisory schema registry for contracts/canon/oracle only. This does not mutate root canon files. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "registry_status",
    "timestamp",
    "registered_schemas",
    "version_metadata",
    "provenance",
    "authority_locks",
    "advisory_only",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleSchemaRegistry.v1" },
    "registry_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "registry_status": { "const": "ORACLE_SCHEMA_REGISTRY_ADVISORY_EXTENSION_READY" },
    "timestamp": { "type": "string", "minLength": 1 },
    "registered_schemas": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_name", "schema_path", "schema_version", "surface_role", "brier_score"],
        "properties": {
          "schema_name": { "type": "string", "minLength": 1 },
          "schema_path": { "type": "string", "pattern": "^contracts/canon/oracle/.+\\.schema\\.json$" },
          "schema_version": { "type": "string", "minLength": 1 },
          "surface_role": { "const": "ADVISORY_CANON_EXTENSION_CONTRACT" },
          "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "version_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_family", "schema_name", "schema_version", "registry_path", "brier_score"],
      "properties": {
        "schema_family": { "const": "oracle_signal_layer" },
        "schema_name": { "const": "oracle_schema_registry" },
        "schema_version": { "const": "v1" },
        "registry_path": { "const": "contracts/canon/oracle/oracle_schema_registry.v1.schema.json" },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "sprint_spine", "canon_extension_only", "root_canon_mutated", "brier_score"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "sprint_spine": { "type": "string", "minLength": 1 },
        "canon_extension_only": { "const": true },
        "root_canon_mutated": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "authority_locks": { "type": "object", "additionalProperties": { "const": false } },
    "advisory_only": { "const": true },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
