{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_adversarial_fixture.v1.schema.json",
  "title": "OracleAdversarialFixture.v1",
  "description": "Advisory adversarial fixture schema under contracts/canon/oracle only. This does not mutate root canon files. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "fixture_status",
    "timestamp",
    "fixture_rows",
    "provenance",
    "authority_locks",
    "advisory_only",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleAdversarialFixture.v1" },
    "fixture_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fixture_status": { "const": "ORACLE_ADVERSARIAL_FIXTURE_ADVISORY_EXTENSION_READY" },
    "timestamp": { "type": "string", "minLength": 1 },
    "fixture_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "attack_vector", "expected_guardrail"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "attack_vector": { "type": "string", "minLength": 1 },
          "expected_guardrail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provenance": { "type": "object" },
    "authority_locks": { "type": "object", "additionalProperties": { "const": false } },
    "advisory_only": { "const": true },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
