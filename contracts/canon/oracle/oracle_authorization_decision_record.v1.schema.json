{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_authorization_decision_record.v1.schema.json",
  "title": "OracleAuthorizationDecisionRecord.v1",
  "description": "Advisory authorization decision record template schema under contracts/canon/oracle only. This is a candidate/template surface and does not record authorization, record attestation, authorize measurement, execute runs, call external oracles, or mutate canon. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_record_id",
    "record_status",
    "timestamp",
    "source_packet_hashes",
    "decision_record_template",
    "operator_gate",
    "decision_options",
    "required_evidence",
    "denial_locks",
    "version_metadata",
    "provenance",
    "authority_locks",
    "advisory_only",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleAuthorizationDecisionRecord.v1" },
    "decision_record_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "record_status": { "const": "ORACLE_AUTHORIZATION_DECISION_RECORD_TEMPLATE_READY_ADVISORY_ONLY" },
    "timestamp": { "type": "string", "minLength": 1 },
    "source_packet_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracle_measurement_authorization_decision_review_candidate",
        "oracle_measurement_authorization_decision_review_candidate_receipt",
        "oracle_measurement_authorization_proposal",
        "oracle_shadow_measurement",
        "oracle_schema_validation_receipt"
      ],
      "properties": {
        "oracle_measurement_authorization_decision_review_candidate": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_measurement_authorization_decision_review_candidate_receipt": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_measurement_authorization_proposal": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_shadow_measurement": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_schema_validation_receipt": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "decision_record_template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "template_status",
        "exact_confirmation_required",
        "attestation_note_required",
        "records_operator_attestation",
        "records_authorization_decision",
        "authorizes_measurement",
        "records_measurement_execution",
        "selected_option",
        "operator_attestation",
        "brier_score"
      ],
      "properties": {
        "template_id": { "const": "ORACLE_AUTHORIZATION_DECISION_RECORD_TEMPLATE" },
        "template_status": { "const": "TEMPLATE_ONLY_NOT_RECORDED" },
        "exact_confirmation_required": { "const": "yes" },
        "attestation_note_required": { "const": true },
        "records_operator_attestation": { "const": false },
        "records_authorization_decision": { "const": false },
        "authorizes_measurement": { "const": false },
        "records_measurement_execution": { "const": false },
        "selected_option": { "const": "UNSELECTED_OPERATOR_GATE_REQUIRED" },
        "operator_attestation": { "const": "UNRECORDED_OPERATOR_GATE_REQUIRED" },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "operator_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "gate_status",
        "operator_required",
        "records_decision",
        "records_attestation",
        "authorizes_measurement",
        "brier_score"
      ],
      "properties": {
        "gate_id": { "const": "ORACLE_AUTHORIZATION_DECISION_RECORD_OPERATOR_GATE" },
        "gate_status": { "const": "HELD_FOR_SEPARATE_OPERATOR_ACTION" },
        "operator_required": { "const": true },
        "records_decision": { "const": false },
        "records_attestation": { "const": false },
        "authorizes_measurement": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "decision_options": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "option_status",
          "operator_meaning",
          "selected_by_this_packet",
          "valid_for_measurement_authorization",
          "brier_score"
        ],
        "properties": {
          "option_id": { "type": "string", "minLength": 1 },
          "option_status": { "const": "AVAILABLE_FOR_FUTURE_OPERATOR_RECORD_ONLY" },
          "operator_meaning": { "type": "string", "minLength": 1 },
          "selected_by_this_packet": { "const": false },
          "valid_for_measurement_authorization": { "const": false },
          "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "evidence_ref",
          "review_status",
          "required_before_any_future_authorization",
          "brier_score"
        ],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "evidence_ref": { "type": "string", "minLength": 1 },
          "review_status": { "const": "HELD_FOR_OPERATOR_REVIEW_ONLY" },
          "required_before_any_future_authorization": { "const": true },
          "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "denial_locks": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lock_id", "locked", "brier_score"],
        "properties": {
          "lock_id": { "type": "string", "minLength": 1 },
          "locked": { "const": false },
          "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "version_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_family", "schema_name", "schema_version", "registry_path", "brier_score"],
      "properties": {
        "schema_family": { "const": "oracle_signal_layer" },
        "schema_name": { "const": "oracle_authorization_decision_record" },
        "schema_version": { "const": "v1" },
        "registry_path": { "const": "contracts/canon/oracle/oracle_schema_registry.v1.schema.json" },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "sprint_spine", "canon_extension_only", "root_canon_mutated", "brier_score"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "sprint_spine": { "type": "string", "minLength": 1 },
        "canon_extension_only": { "const": true },
        "root_canon_mutated": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "authority_locks": { "type": "object", "additionalProperties": { "const": false } },
    "advisory_only": { "const": true },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
