{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_full_live_execution.v1.schema.json",
  "title": "OracleFullLiveExecution.v1",
  "description": "Full live execution readiness schema under contracts/canon/oracle only. This records the explicit FULL_LIVE_EXECUTION_GATE and enables governed live execution surfaces through receipt-first Loop 805 control. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "execution_id",
    "execution_status",
    "timestamp",
    "source_packet_hashes",
    "real_oracle_endpoint_connections",
    "live_signal_ingestion_pipelines",
    "production_scheduler_queue_integration",
    "persistent_telemetry_monitors",
    "holler_live_batch_processing",
    "operator_gate",
    "authority_locks",
    "governance_controls",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleFullLiveExecution.v1" },
    "execution_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "execution_status": { "const": "ORACLE_SIGNAL_LAYER_FULL_LIVE_EXECUTION_READY" },
    "timestamp": { "type": "string", "minLength": 1 },
    "source_packet_hashes": { "type": "object" },
    "real_oracle_endpoint_connections": { "type": "array", "minItems": 2 },
    "live_signal_ingestion_pipelines": { "type": "array", "minItems": 2 },
    "production_scheduler_queue_integration": { "type": "array", "minItems": 2 },
    "persistent_telemetry_monitors": { "type": "array", "minItems": 2 },
    "holler_live_batch_processing": { "type": "array", "minItems": 1 },
    "operator_gate": { "type": "object" },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canon_mutation",
        "runtime_mutation",
        "execution_authority",
        "actual_external_oracle_calls",
        "actual_live_data_ingestion",
        "persistent_production_runtime_activation",
        "mcp_exposure",
        "unreviewed_production_deployment",
        "github_writeback",
        "notion_writeback"
      ],
      "properties": {
        "canon_mutation": { "const": false },
        "runtime_mutation": { "const": false },
        "execution_authority": { "const": true },
        "actual_external_oracle_calls": { "const": true },
        "actual_live_data_ingestion": { "const": true },
        "persistent_production_runtime_activation": { "const": true },
        "mcp_exposure": { "const": false },
        "unreviewed_production_deployment": { "const": false },
        "github_writeback": { "const": false },
        "notion_writeback": { "const": false }
      }
    },
    "governance_controls": { "type": "object" },
    "valid_for_external_oracle_calls": { "const": true },
    "valid_for_live_signal_ingestion": { "const": true },
    "valid_for_persistent_telemetry": { "const": true },
    "valid_for_scheduler_queue_runtime": { "const": true },
    "valid_for_mcp_exposure": { "const": false },
    "valid_for_unreviewed_production_deployment": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
