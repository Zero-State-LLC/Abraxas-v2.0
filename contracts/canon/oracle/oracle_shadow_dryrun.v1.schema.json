{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_shadow_dryrun.v1.schema.json",
  "title": "OracleShadowDryRun.v1",
  "description": "Advisory shadow dry-run schema under contracts/canon/oracle only. This does not mutate root canon files, perform live signals, or authorize execution. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dryrun_id",
    "dryrun_status",
    "timestamp",
    "source_packet_hashes",
    "replay_fixtures",
    "expected_outcomes",
    "validation_binding",
    "route_decision_log",
    "provenance_flow",
    "operator_decision_record_template",
    "version_metadata",
    "provenance",
    "authority_locks",
    "advisory_only",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleShadowDryRun.v1" },
    "dryrun_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dryrun_status": { "const": "ORACLE_SHADOW_DRYRUN_READY_ADVISORY_ONLY" },
    "timestamp": { "type": "string", "minLength": 1 },
    "source_packet_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracle_ingest_wiring",
        "oracle_schema_validation_receipt",
        "oracle_adversarial_fixture"
      ],
      "properties": {
        "oracle_ingest_wiring": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_schema_validation_receipt": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_adversarial_fixture": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "replay_fixtures": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "fixture_kind",
          "source_ref",
          "expected_route",
          "valid_for_live_signal",
          "valid_for_execution",
          "brier_score"
        ],
        "properties": {
          "fixture_id": { "type": "string", "minLength": 1 },
          "fixture_kind": { "type": "string", "minLength": 1 },
          "source_ref": { "type": "string", "minLength": 1 },
          "expected_route": { "type": "string", "minLength": 1 },
          "valid_for_live_signal": { "const": false },
          "valid_for_execution": { "const": false },
          "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "expected_outcomes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "expected_status",
          "expected_guardrail",
          "records_live_result",
          "brier_score"
        ],
        "properties": {
          "fixture_id": { "type": "string", "minLength": 1 },
          "expected_status": { "const": "SHADOW_REPLAY_HELD_FOR_OPERATOR" },
          "expected_guardrail": { "type": "string", "minLength": 1 },
          "records_live_result": { "const": false },
          "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "validation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_validation_receipt_hash",
        "ingest_wiring_hash",
        "validation_required_before_live_execution",
        "live_execution_authorized",
        "brier_score"
      ],
      "properties": {
        "schema_validation_receipt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "ingest_wiring_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "validation_required_before_live_execution": { "const": true },
        "live_execution_authorized": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "route_decision_log": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_id",
          "fixture_id",
          "route_status",
          "decision",
          "valid_for_route_mutation",
          "brier_score"
        ],
        "properties": {
          "route_id": { "type": "string", "minLength": 1 },
          "fixture_id": { "type": "string", "minLength": 1 },
          "route_status": { "const": "PROJECTED_ONLY_NOT_ROUTED" },
          "decision": { "type": "string", "minLength": 1 },
          "valid_for_route_mutation": { "const": false },
          "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "provenance_flow": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flow_id", "source", "target", "sealed_for_writeback", "brier_score"],
        "properties": {
          "flow_id": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "sealed_for_writeback": { "const": false },
          "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "operator_decision_record_template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "exact_confirmation_required",
        "attestation_note_required",
        "records_live_execution",
        "brier_score"
      ],
      "properties": {
        "template_id": { "const": "ORACLE_SHADOW_DRYRUN_OPERATOR_DECISION_TEMPLATE" },
        "exact_confirmation_required": { "const": "yes" },
        "attestation_note_required": { "const": true },
        "records_live_execution": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "version_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_family", "schema_name", "schema_version", "registry_path", "brier_score"],
      "properties": {
        "schema_family": { "const": "oracle_signal_layer" },
        "schema_name": { "const": "oracle_shadow_dryrun" },
        "schema_version": { "const": "v1" },
        "registry_path": { "const": "contracts/canon/oracle/oracle_schema_registry.v1.schema.json" },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "sprint_spine", "canon_extension_only", "root_canon_mutated", "brier_score"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "sprint_spine": { "type": "string", "minLength": 1 },
        "canon_extension_only": { "const": true },
        "root_canon_mutated": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "authority_locks": { "type": "object", "additionalProperties": { "const": false } },
    "advisory_only": { "const": true },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
