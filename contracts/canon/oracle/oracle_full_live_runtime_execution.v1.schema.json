{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_full_live_runtime_execution.v1.schema.json",
  "title": "OracleFullLiveRuntimeExecutionAttempt.v1",
  "description": "Receipt-first full-live runtime execution attempt schema under contracts/canon/oracle only. This records blocked or operator-monitored live probe attempts after FULL_LIVE_EXECUTION_GATE. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "attempt_id",
    "attempt_status",
    "timestamp",
    "source_packet_hashes",
    "operator_execution_gate",
    "execution_request",
    "endpoint_references",
    "pre_execution_blockers",
    "live_probe_results",
    "execution_summary",
    "authority_locks",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleFullLiveRuntimeExecutionAttempt.v1" },
    "attempt_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "attempt_status": {
      "enum": [
        "ORACLE_FULL_LIVE_RUNTIME_EXECUTION_ATTEMPT_BLOCKED",
        "ORACLE_FULL_LIVE_RUNTIME_EXECUTION_ATTEMPT_RECORDED"
      ]
    },
    "timestamp": { "type": "string", "minLength": 1 },
    "source_packet_hashes": { "type": "object" },
    "operator_execution_gate": {
      "type": "object",
      "required": [
        "gate_id",
        "gate_status",
        "gate_hash",
        "operator_monitoring_required",
        "brier_score"
      ]
    },
    "execution_request": {
      "type": "object",
      "required": [
        "execute_requested",
        "preflight_ready",
        "endpoint_environment_ready",
        "operator_attestation_ready",
        "execution_allowed",
        "brier_score"
      ]
    },
    "endpoint_references": { "type": "array", "minItems": 2 },
    "pre_execution_blockers": { "type": "array", "minItems": 5 },
    "live_probe_results": { "type": "array" },
    "execution_summary": {
      "type": "object",
      "required": [
        "external_call_count",
        "live_ingestion_count",
        "payload_record_count",
        "persistent_write_count",
        "telemetry_writeback_count",
        "secret_material_recorded",
        "response_payload_recorded",
        "brier_score"
      ],
      "properties": {
        "external_call_count": { "type": "integer", "minimum": 0 },
        "live_ingestion_count": { "const": 0 },
        "payload_record_count": { "const": 0 },
        "persistent_write_count": { "const": 0 },
        "telemetry_writeback_count": { "const": 0 },
        "secret_material_recorded": { "const": false },
        "response_payload_recorded": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canon_mutation",
        "runtime_mutation",
        "execution_authority",
        "actual_external_oracle_calls",
        "actual_live_data_ingestion",
        "persistent_production_runtime_activation",
        "mcp_exposure",
        "unreviewed_production_deployment",
        "autonomous_outcome_recording",
        "github_writeback",
        "notion_writeback"
      ],
      "properties": {
        "canon_mutation": { "const": false },
        "runtime_mutation": { "const": false },
        "execution_authority": { "type": "boolean" },
        "actual_external_oracle_calls": { "type": "boolean" },
        "actual_live_data_ingestion": { "const": false },
        "persistent_production_runtime_activation": { "const": false },
        "mcp_exposure": { "const": false },
        "unreviewed_production_deployment": { "const": false },
        "autonomous_outcome_recording": { "const": false },
        "github_writeback": { "const": false },
        "notion_writeback": { "const": false }
      }
    },
    "valid_for_external_oracle_calls": { "type": "boolean" },
    "valid_for_live_signal_ingestion": { "const": false },
    "valid_for_payload_persistence": { "const": false },
    "valid_for_autonomous_outcome_recording": { "const": false },
    "valid_for_mcp_exposure": { "const": false },
    "valid_for_unreviewed_production_deployment": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
