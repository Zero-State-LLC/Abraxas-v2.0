{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_ingest_wiring.v1.schema.json",
  "title": "OracleIngestWiring.v1",
  "description": "Advisory ingest wiring schema under contracts/canon/oracle only. This does not mutate root canon files. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "wiring_id",
    "wiring_status",
    "timestamp",
    "source_packet_hashes",
    "intake_pipeline",
    "routing_plan",
    "validation_binding",
    "provenance_flow",
    "shadow_replay_harness",
    "operator_decision_record_template",
    "version_metadata",
    "provenance",
    "authority_locks",
    "advisory_only",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleIngestWiring.v1" },
    "wiring_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "wiring_status": { "const": "ORACLE_INGEST_WIRING_READY_ADVISORY_ONLY" },
    "timestamp": { "type": "string", "minLength": 1 },
    "source_packet_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_envelope", "holler_intake", "schema_validation_receipt"],
      "properties": {
        "signal_envelope": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "holler_intake": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "schema_validation_receipt": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "intake_pipeline": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "stage_status", "input_ref", "output_ref", "brier_score"],
        "properties": {
          "stage_id": { "type": "string", "minLength": 1 },
          "stage_status": { "const": "ADVISORY_ONLY_NOT_EXECUTED" },
          "input_ref": { "type": "string", "minLength": 1 },
          "output_ref": { "type": "string", "minLength": 1 },
          "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "routing_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "valid_for_live_route", "valid_for_queue_mutation", "brier_score"],
      "properties": {
        "mode": { "const": "SHADOW_ROUTE_PLAN_ONLY" },
        "valid_for_live_route": { "const": false },
        "valid_for_queue_mutation": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "validation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_validation_receipt_hash", "validation_required_before_live_ingest", "live_validation_authorized", "brier_score"],
      "properties": {
        "schema_validation_receipt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "validation_required_before_live_ingest": { "const": true },
        "live_validation_authorized": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "provenance_flow": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flow_id", "source", "target", "sealed_for_writeback", "brier_score"],
        "properties": {
          "flow_id": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "sealed_for_writeback": { "const": false },
          "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "shadow_replay_harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "valid_for_execution", "valid_for_live_ingest", "brier_score"],
      "properties": {
        "mode": { "const": "SHADOW_REPLAY_PLAN_ONLY_NOT_EXECUTED" },
        "valid_for_execution": { "const": false },
        "valid_for_live_ingest": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "operator_decision_record_template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_id", "exact_confirmation_required", "attestation_note_required", "records_live_ingest", "brier_score"],
      "properties": {
        "template_id": { "const": "ORACLE_INGEST_WIRING_OPERATOR_DECISION_TEMPLATE" },
        "exact_confirmation_required": { "const": "yes" },
        "attestation_note_required": { "const": true },
        "records_live_ingest": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "version_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_family", "schema_name", "schema_version", "registry_path", "brier_score"],
      "properties": {
        "schema_family": { "const": "oracle_signal_layer" },
        "schema_name": { "const": "oracle_ingest_wiring" },
        "schema_version": { "const": "v1" },
        "registry_path": { "const": "contracts/canon/oracle/oracle_schema_registry.v1.schema.json" },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "sprint_spine", "canon_extension_only", "root_canon_mutated", "brier_score"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "sprint_spine": { "type": "string", "minLength": 1 },
        "canon_extension_only": { "const": true },
        "root_canon_mutated": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "authority_locks": { "type": "object", "additionalProperties": { "const": false } },
    "advisory_only": { "const": true },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
