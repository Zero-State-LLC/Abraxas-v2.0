{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_measurement_authorization_proposal.v1.schema.json",
  "title": "OracleMeasurementAuthorizationProposal.v1",
  "description": "Advisory measurement authorization proposal schema under contracts/canon/oracle only. This prepares an operator review packet but does not authorize measurement, record attestation, execute runs, call external oracles, or mutate canon. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_proposal_id",
    "proposal_status",
    "timestamp",
    "source_packet_hashes",
    "authorization_scope",
    "operator_gate_template",
    "authorization_review_steps",
    "promotion_preconditions",
    "denial_locks",
    "version_metadata",
    "provenance",
    "authority_locks",
    "advisory_only",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleMeasurementAuthorizationProposal.v1" },
    "authorization_proposal_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "proposal_status": { "const": "ORACLE_MEASUREMENT_AUTHORIZATION_PROPOSAL_READY_ADVISORY_ONLY" },
    "timestamp": { "type": "string", "minLength": 1 },
    "source_packet_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracle_measurement_proposal",
        "oracle_measurement_proposal_receipt",
        "oracle_shadow_measurement",
        "oracle_measurement_readiness",
        "oracle_schema_validation_receipt"
      ],
      "properties": {
        "oracle_measurement_proposal": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_measurement_proposal_receipt": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_shadow_measurement": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_measurement_readiness": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_schema_validation_receipt": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "authorization_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "scope_status",
        "summary",
        "operator_gate_required",
        "grants_measurement_authorization",
        "records_operator_attestation",
        "brier_score"
      ],
      "properties": {
        "scope_id": { "const": "ORACLE_MEASUREMENT_AUTHORIZATION_PROPOSAL_SCOPE_001" },
        "scope_status": { "const": "PROPOSAL_ONLY_NOT_AUTHORIZED" },
        "summary": { "type": "string", "minLength": 1 },
        "operator_gate_required": { "const": true },
        "grants_measurement_authorization": { "const": false },
        "records_operator_attestation": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "operator_gate_template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "exact_confirmation_required",
        "attestation_note_required",
        "records_operator_attestation",
        "authorizes_measurement",
        "review_statement",
        "brier_score"
      ],
      "properties": {
        "template_id": { "const": "ORACLE_MEASUREMENT_AUTHORIZATION_PROPOSAL_OPERATOR_GATE_TEMPLATE" },
        "exact_confirmation_required": { "const": "yes" },
        "attestation_note_required": { "const": true },
        "records_operator_attestation": { "const": false },
        "authorizes_measurement": { "const": false },
        "review_statement": { "type": "string", "minLength": 1 },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "authorization_review_steps": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "step_status",
          "evidence_ref",
          "required_before_any_future_authorization",
          "valid_for_execution",
          "brier_score"
        ],
        "properties": {
          "step_id": { "type": "string", "minLength": 1 },
          "step_status": { "const": "HELD_FOR_OPERATOR_REVIEW_ONLY" },
          "evidence_ref": { "type": "string", "minLength": 1 },
          "required_before_any_future_authorization": { "const": true },
          "valid_for_execution": { "const": false },
          "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "promotion_preconditions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "precondition_id",
          "precondition_status",
          "source_ref",
          "satisfied_by_this_packet",
          "brier_score"
        ],
        "properties": {
          "precondition_id": { "type": "string", "minLength": 1 },
          "precondition_status": { "const": "NOT_SATISFIED_PROPOSAL_ONLY" },
          "source_ref": { "type": "string", "minLength": 1 },
          "satisfied_by_this_packet": { "const": false },
          "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "denial_locks": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lock_id", "locked", "brier_score"],
        "properties": {
          "lock_id": { "type": "string", "minLength": 1 },
          "locked": { "const": false },
          "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "version_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_family", "schema_name", "schema_version", "registry_path", "brier_score"],
      "properties": {
        "schema_family": { "const": "oracle_signal_layer" },
        "schema_name": { "const": "oracle_measurement_authorization_proposal" },
        "schema_version": { "const": "v1" },
        "registry_path": { "const": "contracts/canon/oracle/oracle_schema_registry.v1.schema.json" },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "sprint_spine", "canon_extension_only", "root_canon_mutated", "brier_score"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "sprint_spine": { "type": "string", "minLength": 1 },
        "canon_extension_only": { "const": true },
        "root_canon_mutated": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "authority_locks": { "type": "object", "additionalProperties": { "const": false } },
    "advisory_only": { "const": true },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
