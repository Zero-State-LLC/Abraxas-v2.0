{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_production_activation_ready.v1.schema.json",
  "title": "OracleProductionActivationReady.v1",
  "description": "Production activation readiness schema under contracts/canon/oracle only. This authorizes production-ready code/config template generation and shadow/dry-run execution of live wiring surfaces, but not actual external oracle calls, live ingestion, persistent production runtime activation, MCP exposure, or unreviewed deployment. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "activation_id",
    "activation_status",
    "timestamp",
    "source_packet_hashes",
    "production_connector_surfaces",
    "production_endpoint_configurations",
    "scheduler_queue_bindings",
    "production_telemetry_monitors",
    "holler_live_batch_pipelines",
    "operator_gate",
    "authority_locks",
    "advisory_only",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleProductionActivationReady.v1" },
    "activation_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "activation_status": { "const": "ORACLE_SIGNAL_LAYER_PRODUCTION_ACTIVATION_READY" },
    "timestamp": { "type": "string", "minLength": 1 },
    "source_packet_hashes": { "type": "object" },
    "production_connector_surfaces": { "type": "array", "minItems": 2 },
    "production_endpoint_configurations": { "type": "array", "minItems": 2 },
    "scheduler_queue_bindings": { "type": "array", "minItems": 2 },
    "production_telemetry_monitors": { "type": "array", "minItems": 2 },
    "holler_live_batch_pipelines": { "type": "array", "minItems": 1 },
    "operator_gate": { "type": "object" },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canon_mutation",
        "runtime_mutation",
        "execution_authority",
        "actual_external_oracle_calls",
        "actual_live_data_ingestion",
        "persistent_production_runtime_activation",
        "mcp_exposure",
        "unreviewed_production_deployment"
      ],
      "properties": {
        "canon_mutation": { "const": false },
        "runtime_mutation": { "const": false },
        "execution_authority": { "const": false },
        "actual_external_oracle_calls": { "const": false },
        "actual_live_data_ingestion": { "const": false },
        "persistent_production_runtime_activation": { "const": false },
        "mcp_exposure": { "const": false },
        "unreviewed_production_deployment": { "const": false }
      }
    },
    "advisory_only": { "const": true },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false },
    "valid_for_production_code_generation": { "const": true },
    "valid_for_shadow_dryrun_execution": { "const": true },
    "valid_for_actual_external_oracle_calls": { "const": false },
    "valid_for_actual_live_data_ingestion": { "const": false },
    "valid_for_persistent_production_runtime_activation": { "const": false },
    "valid_for_mcp_exposure": { "const": false },
    "valid_for_unreviewed_production_deployment": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
