{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_measurement_proposal.v1.schema.json",
  "title": "OracleMeasurementProposal.v1",
  "description": "Advisory measurement proposal and operator decision-intake refinement schema under contracts/canon/oracle only. This does not authorize measurement, record operator attestation, execute runs, call external oracles, or mutate canon. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "proposal_status",
    "timestamp",
    "source_packet_hashes",
    "proposal_scope",
    "operator_decision_intake_refinement",
    "measurement_proposal_steps",
    "readiness_exit_criteria",
    "boundary_checklist",
    "version_metadata",
    "provenance",
    "authority_locks",
    "advisory_only",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleMeasurementProposal.v1" },
    "proposal_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "proposal_status": { "const": "ORACLE_MEASUREMENT_PROPOSAL_READY_ADVISORY_ONLY" },
    "timestamp": { "type": "string", "minLength": 1 },
    "source_packet_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracle_measurement_readiness",
        "oracle_shadow_measurement",
        "oracle_shadow_measurement_receipt",
        "oracle_operator_decision_intake"
      ],
      "properties": {
        "oracle_measurement_readiness": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_shadow_measurement": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_shadow_measurement_receipt": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_operator_decision_intake": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "proposal_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "scope_status",
        "summary",
        "authorizes_measurement",
        "records_operator_attestation",
        "brier_score"
      ],
      "properties": {
        "scope_id": { "const": "ORACLE_MEASUREMENT_PROPOSAL_SCOPE_001" },
        "scope_status": { "const": "PROPOSAL_ONLY_OPERATOR_REVIEW_REQUIRED" },
        "summary": { "type": "string", "minLength": 1 },
        "authorizes_measurement": { "const": false },
        "records_operator_attestation": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "operator_decision_intake_refinement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "exact_confirmation_required",
        "attestation_note_required",
        "records_operator_attestation",
        "authorizes_measurement",
        "review_questions",
        "brier_score"
      ],
      "properties": {
        "template_id": { "const": "ORACLE_MEASUREMENT_PROPOSAL_OPERATOR_REVIEW_TEMPLATE" },
        "exact_confirmation_required": { "const": "yes" },
        "attestation_note_required": { "const": true },
        "records_operator_attestation": { "const": false },
        "authorizes_measurement": { "const": false },
        "review_questions": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question_id",
              "question",
              "records_decision",
              "valid_for_measurement_authorization",
              "brier_score"
            ],
            "properties": {
              "question_id": { "type": "string", "minLength": 1 },
              "question": { "type": "string", "minLength": 1 },
              "records_decision": { "const": false },
              "valid_for_measurement_authorization": { "const": false },
              "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
            }
          }
        },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "measurement_proposal_steps": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "step_status",
          "evidence_ref",
          "operator_gate_required",
          "valid_for_execution",
          "brier_score"
        ],
        "properties": {
          "step_id": { "type": "string", "minLength": 1 },
          "step_status": { "const": "PROPOSED_FOR_OPERATOR_REVIEW_ONLY" },
          "evidence_ref": { "type": "string", "minLength": 1 },
          "operator_gate_required": { "const": true },
          "valid_for_execution": { "const": false },
          "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "readiness_exit_criteria": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "criterion_status",
          "source_ref",
          "required_before_future_measurement",
          "brier_score"
        ],
        "properties": {
          "criterion_id": { "type": "string", "minLength": 1 },
          "criterion_status": { "const": "HELD_FOR_OPERATOR_REVIEW" },
          "source_ref": { "type": "string", "minLength": 1 },
          "required_before_future_measurement": { "const": true },
          "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "boundary_checklist": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lock_id", "locked", "brier_score"],
        "properties": {
          "lock_id": { "type": "string", "minLength": 1 },
          "locked": { "const": false },
          "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
        }
      }
    },
    "version_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_family", "schema_name", "schema_version", "registry_path", "brier_score"],
      "properties": {
        "schema_family": { "const": "oracle_signal_layer" },
        "schema_name": { "const": "oracle_measurement_proposal" },
        "schema_version": { "const": "v1" },
        "registry_path": { "const": "contracts/canon/oracle/oracle_schema_registry.v1.schema.json" },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "sprint_spine", "canon_extension_only", "root_canon_mutated", "brier_score"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "sprint_spine": { "type": "string", "minLength": 1 },
        "canon_extension_only": { "const": true },
        "root_canon_mutated": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "authority_locks": { "type": "object", "additionalProperties": { "const": false } },
    "advisory_only": { "const": true },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
