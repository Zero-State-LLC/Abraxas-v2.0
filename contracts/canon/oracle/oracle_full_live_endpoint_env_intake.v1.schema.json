{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_full_live_endpoint_env_intake.v1.schema.json",
  "title": "OracleFullLiveEndpointEnvIntake.v1",
  "description": "Redacted operator endpoint-environment intake schema for resolving full-live runtime preflight blockers. This records required environment variable names and review steps only; it never stores endpoint values or performs external calls. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "intake_id",
    "intake_status",
    "timestamp",
    "source_packet_hashes",
    "endpoint_env_requirements",
    "operator_configuration_checklist",
    "rerun_plan",
    "authority_locks",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleFullLiveEndpointEnvIntake.v1" },
    "intake_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "intake_status": { "const": "ORACLE_FULL_LIVE_ENDPOINT_ENV_INTAKE_READY" },
    "timestamp": { "type": "string", "minLength": 1 },
    "source_packet_hashes": { "type": "object" },
    "endpoint_env_requirements": { "type": "array", "minItems": 2 },
    "operator_configuration_checklist": { "type": "array", "minItems": 4 },
    "rerun_plan": { "type": "object" },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canon_mutation",
        "runtime_mutation",
        "execution_authority",
        "actual_external_oracle_calls",
        "actual_live_data_ingestion",
        "persistent_production_runtime_activation",
        "mcp_exposure",
        "unreviewed_production_deployment",
        "autonomous_outcome_recording",
        "github_writeback",
        "notion_writeback"
      ],
      "properties": {
        "canon_mutation": { "const": false },
        "runtime_mutation": { "const": false },
        "execution_authority": { "const": true },
        "actual_external_oracle_calls": { "const": true },
        "actual_live_data_ingestion": { "const": true },
        "persistent_production_runtime_activation": { "const": true },
        "mcp_exposure": { "const": false },
        "unreviewed_production_deployment": { "const": false },
        "autonomous_outcome_recording": { "const": false },
        "github_writeback": { "const": false },
        "notion_writeback": { "const": false }
      }
    },
    "stores_endpoint_values": { "const": false },
    "external_calls_made": { "const": 0 },
    "valid_for_external_oracle_calls": { "const": false },
    "valid_for_live_signal_ingestion": { "const": false },
    "valid_for_scheduler_queue_runtime": { "const": false },
    "valid_for_persistent_telemetry": { "const": false },
    "valid_for_mcp_exposure": { "const": false },
    "valid_for_unreviewed_production_deployment": { "const": false },
    "valid_for_autonomous_outcome_recording": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
