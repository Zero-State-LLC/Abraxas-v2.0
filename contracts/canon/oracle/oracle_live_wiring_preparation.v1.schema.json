{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_live_wiring_preparation.v1.schema.json",
  "title": "OracleLiveWiringPreparation.v1",
  "description": "Advisory live wiring preparation schema under contracts/canon/oracle only. This does not ingest live signals, call external oracles, mutate queues/schedulers, expose MCP, or authorize production activation. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "preparation_id",
    "preparation_status",
    "timestamp",
    "source_packet_hashes",
    "live_ingest_connector_stubs",
    "oracle_endpoint_configuration_templates",
    "scheduler_queue_integration_points",
    "telemetry_monitoring_hooks",
    "operator_gate",
    "provenance",
    "authority_locks",
    "advisory_only",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleLiveWiringPreparation.v1" },
    "preparation_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "preparation_status": { "const": "ORACLE_LIVE_WIRING_PREPARATION_READY_ADVISORY_ONLY" },
    "timestamp": { "type": "string", "minLength": 1 },
    "source_packet_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_ready_gate",
        "oracle_signal_layer_completion",
        "oracle_schema_validation_receipt",
        "oracle_ingest_wiring",
        "oracle_shadow_dryrun",
        "oracle_shadow_measurement"
      ],
      "properties": {
        "activation_ready_gate": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_signal_layer_completion": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_schema_validation_receipt": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_ingest_wiring": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_shadow_dryrun": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "oracle_shadow_measurement": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "live_ingest_connector_stubs": { "type": "array", "minItems": 2 },
    "oracle_endpoint_configuration_templates": { "type": "array", "minItems": 2 },
    "scheduler_queue_integration_points": { "type": "array", "minItems": 2 },
    "telemetry_monitoring_hooks": { "type": "array", "minItems": 2 },
    "operator_gate": { "type": "object" },
    "provenance": { "type": "object" },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canon_mutation",
        "runtime_mutation",
        "execution_authority",
        "live_signal_ingest",
        "external_oracle_calls",
        "scheduler_mutation",
        "queue_mutation",
        "mcp_exposure",
        "github_writeback",
        "notion_writeback",
        "production_activation"
      ],
      "properties": {
        "canon_mutation": { "const": false },
        "runtime_mutation": { "const": false },
        "execution_authority": { "const": false },
        "live_signal_ingest": { "const": false },
        "external_oracle_calls": { "const": false },
        "scheduler_mutation": { "const": false },
        "queue_mutation": { "const": false },
        "mcp_exposure": { "const": false },
        "github_writeback": { "const": false },
        "notion_writeback": { "const": false },
        "production_activation": { "const": false }
      }
    },
    "advisory_only": { "const": true },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false },
    "valid_for_live_signal_ingest": { "const": false },
    "valid_for_external_oracle_calls": { "const": false },
    "valid_for_scheduler_mutation": { "const": false },
    "valid_for_queue_mutation": { "const": false },
    "valid_for_mcp_exposure": { "const": false },
    "valid_for_production_activation": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
