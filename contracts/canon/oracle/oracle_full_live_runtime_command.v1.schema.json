{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_full_live_runtime_command.v1.schema.json",
  "title": "OracleFullLiveRuntimeCommand.v1",
  "description": "Receipt-first full-live runtime command manifest schema under contracts/canon/oracle only. This records operator-monitored command/runbook readiness after ORACLE_FULL_LIVE_RUN_CONTROL_READY. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "runtime_command_id",
    "runtime_command_status",
    "timestamp",
    "source_packet_hashes",
    "operator_monitoring_gate",
    "runtime_command_manifest",
    "endpoint_environment_requirements",
    "scheduler_queue_runtime_manifest",
    "telemetry_monitoring_manifest",
    "holler_live_batch_manifest",
    "pre_run_blockers",
    "authority_locks",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleFullLiveRuntimeCommand.v1" },
    "runtime_command_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtime_command_status": { "const": "ORACLE_FULL_LIVE_RUNTIME_COMMAND_READY" },
    "timestamp": { "type": "string", "minLength": 1 },
    "source_packet_hashes": { "type": "object" },
    "operator_monitoring_gate": { "type": "object" },
    "runtime_command_manifest": { "type": "array", "minItems": 3 },
    "endpoint_environment_requirements": { "type": "array", "minItems": 2 },
    "scheduler_queue_runtime_manifest": { "type": "array", "minItems": 2 },
    "telemetry_monitoring_manifest": { "type": "array", "minItems": 3 },
    "holler_live_batch_manifest": { "type": "array", "minItems": 1 },
    "pre_run_blockers": { "type": "array", "minItems": 5 },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canon_mutation",
        "runtime_mutation",
        "execution_authority",
        "actual_external_oracle_calls",
        "actual_live_data_ingestion",
        "persistent_production_runtime_activation",
        "mcp_exposure",
        "unreviewed_production_deployment",
        "autonomous_outcome_recording",
        "github_writeback",
        "notion_writeback"
      ],
      "properties": {
        "canon_mutation": { "const": false },
        "runtime_mutation": { "const": false },
        "execution_authority": { "const": true },
        "actual_external_oracle_calls": { "const": true },
        "actual_live_data_ingestion": { "const": true },
        "persistent_production_runtime_activation": { "const": true },
        "mcp_exposure": { "const": false },
        "unreviewed_production_deployment": { "const": false },
        "autonomous_outcome_recording": { "const": false },
        "github_writeback": { "const": false },
        "notion_writeback": { "const": false }
      }
    },
    "valid_for_external_oracle_calls": { "const": true },
    "valid_for_live_signal_ingestion": { "const": true },
    "valid_for_scheduler_queue_runtime": { "const": true },
    "valid_for_persistent_telemetry": { "const": true },
    "valid_for_mcp_exposure": { "const": false },
    "valid_for_unreviewed_production_deployment": { "const": false },
    "valid_for_autonomous_outcome_recording": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
