{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_sandbox_probe_gate_proposal.v1.schema.json",
  "title": "OracleSandboxProbeGateProposal.v1",
  "description": "Advisory-only #881 sandbox probe gate proposal. Consumes secret-store stubs without authorizing probe execution, external calls, scheduler runtime, telemetry writeback, or secret persistence. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "proposal_id",
    "proposal_status",
    "timestamp",
    "source_packet_hashes",
    "operator_gate_template",
    "pre_probe_checklist",
    "probe_dry_run_plan",
    "rollback_plan",
    "provenance",
    "authority_locks",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleSandboxProbeGateProposal.v1" },
    "proposal_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "proposal_status": {
      "const": "ORACLE_SANDBOX_PROBE_GATE_PROPOSAL_READY_ADVISORY_ONLY"
    },
    "timestamp": { "type": "string", "minLength": 1 },
    "source_packet_hashes": { "type": "object" },
    "operator_gate_template": {
      "type": "object",
      "required": [
        "required_phrase",
        "attestation_note_required",
        "authorizes_probe_execution",
        "brier_score"
      ],
      "properties": {
        "required_phrase": { "const": "ORACLE_SANDBOX_PROBE_GATE_CONFIRMED" },
        "attestation_note_required": { "const": true },
        "authorizes_probe_execution": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "pre_probe_checklist": { "type": "array", "minItems": 4 },
    "probe_dry_run_plan": {
      "type": "object",
      "required": [
        "plan_status",
        "external_calls_allowed_by_this_proposal",
        "scheduler_enabled_by_this_proposal",
        "payload_persistence_enabled_by_this_proposal",
        "brier_score"
      ],
      "properties": {
        "plan_status": { "const": "PROPOSAL_ONLY_NO_PROBE_EXECUTION" },
        "external_calls_allowed_by_this_proposal": { "const": false },
        "scheduler_enabled_by_this_proposal": { "const": false },
        "payload_persistence_enabled_by_this_proposal": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "rollback_plan": { "type": "object" },
    "provenance": { "type": "object" },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canon_mutation",
        "runtime_mutation",
        "execution_authority",
        "actual_external_oracle_calls",
        "actual_live_data_ingestion",
        "persistent_production_runtime_activation",
        "scheduler_queue_runtime",
        "sandbox_probe_execution",
        "secret_material_persistence",
        "payload_persistence",
        "telemetry_writeback",
        "mcp_exposure",
        "github_writeback",
        "notion_writeback"
      ],
      "properties": {
        "canon_mutation": { "const": false },
        "runtime_mutation": { "const": false },
        "execution_authority": { "const": false },
        "actual_external_oracle_calls": { "const": false },
        "actual_live_data_ingestion": { "const": false },
        "persistent_production_runtime_activation": { "const": false },
        "scheduler_queue_runtime": { "const": false },
        "sandbox_probe_execution": { "const": false },
        "secret_material_persistence": { "const": false },
        "payload_persistence": { "const": false },
        "telemetry_writeback": { "const": false },
        "mcp_exposure": { "const": false },
        "github_writeback": { "const": false },
        "notion_writeback": { "const": false }
      }
    },
    "valid_for_sandbox_probe_execution": { "const": false },
    "valid_for_external_oracle_calls": { "const": false },
    "valid_for_scheduler_queue_runtime": { "const": false },
    "valid_for_secret_material_persistence": { "const": false },
    "valid_for_payload_persistence": { "const": false },
    "valid_for_telemetry_writeback": { "const": false },
    "valid_for_mcp_exposure": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
