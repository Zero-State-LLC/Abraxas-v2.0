{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_persistent_execution_secret_vault_plan.v1.schema.json",
  "title": "OraclePersistentExecutionSecretVaultPlan.v1",
  "description": "Docs-and-receipt-only persistent execution plus secret vault planning schema. Advisory extension, no secret capture, no live calls, no runtime/canon/writeback activation. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "plan_id",
    "plan_status",
    "timestamp",
    "source_packet_hashes",
    "secret_handling_requirements",
    "persistent_execution_boundaries",
    "runtime_receipt_gate",
    "rollback_plan",
    "provenance",
    "authority_locks",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OraclePersistentExecutionSecretVaultPlan.v1" },
    "plan_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "plan_status": {
      "const": "ORACLE_PERSISTENT_EXECUTION_SECRET_VAULT_PLAN_READY_ADVISORY_ONLY"
    },
    "timestamp": { "type": "string", "minLength": 1 },
    "source_packet_hashes": { "type": "object" },
    "secret_handling_requirements": { "type": "array", "minItems": 3 },
    "persistent_execution_boundaries": {
      "type": "object",
      "required": [
        "runtime_mode",
        "persistent_execution_enabled",
        "external_calls_allowed",
        "secret_material_allowed_in_repo",
        "telemetry_writeback_allowed",
        "brier_score"
      ],
      "properties": {
        "runtime_mode": { "const": "SANDBOX_GATED_PLANNING_ONLY" },
        "persistent_execution_enabled": { "const": false },
        "external_calls_allowed": { "const": false },
        "secret_material_allowed_in_repo": { "const": false },
        "telemetry_writeback_allowed": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "runtime_receipt_gate": { "type": "object" },
    "rollback_plan": { "type": "object" },
    "provenance": { "type": "object" },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canon_mutation",
        "runtime_mutation",
        "execution_authority",
        "actual_external_oracle_calls",
        "actual_live_data_ingestion",
        "persistent_production_runtime_activation",
        "secret_material_persistence",
        "payload_persistence",
        "telemetry_writeback",
        "mcp_exposure",
        "unreviewed_production_deployment",
        "autonomous_outcome_recording",
        "github_writeback",
        "notion_writeback"
      ],
      "properties": {
        "canon_mutation": { "const": false },
        "runtime_mutation": { "const": false },
        "execution_authority": { "const": false },
        "actual_external_oracle_calls": { "const": false },
        "actual_live_data_ingestion": { "const": false },
        "persistent_production_runtime_activation": { "const": false },
        "secret_material_persistence": { "const": false },
        "payload_persistence": { "const": false },
        "telemetry_writeback": { "const": false },
        "mcp_exposure": { "const": false },
        "unreviewed_production_deployment": { "const": false },
        "autonomous_outcome_recording": { "const": false },
        "github_writeback": { "const": false },
        "notion_writeback": { "const": false }
      }
    },
    "valid_for_external_oracle_calls": { "const": false },
    "valid_for_live_signal_ingestion": { "const": false },
    "valid_for_scheduler_queue_runtime": { "const": false },
    "valid_for_persistent_telemetry": { "const": false },
    "valid_for_secret_material_persistence": { "const": false },
    "valid_for_payload_persistence": { "const": false },
    "valid_for_autonomous_outcome_recording": { "const": false },
    "valid_for_mcp_exposure": { "const": false },
    "valid_for_unreviewed_production_deployment": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
