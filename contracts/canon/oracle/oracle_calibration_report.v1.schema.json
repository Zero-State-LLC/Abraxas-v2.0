{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_calibration_report.v1.schema.json",
  "title": "OracleCalibrationReport.v1",
  "description": "Advisory calibration report schema under contracts/canon/oracle only. This does not mutate root canon files. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "report_status",
    "timestamp",
    "calibration_rows",
    "aggregate_brier_score",
    "version_metadata",
    "cross_references",
    "provenance",
    "authority_locks",
    "advisory_only",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleCalibrationReport.v1" },
    "report_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "report_status": { "const": "ORACLE_CALIBRATION_REPORT_ADVISORY_EXTENSION_READY" },
    "timestamp": { "type": "string", "minLength": 1 },
    "calibration_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row_id", "forecast_probability", "observed_outcome", "brier_component"],
        "properties": {
          "row_id": { "type": "string", "minLength": 1 },
          "forecast_probability": { "type": "number", "minimum": 0, "maximum": 1 },
          "observed_outcome": { "type": "integer", "minimum": 0, "maximum": 1 },
          "brier_component": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "aggregate_brier_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "version_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_family", "schema_name", "schema_version", "registry_path", "brier_score"],
      "properties": {
        "schema_family": { "const": "oracle_signal_layer" },
        "schema_name": { "const": "oracle_calibration_report" },
        "schema_version": { "const": "v1" },
        "registry_path": { "const": "contracts/canon/oracle/oracle_schema_registry.v1.schema.json" },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "cross_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_schema", "signal_envelope_schema", "holler_intake_schema", "adversarial_fixture_schema"],
      "properties": {
        "registry_schema": { "const": "contracts/canon/oracle/oracle_schema_registry.v1.schema.json" },
        "signal_envelope_schema": { "const": "contracts/canon/oracle/oracle_signal_envelope.v1.schema.json" },
        "holler_intake_schema": { "const": "contracts/canon/oracle/oracle_holler_intake.v1.schema.json" },
        "adversarial_fixture_schema": { "const": "contracts/canon/oracle/oracle_adversarial_fixture.v1.schema.json" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "sprint_spine", "canon_extension_only", "root_canon_mutated", "brier_score"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "sprint_spine": { "type": "string", "minLength": 1 },
        "canon_extension_only": { "const": true },
        "root_canon_mutated": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "authority_locks": { "type": "object", "additionalProperties": { "const": false } },
    "advisory_only": { "const": true },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
