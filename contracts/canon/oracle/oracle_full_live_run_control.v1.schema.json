{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_full_live_run_control.v1.schema.json",
  "title": "OracleFullLiveRunControl.v1",
  "description": "Governed full-live run-control schema under contracts/canon/oracle only. This records receipt-first live execution controls after FULL_LIVE_EXECUTION_READY. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_control_id",
    "run_control_status",
    "timestamp",
    "source_packet_hashes",
    "operator_gate",
    "endpoint_runtime_plan",
    "scheduler_queue_plan",
    "telemetry_monitoring_plan",
    "holler_live_batch_plan",
    "pre_execution_checks",
    "authority_locks",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleFullLiveRunControl.v1" },
    "run_control_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "run_control_status": { "const": "ORACLE_FULL_LIVE_RUN_CONTROL_READY" },
    "timestamp": { "type": "string", "minLength": 1 },
    "source_packet_hashes": { "type": "object" },
    "operator_gate": { "type": "object" },
    "endpoint_runtime_plan": { "type": "array", "minItems": 2 },
    "scheduler_queue_plan": { "type": "array", "minItems": 2 },
    "telemetry_monitoring_plan": { "type": "array", "minItems": 2 },
    "holler_live_batch_plan": { "type": "array", "minItems": 1 },
    "pre_execution_checks": { "type": "array", "minItems": 4 },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canon_mutation",
        "runtime_mutation",
        "execution_authority",
        "actual_external_oracle_calls",
        "actual_live_data_ingestion",
        "persistent_production_runtime_activation",
        "mcp_exposure",
        "unreviewed_production_deployment",
        "autonomous_outcome_recording",
        "github_writeback",
        "notion_writeback"
      ],
      "properties": {
        "canon_mutation": { "const": false },
        "runtime_mutation": { "const": false },
        "execution_authority": { "const": true },
        "actual_external_oracle_calls": { "const": true },
        "actual_live_data_ingestion": { "const": true },
        "persistent_production_runtime_activation": { "const": true },
        "mcp_exposure": { "const": false },
        "unreviewed_production_deployment": { "const": false },
        "autonomous_outcome_recording": { "const": false },
        "github_writeback": { "const": false },
        "notion_writeback": { "const": false }
      }
    },
    "valid_for_external_oracle_calls": { "const": true },
    "valid_for_live_signal_ingestion": { "const": true },
    "valid_for_scheduler_queue_runtime": { "const": true },
    "valid_for_persistent_telemetry": { "const": true },
    "valid_for_mcp_exposure": { "const": false },
    "valid_for_unreviewed_production_deployment": { "const": false },
    "valid_for_autonomous_outcome_recording": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
