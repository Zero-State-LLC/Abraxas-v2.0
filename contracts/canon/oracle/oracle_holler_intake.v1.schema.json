{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_holler_intake.v1.schema.json",
  "title": "OracleHollerIntake.v1",
  "description": "Advisory HollerSports batch evolution schema under contracts/canon/oracle only. This does not mutate root canon files. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intake_id",
    "intake_status",
    "timestamp",
    "holler_batch",
    "shadow_replay",
    "version_metadata",
    "cross_references",
    "provenance",
    "authority_locks",
    "advisory_only",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleHollerIntake.v1" },
    "intake_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "intake_status": { "const": "HOLLERSPORTS_INTAKE_ADVISORY_EXTENSION_READY" },
    "timestamp": { "type": "string", "minLength": 1 },
    "holler_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "sport", "market_count", "calibration_policy", "adversarial_fixture_count"],
      "properties": {
        "batch_id": { "type": "string", "pattern": "^[A-Z0-9_\\-]+$" },
        "sport": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
        "market_count": { "type": "integer", "minimum": 0 },
        "calibration_policy": { "type": "string", "minLength": 1 },
        "adversarial_fixture_count": { "type": "integer", "minimum": 0 }
      }
    },
    "shadow_replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "valid_for_execution", "brier_score"],
      "properties": {
        "mode": { "const": "SHADOW_REPLAY_HARNESS_ONLY_NOT_EXECUTED" },
        "valid_for_execution": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "version_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_family", "schema_name", "schema_version", "registry_path", "brier_score"],
      "properties": {
        "schema_family": { "const": "oracle_signal_layer" },
        "schema_name": { "const": "oracle_holler_intake" },
        "schema_version": { "const": "v1" },
        "registry_path": { "const": "contracts/canon/oracle/oracle_schema_registry.v1.schema.json" },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "cross_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_schema", "signal_envelope_schema", "calibration_report_schema", "adversarial_fixture_schema"],
      "properties": {
        "registry_schema": { "const": "contracts/canon/oracle/oracle_schema_registry.v1.schema.json" },
        "signal_envelope_schema": { "const": "contracts/canon/oracle/oracle_signal_envelope.v1.schema.json" },
        "calibration_report_schema": { "const": "contracts/canon/oracle/oracle_calibration_report.v1.schema.json" },
        "adversarial_fixture_schema": { "const": "contracts/canon/oracle/oracle_adversarial_fixture.v1.schema.json" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "sprint_spine", "canon_extension_only", "root_canon_mutated", "brier_score"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "sprint_spine": { "type": "string", "minLength": 1 },
        "canon_extension_only": { "const": true },
        "root_canon_mutated": { "const": false },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "authority_locks": { "type": "object", "additionalProperties": { "const": false } },
    "advisory_only": { "const": true },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
