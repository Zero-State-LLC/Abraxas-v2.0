{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/oracle/oracle_holler_intake.v1.schema.json",
  "title": "OracleHollerIntake.v1",
  "description": "Advisory HollerSports batch evolution schema under contracts/canon/oracle only. This does not mutate root canon files. Brier Score: 0.10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intake_id",
    "intake_status",
    "timestamp",
    "holler_batch",
    "shadow_replay",
    "provenance",
    "authority_locks",
    "advisory_only",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "brier_score",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "OracleHollerIntake.v1" },
    "intake_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "intake_status": { "const": "HOLLERSPORTS_INTAKE_ADVISORY_EXTENSION_READY" },
    "timestamp": { "type": "string", "minLength": 1 },
    "holler_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "sport", "market_count", "calibration_policy", "adversarial_fixture_count"],
      "properties": {
        "batch_id": { "type": "string", "minLength": 1 },
        "sport": { "type": "string", "minLength": 1 },
        "market_count": { "type": "integer", "minimum": 0 },
        "calibration_policy": { "type": "string", "minLength": 1 },
        "adversarial_fixture_count": { "type": "integer", "minimum": 0 }
      }
    },
    "shadow_replay": { "type": "object" },
    "provenance": { "type": "object" },
    "authority_locks": { "type": "object", "additionalProperties": { "const": false } },
    "advisory_only": { "const": true },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "execution_authority": { "const": false },
    "brier_score": { "type": "number", "minimum": 0, "maximum": 2 },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
