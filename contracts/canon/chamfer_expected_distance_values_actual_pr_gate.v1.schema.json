{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/canon/chamfer_expected_distance_values_actual_pr_gate.v1.schema.json",
  "title": "ChamferExpectedDistanceValuesActualPRGate.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version","gate_id","gate_type","operator_id","source_fixture_manifest_refs","source_fixture_archive_receipt_refs","source_expected_distance_value_plan_refs","source_expected_distance_value_plan_archive_refs","source_fixture_file_refs","gate_scope","eligible_value_fixture_refs","null_locked_fixture_refs","expected_value_authorization_state","tolerance_authorization_state","value_creation_constraints","validation_plan","blocker_findings","output_contract","governance_flags","provenance","created_at_utc","canonical_hash"
  ],
  "properties": {
    "schema_version": {"const": "ChamferExpectedDistanceValuesActualPRGate.v1"},
    "gate_id": {"type": "string", "minLength": 1},
    "gate_type": {"const": "CHAMFER_EXPECTED_DISTANCE_VALUES_ACTUAL_PR_GATE"},
    "operator_id": {"const": "CHAMFER_DISTANCE"},
    "source_fixture_manifest_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"}},
    "source_fixture_archive_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"}},
    "source_expected_distance_value_plan_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"}},
    "source_expected_distance_value_plan_archive_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"}},
    "source_fixture_file_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.:/-]+$"}},
    "gate_scope": {"type": "object", "additionalProperties": false, "required": ["gate_family", "intended_lane", "gate_stage"], "properties": {"gate_family": {"enum": ["EXPECTED_DISTANCE_VALUE_ACTUAL_PR_GATE", "VALUE_ELIGIBILITY_REVIEW_GATE", "FIXTURE_VALUE_MAPPING_GATE"]}, "intended_lane": {"enum": ["SHADOW", "PROJECTION", "OBSERVATION_ONLY"]}, "gate_stage": {"enum": ["GATE_ONLY", "VALUES_HELD", "BLOCKED_PENDING_OPERATOR_REVIEW"]}}},
    "eligible_value_fixture_refs": {"type": "array", "minItems": 1},
    "null_locked_fixture_refs": {"type": "array", "minItems": 1},
    "expected_value_authorization_state": {"type": "object"},
    "tolerance_authorization_state": {"type": "object"},
    "value_creation_constraints": {"type": "object"},
    "validation_plan": {"type": "object"},
    "blocker_findings": {"type": "array", "minItems": 1},
    "output_contract": {"type": "object"},
    "governance_flags": {"type": "object"},
    "provenance": {"type": "object"},
    "created_at_utc": {"type": "string", "minLength": 1},
    "canonical_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
