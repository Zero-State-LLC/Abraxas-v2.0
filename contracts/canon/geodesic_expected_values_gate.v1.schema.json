{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "GeodesicExpectedValuesGate.v1",
    "description": "Expected-values gate for GEODESIC valid fixtures. EXPECTED_VALUES_GATE_ONLY: authorizes adding static expected_geodesic_distance to valid fixtures only. No metric emission, no computation, no forecast influence.",
    "type": "object",
    "required": [
        "schema_version",
        "gate_id",
        "operator_id",
        "gate_status",
        "gate_stage",
        "intended_lane",
        "source_fixture_plan_hash",
        "source_fixture_manifest_hash",
        "valid_fixture_review",
        "expected_value_authorization_scope",
        "invalid_fixture_exclusion_scope",
        "not_computable_fixture_exclusion_scope",
        "metric_emission_block",
        "forecast_influence_block",
        "p43_surface_lane_block",
        "blocked_scopes",
        "authority_locks",
        "recommended_next_step",
        "canonical_hash"
    ],
    "properties": {
        "schema_version": {"type": "string", "enum": ["GeodesicExpectedValuesGate.v1"]},
        "gate_id": {"type": "string"},
        "operator_id": {"type": "string", "enum": ["GEODESIC"]},
        "gate_status": {"type": "string", "enum": ["GEODESIC_EXPECTED_VALUES_GATE_READY"]},
        "gate_stage": {"type": "string", "enum": ["EXPECTED_VALUES_GATE_ONLY"]},
        "intended_lane": {"type": "string", "enum": ["SHADOW", "PROJECTION", "OBSERVATION_ONLY"]},
        "source_fixture_plan_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "source_fixture_manifest_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "valid_fixture_review": {"type": "object"},
        "expected_value_authorization_scope": {"type": "object"},
        "invalid_fixture_exclusion_scope": {"type": "object"},
        "not_computable_fixture_exclusion_scope": {"type": "object"},
        "metric_emission_block": {"type": "object"},
        "forecast_influence_block": {"type": "object"},
        "p43_surface_lane_block": {"type": "object"},
        "blocked_scopes": {"type": "object"},
        "authority_locks": {"type": "object"},
        "recommended_next_step": {"type": "string"},
        "canonical_hash": {"type": "string", "minLength": 64, "maxLength": 64}
    },
    "additionalProperties": false
}
