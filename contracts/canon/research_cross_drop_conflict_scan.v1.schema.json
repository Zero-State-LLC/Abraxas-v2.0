{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/research_cross_drop_conflict_scan.v1.schema.json",
  "title": "Research Cross-Drop Conflict Scan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lane_id",
    "artifact_type",
    "conflict_scan_status",
    "conflict_scan_ready",
    "conflict_findings",
    "conflict_summary",
    "missing_or_invalid_inputs",
    "provenance",
    "recommended_next_lane",
    "authority_locks",
    "packet_hash"
  ],
  "properties": {
    "lane_id": { "const": "P99_RESEARCH_CROSS_DROP_CONFLICT_SCAN" },
    "artifact_type": { "const": "ResearchCrossDropConflictScan.v1" },
    "conflict_scan_status": { "enum": ["PASS", "NOT_COMPUTABLE"] },
    "conflict_scan_ready": { "type": "boolean" },
    "conflict_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "compared_proof_ids",
          "compared_source_surface_ids",
          "compared_research_fold_families",
          "conflict_scan_scope",
          "checked_dimensions",
          "detected_conflicts",
          "blocking_conflict_detected",
          "status"
        ],
        "properties": {
          "finding_id": { "const": "DROP006_DROP007_CROSS_DROP_CONFLICT_SCAN" },
          "compared_proof_ids": { "type": "array", "items": { "type": "string" } },
          "compared_source_surface_ids": { "type": "array", "items": { "type": "string" } },
          "compared_research_fold_families": { "type": "array", "items": { "type": "string" } },
          "conflict_scan_scope": { "const": "advisory_cross_drop_conflict_scan_only" },
          "checked_dimensions": { "type": "array", "items": { "type": "string" } },
          "detected_conflicts": { "type": "array", "items": { "type": "string" } },
          "blocking_conflict_detected": { "const": false },
          "status": { "const": "PASS" }
        }
      }
    },
    "conflict_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scanned_drop_count", "conflict_count", "blocking_conflict_detected"],
      "properties": {
        "scanned_drop_count": { "type": "integer" },
        "conflict_count": { "type": "integer" },
        "blocking_conflict_detected": { "type": "boolean" }
      }
    },
    "missing_or_invalid_inputs": { "type": "array", "items": { "type": "string" } },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "upstream_lane_id", "expected_proof_ids", "deterministic_ordering"],
      "properties": {
        "source": { "const": "p98_research_shadow_stabilization_proof_plan" },
        "upstream_lane_id": { "const": "P98_RESEARCH_SHADOW_STABILIZATION_PROOF_PLAN" },
        "expected_proof_ids": { "type": "array", "items": { "type": "string" } },
        "deterministic_ordering": { "const": "finding_id_ascending" }
      }
    },
    "recommended_next_lane": { "type": "string" },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_only",
        "projection_only",
        "planning_only",
        "evidence_only",
        "scan_only",
        "shadow_only",
        "production_activation",
        "canon_promotion",
        "scheduler_mutation",
        "runtime_authority",
        "forecast_influence",
        "execution_authority",
        "repair_execution_authority",
        "regeneration_execution_authority",
        "token_minting_allowed",
        "valid_for_execution",
        "canonical_status"
      ],
      "properties": {
        "advisory_only": { "const": true },
        "projection_only": { "const": true },
        "planning_only": { "const": true },
        "evidence_only": { "const": true },
        "scan_only": { "const": true },
        "shadow_only": { "const": true },
        "production_activation": { "const": false },
        "canon_promotion": { "const": false },
        "scheduler_mutation": { "const": false },
        "runtime_authority": { "const": false },
        "forecast_influence": { "const": false },
        "execution_authority": { "const": false },
        "repair_execution_authority": { "const": false },
        "regeneration_execution_authority": { "const": false },
        "token_minting_allowed": { "const": false },
        "valid_for_execution": { "const": false },
        "canonical_status": { "const": "ADVISORY_ONLY" }
      }
    },
    "packet_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
