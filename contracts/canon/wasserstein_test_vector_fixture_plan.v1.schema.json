{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WassersteinTestVectorFixturePlan.v1",
  "description": "SHADOW-lane fixture plan for Wasserstein test vector fixtures. Defines fixture cases for all 14 schema groups (5 valid, 5 invalid, 4 not-computable). No fixture files generated; no Wasserstein computation authorized.",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_plan_id",
    "fixture_plan_type",
    "operator_id",
    "source_schema_plan_hash",
    "intended_lane",
    "fixture_stage",
    "valid_fixture_plan",
    "invalid_fixture_plan",
    "not_computable_fixture_plan",
    "determinism_requirements",
    "numerical_policy_requirements",
    "blocked_scopes",
    "authority_locks",
    "recommended_next_step",
    "provenance",
    "created_at_utc",
    "canonical_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "WassersteinTestVectorFixturePlan.v1" },
    "fixture_plan_id": { "type": "string" },
    "fixture_plan_type": { "type": "string", "const": "WASSERSTEIN_TEST_VECTOR_FIXTURE_PLAN" },
    "operator_id": { "type": "string", "const": "WASSERSTEIN" },
    "source_schema_plan_hash": { "type": "string" },
    "intended_lane": { "type": "string", "enum": ["SHADOW", "PROJECTION", "OBSERVATION_ONLY"] },
    "fixture_stage": { "type": "string", "enum": ["FIXTURE_PLAN_ONLY", "BLOCKED_PENDING_OPERATOR_REVIEW"] },
    "valid_fixture_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fixture_plan_id", "schema_group_id", "schema_type", "fixture_stage", "description", "planned_inputs", "blocked_outputs", "implementation_status"],
        "additionalProperties": true,
        "properties": {
          "fixture_plan_id": { "type": "string" },
          "schema_group_id": { "type": "string", "enum": ["valid-001", "valid-002", "valid-003", "valid-004", "valid-005"] },
          "schema_type": { "type": "string", "enum": ["DISTRIBUTION_PAIR_SCHEMA", "WEIGHTED_HISTOGRAM_SCHEMA", "REFERENCE_VECTOR_SCHEMA", "GROUND_METRIC_SCHEMA", "DEGENERATE_DISTRIBUTION_SCHEMA"] },
          "fixture_stage": { "type": "string", "enum": ["FIXTURE_PLAN_ONLY", "BLOCKED_PENDING_OPERATOR_REVIEW"] },
          "description": { "type": "string" },
          "planned_inputs": { "type": "object" },
          "blocked_outputs": { "type": "array", "items": { "type": "string" } },
          "implementation_status": { "type": "string", "enum": ["PLANNED_ONLY", "NOT_IMPLEMENTED", "BLOCKED_PENDING_REVIEW"] }
        }
      }
    },
    "invalid_fixture_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fixture_plan_id", "schema_group_id", "invalid_reason", "target_field", "expected_failure", "fixture_stage", "description", "blocked_outputs", "implementation_status"],
        "additionalProperties": true,
        "properties": {
          "fixture_plan_id": { "type": "string" },
          "schema_group_id": { "type": "string", "enum": ["invalid-001", "invalid-002", "invalid-003", "invalid-004", "invalid-005"] },
          "invalid_reason": { "type": "string", "enum": ["MISSING_REQUIRED_FIELD", "EMPTY_DISTRIBUTION", "INVALID_WEIGHT_SUM", "DIMENSION_MISMATCH", "GROUND_METRIC_UNDECLARED"] },
          "target_field": { "type": "string" },
          "expected_failure": { "type": "string" },
          "fixture_stage": { "type": "string", "enum": ["FIXTURE_PLAN_ONLY", "BLOCKED_PENDING_OPERATOR_REVIEW"] },
          "description": { "type": "string" },
          "blocked_outputs": { "type": "array", "items": { "type": "string" } },
          "implementation_status": { "type": "string", "enum": ["PLANNED_ONLY", "NOT_IMPLEMENTED", "BLOCKED_PENDING_REVIEW"] }
        }
      }
    },
    "not_computable_fixture_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fixture_plan_id", "schema_group_id", "not_computable_reason", "expected_state", "fixture_stage", "description", "blocked_outputs", "implementation_status"],
        "additionalProperties": true,
        "properties": {
          "fixture_plan_id": { "type": "string" },
          "schema_group_id": { "type": "string", "enum": ["nc-001", "nc-002", "nc-003", "nc-004"] },
          "not_computable_reason": { "type": "string", "enum": ["EMPTY_INPUT", "GROUND_METRIC_UNDECLARED", "NUMERICAL_POLICY_MISSING", "DIMENSIONALITY_UNDECLARED"] },
          "expected_state": { "type": "string", "enum": ["NOT_COMPUTABLE", "REJECTED_INPUT", "VALIDATION_ERROR"] },
          "fixture_stage": { "type": "string", "enum": ["FIXTURE_PLAN_ONLY", "BLOCKED_PENDING_OPERATOR_REVIEW"] },
          "description": { "type": "string" },
          "blocked_outputs": { "type": "array", "items": { "type": "string" } },
          "implementation_status": { "type": "string", "enum": ["PLANNED_ONLY", "NOT_IMPLEMENTED", "BLOCKED_PENDING_REVIEW"] }
        }
      }
    },
    "determinism_requirements": {
      "type": "object",
      "required": ["sort_by_fixture_id", "stable_serialization_required", "canonical_hash_required", "nondeterministic_ordering_allowed", "replay_stable", "blocked_outputs_sorted"],
      "additionalProperties": false,
      "properties": {
        "sort_by_fixture_id": { "type": "boolean", "const": true },
        "stable_serialization_required": { "type": "boolean", "const": true },
        "canonical_hash_required": { "type": "boolean", "const": true },
        "nondeterministic_ordering_allowed": { "type": "boolean", "const": false },
        "replay_stable": { "type": "boolean", "const": true },
        "blocked_outputs_sorted": { "type": "boolean", "const": true }
      }
    },
    "numerical_policy_requirements": {
      "type": "object",
      "required": ["float_precision", "weight_sum_tolerance", "policy_declared", "policy_enforced_at_fixture_validation", "metric_value_computation_allowed"],
      "additionalProperties": false,
      "properties": {
        "float_precision": { "type": "string", "const": "float64" },
        "weight_sum_tolerance": { "type": "string", "const": "1e-9" },
        "policy_declared": { "type": "boolean", "const": true },
        "policy_enforced_at_fixture_validation": { "type": "boolean", "const": false },
        "metric_value_computation_allowed": { "type": "boolean", "const": false }
      }
    },
    "blocked_scopes": {
      "type": "object",
      "required": ["fixture_files_generated", "wasserstein_computation", "emits_metric_values", "expected_wasserstein_distances_added", "forecast_influence", "p43_surface_lanes", "production_activation", "canon_promotion", "runtime_mutation", "execution_authority", "inference_authority"],
      "additionalProperties": false,
      "properties": {
        "fixture_files_generated": { "type": "boolean", "const": false },
        "wasserstein_computation": { "type": "boolean", "const": false },
        "emits_metric_values": { "type": "boolean", "const": false },
        "expected_wasserstein_distances_added": { "type": "boolean", "const": false },
        "forecast_influence": { "type": "boolean", "const": false },
        "p43_surface_lanes": { "type": "boolean", "const": false },
        "production_activation": { "type": "boolean", "const": false },
        "canon_promotion": { "type": "boolean", "const": false },
        "runtime_mutation": { "type": "boolean", "const": false },
        "execution_authority": { "type": "boolean", "const": false },
        "inference_authority": { "type": "boolean", "const": false }
      }
    },
    "authority_locks": {
      "type": "object",
      "required": ["advisory_only", "shadow_lane_only", "fixture_plan_only", "fixture_files_generated", "wasserstein_computation_authorized", "emits_metric_values", "expected_wasserstein_distances_added", "forecast_influence", "p43_surface_lanes_authorized", "production_activation", "canon_promotion", "runtime_mutation", "execution_authority", "inference_authority"],
      "additionalProperties": false,
      "properties": {
        "advisory_only": { "type": "boolean", "const": true },
        "shadow_lane_only": { "type": "boolean", "const": true },
        "fixture_plan_only": { "type": "boolean", "const": true },
        "fixture_files_generated": { "type": "boolean", "const": false },
        "wasserstein_computation_authorized": { "type": "boolean", "const": false },
        "emits_metric_values": { "type": "boolean", "const": false },
        "expected_wasserstein_distances_added": { "type": "boolean", "const": false },
        "forecast_influence": { "type": "boolean", "const": false },
        "p43_surface_lanes_authorized": { "type": "boolean", "const": false },
        "production_activation": { "type": "boolean", "const": false },
        "canon_promotion": { "type": "boolean", "const": false },
        "runtime_mutation": { "type": "boolean", "const": false },
        "execution_authority": { "type": "boolean", "const": false },
        "inference_authority": { "type": "boolean", "const": false }
      }
    },
    "recommended_next_step": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["source", "evidence_refs", "generated_by", "upstream_schema_refs"],
      "additionalProperties": true,
      "properties": {
        "source": { "type": "string" },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "generated_by": { "type": "string" },
        "upstream_schema_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "created_at_utc": { "type": "string" },
    "canonical_hash": { "type": "string" }
  }
}
