{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/abx_codegen_intelligence_spine_phase1_code_detail_plan.v1.schema.json",
  "title": "ABX Codegen Intelligence Spine Phase 1 Code Detail Plan",
  "type": "object",
  "required": [
    "artifact_type",
    "plan_id",
    "phase1_code_detail_plan_status",
    "source_notion_spec",
    "source_harness_implementation_roadmap_plan",
    "target_file",
    "planned_interfaces",
    "draft_receipt_fields",
    "draft_recommendation_values",
    "phase1_next_steps",
    "implementation_blockers",
    "recommended_next_lane",
    "safe_to_auto_continue",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "execution_authority",
    "valid_for_execution",
    "valid_for_implementation",
    "authority_locks",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {
      "const": "AbxCodegenIntelligenceSpinePhase1CodeDetailPlan.v1"
    },
    "plan_id": {
      "const": "ABX_CODEGEN_INTELLIGENCE_SPINE_PHASE1_CODE_DETAIL_PLAN_001"
    },
    "phase1_code_detail_plan_status": {
      "enum": [
        "ABX_CODEGEN_PHASE1_CODE_DETAIL_PLAN_HELD_FOR_OPERATOR",
        "NOT_COMPUTABLE"
      ]
    },
    "source_notion_spec": {"type": "object"},
    "source_harness_implementation_roadmap_plan": {"type": "object"},
    "target_file": {"const": "core/codegen_shadow_replay_harness.py"},
    "planned_interfaces": {
      "type": "array",
      "items": {"type": "object"}
    },
    "draft_receipt_fields": {
      "type": "array",
      "items": {"type": "object"}
    },
    "draft_recommendation_values": {
      "type": "array",
      "items": {"type": "object"}
    },
    "phase1_next_steps": {
      "type": "array",
      "items": {"type": "object"}
    },
    "implementation_blockers": {
      "type": "array",
      "items": {"type": "string"}
    },
    "recommended_next_lane": {"const": "NOT_COMPUTABLE"},
    "safe_to_auto_continue": {"const": false},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "non_authoritative": {"const": true},
    "execution_authority": {"const": false},
    "valid_for_execution": {"const": false},
    "valid_for_implementation": {"const": false},
    "authority_locks": {
      "type": "object",
      "additionalProperties": {"const": false}
    },
    "packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
