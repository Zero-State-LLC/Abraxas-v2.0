{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "GeodesicComputationImplementationGate.v1",
    "description": "Gate artifact reviewing the GEODESIC computation implementation plan and explicitly authorizing bounded SHADOW test-vector computation code implementation. geodesic_computation_implementation_authorized=true. No metric emission, no forecast influence.",
    "type": "object",
    "required": [
        "schema_version",
        "gate_id",
        "operator_id",
        "gate_status",
        "gate_stage",
        "intended_lane",
        "source_implementation_plan_hash",
        "source_operator_decision_hash",
        "source_computation_authorization_review_hash",
        "implementation_plan_review",
        "authorized_implementation_scope",
        "valid_fixture_scope",
        "rejection_fixture_scope",
        "no_metric_emission_block",
        "no_forecast_influence_block",
        "no_p43_surface_lane_block",
        "blocked_scopes",
        "authority_locks",
        "recommended_next_step",
        "canonical_hash"
    ],
    "properties": {
        "schema_version": {"type": "string", "enum": ["GeodesicComputationImplementationGate.v1"]},
        "gate_id": {"type": "string"},
        "operator_id": {"type": "string", "enum": ["GEODESIC"]},
        "gate_status": {"type": "string", "enum": ["GEODESIC_COMPUTATION_IMPLEMENTATION_GATE_READY"]},
        "gate_stage": {"type": "string", "enum": ["COMPUTATION_IMPLEMENTATION_GATE_ONLY"]},
        "intended_lane": {"type": "string", "enum": ["SHADOW", "PROJECTION", "OBSERVATION_ONLY"]},
        "source_implementation_plan_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "source_operator_decision_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "source_computation_authorization_review_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "implementation_plan_review": {"type": "object"},
        "authorized_implementation_scope": {"type": "object"},
        "valid_fixture_scope": {"type": "object"},
        "rejection_fixture_scope": {"type": "object"},
        "no_metric_emission_block": {"type": "object"},
        "no_forecast_influence_block": {"type": "object"},
        "no_p43_surface_lane_block": {"type": "object"},
        "blocked_scopes": {"type": "object"},
        "authority_locks": {"type": "object"},
        "recommended_next_step": {"type": "string"},
        "canonical_hash": {"type": "string", "minLength": 64, "maxLength": 64}
    },
    "additionalProperties": false
}
