{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/research_fold_validation_plan.v1.schema.json",
  "title": "Research Fold Validation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lane_id",
    "artifact_type",
    "validation_plan_status",
    "validation_plan_ready",
    "validation_records",
    "missing_or_invalid_inputs",
    "provenance",
    "recommended_next_lane",
    "authority_locks",
    "packet_hash"
  ],
  "properties": {
    "lane_id": { "const": "P96_RESEARCH_FOLD_VALIDATION_PLAN" },
    "artifact_type": { "const": "ResearchFoldValidationPlan.v1" },
    "validation_plan_status": { "enum": ["PASS", "NOT_COMPUTABLE"] },
    "validation_plan_ready": { "type": "boolean" },
    "validation_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "validation_id",
          "spec_id",
          "source_surface_id",
          "research_fold_family",
          "validation_scope",
          "required_checks",
          "expected_evidence",
          "status"
        ],
        "properties": {
          "validation_id": { "type": "string" },
          "spec_id": { "type": "string" },
          "source_surface_id": { "type": "string" },
          "research_fold_family": { "type": "string" },
          "validation_scope": { "const": "advisory_research_fold_validation_only" },
          "required_checks": { "type": "array", "items": { "type": "string" } },
          "expected_evidence": { "type": "array", "items": { "type": "string" } },
          "status": { "const": "PLANNED" }
        }
      }
    },
    "missing_or_invalid_inputs": { "type": "array", "items": { "type": "string" } },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "upstream_lane_id", "expected_built_specs", "deterministic_ordering"],
      "properties": {
        "source": { "const": "p95_research_fold_drop_spec_builder" },
        "upstream_lane_id": { "const": "P95_RESEARCH_FOLD_DROP_SPEC_BUILDER" },
        "expected_built_specs": { "type": "array", "items": { "type": "string" } },
        "deterministic_ordering": { "const": "validation_id_ascending" }
      }
    },
    "recommended_next_lane": { "type": "string" },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_only",
        "projection_only",
        "planning_only",
        "evidence_only",
        "validation_only",
        "production_activation",
        "canon_promotion",
        "scheduler_mutation",
        "runtime_authority",
        "forecast_influence",
        "execution_authority",
        "repair_execution_authority",
        "regeneration_execution_authority",
        "token_minting_allowed",
        "valid_for_execution",
        "canonical_status"
      ],
      "properties": {
        "advisory_only": { "const": true },
        "projection_only": { "const": true },
        "planning_only": { "const": true },
        "evidence_only": { "const": true },
        "validation_only": { "const": true },
        "production_activation": { "const": false },
        "canon_promotion": { "const": false },
        "scheduler_mutation": { "const": false },
        "runtime_authority": { "const": false },
        "forecast_influence": { "const": false },
        "execution_authority": { "const": false },
        "repair_execution_authority": { "const": false },
        "regeneration_execution_authority": { "const": false },
        "token_minting_allowed": { "const": false },
        "valid_for_execution": { "const": false },
        "canonical_status": { "const": "ADVISORY_ONLY" }
      }
    },
    "packet_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
