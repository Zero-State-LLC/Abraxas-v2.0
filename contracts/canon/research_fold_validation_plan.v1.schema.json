{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/research_fold_validation_plan.v1.schema.json",
  "title": "Research Fold Validation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "canonical_status",
    "advisory_only",
    "projection_only",
    "lane_id",
    "status",
    "upstream_lane_id",
    "upstream_drop_spec_status",
    "fixture_plan",
    "positive_proof_packet_plan",
    "negative_failure_proof_packet_plan",
    "operator_review_requirements",
    "aal_viz_projection_constraints",
    "authority_locks",
    "recommended_next_lane",
    "recommended_next_lane_reason",
    "not_computable_reasons",
    "provenance",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {"const": "ResearchFoldValidationPlan.v1"},
    "canonical_status": {"const": "ADVISORY_ONLY"},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "lane_id": {"const": "P96_RESEARCH_FOLD_VALIDATION_PLAN"},
    "status": {"enum": ["PASS", "NOT_COMPUTABLE"]},
    "upstream_lane_id": {"const": "P95_RESEARCH_FOLD_DROP_SPEC_BUILDER"},
    "upstream_drop_spec_status": {"type": ["string", "null"]},
    "fixture_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["drop_id", "fixture_targets"],
        "properties": {
          "drop_id": {"enum": ["DROP006", "DROP007"]},
          "fixture_targets": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "positive_proof_packet_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic_source_candidate_ordering",
        "canon_shadow_target_mapping",
        "authority_locks_remain_false",
        "advisory_only_posture_preserved",
        "aal_viz_projection_only_posture_preserved",
        "next_state"
      ],
      "properties": {
        "deterministic_source_candidate_ordering": {"type": "string"},
        "canon_shadow_target_mapping": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["drop_id", "spec_ids", "canon_shadow_target"],
            "properties": {
              "drop_id": {"enum": ["DROP006", "DROP007"]},
              "spec_ids": {
                "type": "array",
                "items": {"type": "string"}
              },
              "canon_shadow_target": {"type": "string"}
            }
          }
        },
        "authority_locks_remain_false": {"const": true},
        "advisory_only_posture_preserved": {"const": true},
        "aal_viz_projection_only_posture_preserved": {"const": true},
        "next_state": {"const": "VALIDATION_PLANNING_ONLY"}
      }
    },
    "negative_failure_proof_packet_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rejected_conditions"],
      "properties": {
        "rejected_conditions": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "operator_review_requirements": {
      "type": "array",
      "items": {"type": "string"}
    },
    "aal_viz_projection_constraints": {
      "type": "array",
      "items": {"type": "string"}
    },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_activation",
        "canon_promotion",
        "runtime_mutation",
        "forecast_influence",
        "forecast_weight_allowed",
        "shadow_to_forecast_leakage",
        "scheduler_mutation",
        "autonomous_execution",
        "operator_bypass",
        "hidden_intent_claim_authority"
      ],
      "properties": {
        "production_activation": {"const": false},
        "canon_promotion": {"const": false},
        "runtime_mutation": {"const": false},
        "forecast_influence": {"const": false},
        "forecast_weight_allowed": {"const": false},
        "shadow_to_forecast_leakage": {"const": false},
        "scheduler_mutation": {"const": false},
        "autonomous_execution": {"const": false},
        "operator_bypass": {"const": false},
        "hidden_intent_claim_authority": {"const": false}
      }
    },
    "recommended_next_lane": {"type": "string"},
    "recommended_next_lane_reason": {"type": "string"},
    "not_computable_reasons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "mapping_method",
        "drop_order",
        "fixture_ordering",
        "p95_status",
        "p95_artifact_type",
        "gated_recommendation_rule"
      ],
      "properties": {
        "source": {"type": "string"},
        "mapping_method": {"type": "string"},
        "drop_order": {"type": "array", "items": {"type": "string"}},
        "fixture_ordering": {"type": "string"},
        "p95_status": {"type": ["string", "null"]},
        "p95_artifact_type": {"type": ["string", "null"]},
        "gated_recommendation_rule": {"type": "string"}
      }
    },
    "packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
