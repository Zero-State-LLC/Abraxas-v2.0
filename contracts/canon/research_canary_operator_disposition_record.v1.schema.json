{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "contracts/canon/research_canary_operator_disposition_record.v1.schema.json",
    "title": "Research Canary Operator Disposition Record v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "lane_id",
        "artifact_type",
        "status",
        "lane_status",
        "upstream_lane_id",
        "upstream_artifact_type",
        "upstream_packet_hash",
        "disposition_batch_id",
        "operator_id",
        "dispositioned_candidates",
        "disposition_records",
        "missing_or_invalid_inputs",
        "authority_locks",
        "governance_posture",
        "advisory_only",
        "projection_only",
        "p131_created",
        "activation_approved",
        "authorization_granted",
        "production_activation",
        "canon_promotion",
        "scheduler_mutation",
        "baseline_mutation",
        "runtime_mutation",
        "queue_mutation",
        "governance_authority_mutation",
        "authority_change",
        "b002_status",
        "recommended_next_lane",
        "packet_hash"
    ],
    "properties": {
        "lane_id": {"const": "RESEARCH_CANARY_OPERATOR_DISPOSITION_RECORD"},
        "artifact_type": {"const": "ResearchCanaryOperatorDispositionRecord.v1"},
        "status": {
            "enum": [
                "RESEARCH_CANARY_OPERATOR_DISPOSITION_RECORD_READY",
                "NOT_COMPUTABLE",
                "REJECTED_AUTHORITY_DRIFT"
            ]
        },
        "lane_status": {
            "enum": [
                "OPERATOR_DISPOSITION_RECORD_EMITTED",
                "NOT_COMPUTABLE",
                "REJECTED_AUTHORITY_DRIFT"
            ]
        },
        "upstream_lane_id": {
            "const": "P130_RESEARCH_CANARY_FINAL_ACTIVATION_AUTHORIZATION_REVIEW_HOLD"
        },
        "upstream_artifact_type": {
            "const": "ResearchCanaryFinalActivationAuthorizationReviewHold.v1"
        },
        "upstream_packet_hash": {"type": ["string", "null"]},
        "disposition_batch_id": {"type": ["string", "null"]},
        "operator_id": {"type": ["string", "null"]},
        "disposition_scope": {"type": "string"},
        "disposition_mode": {"type": "string"},
        "dispositioned_candidates": {
            "type": "array",
            "items": {"type": "string"}
        },
        "disposition_records": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "candidate_id",
                    "disposition",
                    "disposition_status",
                    "rationale",
                    "activation_approved",
                    "authorization_granted",
                    "production_activation",
                    "valid_for_execution",
                    "canon_promotion",
                    "scheduler_mutation"
                ],
                "properties": {
                    "candidate_id": {"type": "string"},
                    "disposition": {
                        "enum": [
                            "defer_hold_indefinitely",
                            "deny_activation_path",
                            "request_further_evidence"
                        ]
                    },
                    "disposition_status": {
                        "enum": [
                            "HOLD_DEFERRED_INDEFINITELY",
                            "ACTIVATION_PATH_DENIED",
                            "FURTHER_EVIDENCE_REQUESTED"
                        ]
                    },
                    "rationale": {"type": "string"},
                    "activation_approved": {"const": false},
                    "authorization_granted": {"const": false},
                    "production_activation": {"const": false},
                    "valid_for_execution": {"const": false},
                    "canon_promotion": {"const": false},
                    "scheduler_mutation": {"const": false}
                }
            }
        },
        "missing_or_invalid_inputs": {
            "type": "array",
            "items": {"type": "string"}
        },
        "authority_locks": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "production_activation",
                "execution_authority",
                "runtime_authority",
                "scheduler_mutation",
                "canon_promotion",
                "forecast_influence",
                "repair_execution_authority",
                "regeneration_execution_authority",
                "token_minting_allowed",
                "valid_for_execution",
                "activation_approved",
                "authorization_granted"
            ],
            "properties": {
                "production_activation": {"const": false},
                "execution_authority": {"const": false},
                "runtime_authority": {"const": false},
                "scheduler_mutation": {"const": false},
                "canon_promotion": {"const": false},
                "forecast_influence": {"const": false},
                "repair_execution_authority": {"const": false},
                "regeneration_execution_authority": {"const": false},
                "token_minting_allowed": {"const": false},
                "valid_for_execution": {"const": false},
                "activation_approved": {"const": false},
                "authorization_granted": {"const": false}
            }
        },
        "governance_posture": {"const": "ADVISORY_ONLY"},
        "advisory_only": {"const": true},
        "projection_only": {"const": true},
        "p131_created": {"const": false},
        "activation_approved": {"const": false},
        "authorization_granted": {"const": false},
        "production_activation": {"const": false},
        "canon_promotion": {"const": false},
        "scheduler_mutation": {"const": false},
        "baseline_mutation": {"const": false},
        "runtime_mutation": {"const": false},
        "queue_mutation": {"const": false},
        "governance_authority_mutation": {"const": false},
        "authority_change": {"const": "none"},
        "b002_status": {
            "enum": [
                "RESOLVED_BY_OPERATOR_DEFER_ALL",
                "RESOLVED_BY_OPERATOR_MIXED_DISPOSITION",
                "NOT_COMPUTABLE"
            ]
        },
        "recommended_next_lane": {
            "enum": [
                "OPERATOR_DISPOSITION_COMPLETE_ADVISORY_HOLD_CLOSED",
                "NOT_COMPUTABLE"
            ]
        },
        "packet_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        }
    }
}
