{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "GeodesicComputationOperatorClosure.v1",
    "description": "Operator closure artifact formally closing the GEODESIC computation phase. Confirms all 13 fixture outcomes are correct, SHADOW-only posture held, and computation phase is complete. No metric emission. No forecast influence.",
    "type": "object",
    "required": [
        "schema_version",
        "closure_id",
        "operator_id",
        "closure_status",
        "closure_stage",
        "intended_lane",
        "source_complete_review_hash",
        "source_computation_receipt_hash",
        "source_implementation_gate_hash",
        "source_implementation_plan_hash",
        "phase_completion_review",
        "valid_fixture_result_closure",
        "rejection_fixture_closure",
        "authority_lock_closure",
        "blocked_scopes",
        "authority_locks",
        "recommended_next_step",
        "canonical_hash"
    ],
    "properties": {
        "schema_version": {"type": "string", "enum": ["GeodesicComputationOperatorClosure.v1"]},
        "closure_id": {"type": "string"},
        "operator_id": {"type": "string", "enum": ["GEODESIC"]},
        "closure_status": {"type": "string", "enum": ["GEODESIC_COMPUTATION_OPERATOR_CLOSURE_COMPLETE"]},
        "closure_stage": {"type": "string", "enum": ["COMPUTATION_OPERATOR_CLOSURE_ONLY"]},
        "intended_lane": {"type": "string", "enum": ["SHADOW"]},
        "source_complete_review_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "source_computation_receipt_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "source_implementation_gate_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "source_implementation_plan_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "phase_completion_review": {"type": "object"},
        "valid_fixture_result_closure": {"type": "object"},
        "rejection_fixture_closure": {"type": "object"},
        "authority_lock_closure": {"type": "object"},
        "blocked_scopes": {"type": "object"},
        "authority_locks": {"type": "object"},
        "recommended_next_step": {"type": "string"},
        "canonical_hash": {"type": "string", "minLength": 64, "maxLength": 64}
    },
    "additionalProperties": false
}
