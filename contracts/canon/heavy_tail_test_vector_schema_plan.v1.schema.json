{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/canon/heavy_tail_test_vector_schema_plan.v1.schema.json",
  "title": "HeavyTailTestVectorSchemaPlan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version","plan_id","plan_type","plan_status","operator_id",
    "source_authorization_binding","schema_field_definition","parameter_bound_policy",
    "valid_fixture_schema_groups","invalid_fixture_schema_groups","not_computable_schema_groups",
    "closed_form_derivation_policy","fixture_corpus_strategy",
    "authority_lock_review","blocked_scope_review","recommended_next_step",
    "provenance","created_at_utc","canonical_hash"
  ],
  "properties": {
    "schema_version": {"const": "HeavyTailTestVectorSchemaPlan.v1"},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_type": {"const": "HEAVY_TAIL_TEST_VECTOR_SCHEMA_PLAN"},
    "plan_status": {"const": "HEAVY_TAIL_TEST_VECTOR_SCHEMA_PLAN_COMPLETE"},
    "operator_id": {"const": "HEAVY_TAIL"},
    "source_authorization_binding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["authorization_artifact_id","authorization_canonical_hash","hash_confirmed"],
      "properties": {
        "authorization_artifact_id": {"type": "string", "minLength": 1},
        "authorization_canonical_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hash_confirmed": {"const": true}
      }
    },
    "schema_field_definition": {"type": "object", "additionalProperties": true, "minProperties": 1},
    "parameter_bound_policy": {"type": "object", "additionalProperties": true, "minProperties": 1},
    "valid_fixture_schema_groups": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["group_id","group_label","description","expected_input_contract","blocked_operations","implementation_status"],
        "properties": {
          "group_id": {"type": "string", "minLength": 1},
          "group_label": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "expected_input_contract": {"type": "object", "additionalProperties": true},
          "blocked_operations": {"type": "array", "items": {"type": "string"}},
          "implementation_status": {"enum": ["PLANNED_ONLY","NOT_IMPLEMENTED","BLOCKED_PENDING_REVIEW"]}
        }
      }
    },
    "invalid_fixture_schema_groups": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["group_id","group_label","invalid_reason","target_field","expected_failure","implementation_status"],
        "properties": {
          "group_id": {"type": "string", "minLength": 1},
          "group_label": {"type": "string", "minLength": 1},
          "invalid_reason": {"type": "string", "minLength": 1},
          "target_field": {"type": "string", "minLength": 1},
          "expected_failure": {"type": "string", "minLength": 1},
          "implementation_status": {"enum": ["PLANNED_ONLY","NOT_IMPLEMENTED","BLOCKED_PENDING_REVIEW"]}
        }
      }
    },
    "not_computable_schema_groups": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["group_id","group_label","not_computable_reason","description","expected_state","implementation_status"],
        "properties": {
          "group_id": {"type": "string", "minLength": 1},
          "group_label": {"type": "string", "minLength": 1},
          "not_computable_reason": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "expected_state": {"const": "NOT_COMPUTABLE"},
          "implementation_status": {"enum": ["PLANNED_ONLY","NOT_IMPLEMENTED","BLOCKED_PENDING_REVIEW"]}
        }
      }
    },
    "closed_form_derivation_policy": {"type": "object", "additionalProperties": true, "minProperties": 1},
    "fixture_corpus_strategy": {"type": "object", "additionalProperties": true, "minProperties": 1},
    "authority_lock_review": {
      "type": "object", "additionalProperties": false,
      "required": [
        "advisory_only","shadow_lane_only","schema_plan_only","heavy_tail_schema_defined",
        "fixture_files_created","computation_executed","baseline_pack_updated",
        "emits_metric_values","forecast_influence","p43_surface_lanes_authorized",
        "production_activation","canon_promotion","runtime_mutation",
        "execution_authority","inference_authority"
      ],
      "properties": {
        "advisory_only": {"const": true},
        "shadow_lane_only": {"const": true},
        "schema_plan_only": {"const": true},
        "heavy_tail_schema_defined": {"const": true},
        "fixture_files_created": {"const": false},
        "computation_executed": {"const": false},
        "baseline_pack_updated": {"const": false},
        "emits_metric_values": {"const": false},
        "forecast_influence": {"const": false},
        "p43_surface_lanes_authorized": {"const": false},
        "production_activation": {"const": false},
        "canon_promotion": {"const": false},
        "runtime_mutation": {"const": false},
        "execution_authority": {"const": false},
        "inference_authority": {"const": false}
      }
    },
    "blocked_scope_review": {"type": "object", "additionalProperties": true, "minProperties": 1},
    "recommended_next_step": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object", "additionalProperties": true,
      "required": ["source","evidence_refs","generated_by","upstream_schema_refs"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "generated_by": {"type": "string", "minLength": 1},
        "upstream_schema_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "created_at_utc": {"type": "string", "minLength": 1},
    "canonical_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
