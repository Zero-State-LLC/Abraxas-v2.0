{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/abx_codegen_intelligence_spine_testing_validation_strategy_plan.v1.schema.json",
  "title": "ABX Codegen Intelligence Spine Testing Validation Strategy Plan",
  "type": "object",
  "required": [
    "artifact_type",
    "plan_id",
    "testing_validation_strategy_plan_status",
    "source_notion_spec",
    "source_failure_taxonomy_plan",
    "testing_layers",
    "recommended_test_structure",
    "golden_fixture_strategy",
    "continuous_validation",
    "recommended_next_lane",
    "safe_to_auto_continue",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "execution_authority",
    "valid_for_execution",
    "valid_for_implementation",
    "authority_locks",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {
      "const": "AbxCodegenIntelligenceSpineTestingValidationStrategyPlan.v1"
    },
    "plan_id": {
      "const": "ABX_CODEGEN_INTELLIGENCE_SPINE_TESTING_VALIDATION_STRATEGY_PLAN_001"
    },
    "testing_validation_strategy_plan_status": {
      "enum": [
        "ABX_CODEGEN_TESTING_VALIDATION_STRATEGY_PLAN_READY",
        "NOT_COMPUTABLE"
      ]
    },
    "source_notion_spec": {"type": "object"},
    "source_failure_taxonomy_plan": {"type": "object"},
    "testing_layers": {
      "type": "array",
      "items": {"type": "object"}
    },
    "recommended_test_structure": {"type": "object"},
    "golden_fixture_strategy": {"type": "object"},
    "continuous_validation": {"type": "object"},
    "recommended_next_lane": {"const": "NOT_COMPUTABLE"},
    "safe_to_auto_continue": {"const": false},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "non_authoritative": {"const": true},
    "execution_authority": {"const": false},
    "valid_for_execution": {"const": false},
    "valid_for_implementation": {"const": false},
    "authority_locks": {
      "type": "object",
      "additionalProperties": {"const": false}
    },
    "packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
