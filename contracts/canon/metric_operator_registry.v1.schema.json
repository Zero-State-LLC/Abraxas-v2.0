{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/metric_operator_registry.v1.schema.json",
  "title": "Metric Operator Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "registry_type",
    "operators",
    "governance_flags",
    "provenance",
    "created_at_utc",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": {"const": "MetricOperatorRegistry.v1"},
    "registry_id": {"type": "string", "minLength": 1},
    "registry_type": {"const": "METRIC_OPERATOR_REGISTRY"},
    "operators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operator_id", "operator_name", "operator_family", "description", "allowed_domains",
          "input_shape_descriptor", "output_descriptor", "computation_status", "shadow_only",
          "allowed_architecture_targets", "required_evidence", "risk_notes", "implementation_status"
        ],
        "properties": {
          "operator_id": {"enum": ["WASSERSTEIN","CHAMFER","GEODESIC","NORM_GEOMETRY","TRANSPORT","HYPERVECTOR_BINDING","RESERVOIR_STATE_SPACE","COUNTERFACTUAL_DIFFUSION","HEAVY_TAIL","HYSTERESIS","STOCHASTIC_GEOMETRY","TOPOLOGICAL_PRIMITIVES"]},
          "operator_name": {"type": "string", "minLength": 1},
          "operator_family": {"enum": ["TRANSPORT_METRIC","SPATIAL_ALIGNMENT","GEODESIC_TOPOLOGY","NORM_GEOMETRY","SYMBOLIC_BINDING","STATE_SPACE_DIAGNOSTIC","COUNTERFACTUAL_GEOMETRY","DISTRIBUTION_TAIL_ANALYSIS","PATH_DEPENDENT_MEMORY","STOCHASTIC_SPATIAL_FIELD","TOPOLOGICAL_FEATURE_EXTRACTION"]},
          "description": {"type": "string", "minLength": 1},
          "allowed_domains": {"type": "array", "items": {"type": "string"}},
          "input_shape_descriptor": {"type": "string", "minLength": 1},
          "output_descriptor": {"type": "string", "minLength": 1},
          "computation_status": {"enum": ["DECLARED_ONLY","NOT_IMPLEMENTED","SHADOW_STUB_ONLY"]},
          "shadow_only": {"const": true},
          "allowed_architecture_targets": {
            "type": "array",
            "items": {"enum": ["ORACLE_SIGNAL_LAYER","AAL_VIZ","YGGDRASIL","ABX_RUNES","P27_P28_TEMPORAL_CONTINUITY","RESERVOIR_RUNTIME","PROJECTION_RUNTIME","DRIFT_DETECTION","SIGNAL_COMPRESSION","MULTI_DOMAIN_ANALYSIS","GEOMETRIC_INTELLIGENCE_RUNTIME"]}
          },
          "required_evidence": {
            "type": "array",
            "items": {"enum": ["RESEARCH_ITEM_REF","GEOMETRIC_SIGNAL_PACKET_REF","PROVENANCE_REF","REPLAY_VALIDATION_REQUIRED","BASELINE_COMPARATOR_REQUIRED","SHADOW_OBSERVATION_REQUIRED"]}
          },
          "risk_notes": {"type": "array", "items": {"type": "string"}},
          "implementation_status": {"enum": ["RESEARCH_METADATA_ONLY","SCHEMA_DECLARED","SHADOW_READY_PENDING_TESTS"]}
        }
      }
    },
    "governance_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_activation","canon_promotion","scheduler_mutation","runtime_authority","runtime_mutation","forecast_influence","execution_authority","token_minting_allowed","valid_for_execution","activation_approved","authorization_granted"],
      "properties": {
        "production_activation": {"const": false},
        "canon_promotion": {"const": false},
        "scheduler_mutation": {"const": false},
        "runtime_authority": {"const": false},
        "runtime_mutation": {"const": false},
        "forecast_influence": {"const": false},
        "execution_authority": {"const": false},
        "token_minting_allowed": {"const": false},
        "valid_for_execution": {"const": false},
        "activation_approved": {"const": false},
        "authorization_granted": {"const": false}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source","evidence_refs","generated_by","upstream_schema_refs"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "generated_by": {"type": "string", "minLength": 1},
        "upstream_schema_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "created_at_utc": {"type": "string", "minLength": 1},
    "canonical_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
