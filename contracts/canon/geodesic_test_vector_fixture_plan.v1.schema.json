{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "GeodesicTestVectorFixturePlan.v1",
    "description": "Fixture plan for GEODESIC test vector schema groups. FIXTURE_PLAN_ONLY: no fixture files generated, no metric values emitted, no geodesic computation authorized.",
    "type": "object",
    "required": [
        "schema_version",
        "fixture_plan_type",
        "fixture_plan_id",
        "fixture_stage",
        "operator_id",
        "created_at_utc",
        "intended_lane",
        "source_schema_plan_hash",
        "source_authorization_review_hash",
        "valid_fixture_plan",
        "invalid_fixture_plan",
        "not_computable_fixture_plan",
        "authority_locks",
        "blocked_scopes",
        "determinism_requirements",
        "numerical_policy_requirements",
        "recommended_next_step",
        "canonical_hash"
    ],
    "properties": {
        "schema_version": {"type": "string", "enum": ["GeodesicTestVectorFixturePlan.v1"]},
        "fixture_plan_type": {"type": "string", "enum": ["GEODESIC_TEST_VECTOR_FIXTURE_PLAN"]},
        "fixture_plan_id": {"type": "string"},
        "fixture_stage": {"type": "string", "enum": ["FIXTURE_PLAN_ONLY", "BLOCKED_PENDING_OPERATOR_REVIEW"]},
        "operator_id": {"type": "string", "enum": ["GEODESIC"]},
        "created_at_utc": {"type": "string"},
        "intended_lane": {"type": "string", "enum": ["SHADOW", "PROJECTION", "OBSERVATION_ONLY"]},
        "source_schema_plan_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "source_authorization_review_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "valid_fixture_plan": {"type": "array", "minItems": 5, "maxItems": 5},
        "invalid_fixture_plan": {"type": "array", "minItems": 4, "maxItems": 4},
        "not_computable_fixture_plan": {"type": "array", "minItems": 4, "maxItems": 4},
        "authority_locks": {"type": "object"},
        "blocked_scopes": {"type": "object"},
        "determinism_requirements": {"type": "object"},
        "numerical_policy_requirements": {"type": "object"},
        "recommended_next_step": {"type": "string"},
        "canonical_hash": {"type": "string", "minLength": 64, "maxLength": 64}
    },
    "additionalProperties": false
}
