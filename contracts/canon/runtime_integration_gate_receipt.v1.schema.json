{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/runtime_integration_gate_receipt.v1.schema.json",
  "title": "Runtime Integration Gate Receipt",
  "type": "object",
  "required": [
    "artifact_type",
    "receipt_id",
    "receipt_status",
    "target_surface",
    "target_surface_status",
    "notion_source",
    "patch_id",
    "source_paths",
    "source_hashes",
    "required_source_statuses",
    "notion_gap_evidence",
    "runtime_spine_evidence",
    "runtime_spine_path_records",
    "required_declaration_fields",
    "covered_subsystem_count",
    "covered_subsystems",
    "gate_policy",
    "receipt_summary",
    "recommended_next_lane",
    "recommended_next_action",
    "advisory_only",
    "shadow_only",
    "projection_only",
    "non_authoritative",
    "valid_for_execution",
    "valid_for_runtime_wiring",
    "forecast_routing_allowed",
    "canon_mutation_allowed",
    "runtime_mutation_allowed",
    "replay_mutation_allowed",
    "queue_mutation_allowed",
    "scheduler_mutation_allowed",
    "execution_authority",
    "operator_command_authority",
    "autonomous_action_allowed",
    "autonomous_promotion_allowed",
    "duplicate_runtime_authority_created",
    "mandatory_pre_dispatch_gate_enabled",
    "notion_writeback_allowed",
    "github_writeback_allowed",
    "authority_locks",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {"const": "RuntimeIntegrationGateReceipt.v1"},
    "receipt_id": {"const": "ABRAXAS_RUNTIME_INTEGRATION_GATE_RECEIPT_001"},
    "receipt_status": {
      "enum": ["RUNTIME_INTEGRATION_GATE_RECEIPT_READY_ADVISORY_ONLY", "NOT_COMPUTABLE"]
    },
    "target_surface": {"const": "ABRAXAS_RUNTIME_INTEGRATION_GATE_001"},
    "target_surface_status": {"const": "RECEIPT_READY_MANDATORY_GATE_NOT_ENABLED"},
    "notion_source": {"const": "ABRAXAS_RUNTIME_INTEGRATION_GATE_001"},
    "patch_id": {"const": "PATCH-ABX-RUNTIME-INTEGRATION-GATE-RECEIPT-001"},
    "source_paths": {
      "type": "object",
      "required": ["repo_notion_diff", "canon_resume_state", "temporal_spine_precheck"],
      "properties": {
        "repo_notion_diff": {"type": "string"},
        "canon_resume_state": {"type": "string"},
        "temporal_spine_precheck": {"type": "string"}
      },
      "additionalProperties": false
    },
    "source_hashes": {
      "type": "object",
      "required": ["repo_notion_diff", "canon_resume_state", "temporal_spine_precheck"],
      "properties": {
        "repo_notion_diff": {"type": "string"},
        "canon_resume_state": {"type": "string"},
        "temporal_spine_precheck": {"type": "string"}
      },
      "additionalProperties": false
    },
    "required_source_statuses": {
      "type": "object",
      "additionalProperties": {"enum": ["OBSERVED", "MISSING"]}
    },
    "notion_gap_evidence": {
      "type": "object",
      "required": [
        "repo_equivalent_found",
        "implementation_status",
        "match_strength",
        "recommended_action",
        "missing_elements"
      ],
      "properties": {
        "repo_equivalent_found": {"type": "boolean"},
        "implementation_status": {"type": "string"},
        "match_strength": {"type": "string"},
        "recommended_action": {"type": "string"},
        "missing_elements": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "runtime_spine_evidence": {
      "type": "object",
      "required": [
        "runtime_spine_paths_observed",
        "runtime_spine_paths_total",
        "mandatory_pre_dispatch_gate_present",
        "mandatory_pre_dispatch_gate_enabled",
        "runtime_spine_remains_skeleton"
      ],
      "properties": {
        "runtime_spine_paths_observed": {"type": "integer", "minimum": 0},
        "runtime_spine_paths_total": {"type": "integer", "minimum": 0},
        "mandatory_pre_dispatch_gate_present": {"const": false},
        "mandatory_pre_dispatch_gate_enabled": {"const": false},
        "runtime_spine_remains_skeleton": {"const": true}
      },
      "additionalProperties": false
    },
    "runtime_spine_path_records": {"$ref": "#/$defs/path_records"},
    "required_declaration_fields": {"type": "array", "items": {"type": "string"}},
    "covered_subsystem_count": {"type": "integer", "minimum": 0},
    "covered_subsystems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subsystem_id",
          "source_canonical_owner",
          "parent_subsystem_candidate",
          "target_runtime_surface",
          "allowed_inputs",
          "allowed_outputs",
          "forbidden_outputs",
          "provenance_requirements",
          "validation_commands",
          "governance_locks",
          "no_authority_seal",
          "declared_fields",
          "field_completeness"
        ],
        "properties": {
          "subsystem_id": {"type": "string"},
          "source_canonical_owner": {"type": "string"},
          "parent_subsystem_candidate": {"type": "string"},
          "target_runtime_surface": {"type": "string"},
          "allowed_inputs": {"type": "array", "items": {"type": "string"}},
          "allowed_outputs": {"type": "array", "items": {"type": "string"}},
          "forbidden_outputs": {"type": "array", "items": {"type": "string"}},
          "provenance_requirements": {"type": "array", "items": {"type": "string"}},
          "validation_commands": {"type": "array", "items": {"type": "string"}},
          "governance_locks": {"$ref": "#/$defs/authority_locks"},
          "no_authority_seal": {"$ref": "#/$defs/no_authority_seal"},
          "declared_fields": {"type": "array", "items": {"type": "string"}},
          "field_completeness": {"const": "COMPLETE"}
        },
        "additionalProperties": false
      }
    },
    "gate_policy": {
      "type": "object",
      "required": ["allowed_patch_classes", "blocked_patch_classes", "operator_review_required_where_behavior_changes"],
      "properties": {
        "allowed_patch_classes": {"type": "array", "items": {"type": "string"}},
        "blocked_patch_classes": {"type": "array", "items": {"type": "string"}},
        "operator_review_required_where_behavior_changes": {"const": true}
      },
      "additionalProperties": false
    },
    "receipt_summary": {
      "type": "object",
      "required": [
        "all_subsystems_declare_required_fields",
        "runtime_spine_evidence_observed",
        "duplicate_runtime_authority_created",
        "mandatory_gate_enabled",
        "ready_for_live_runtime_wiring"
      ],
      "properties": {
        "all_subsystems_declare_required_fields": {"type": "boolean"},
        "runtime_spine_evidence_observed": {"type": "boolean"},
        "duplicate_runtime_authority_created": {"const": false},
        "mandatory_gate_enabled": {"const": false},
        "ready_for_live_runtime_wiring": {"const": false}
      },
      "additionalProperties": false
    },
    "recommended_next_lane": {"const": "RUNTIME_INTEGRATION_GATE_OPERATOR_REVIEW_OR_ADVISORY_SPEC_PLAN"},
    "recommended_next_action": {"type": "string"},
    "advisory_only": {"const": true},
    "shadow_only": {"const": true},
    "projection_only": {"const": true},
    "non_authoritative": {"const": true},
    "valid_for_execution": {"const": false},
    "valid_for_runtime_wiring": {"const": false},
    "forecast_routing_allowed": {"const": false},
    "canon_mutation_allowed": {"const": false},
    "runtime_mutation_allowed": {"const": false},
    "replay_mutation_allowed": {"const": false},
    "queue_mutation_allowed": {"const": false},
    "scheduler_mutation_allowed": {"const": false},
    "execution_authority": {"const": false},
    "operator_command_authority": {"const": false},
    "autonomous_action_allowed": {"const": false},
    "autonomous_promotion_allowed": {"const": false},
    "duplicate_runtime_authority_created": {"const": false},
    "mandatory_pre_dispatch_gate_enabled": {"const": false},
    "notion_writeback_allowed": {"const": false},
    "github_writeback_allowed": {"const": false},
    "authority_locks": {"$ref": "#/$defs/authority_locks"},
    "packet_hash": {"type": "string"}
  },
  "$defs": {
    "path_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "status", "source_hash"],
        "properties": {
          "path": {"type": "string"},
          "status": {"enum": ["OBSERVED", "MISSING"]},
          "source_hash": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "authority_locks": {
      "type": "object",
      "required": [
        "advisory_only",
        "shadow_only",
        "non_authoritative",
        "forecast_routing",
        "canon_mutation",
        "runtime_mutation",
        "replay_mutation",
        "execution_authority",
        "operator_command_authority",
        "autonomous_action",
        "autonomous_promotion",
        "duplicate_runtime_authority_created",
        "mandatory_pre_dispatch_gate_enabled"
      ],
      "properties": {
        "advisory_only": {"const": true},
        "shadow_only": {"const": true},
        "non_authoritative": {"const": true},
        "forecast_routing": {"const": false},
        "canon_mutation": {"const": false},
        "runtime_mutation": {"const": false},
        "replay_mutation": {"const": false},
        "execution_authority": {"const": false},
        "operator_command_authority": {"const": false},
        "autonomous_action": {"const": false},
        "autonomous_promotion": {"const": false},
        "duplicate_runtime_authority_created": {"const": false},
        "mandatory_pre_dispatch_gate_enabled": {"const": false}
      },
      "additionalProperties": false
    },
    "no_authority_seal": {
      "type": "object",
      "required": [
        "runtime_integration_status",
        "duplicate_runtime_authority_created",
        "forecast_routing",
        "canon_mutation",
        "runtime_mutation",
        "replay_mutation",
        "execution_authority",
        "mandatory_pre_dispatch_gate_enabled"
      ],
      "properties": {
        "runtime_integration_status": {"const": "BOUND_TO_EXISTING_CANONICAL_SYSTEMS_ADVISORY_ONLY"},
        "duplicate_runtime_authority_created": {"const": false},
        "forecast_routing": {"const": false},
        "canon_mutation": {"const": false},
        "runtime_mutation": {"const": false},
        "replay_mutation": {"const": false},
        "execution_authority": {"const": false},
        "mandatory_pre_dispatch_gate_enabled": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
