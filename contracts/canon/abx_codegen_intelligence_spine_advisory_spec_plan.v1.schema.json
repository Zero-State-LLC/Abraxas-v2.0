{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/abx_codegen_intelligence_spine_advisory_spec_plan.v1.schema.json",
  "title": "ABX Codegen Intelligence Spine Advisory Spec Plan",
  "type": "object",
  "required": [
    "artifact_type",
    "plan_id",
    "plan_status",
    "target_surface",
    "target_surface_status",
    "patch_id",
    "source_paths",
    "source_hashes",
    "required_source_statuses",
    "notion_spec_stack",
    "schema_contracts",
    "fixture_harness",
    "shadow_replay_boundary",
    "meta_gate_boundary",
    "authority_locks",
    "blocked_actions",
    "recommended_next_lane",
    "recommended_next_action",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "valid_for_execution",
    "valid_for_implementation",
    "codegen_engine_implementation_performed",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {"const": "AbxCodegenIntelligenceSpineAdvisorySpecPlan.v1"},
    "plan_id": {"const": "ABX_CODEGEN_INTELLIGENCE_SPINE_ADVISORY_SPEC_PLAN_001"},
    "plan_status": {
      "enum": [
        "ABX_CODEGEN_INTELLIGENCE_SPINE_ADVISORY_SPEC_PLAN_READY",
        "NOT_COMPUTABLE"
      ]
    },
    "target_surface": {"const": "ABX_CODEGEN_INTELLIGENCE_SPINE_001"},
    "target_surface_status": {"const": "ADVISORY_SPEC_STACK_REPO_ALIGNED"},
    "patch_id": {"const": "PATCH-ABX-CODEGEN-INTELLIGENCE-SPINE-ADVISORY-SPEC-PLAN-001"},
    "source_paths": {
      "type": "object",
      "required": ["gap_analysis_plan", "canon_resume_state", "temporal_spine_precheck"],
      "properties": {
        "gap_analysis_plan": {"type": "string"},
        "canon_resume_state": {"type": "string"},
        "temporal_spine_precheck": {"type": "string"}
      },
      "additionalProperties": false
    },
    "source_hashes": {
      "type": "object",
      "required": ["gap_analysis_plan", "canon_resume_state", "temporal_spine_precheck"],
      "additionalProperties": {"type": "string"}
    },
    "required_source_statuses": {
      "type": "object",
      "additionalProperties": {"enum": ["OBSERVED", "MISSING"]}
    },
    "notion_spec_stack": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["surface_id", "title", "status", "source_observed_at", "source_hash"],
        "properties": {
          "surface_id": {"type": "string"},
          "title": {"type": "string"},
          "status": {"type": "string"},
          "source_observed_at": {"type": "string"},
          "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "schema_contracts": {"type": "array"},
    "fixture_harness": {"type": "object"},
    "shadow_replay_boundary": {"type": "object"},
    "meta_gate_boundary": {"type": "object"},
    "authority_locks": {
      "type": "object",
      "additionalProperties": {"const": false}
    },
    "blocked_actions": {"type": "array", "items": {"type": "string"}},
    "recommended_next_lane": {"const": "ABX_CODEGEN_INTELLIGENCE_SPINE_FIXTURE_VALIDATION_HARNESS_PLAN"},
    "recommended_next_action": {"type": "string"},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "non_authoritative": {"const": true},
    "valid_for_execution": {"const": false},
    "valid_for_implementation": {"const": false},
    "codegen_engine_implementation_performed": {"const": false},
    "packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
