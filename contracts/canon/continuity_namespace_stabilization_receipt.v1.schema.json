{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/continuity_namespace_stabilization_receipt.v1.schema.json",
  "title": "Continuity Namespace Stabilization Receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "advisory_only",
    "artifact_type",
    "audit_plan_consistency_status",
    "authority_locks",
    "authorization_authority",
    "authorization_granted",
    "authorization_record_created",
    "authorization_record_creation_authority",
    "blocked_action_status",
    "byte_stability_status",
    "canon_promotion",
    "composite_id_format",
    "composite_id_mutation_status",
    "consumed_audit_artifact_path",
    "consumed_migration_plan_artifact_path",
    "denied_authority",
    "execution_authority",
    "forecast_influence",
    "non_execution_boundary_status",
    "packet_hash",
    "packet_source_inputs",
    "production_activation",
    "projection_only",
    "receipt_id",
    "recommended_next_action",
    "recommended_next_lane",
    "record_creation_authority",
    "registry_binding_status",
    "runtime_authority",
    "scheduler_mutation",
    "selected_policy",
    "source_state",
    "stabilization_window_status",
    "token_minting_allowed",
    "token_minting_authority",
    "valid_for_execution"
  ],
  "properties": {
    "advisory_only": { "const": true },
    "artifact_type": { "const": "ContinuityNamespaceStabilizationReceipt.v1" },
    "audit_plan_consistency_status": { "const": "CONSISTENT" },
    "authority_locks": {
      "type": "object",
      "required": [
        "authorization_authority",
        "authorization_record_creation_authority",
        "canon_promotion",
        "execution_authority",
        "forecast_influence",
        "production_activation",
        "record_creation_authority",
        "runtime_authority",
        "scheduler_mutation",
        "token_minting_authority"
      ],
      "additionalProperties": { "const": false }
    },
    "authorization_authority": { "const": false },
    "authorization_granted": { "const": false },
    "authorization_record_created": { "const": false },
    "authorization_record_creation_authority": { "const": false },
    "blocked_action_status": { "const": "BLOCKED_ACTIONS_REMAIN_DENIED" },
    "byte_stability_status": { "const": "BYTE_STABLE" },
    "canon_promotion": { "const": false },
    "composite_id_format": { "const": "<NAMESPACE_ID>.<P_LANE_ID>" },
    "composite_id_mutation_status": { "const": "NO_COMPOSITE_ID_MUTATION_DETECTED" },
    "consumed_audit_artifact_path": { "const": "out/continuity_namespace_audit/latest.json" },
    "consumed_migration_plan_artifact_path": { "const": "out/continuity_namespace_migration_plan/latest.json" },
    "denied_authority": { "type": "array", "items": { "type": "string" } },
    "execution_authority": { "const": false },
    "forecast_influence": { "const": false },
    "non_execution_boundary_status": { "const": "NON_EXECUTION_BOUNDARY_CONFIRMED" },
    "packet_hash": { "type": "string" },
    "packet_source_inputs": { "type": "array", "minItems": 5 },
    "production_activation": { "const": false },
    "projection_only": { "const": true },
    "receipt_id": { "const": "CONTINUITY_NAMESPACE_STABILIZATION_RECEIPT_001" },
    "recommended_next_action": { "type": "string" },
    "recommended_next_lane": { "const": "NOT_COMPUTABLE" },
    "record_creation_authority": { "const": false },
    "registry_binding_status": { "const": "BOUND" },
    "runtime_authority": { "const": false },
    "scheduler_mutation": { "const": false },
    "selected_policy": { "const": "D_HYBRID_CANONICAL_GLOBAL_IDS_WITH_BRANCH_LOCAL_ALIASES" },
    "source_state": {
      "type": "object",
      "required": ["canon", "downstream", "governance", "highest_observed_lane", "lane_count"],
      "properties": {
        "canon": { "const": "ADVISORY_ONLY" },
        "downstream": { "const": "NOT_COMPUTABLE" },
        "governance": { "const": "FROZEN" },
        "highest_observed_lane": { "const": "P102G" },
        "lane_count": { "const": 58 }
      }
    },
    "stabilization_window_status": { "const": "STABILIZATION_HOLD_READY" },
    "token_minting_allowed": { "const": false },
    "token_minting_authority": { "const": false },
    "valid_for_execution": { "const": false }
  }
}
