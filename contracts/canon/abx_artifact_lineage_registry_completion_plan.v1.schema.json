        "artifact_family",
        "producer_module",
        "runner_path",
        "schema_path",
        "output_json_path",
        "output_md_path",
        "registry_entry",
        "parent_artifacts",
        "child_artifacts",
        "provenance_hash",
        "drift_status",
        "replay_status",
        "notion_surface",
        "not_computable_reason"
