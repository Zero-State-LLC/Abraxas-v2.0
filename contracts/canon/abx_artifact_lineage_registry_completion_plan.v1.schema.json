    "required_repo_scans": { "type": "array", "minItems": 11, "items": { "type": "string" } },
    "required_registry_checks": { "type": "array", "minItems": 4, "items": { "type": "string" } },
    "required_runner_checks": { "type": "array", "minItems": 4, "items": { "type": "string" } },
    "required_schema_checks": { "type": "array", "minItems": 4, "items": { "type": "string" } },
    "required_output_checks": { "type": "array", "minItems": 4, "items": { "type": "string" } },
