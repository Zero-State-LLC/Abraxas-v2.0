{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/counterfactual_geometry_engine.v1.schema.json",
  "title": "Counterfactual Geometry Engine v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engine_id", "engine_type", "source_attachment_refs", "source_signal_packet_refs", "source_metric_registry_refs", "source_projection_refs", "source_route_metadata_refs", "counterfactual_scope", "branch_declarations", "geometry_policy", "diffusion_policy", "comparison_policy", "output_contract", "computation_status", "governance_flags", "provenance", "created_at_utc", "canonical_hash"],
  "properties": {
    "schema_version": {"const": "CounterfactualGeometryEngine.v1"},
    "engine_id": {"type": "string", "minLength": 1},
    "engine_type": {"const": "COUNTERFACTUAL_GEOMETRY_ENGINE"},
    "source_attachment_refs": {"type": "array", "items": {"type": "string"}},
    "source_signal_packet_refs": {"type": "array", "items": {"type": "string"}},
    "source_metric_registry_refs": {"type": "array", "items": {"type": "string"}},
    "source_projection_refs": {"type": "array", "items": {"type": "string"}},
    "source_route_metadata_refs": {"type": "array", "items": {"type": "string"}},
    "counterfactual_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "observation_window", "branch_family", "intended_lane"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "observation_window": {"type": "string", "minLength": 1},
        "branch_family": {"enum": ["TEMPORAL_BRANCH", "CAUSAL_BRANCH", "SYMBOLIC_BRANCH", "GEOMETRIC_BRANCH", "MULTI_DOMAIN_BRANCH", "NOT_COMPUTABLE_BRANCH"]},
        "intended_lane": {"enum": ["SHADOW", "REPLAY", "PROJECTION", "OBSERVATION_ONLY"]}
      }
    },
    "branch_declarations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["branch_id", "branch_type", "description", "declared_use", "evidence_required", "implementation_status"],
        "properties": {
          "branch_id": {"type": "string", "minLength": 1},
          "branch_type": {"enum": ["COUNTERFACTUAL_REFERENCE", "BASELINE_BRANCH", "PERTURBATION_BRANCH", "DIVERGENCE_BRANCH", "REPLAY_BRANCH", "PROJECTION_BRANCH", "NOT_COMPUTABLE_BRANCH"]},
          "description": {"type": "string", "minLength": 1},
          "declared_use": {"enum": ["BRANCH_CONTEXT", "DIVERGENCE_CONTEXT", "TEMPORAL_CONTEXT", "CAUSAL_CONTEXT", "PROJECTION_CONTEXT", "BASELINE_COMPARISON_CONTEXT", "NOT_COMPUTABLE_CONTEXT"]},
          "evidence_required": {
            "type": "array",
            "items": {"enum": ["BASELINE_COMPARATOR_REQUIRED", "SOURCE_PACKET_REF_REQUIRED", "REPLAY_VALIDATION_REQUIRED", "PROVENANCE_REF_REQUIRED", "SHADOW_OBSERVATION_REQUIRED", "NO_RUNTIME_EFFECT_REQUIRED"]}
          },
          "implementation_status": {"enum": ["DECLARED_ONLY", "METADATA_ONLY", "NOT_IMPLEMENTED", "SHADOW_STUB_ONLY"]}
        }
      }
    },
    "geometry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry_declared", "geometry_computed", "metric_distance_computed", "route_geometry_computed", "manifold_projection_computed"],
      "properties": {
        "geometry_declared": {"const": true},
        "geometry_computed": {"const": false},
        "metric_distance_computed": {"const": false},
        "route_geometry_computed": {"const": false},
        "manifold_projection_computed": {"const": false}
      }
    },
    "diffusion_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diffusion_declared", "diffusion_computed", "smoothing_computed", "generated_scenarios", "probability_updated"],
      "properties": {
        "diffusion_declared": {"const": true},
        "diffusion_computed": {"const": false},
        "smoothing_computed": {"const": false},
        "generated_scenarios": {"const": false},
        "probability_updated": {"const": false}
      }
    },
    "comparison_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_declared", "comparison_computed", "baseline_required", "replay_validation_required", "affects_forecast", "affects_runtime", "affects_routing", "affects_scheduler"],
      "properties": {
        "comparison_declared": {"const": true},
        "comparison_computed": {"const": false},
        "baseline_required": {"const": true},
        "replay_validation_required": {"const": true},
        "affects_forecast": {"const": false},
        "affects_runtime": {"const": false},
        "affects_routing": {"const": false},
        "affects_scheduler": {"const": false}
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emits_branch_scores", "emits_scenario_outputs", "emits_probability_updates", "emits_context_labels", "emits_observation_notes", "emits_forecast_inputs", "emits_runtime_controls", "emits_authority_tokens"],
      "properties": {
        "emits_branch_scores": {"const": false},
        "emits_scenario_outputs": {"const": false},
        "emits_probability_updates": {"const": false},
        "emits_context_labels": {"const": true},
        "emits_observation_notes": {"const": true},
        "emits_forecast_inputs": {"const": false},
        "emits_runtime_controls": {"const": false},
        "emits_authority_tokens": {"const": false}
      }
    },
    "computation_status": {"enum": ["DECLARED_ONLY", "METADATA_ONLY", "NOT_IMPLEMENTED", "SHADOW_STUB_ONLY"]},
    "governance_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_activation", "canon_promotion", "scheduler_mutation", "runtime_authority", "runtime_mutation", "forecast_influence", "execution_authority", "token_minting_allowed", "valid_for_execution", "activation_approved", "authorization_granted"],
      "properties": {
        "production_activation": {"const": false},
        "canon_promotion": {"const": false},
        "scheduler_mutation": {"const": false},
        "runtime_authority": {"const": false},
        "runtime_mutation": {"const": false},
        "forecast_influence": {"const": false},
        "execution_authority": {"const": false},
        "token_minting_allowed": {"const": false},
        "valid_for_execution": {"const": false},
        "activation_approved": {"const": false},
        "authorization_granted": {"const": false}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "evidence_refs", "generated_by", "upstream_schema_refs"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "generated_by": {"type": "string", "minLength": 1},
        "upstream_schema_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "created_at_utc": {"type": "string", "minLength": 1},
    "canonical_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
