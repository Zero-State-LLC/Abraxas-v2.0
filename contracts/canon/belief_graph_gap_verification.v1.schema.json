{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/belief_graph_gap_verification.v1.schema.json",
  "title": "Belief Graph Gap Verification",
  "type": "object",
  "required": [
    "artifact_type",
    "verification_id",
    "verification_status",
    "notion_source",
    "patch_id",
    "depends_on_patch",
    "rune_equivalent_surface_audit_path",
    "rune_equivalent_surface_audit_hash",
    "component_records",
    "summary",
    "belief_graph_equivalent_observed",
    "belief_graph_implementation_performed",
    "graph_runtime_created",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "forecast_routing",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "valid_for_execution",
    "recommended_next_patch",
    "authority_locks",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {"const": "BeliefGraphGapVerification.v1"},
    "verification_id": {"const": "BELIEF_GRAPH_GAP_VERIFICATION_001"},
    "verification_status": {"enum": ["GAP_VERIFICATION_EMITTED_ADVISORY_ONLY", "NOT_COMPUTABLE"]},
    "notion_source": {"const": "ABRAXAS_PATCH_QUEUE_REVISED_001"},
    "patch_id": {"const": "PATCH-ABX-BELIEF-GRAPH-GAP-VERIFICATION-001"},
    "depends_on_patch": {"const": "PATCH-ABX-RUNE-EQUIVALENT-SURFACE-AUDIT-001"},
    "rune_equivalent_surface_audit_path": {"type": "string"},
    "rune_equivalent_surface_audit_hash": {"type": "string"},
    "component_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component",
          "status",
          "required_paths",
          "observed_paths",
          "missing_paths",
          "source_hashes",
          "evidence_strength",
          "recommended_action"
        ],
        "properties": {
          "component": {"type": "string"},
          "status": {"enum": ["OBSERVED", "MISSING"]},
          "required_paths": {"type": "array", "items": {"type": "string"}},
          "observed_paths": {"type": "array", "items": {"type": "string"}},
          "missing_paths": {"type": "array", "items": {"type": "string"}},
          "source_hashes": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          },
          "evidence_strength": {"enum": ["STRONG", "WEAK", "MISSING"]},
          "recommended_action": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_components", "observed_components", "missing_components"],
      "properties": {
        "total_components": {"type": "integer", "minimum": 0},
        "observed_components": {"type": "integer", "minimum": 0},
        "missing_components": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "belief_graph_equivalent_observed": {"type": "boolean"},
    "belief_graph_implementation_performed": {"const": false},
    "graph_runtime_created": {"const": false},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "non_authoritative": {"const": true},
    "forecast_routing": {"const": false},
    "canon_mutation": {"const": false},
    "runtime_mutation": {"const": false},
    "execution_authority": {"const": false},
    "valid_for_execution": {"const": false},
    "recommended_next_patch": {"enum": ["PATCH-ABX-BELIEF-GRAPH-CONTRACT-PLAN-001", "PATCH-ABX-RUNE-REGISTRY-FORMALIZATION-PLAN-001", "NOT_COMPUTABLE"]},
    "authority_locks": {
      "type": "object",
      "required": [
        "canon_mutation",
        "execution_authority",
        "forecast_routing",
        "runtime_mutation",
        "scheduler_mutation",
        "token_minting",
        "truth_assignment",
        "belief_promotion"
      ],
      "properties": {
        "canon_mutation": {"const": false},
        "execution_authority": {"const": false},
        "forecast_routing": {"const": false},
        "runtime_mutation": {"const": false},
        "scheduler_mutation": {"const": false},
        "token_minting": {"const": false},
        "truth_assignment": {"const": false},
        "belief_promotion": {"const": false}
      },
      "additionalProperties": false
    },
    "packet_hash": {"type": "string"}
  },
  "additionalProperties": false
}
