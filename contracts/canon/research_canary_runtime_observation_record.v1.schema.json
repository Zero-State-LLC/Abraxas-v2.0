{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/research_canary_runtime_observation_record.v1.schema.json",
  "title": "Research Canary Runtime Observation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "canonical_status",
    "advisory_only",
    "projection_only",
    "lane_id",
    "status",
    "upstream_lane_id",
    "upstream_status",
    "lane_status",
    "stabilized_candidates",
    "held_candidates",
    "repair_candidates",
    "rejected_candidates",
    "analyzed_candidates",
    "candidate_statuses",
    "missing_requirements",
    "authority_locks",
    "recommended_next_lane",
    "recommended_next_lane_reason",
    "not_computable_reasons",
    "provenance",
    "packet_hash",
    "runtime_observation_complete_candidates",
    "runtime_observation_incomplete_candidates",
    "candidate_runtime_observation_statuses",
    "missing_runtime_observation_requirements",
    "required_runtime_observation_evidence"
  ],
  "properties": {
    "artifact_type": {
      "const": "ResearchCanaryRuntimeObservationRecord.v1"
    },
    "canonical_status": {
      "const": "ADVISORY_ONLY"
    },
    "advisory_only": {
      "const": true
    },
    "projection_only": {
      "const": true
    },
    "lane_id": {
      "const": "P119_RESEARCH_CANARY_RUNTIME_OBSERVATION_RECORD"
    },
    "status": {
      "enum": [
        "CANARY_RUNTIME_OBSERVATION_RECORD_EMITTED",
        "NOT_COMPUTABLE",
        "REJECTED_AUTHORITY_DRIFT"
      ]
    },
    "upstream_lane_id": {
      "const": "P118_RESEARCH_CONTROLLED_CANARY_ENVELOPE_DRAFT"
    },
    "upstream_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "upstream_lane_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "lane_status": {
      "enum": [
        "CANARY_RUNTIME_OBSERVATION_INCOMPLETE",
        "CANARY_RUNTIME_OBSERVATION_COMPLETE",
        "CANARY_RUNTIME_OBSERVATION_REJECTED_AUTHORITY_DRIFT"
      ]
    },
    "research_canary_runtime_observation_record_status": {
      "enum": [
        "CANARY_RUNTIME_OBSERVATION_INCOMPLETE",
        "CANARY_RUNTIME_OBSERVATION_COMPLETE",
        "CANARY_RUNTIME_OBSERVATION_REJECTED_AUTHORITY_DRIFT"
      ]
    },
    "stabilized_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "held_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "repair_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "rejected_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "analyzed_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "runtime_observation_complete_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "runtime_observation_incomplete_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "candidate_statuses": {
      "$ref": "#/$defs/candidateStatuses"
    },
    "candidate_runtime_observation_statuses": {
      "$ref": "#/$defs/candidateStatuses"
    },
    "missing_requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "missing_runtime_observation_requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required_runtime_observation_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_activation",
        "canon_promotion",
        "runtime_mutation",
        "forecast_influence",
        "forecast_weight_allowed",
        "shadow_to_forecast_leakage",
        "scheduler_mutation",
        "autonomous_execution",
        "operator_bypass",
        "hidden_intent_claim_authority",
        "canary_activation",
        "canary_authority",
        "canary_plan_execution",
        "canary_authorization",
        "canary_authorization_execution",
        "canary_final_precheck_authority",
        "canary_package_authority",
        "canary_package_execution",
        "canary_runtime_envelope_authority",
        "canary_runtime_execution",
        "canary_runtime_control",
        "rollback_execution_authority",
        "termination_execution_authority"
      ],
      "properties": {
        "production_activation": {
          "const": false
        },
        "canon_promotion": {
          "const": false
        },
        "runtime_mutation": {
          "const": false
        },
        "forecast_influence": {
          "const": false
        },
        "forecast_weight_allowed": {
          "const": false
        },
        "shadow_to_forecast_leakage": {
          "const": false
        },
        "scheduler_mutation": {
          "const": false
        },
        "autonomous_execution": {
          "const": false
        },
        "operator_bypass": {
          "const": false
        },
        "hidden_intent_claim_authority": {
          "const": false
        },
        "canary_activation": {
          "const": false
        },
        "canary_authority": {
          "const": false
        },
        "canary_plan_execution": {
          "const": false
        },
        "canary_authorization": {
          "const": false
        },
        "canary_authorization_execution": {
          "const": false
        },
        "canary_final_precheck_authority": {
          "const": false
        },
        "canary_package_authority": {
          "const": false
        },
        "canary_package_execution": {
          "const": false
        },
        "canary_runtime_envelope_authority": {
          "const": false
        },
        "canary_runtime_execution": {
          "const": false
        },
        "canary_runtime_control": {
          "const": false
        },
        "rollback_execution_authority": {
          "const": false
        },
        "termination_execution_authority": {
          "const": false
        }
      }
    },
    "recommended_next_lane": {
      "type": "string"
    },
    "recommended_next_lane_reason": {
      "type": "string"
    },
    "not_computable_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    },
    "packet_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "candidateStatuses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "envelope_draft_complete_observed",
          "observation_metric_set_defined",
          "anomaly_channel_defined",
          "rollback_signal_defined",
          "termination_signal_defined",
          "operator_observation_review_required",
          "runtime_control_disabled_confirmed",
          "runtime_mutation_disabled_confirmed",
          "scheduler_mutation_disabled_confirmed",
          "provenance_bundle_attached",
          "authority_drift_observed",
          "missing_requirements",
          "canary_runtime_observation_status"
        ],
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "envelope_draft_complete_observed": {
            "type": "boolean"
          },
          "observation_metric_set_defined": {
            "type": "boolean"
          },
          "anomaly_channel_defined": {
            "type": "boolean"
          },
          "rollback_signal_defined": {
            "type": "boolean"
          },
          "termination_signal_defined": {
            "type": "boolean"
          },
          "operator_observation_review_required": {
            "type": "boolean"
          },
          "runtime_control_disabled_confirmed": {
            "type": "boolean"
          },
          "runtime_mutation_disabled_confirmed": {
            "type": "boolean"
          },
          "scheduler_mutation_disabled_confirmed": {
            "type": "boolean"
          },
          "provenance_bundle_attached": {
            "type": "boolean"
          },
          "authority_drift_observed": {
            "type": "boolean"
          },
          "missing_requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "canary_runtime_observation_status": {
            "enum": [
              "CANARY_RUNTIME_OBSERVATION_INCOMPLETE",
              "CANARY_RUNTIME_OBSERVATION_COMPLETE",
              "CANARY_RUNTIME_OBSERVATION_REJECTED_AUTHORITY_DRIFT"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
