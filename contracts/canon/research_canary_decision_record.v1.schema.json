{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/research_canary_decision_record.v1.schema.json",
  "title": "Research Canary Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "canonical_status",
    "advisory_only",
    "projection_only",
    "lane_id",
    "status",
    "upstream_lane_id",
    "upstream_canary_review_packet_status",
    "canary_decision_record_status",
    "stabilized_candidates",
    "held_candidates",
    "repair_candidates",
    "rejected_candidates",
    "analyzed_candidates",
    "approved_for_future_canary_plan_candidates",
    "held_for_review_candidates",
    "repair_requested_candidates",
    "rejected_by_decision_candidates",
    "candidate_decision_statuses",
    "allowed_decisions",
    "forbidden_decisions",
    "missing_decision_requirements",
    "authority_locks",
    "recommended_next_lane",
    "recommended_next_lane_reason",
    "not_computable_reasons",
    "provenance",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {
      "const": "ResearchCanaryDecisionRecord.v1"
    },
    "canonical_status": {
      "const": "ADVISORY_ONLY"
    },
    "advisory_only": {
      "const": true
    },
    "projection_only": {
      "const": true
    },
    "lane_id": {
      "const": "P108_RESEARCH_CANARY_DECISION_RECORD"
    },
    "status": {
      "enum": [
        "CANARY_DECISION_RECORD_EMITTED",
        "NOT_COMPUTABLE",
        "REJECTED_AUTHORITY_DRIFT"
      ]
    },
    "upstream_lane_id": {
      "const": "P107_RESEARCH_CANARY_REVIEW_PACKET"
    },
    "upstream_canary_review_packet_status": {
      "type": ["string", "null"]
    },
    "canary_decision_record_status": {
      "enum": ["EMITTED", "NOT_COMPUTABLE", "REJECTED_AUTHORITY_DRIFT"]
    },
    "stabilized_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "held_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "repair_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "rejected_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "analyzed_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "approved_for_future_canary_plan_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "held_for_review_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "repair_requested_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "rejected_by_decision_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "candidate_decision_statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "decision",
          "operator_decision_observed",
          "decision_rationale_attached",
          "provenance_bundle_attached",
          "review_packet_complete_observed",
          "authority_drift_observed",
          "missing_decision_requirements",
          "canary_decision_status"
        ],
        "properties": {
          "candidate_id": {"type": "string"},
          "decision": {
            "enum": [
              "hold",
              "request_repair",
              "reject",
              "approve_for_future_canary_plan"
            ]
          },
          "operator_decision_observed": {"type": "boolean"},
          "decision_rationale_attached": {"type": "boolean"},
          "provenance_bundle_attached": {"type": "boolean"},
          "review_packet_complete_observed": {"type": "boolean"},
          "authority_drift_observed": {"type": "boolean"},
          "missing_decision_requirements": {
            "type": "array",
            "items": {"type": "string"}
          },
          "canary_decision_status": {
            "enum": [
              "CANARY_DECISION_HELD_PENDING_REVIEW",
              "CANARY_DECISION_REPAIR_REQUESTED",
              "CANARY_DECISION_REJECTED",
              "CANARY_DECISION_APPROVED_FOR_FUTURE_PLAN",
              "CANARY_DECISION_REJECTED_AUTHORITY_DRIFT"
            ]
          },
          "notes": {"type": "string"}
        }
      }
    },
    "allowed_decisions": {
      "type": "array",
      "items": {
        "enum": [
          "hold",
          "request_repair",
          "reject",
          "approve_for_future_canary_plan"
        ]
      },
      "uniqueItems": true
    },
    "forbidden_decisions": {
      "type": "array",
      "items": {
        "enum": [
          "activate_canary",
          "grant_canary_authority",
          "production_activate",
          "canon_promote",
          "runtime_mutate",
          "scheduler_mutate",
          "forecast_weight_import",
          "autonomous_execute",
          "operator_bypass",
          "hidden_intent_claim_authority"
        ]
      },
      "uniqueItems": true
    },
    "missing_decision_requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_activation",
        "canon_promotion",
        "runtime_mutation",
        "forecast_influence",
        "forecast_weight_allowed",
        "shadow_to_forecast_leakage",
        "scheduler_mutation",
        "autonomous_execution",
        "operator_bypass",
        "hidden_intent_claim_authority",
        "canary_activation",
        "canary_authority"
      ],
      "properties": {
        "production_activation": {"const": false},
        "canon_promotion": {"const": false},
        "runtime_mutation": {"const": false},
        "forecast_influence": {"const": false},
        "forecast_weight_allowed": {"const": false},
        "shadow_to_forecast_leakage": {"const": false},
        "scheduler_mutation": {"const": false},
        "autonomous_execution": {"const": false},
        "operator_bypass": {"const": false},
        "hidden_intent_claim_authority": {"const": false},
        "canary_activation": {"const": false},
        "canary_authority": {"const": false}
      }
    },
    "recommended_next_lane": {"type": "string"},
    "recommended_next_lane_reason": {"type": "string"},
    "not_computable_reasons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "mapping_method",
        "required_decision_observation_fields",
        "boundary_rules",
        "gated_recommendation_rule",
        "p107_status",
        "p107_artifact_type"
      ],
      "properties": {
        "source": {"type": "string"},
        "mapping_method": {"type": "string"},
        "required_decision_observation_fields": {
          "type": "array",
          "items": {"type": "string"}
        },
        "boundary_rules": {
          "type": "array",
          "items": {"type": "string"}
        },
        "gated_recommendation_rule": {"type": "string"},
        "p107_status": {"type": ["string", "null"]},
        "p107_artifact_type": {"type": ["string", "null"]}
      }
    },
    "packet_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
