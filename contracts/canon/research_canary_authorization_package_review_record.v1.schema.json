{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/research_canary_authorization_package_review_record.v1.schema.json",
  "title": "Research Canary Authorization Package Review Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "canonical_status",
    "advisory_only",
    "projection_only",
    "lane_id",
    "status",
    "upstream_lane_id",
    "upstream_status",
    "lane_status",
    "stabilized_candidates",
    "held_candidates",
    "repair_candidates",
    "rejected_candidates",
    "analyzed_candidates",
    "candidate_statuses",
    "missing_requirements",
    "authority_locks",
    "recommended_next_lane",
    "recommended_next_lane_reason",
    "not_computable_reasons",
    "provenance",
    "packet_hash",
    "upstream_canary_authorization_package_draft_status",
    "canary_authorization_package_review_record_status",
    "package_review_complete_candidates",
    "package_review_incomplete_candidates",
    "candidate_package_review_statuses",
    "missing_package_review_requirements",
    "required_package_review_observations"
  ],
  "properties": {
    "artifact_type": {"const": "ResearchCanaryAuthorizationPackageReviewRecord.v1"},
    "canonical_status": {"const": "ADVISORY_ONLY"},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "lane_id": {"const": "P115_RESEARCH_CANARY_AUTHORIZATION_PACKAGE_REVIEW_RECORD"},
    "status": {
      "enum": [
        "CANARY_AUTHORIZATION_PACKAGE_REVIEW_RECORD_EMITTED",
        "NOT_COMPUTABLE",
        "REJECTED_AUTHORITY_DRIFT"
      ]
    },
    "upstream_lane_id": {"const": "P114_RESEARCH_CANARY_AUTHORIZATION_PACKAGE_DRAFT"},
    "upstream_status": {"type": ["string", "null"]},
    "upstream_canary_authorization_package_draft_status": {"type": ["string", "null"]},
    "lane_status": {
      "enum": [
        "CANARY_AUTHORIZATION_PACKAGE_REVIEW_INCOMPLETE",
        "CANARY_AUTHORIZATION_PACKAGE_REVIEW_COMPLETE",
        "CANARY_AUTHORIZATION_PACKAGE_REVIEW_REJECTED_AUTHORITY_DRIFT"
      ]
    },
    "canary_authorization_package_review_record_status": {
      "enum": [
        "CANARY_AUTHORIZATION_PACKAGE_REVIEW_INCOMPLETE",
        "CANARY_AUTHORIZATION_PACKAGE_REVIEW_COMPLETE",
        "CANARY_AUTHORIZATION_PACKAGE_REVIEW_REJECTED_AUTHORITY_DRIFT"
      ]
    },
    "stabilized_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "held_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "repair_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "rejected_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "analyzed_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "package_review_complete_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "package_review_incomplete_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "candidate_statuses": {"$ref": "#/$defs/candidateStatuses"},
    "candidate_package_review_statuses": {"$ref": "#/$defs/candidateStatuses"},
    "missing_requirements": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "missing_package_review_requirements": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "required_package_review_observations": {"type": "array", "items": {"type": "string"}},
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_activation",
        "canon_promotion",
        "runtime_mutation",
        "forecast_influence",
        "forecast_weight_allowed",
        "shadow_to_forecast_leakage",
        "scheduler_mutation",
        "autonomous_execution",
        "operator_bypass",
        "hidden_intent_claim_authority",
        "canary_activation",
        "canary_authority",
        "canary_plan_execution",
        "canary_authorization",
        "canary_authorization_execution",
        "canary_final_precheck_authority",
        "canary_package_authority",
        "canary_package_execution",
        "canary_runtime_envelope_authority"
      ],
      "properties": {
        "production_activation": {"const": false},
        "canon_promotion": {"const": false},
        "runtime_mutation": {"const": false},
        "forecast_influence": {"const": false},
        "forecast_weight_allowed": {"const": false},
        "shadow_to_forecast_leakage": {"const": false},
        "scheduler_mutation": {"const": false},
        "autonomous_execution": {"const": false},
        "operator_bypass": {"const": false},
        "hidden_intent_claim_authority": {"const": false},
        "canary_activation": {"const": false},
        "canary_authority": {"const": false},
        "canary_plan_execution": {"const": false},
        "canary_authorization": {"const": false},
        "canary_authorization_execution": {"const": false},
        "canary_final_precheck_authority": {"const": false},
        "canary_package_authority": {"const": false},
        "canary_package_execution": {"const": false},
        "canary_runtime_envelope_authority": {"const": false}
      }
    },
    "recommended_next_lane": {"type": "string"},
    "recommended_next_lane_reason": {"type": "string"},
    "not_computable_reasons": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object"},
    "packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "candidateStatuses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "package_draft_complete_observed",
          "package_scope_review_complete",
          "package_conditions_review_complete",
          "rollback_binding_review_complete",
          "monitoring_binding_review_complete",
          "blast_radius_binding_review_complete",
          "exit_criteria_binding_review_complete",
          "provenance_review_complete",
          "safety_review_complete",
          "execution_disabled_review_complete",
          "operator_review_observed",
          "authority_drift_observed",
          "missing_requirements",
          "canary_authorization_package_review_status"
        ],
        "properties": {
          "candidate_id": {"type": "string"},
          "package_draft_complete_observed": {"type": "boolean"},
          "package_scope_review_complete": {"type": "boolean"},
          "package_conditions_review_complete": {"type": "boolean"},
          "rollback_binding_review_complete": {"type": "boolean"},
          "monitoring_binding_review_complete": {"type": "boolean"},
          "blast_radius_binding_review_complete": {"type": "boolean"},
          "exit_criteria_binding_review_complete": {"type": "boolean"},
          "provenance_review_complete": {"type": "boolean"},
          "safety_review_complete": {"type": "boolean"},
          "execution_disabled_review_complete": {"type": "boolean"},
          "operator_review_observed": {"type": "boolean"},
          "authority_drift_observed": {"type": "boolean"},
          "missing_requirements": {"type": "array", "items": {"type": "string"}},
          "canary_authorization_package_review_status": {
            "enum": [
              "CANARY_AUTHORIZATION_PACKAGE_REVIEW_INCOMPLETE",
              "CANARY_AUTHORIZATION_PACKAGE_REVIEW_COMPLETE",
              "CANARY_AUTHORIZATION_PACKAGE_REVIEW_REJECTED_AUTHORITY_DRIFT"
            ]
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
