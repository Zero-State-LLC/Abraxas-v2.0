{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/notion_patch_queue_terminal_state.v1.schema.json",
  "title": "Notion Patch Queue Terminal State",
  "type": "object",
  "required": [
    "artifact_type",
    "terminal_state_id",
    "terminal_state_status",
    "notion_source",
    "depends_on_patch",
    "consumed_rune_registry_formalization_plan_path",
    "consumed_rune_registry_formalization_plan_hash",
    "queue_is_terminal",
    "terminal_reason",
    "candidate_holds",
    "required_operator_input",
    "safe_to_auto_continue",
    "auto_patch_generation_allowed",
    "notion_writeback_allowed",
    "github_writeback_allowed",
    "advisory_only",
    "projection_only",
    "evidence_only",
    "non_authoritative",
    "forecast_routing",
    "canon_mutation",
    "runtime_mutation",
    "execution_authority",
    "valid_for_execution",
    "recommended_next_patch",
    "recommended_next_lane",
    "blocked_actions",
    "authority_locks",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {"const": "NotionPatchQueueTerminalState.v1"},
    "terminal_state_id": {"const": "NOTION_PATCH_QUEUE_TERMINAL_STATE_001"},
    "terminal_state_status": {
      "enum": ["QUEUE_TERMINAL_STATE_EMITTED_ADVISORY_ONLY", "NOT_COMPUTABLE"]
    },
    "notion_source": {"const": "ABRAXAS_PATCH_QUEUE_REVISED_001"},
    "depends_on_patch": {"const": "PATCH-ABX-RUNE-REGISTRY-FORMALIZATION-PLAN-001"},
    "consumed_rune_registry_formalization_plan_path": {"type": "string"},
    "consumed_rune_registry_formalization_plan_hash": {"type": "string"},
    "queue_is_terminal": {"type": "boolean"},
    "terminal_reason": {"type": "string"},
    "candidate_holds": {"type": "array", "items": {"type": "string"}},
    "required_operator_input": {"type": "string"},
    "safe_to_auto_continue": {"const": false},
    "auto_patch_generation_allowed": {"const": false},
    "notion_writeback_allowed": {"const": false},
    "github_writeback_allowed": {"const": false},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "evidence_only": {"const": true},
    "non_authoritative": {"const": true},
    "forecast_routing": {"const": false},
    "canon_mutation": {"const": false},
    "runtime_mutation": {"const": false},
    "execution_authority": {"const": false},
    "valid_for_execution": {"const": false},
    "recommended_next_patch": {"const": "NOT_COMPUTABLE"},
    "recommended_next_lane": {"const": "NOT_COMPUTABLE"},
    "blocked_actions": {"type": "array", "items": {"type": "string"}},
    "authority_locks": {
      "type": "object",
      "required": [
        "auto_patch_generation",
        "canon_mutation",
        "execution_authority",
        "forecast_routing",
        "github_writeback",
        "notion_writeback",
        "runtime_mutation",
        "scheduler_mutation",
        "token_minting"
      ],
      "properties": {
        "auto_patch_generation": {"const": false},
        "canon_mutation": {"const": false},
        "execution_authority": {"const": false},
        "forecast_routing": {"const": false},
        "github_writeback": {"const": false},
        "notion_writeback": {"const": false},
        "runtime_mutation": {"const": false},
        "scheduler_mutation": {"const": false},
        "token_minting": {"const": false}
      },
      "additionalProperties": false
    },
    "packet_hash": {"type": "string"}
  },
  "additionalProperties": false
}
