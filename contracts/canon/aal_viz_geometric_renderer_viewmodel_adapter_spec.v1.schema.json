{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/canon/aal_viz_geometric_renderer_viewmodel_adapter_spec.v1.schema.json",
  "title": "AALVizGeometricRendererViewmodelAdapterSpec.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_spec_id",
    "adapter_spec_type",
    "adapter_spec_status",
    "source_wp001_boundary_hash",
    "source_p44_plan_hash",
    "source_operator_decision_ref",
    "field_mapping_table",
    "output_contract",
    "validation_rules",
    "blocked_scopes",
    "authority_locks",
    "governance_flags",
    "recommended_next_step",
    "provenance",
    "created_at_utc",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": {"const": "AALVizGeometricRendererViewmodelAdapterSpec.v1"},
    "adapter_spec_id": {"type": "string", "minLength": 1},
    "adapter_spec_type": {"const": "AAL_VIZ_GEOMETRIC_RENDERER_VIEWMODEL_ADAPTER_SPEC"},
    "adapter_spec_status": {"const": "VIEWMODEL_ADAPTER_SPEC_DEFINED"},
    "source_wp001_boundary_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_p44_plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_operator_decision_ref": {"type": "string", "minLength": 1},
    "field_mapping_table": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_field", "target_field", "mapping_type", "execution_authority"],
        "properties": {
          "source_field": {"type": "string", "minLength": 1},
          "target_field": {"type": "string", "minLength": 1},
          "mapping_type": {"enum": ["PASSTHROUGH_DECLARED_ONLY"]},
          "execution_authority": {"const": false}
        }
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_output_fields",
        "output_type",
        "emits_rendered_output",
        "emits_metric_values",
        "emits_ui_controls",
        "emits_planning_metadata"
      ],
      "properties": {
        "declared_output_fields": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "output_type": {"const": "VIEWMODEL_ADAPTER_SPEC_DEFINED"},
        "emits_rendered_output": {"const": false},
        "emits_metric_values": {"const": false},
        "emits_ui_controls": {"const": false},
        "emits_planning_metadata": {"const": true}
      }
    },
    "validation_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "AUTHORITY_LOCK_SCAN",
          "FIELD_MAPPING_COMPLETENESS",
          "GOVERNANCE_FALSE_FLAG_SCAN",
          "NO_RUNTIME_MUTATION_SCAN",
          "OUTPUT_FIELDS_COMPLETENESS",
          "SCHEMA_VALIDATION",
          "WORK_PACKAGE_BOUNDARY_CHECK"
        ]
      }
    },
    "blocked_scopes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_only",
        "baseline_mutation",
        "canon_promotion",
        "governance_authority_mutation",
        "metric_computation_authorized",
        "p43_surface_lanes_authorized",
        "production_activation",
        "projection_only",
        "renderer_code_authorized",
        "runtime_mutation",
        "scheduler_mutation",
        "work_package_definition_only"
      ],
      "properties": {
        "advisory_only": {"const": true},
        "projection_only": {"const": true},
        "work_package_definition_only": {"const": true},
        "renderer_code_authorized": {"const": false},
        "metric_computation_authorized": {"const": false},
        "p43_surface_lanes_authorized": {"const": false},
        "production_activation": {"const": false},
        "canon_promotion": {"const": false},
        "scheduler_mutation": {"const": false},
        "baseline_mutation": {"const": false},
        "runtime_mutation": {"const": false},
        "governance_authority_mutation": {"const": false}
      }
    },
    "governance_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_approved",
        "authorization_granted",
        "canon_promotion",
        "execution_authority",
        "forecast_influence",
        "production_activation",
        "runtime_authority",
        "runtime_mutation",
        "scheduler_mutation",
        "token_minting_allowed",
        "valid_for_execution"
      ],
      "properties": {
        "activation_approved": {"const": false},
        "authorization_granted": {"const": false},
        "canon_promotion": {"const": false},
        "execution_authority": {"const": false},
        "forecast_influence": {"const": false},
        "production_activation": {"const": false},
        "runtime_authority": {"const": false},
        "runtime_mutation": {"const": false},
        "scheduler_mutation": {"const": false},
        "token_minting_allowed": {"const": false},
        "valid_for_execution": {"const": false}
      }
    },
    "recommended_next_step": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "evidence_refs", "generated_by", "upstream_schema_refs"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "generated_by": {"type": "string", "minLength": 1},
        "upstream_schema_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "created_at_utc": {"type": "string", "minLength": 1},
    "canonical_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
