{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TransportBaselinePromotionComplete.v1",
  "description": "Schema for TRANSPORT baseline promotion completion artifact. Advisory-only. SHADOW lane. Closes the TRANSPORT baseline promotion phase by binding the promotion review, operator decision, and computation closure; updates the pack vector from VALID_METADATA_VECTOR/NOT_IMPLEMENTED to VALID_SHADOW_ONLY_VECTOR/SHADOW_STUB_ONLY.",
  "type": "object",
  "required": [
    "authority_lock_completion",
    "baseline_pack_update",
    "blocked_scope_completion",
    "canonical_hash",
    "closure_binding",
    "complete_id",
    "complete_stage",
    "complete_status",
    "created_at_utc",
    "decision_binding",
    "intended_lane",
    "operator_id",
    "parity_state_completion",
    "recommended_next_step",
    "review_binding",
    "schema_version",
    "unchanged_operators_review"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "TransportBaselinePromotionComplete.v1"},
    "complete_id": {"type": "string"},
    "complete_status": {"type": "string", "const": "TRANSPORT_BASELINE_PROMOTION_COMPLETE"},
    "complete_stage": {"type": "string", "const": "BASELINE_PROMOTION_COMPLETE"},
    "operator_id": {"type": "string", "const": "TRANSPORT"},
    "intended_lane": {"type": "string", "const": "SHADOW"},
    "created_at_utc": {"type": "string"},
    "review_binding": {"type": "object"},
    "decision_binding": {"type": "object"},
    "closure_binding": {"type": "object"},
    "baseline_pack_update": {"type": "object"},
    "parity_state_completion": {"type": "object"},
    "unchanged_operators_review": {"type": "object"},
    "authority_lock_completion": {"type": "object"},
    "blocked_scope_completion": {"type": "object"},
    "recommended_next_step": {"type": "string"},
    "canonical_hash": {"type": "string", "minLength": 64, "maxLength": 64}
  },
  "additionalProperties": false
}
