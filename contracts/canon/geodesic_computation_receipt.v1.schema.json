{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "GeodesicComputationReceipt.v1",
    "description": "Receipt artifact recording bounded SHADOW CPU-reference GEODESIC test-vector computation outcomes across all 13 fixtures. No metric emission. No forecast influence. No P43 lanes.",
    "type": "object",
    "required": [
        "schema_version",
        "receipt_id",
        "operator_id",
        "computation_status",
        "computation_stage",
        "intended_lane",
        "source_implementation_gate_hash",
        "source_implementation_plan_hash",
        "valid_fixture_results",
        "invalid_fixture_results",
        "not_computable_fixture_results",
        "comparison_summary",
        "deterministic_ordering_summary",
        "numerical_policy",
        "no_metric_emission_review",
        "no_forecast_influence_review",
        "no_p43_surface_lane_review",
        "blocked_scopes",
        "authority_locks",
        "recommended_next_step",
        "canonical_hash"
    ],
    "properties": {
        "schema_version": {"type": "string", "enum": ["GeodesicComputationReceipt.v1"]},
        "receipt_id": {"type": "string"},
        "operator_id": {"type": "string", "enum": ["GEODESIC"]},
        "computation_status": {"type": "string", "enum": ["GEODESIC_COMPUTATION_COMPLETE"]},
        "computation_stage": {"type": "string", "enum": ["TEST_VECTOR_COMPUTATION_ONLY"]},
        "intended_lane": {"type": "string", "enum": ["SHADOW"]},
        "source_implementation_gate_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "source_implementation_plan_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "valid_fixture_results": {"type": "array", "minItems": 5, "maxItems": 5},
        "invalid_fixture_results": {"type": "array", "minItems": 4, "maxItems": 4},
        "not_computable_fixture_results": {"type": "array", "minItems": 4, "maxItems": 4},
        "comparison_summary": {"type": "object"},
        "deterministic_ordering_summary": {"type": "object"},
        "numerical_policy": {"type": "object"},
        "no_metric_emission_review": {"type": "object"},
        "no_forecast_influence_review": {"type": "object"},
        "no_p43_surface_lane_review": {"type": "object"},
        "blocked_scopes": {"type": "object"},
        "authority_locks": {"type": "object"},
        "recommended_next_step": {"type": "string"},
        "canonical_hash": {"type": "string", "minLength": 64, "maxLength": 64}
    },
    "additionalProperties": false
}
