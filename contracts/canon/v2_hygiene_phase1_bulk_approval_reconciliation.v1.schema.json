{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/v2_hygiene_phase1_bulk_approval_reconciliation.v1.schema.json",
  "title": "v2.0 Hygiene Phase 1 Bulk Approval Reconciliation",
  "type": "object",
  "required": [
    "schema_version",
    "reconciliation_id",
    "reconciliation_status",
    "source_records",
    "source_ready",
    "notion_phase1_status",
    "bulk_review_status",
    "bulk_review_only_approval_recorded",
    "bulk_authority_approval_granted",
    "operator_gate_status",
    "operator_authorization_observed",
    "operator_authorization_required",
    "operator_decision_after_bulk_review",
    "phase1_task_effects",
    "effect_summary",
    "reconciliation_findings",
    "recommended_next_action",
    "recommended_next_lane",
    "recommended_next_patch",
    "advisory_only",
    "projection_only",
    "evidence_only",
    "non_authoritative",
    "implementation_authorized",
    "valid_for_implementation",
    "valid_for_execution",
    "safe_to_prepare_patch",
    "safe_to_auto_continue",
    "authorization_granted",
    "authorization_record_created",
    "operator_attestation_created",
    "operator_evidence_bundle_created",
    "hygiene_code_creation_authorized",
    "schema_file_creation_authorized",
    "rune_registration_authorized",
    "v2_module_registration_authorized",
    "strict_mode_enablement_authorized",
    "notion_writeback_allowed",
    "github_writeback_allowed",
    "runtime_mutation",
    "queue_mutation",
    "scheduler_mutation",
    "canon_mutation",
    "schema_mutation",
    "authority_locks",
    "blockers",
    "downstream",
    "reconciliation_hash"
  ],
  "properties": {
    "schema_version": {"const": "V2HygienePhase1BulkApprovalReconciliation.v1"},
    "reconciliation_id": {"const": "V2_HYGIENE_PHASE1_BULK_APPROVAL_RECONCILIATION_001"},
    "reconciliation_status": {
      "enum": [
        "V2_HYGIENE_PHASE1_BULK_APPROVAL_RECONCILIATION_HELD_FOR_OPERATOR_AUTHORIZATION",
        "V2_HYGIENE_PHASE1_BULK_APPROVAL_RECONCILIATION_BLOCKED"
      ]
    },
    "source_records": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "status_field",
          "expected_status",
          "observed_status",
          "source_observed",
          "status_matches_expected",
          "source_hash"
        ],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "status_field": {"type": "string", "minLength": 1},
          "expected_status": {"type": "string", "minLength": 1},
          "observed_status": {"type": "string", "minLength": 1},
          "source_observed": {"type": "boolean"},
          "status_matches_expected": {"type": "boolean"},
          "source_hash": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_ready": {"type": "boolean"},
    "notion_phase1_status": {"const": "READY_TO_BEGIN_IMPLEMENTATION"},
    "bulk_review_status": {"type": "string", "minLength": 1},
    "bulk_review_only_approval_recorded": {"type": "boolean"},
    "bulk_authority_approval_granted": {"const": false},
    "operator_gate_status": {"type": "string", "minLength": 1},
    "operator_authorization_observed": {"const": false},
    "operator_authorization_required": {"const": true},
    "operator_decision_after_bulk_review": {"const": "HOLD"},
    "phase1_task_effects": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "priority",
          "task",
          "notion_status",
          "bulk_review_disposition",
          "post_reconciliation_status",
          "repo_path",
          "repo_observed",
          "implementation_authorized",
          "code_creation_authorized",
          "schema_file_creation_authorized",
          "execution_authority"
        ],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "priority": {"enum": ["P0", "P1", "P2"]},
          "task": {"type": "string", "minLength": 1},
          "notion_status": {"const": "READY_FOR_WORK"},
          "bulk_review_disposition": {"const": "REVIEW_ONLY_APPROVED"},
          "post_reconciliation_status": {"const": "HELD_FOR_EXPLICIT_OPERATOR_AUTHORIZATION"},
          "repo_path": {"type": "string", "minLength": 1},
          "repo_observed": {"type": "boolean"},
          "implementation_authorized": {"const": false},
          "code_creation_authorized": {"const": false},
          "schema_file_creation_authorized": {"const": false},
          "execution_authority": {"const": false}
        }
      }
    },
    "effect_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase1_task_count",
        "review_only_approved_task_count",
        "implementation_authorized_task_count",
        "held_task_count",
        "repo_observed_task_count"
      ],
      "properties": {
        "phase1_task_count": {"const": 14},
        "review_only_approved_task_count": {"const": 14},
        "implementation_authorized_task_count": {"const": 0},
        "held_task_count": {"const": 14},
        "repo_observed_task_count": {"type": "integer", "minimum": 0}
      }
    },
    "reconciliation_findings": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "finding_status", "authority_granted"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "finding_status": {"type": "string", "minLength": 1},
          "authority_granted": {"const": false}
        }
      }
    },
    "recommended_next_action": {"type": "string", "minLength": 1},
    "recommended_next_lane": {"const": "NOT_COMPUTABLE"},
    "recommended_next_patch": {"const": "NOT_COMPUTABLE"},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "evidence_only": {"const": true},
    "non_authoritative": {"const": true},
    "implementation_authorized": {"const": false},
    "valid_for_implementation": {"const": false},
    "valid_for_execution": {"const": false},
    "safe_to_prepare_patch": {"const": false},
    "safe_to_auto_continue": {"const": false},
    "authorization_granted": {"const": false},
    "authorization_record_created": {"const": false},
    "operator_attestation_created": {"const": false},
    "operator_evidence_bundle_created": {"const": false},
    "hygiene_code_creation_authorized": {"const": false},
    "schema_file_creation_authorized": {"const": false},
    "rune_registration_authorized": {"const": false},
    "v2_module_registration_authorized": {"const": false},
    "strict_mode_enablement_authorized": {"const": false},
    "notion_writeback_allowed": {"const": false},
    "github_writeback_allowed": {"const": false},
    "runtime_mutation": {"const": false},
    "queue_mutation": {"const": false},
    "scheduler_mutation": {"const": false},
    "canon_mutation": {"const": false},
    "schema_mutation": {"const": false},
    "authority_locks": {
      "type": "object",
      "additionalProperties": {"const": false},
      "minProperties": 1
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "downstream": {"const": "NOT_COMPUTABLE"},
    "reconciliation_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
