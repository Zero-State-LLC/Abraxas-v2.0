    "candidate_statuses",
    "missing_requirements",
    "authority_locks",
    "recommended_next_lane",
    "recommended_next_lane_reason",
    "not_computable_reasons",
    "provenance",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {"const": "ResearchCanaryOperatorGoNoGoReview.v1"},
    "canonical_status": {"const": "ADVISORY_ONLY"},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "lane_id": {"const": "P121_RESEARCH_CANARY_OPERATOR_GO_NO_GO_REVIEW"},
    "status": {
      "enum": [
        "CANARY_OPERATOR_GO_NO_GO_REVIEW_EMITTED",
        "NOT_COMPUTABLE",
        "REJECTED_AUTHORITY_DRIFT"
      ]
    },
    "upstream_lane_id": {"const": "P120_RESEARCH_CANARY_ROLLBACK_TERMINATION_GOVERNANCE"},
    "upstream_status": {"type": ["string", "null"]},
    "upstream_lane_status": {"type": ["string", "null"]},
    "lane_status": {
      "enum": [
        "CANARY_OPERATOR_GO_NO_GO_INCOMPLETE",
        "CANARY_OPERATOR_NO_GO",
        "CANARY_OPERATOR_HOLD",
        "CANARY_OPERATOR_REPAIR_REQUIRED",
        "CANARY_OPERATOR_GO_FOR_ACTIVATION_PACKAGE_PLANNING",
        "CANARY_OPERATOR_GO_NO_GO_REJECTED_AUTHORITY_DRIFT"
      ]
    },
    "stabilized_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "held_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "repair_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "rejected_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "analyzed_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
