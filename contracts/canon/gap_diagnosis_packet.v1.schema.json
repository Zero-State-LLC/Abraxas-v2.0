{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/canon/gap_diagnosis_packet.v1.schema.json",
  "title": "GapDiagnosisPacket.v1",
  "type": "object",
  "required": [
    "schema_version",
    "diagnosis_id",
    "timestamp",
    "detected_by",
    "gap_type",
    "target_surface",
    "description",
    "evidence_sources",
    "severity",
    "impact_assessment",
    "recommended_next_lane",
    "proposed_improvement_types",
    "self_diagnosis_flag",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "GapDiagnosisPacket.v1"},
    "diagnosis_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "detected_by": {
      "enum": [
        "ABX_CODEGEN_INTELLIGENCE_SPINE",
        "EXTERNAL_AUDIT",
        "CONTINUITY_SPINE_SCAN",
        "RECONCILIATION_MATRIX"
      ]
    },
    "gap_type": {
      "enum": [
        "MISSING_IMPLEMENTATION",
        "PARTIAL_BINDING",
        "DRIFT",
        "OPPORTUNITY_SYNTHESIS",
        "SELF_IMPROVEMENT_TARGET",
        "POLICY_VIOLATION"
      ]
    },
    "target_surface": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 20},
    "evidence_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_type", "path_or_id", "hash", "summary"],
        "properties": {
          "source_type": {
            "enum": [
              "REPO_ARTIFACT",
              "NOTION_PAGE",
              "CONTINUITY_SPINE",
              "RECONCILIATION_MATRIX",
              "GENERATED_ARTIFACT_POLICY"
            ]
          },
          "path_or_id": {"type": "string", "minLength": 1},
          "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "summary": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "impact_assessment": {
      "type": "object",
      "required": ["affected_subsystems", "governance_impact", "continuity_impact"],
      "properties": {
        "affected_subsystems": {"type": "array", "items": {"type": "string"}},
        "governance_impact": {"type": "string", "minLength": 1},
        "continuity_impact": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "recommended_next_lane": {"type": "string", "minLength": 1},
    "proposed_improvement_types": {
      "type": "array",
      "items": {
        "enum": [
          "NEW_MODULE",
          "REFACTOR",
          "SYNTHESIS",
          "SELF_IMPROVEMENT",
          "CONTRACT_UPDATE",
          "FIXTURE_GENERATION"
        ]
      }
    },
    "self_diagnosis_flag": {"type": "boolean"},
    "provenance": {
      "type": "object",
      "required": ["continuity_lane", "repo_gap_analysis_reference"],
      "properties": {
        "continuity_lane": {"type": "string", "minLength": 1},
        "repo_gap_analysis_reference": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
