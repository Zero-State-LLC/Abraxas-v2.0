{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "contracts/canon/wasserstein_cpu_baseline_implementation_gate.v1.schema.json",
    "title": "Wasserstein CPU Baseline Implementation Gate",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "gate_id",
        "operator_id",
        "gate_status",
        "gate_stage",
        "created_at_utc",
        "intended_lane",
        "source_operator_decision_hash",
        "locked_constants_binding",
        "fixture_scope_review",
        "authorized_implementation_scope",
        "no_metric_emission_block",
        "no_forecast_influence_block",
        "no_p43_surface_lane_block",
        "blocked_scopes",
        "authority_locks",
        "recommended_next_step",
        "canonical_hash"
    ],
    "properties": {
        "schema_version": {
            "const": "WassersteinCpuBaselineImplementationGate.v1"
        },
        "gate_id": {
            "type": "string"
        },
        "operator_id": {
            "const": "WASSERSTEIN"
        },
        "gate_status": {
            "const": "WASSERSTEIN_CPU_BASELINE_IMPLEMENTATION_GATE_READY"
        },
        "gate_stage": {
            "const": "COMPUTATION_IMPLEMENTATION_GATE_ONLY"
        },
        "created_at_utc": {
            "type": "string"
        },
        "intended_lane": {
            "type": "string"
        },
        "source_operator_decision_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "locked_constants_binding": {
            "type": "object",
            "additionalProperties": true,
            "required": [
                "solver_policy",
                "supported_fixture_scope",
                "float64_precision_declaration",
                "balance_tolerance_declaration",
                "max_distribution_length_declaration",
                "max_coordinate_magnitude_declaration",
                "not_computable_branch_enumeration_confirmation",
                "all_constants_locked",
                "constants_count"
            ]
        },
        "fixture_scope_review": {
            "type": "object",
            "additionalProperties": true,
            "required": [
                "supported_fixture_scope",
                "valid_fixture_count",
                "invalid_fixture_count",
                "not_computable_fixture_count",
                "total_fixture_count",
                "fixture_scope_confirmed"
            ]
        },
        "authorized_implementation_scope": {
            "type": "object",
            "additionalProperties": true,
            "required": [
                "wasserstein_cpu_baseline_implementation_authorized",
                "authorized_computation_type",
                "bounded_scope_only",
                "fixture_scope",
                "locked_constants_binding"
            ]
        },
        "no_metric_emission_block": {
            "type": "object",
            "additionalProperties": true
        },
        "no_forecast_influence_block": {
            "type": "object",
            "additionalProperties": true
        },
        "no_p43_surface_lane_block": {
            "type": "object",
            "additionalProperties": true
        },
        "blocked_scopes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "emits_metric_values",
                "forecast_influence",
                "p43_surface_lanes_authorized",
                "production_activation",
                "canon_promotion",
                "runtime_mutation",
                "execution_authority",
                "inference_authority"
            ],
            "properties": {
                "emits_metric_values": {"const": false},
                "forecast_influence": {"const": false},
                "p43_surface_lanes_authorized": {"const": false},
                "production_activation": {"const": false},
                "canon_promotion": {"const": false},
                "runtime_mutation": {"const": false},
                "execution_authority": {"const": false},
                "inference_authority": {"const": false}
            }
        },
        "authority_locks": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "advisory_only",
                "shadow_lane_only",
                "implementation_gate_only",
                "wasserstein_cpu_baseline_implementation_authorized",
                "emits_metric_values",
                "forecast_influence",
                "p43_surface_lanes_authorized",
                "production_activation",
                "canon_promotion",
                "runtime_mutation",
                "execution_authority",
                "inference_authority"
            ],
            "properties": {
                "advisory_only": {"const": true},
                "shadow_lane_only": {"const": true},
                "implementation_gate_only": {"const": true},
                "wasserstein_cpu_baseline_implementation_authorized": {"const": true},
                "emits_metric_values": {"const": false},
                "forecast_influence": {"const": false},
                "p43_surface_lanes_authorized": {"const": false},
                "production_activation": {"const": false},
                "canon_promotion": {"const": false},
                "runtime_mutation": {"const": false},
                "execution_authority": {"const": false},
                "inference_authority": {"const": false}
            }
        },
        "recommended_next_step": {
            "type": "string"
        },
        "canonical_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        }
    }
}
