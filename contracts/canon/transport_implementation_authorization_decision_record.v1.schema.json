{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/transport_implementation_authorization_decision_record.v1.schema.json",
  "title": "Transport Implementation Authorization Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "operator_id",
    "source_operator_decision_hash",
    "decision_id",
    "implementation_lane_authorized",
    "baseline_target",
    "record_status",
    "locked_constants_record",
    "decision_validation_review",
    "blocked_scope_acknowledgement_review",
    "implementation_gate_prerequisite_review",
    "authority_locks",
    "blocked_scopes",
    "recommended_next_step",
    "output_contract",
    "provenance",
    "created_at_utc",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "TransportImplementationAuthorizationDecisionRecord.v1" },
    "record_id": { "type": "string" },
    "operator_id": { "const": "TRANSPORT" },
    "source_operator_decision_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decision_id": { "type": "string" },
    "implementation_lane_authorized": { "const": "TEST_VECTOR_COMPUTATION_ONLY" },
    "baseline_target": { "const": "SHADOW_STUB_ONLY" },
    "record_status": { "const": "TRANSPORT_IMPLEMENTATION_AUTHORIZATION_DECISION_RECORDED" },
    "locked_constants_record": {
      "type": "object",
      "additionalProperties": true,
      "required": ["all_locked_constants_present", "constants_valid_for_test_vector_scope"],
      "properties": {
        "all_locked_constants_present": { "const": true },
        "constants_valid_for_test_vector_scope": { "const": true }
      }
    },
    "decision_validation_review": {
      "type": "object",
      "additionalProperties": true,
      "required": ["decision_valid", "all_authority_flags_false"],
      "properties": {
        "decision_valid": { "const": true },
        "all_authority_flags_false": { "const": true }
      }
    },
    "blocked_scope_acknowledgement_review": {
      "type": "object",
      "additionalProperties": true,
      "required": ["all_acknowledgements_confirmed"],
      "properties": {
        "all_acknowledgements_confirmed": { "const": true }
      }
    },
    "implementation_gate_prerequisite_review": {
      "type": "object",
      "additionalProperties": true,
      "required": ["prerequisites_met", "seven_locked_constants_declared"],
      "properties": {
        "prerequisites_met": { "const": true },
        "seven_locked_constants_declared": { "const": true }
      }
    },
    "authority_locks": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "advisory_only",
        "shadow_lane_only",
        "decision_record_only",
        "transport_computation_implementation_authorized",
        "lp_solver_invocation_authorized_for_test_vectors",
        "emits_metric_values",
        "forecast_influence",
        "p43_surface_lanes_authorized",
        "production_activation",
        "canon_promotion",
        "runtime_mutation",
        "execution_authority",
        "inference_authority"
      ],
      "properties": {
        "advisory_only": { "const": true },
        "shadow_lane_only": { "const": true },
        "decision_record_only": { "const": true },
        "transport_computation_implementation_authorized": { "const": false },
        "lp_solver_invocation_authorized_for_test_vectors": { "const": false },
        "emits_metric_values": { "const": false },
        "forecast_influence": { "const": false },
        "p43_surface_lanes_authorized": { "const": false },
        "production_activation": { "const": false },
        "canon_promotion": { "const": false },
        "runtime_mutation": { "const": false },
        "execution_authority": { "const": false },
        "inference_authority": { "const": false }
      }
    },
    "blocked_scopes": { "type": "array", "items": { "type": "string" } },
    "recommended_next_step": { "type": "string" },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emits_metric_values", "emits_scores", "emits_decision_record",
        "emits_authority_tokens", "emits_forecast_inputs", "emits_runtime_controls"
      ],
      "properties": {
        "emits_metric_values": { "const": false },
        "emits_scores": { "const": false },
        "emits_decision_record": { "const": true },
        "emits_authority_tokens": { "const": false },
        "emits_forecast_inputs": { "const": false },
        "emits_runtime_controls": { "const": false }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "advisory_only", "generated_by"]
    },
    "created_at_utc": { "type": "string" },
    "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
