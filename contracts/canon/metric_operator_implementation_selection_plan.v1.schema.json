{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/canon/metric_operator_implementation_selection_plan.v1.schema.json",
  "title": "MetricOperatorImplementationSelectionPlan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","plan_id","plan_type","source_metric_registry_refs","source_test_vector_pack_refs","source_renderer_implementation_plan_refs","selection_scope","operator_candidates","selection_policy","readiness_constraints","implementation_gates","output_contract","governance_flags","provenance","created_at_utc","canonical_hash"],
  "properties": {
    "schema_version": {"const": "MetricOperatorImplementationSelectionPlan.v1"},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_type": {"const": "METRIC_OPERATOR_IMPLEMENTATION_SELECTION_PLAN"},
    "source_metric_registry_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_test_vector_pack_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_renderer_implementation_plan_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "selection_scope": {"type": "object", "additionalProperties": false, "required": ["selection_family", "intended_lane", "selection_stage"], "properties": {"selection_family": {"enum": ["FIRST_OPERATOR_SELECTION", "BASELINE_OPERATOR_SELECTION", "LOW_RISK_OPERATOR_SELECTION", "PROJECTION_READY_OPERATOR_SELECTION", "MULTI_OPERATOR_SELECTION_PLANNING"]}, "intended_lane": {"enum": ["SHADOW", "PROJECTION", "OBSERVATION_ONLY"]}, "selection_stage": {"enum": ["SELECTION_PLAN_ONLY", "READINESS_RANKING_ONLY", "IMPLEMENTATION_NOT_STARTED", "BLOCKED_PENDING_OPERATOR_REVIEW"]}}},
    "operator_candidates": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "operator_id", "operator_family", "selection_rank", "readiness_status", "implementation_risk", "evidence_refs", "blocked_operations", "rationale", "implementation_status"], "properties": {"candidate_id": {"type": "string", "minLength": 1}, "operator_id": {"enum": ["WASSERSTEIN", "CHAMFER", "GEODESIC", "NORM_GEOMETRY", "TRANSPORT", "HYPERVECTOR_BINDING", "RESERVOIR_STATE_SPACE", "COUNTERFACTUAL_DIFFUSION", "HEAVY_TAIL", "HYSTERESIS", "STOCHASTIC_GEOMETRY", "TOPOLOGICAL_PRIMITIVES"]}, "operator_family": {"enum": ["TRANSPORT_METRIC", "SPATIAL_ALIGNMENT", "GEODESIC_TOPOLOGY", "NORM_GEOMETRY", "SYMBOLIC_BINDING", "STATE_SPACE_DIAGNOSTIC", "COUNTERFACTUAL_GEOMETRY", "DISTRIBUTION_TAIL_ANALYSIS", "PATH_DEPENDENT_MEMORY", "STOCHASTIC_SPATIAL_FIELD", "TOPOLOGICAL_FEATURE_EXTRACTION"]}, "selection_rank": {"type": "integer", "minimum": 1}, "readiness_status": {"enum": ["READY_FOR_IMPLEMENTATION_PLAN", "NEEDS_MORE_TEST_VECTORS", "NEEDS_BASELINE_COMPARATOR", "NEEDS_OPERATOR_REVIEW", "BLOCKED_BY_GOVERNANCE", "NOT_COMPUTABLE"]}, "implementation_risk": {"enum": ["LOW", "MEDIUM", "HIGH", "NOT_COMPUTABLE"]}, "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "blocked_operations": {"type": "array", "items": {"type": "string", "minLength": 1}}, "rationale": {"type": "string", "minLength": 1}, "implementation_status": {"enum": ["SELECTED_FOR_PLANNING_ONLY", "CANDIDATE_ONLY", "NOT_IMPLEMENTED", "BLOCKED_PENDING_REVIEW"]}}}},
    "selection_policy": {"type": "object", "additionalProperties": false, "required": ["uses_test_vectors", "uses_registry_metadata", "uses_renderer_plan_context", "no_metric_computation", "no_runtime_effect", "no_forecast_effect", "no_authority_grant"], "properties": {"uses_test_vectors": {"const": true}, "uses_registry_metadata": {"const": true}, "uses_renderer_plan_context": {"const": true}, "no_metric_computation": {"const": true}, "no_runtime_effect": {"const": true}, "no_forecast_effect": {"const": true}, "no_authority_grant": {"const": true}}},
    "readiness_constraints": {"type": "object", "additionalProperties": false, "required": ["requires_test_vector_coverage", "requires_baseline_comparator", "requires_operator_review", "requires_no_authority_scan", "requires_no_runtime_mutation", "requires_no_forecast_influence"], "properties": {"requires_test_vector_coverage": {"const": true}, "requires_baseline_comparator": {"const": true}, "requires_operator_review": {"const": true}, "requires_no_authority_scan": {"const": true}, "requires_no_runtime_mutation": {"const": true}, "requires_no_forecast_influence": {"const": true}}},
    "implementation_gates": {"type": "object", "additionalProperties": false, "required": ["implementation_blocked", "planning_only", "requires_new_operator_plan", "requires_dedicated_tests", "requires_stabilization_window"], "properties": {"implementation_blocked": {"const": true}, "planning_only": {"const": true}, "requires_new_operator_plan": {"const": true}, "requires_dedicated_tests": {"const": true}, "requires_stabilization_window": {"const": true}}},
    "output_contract": {"type": "object", "additionalProperties": false, "required": ["emits_metric_code", "emits_metric_values", "emits_scores", "emits_forecast_inputs", "emits_runtime_controls", "emits_authority_tokens", "emits_selection_metadata", "emits_readiness_ranking"], "properties": {"emits_metric_code": {"const": false}, "emits_metric_values": {"const": false}, "emits_scores": {"const": false}, "emits_forecast_inputs": {"const": false}, "emits_runtime_controls": {"const": false}, "emits_authority_tokens": {"const": false}, "emits_selection_metadata": {"const": true}, "emits_readiness_ranking": {"const": true}}},
    "governance_flags": {"type": "object", "additionalProperties": false, "required": ["production_activation", "canon_promotion", "scheduler_mutation", "runtime_authority", "runtime_mutation", "forecast_influence", "execution_authority", "token_minting_allowed", "valid_for_execution", "activation_approved", "authorization_granted"], "properties": {"production_activation": {"const": false}, "canon_promotion": {"const": false}, "scheduler_mutation": {"const": false}, "runtime_authority": {"const": false}, "runtime_mutation": {"const": false}, "forecast_influence": {"const": false}, "execution_authority": {"const": false}, "token_minting_allowed": {"const": false}, "valid_for_execution": {"const": false}, "activation_approved": {"const": false}, "authorization_granted": {"const": false}}},
    "provenance": {"type": "object", "additionalProperties": true, "required": ["source", "evidence_refs", "generated_by", "upstream_schema_refs"], "properties": {"source": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "generated_by": {"type": "string", "minLength": 1}, "upstream_schema_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "created_at_utc": {"type": "string", "minLength": 1},
    "canonical_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
