{
  "$id": "https://abraxas/contracts/canon/heavy_tail_baseline_promotion_review.v1.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
    "authority_locks": { "type": "object" },
    "authorization_review": { "type": "object" },
    "baseline_pack_update_review": { "type": "object" },
    "blocked_scopes": { "type": "object" },
    "canonical_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "computation_receipt_review": { "type": "object" },
    "created_at_utc": { "type": "string" },
    "current_pack_state_review": { "type": "object" },
    "intended_lane": { "type": "string", "const": "SHADOW" },
    "no_forecast_influence_review": { "type": "object" },
    "no_metric_emission_review": { "type": "object" },
    "no_p43_surface_lane_review": { "type": "object" },
    "operator_id": { "type": "string", "const": "HEAVY_TAIL" },
    "operator_state_after_update": { "type": "object" },
    "parity_review": { "type": "object" },
    "recommended_next_step": {
      "type": "string",
      "const": "HEAVY_TAIL_BASELINE_PROMOTION_COMPLETE"
    },
    "review_id": {
      "type": "string",
      "const": "heavy_tail_baseline_promotion_review_001"
    },
    "review_stage": {
      "type": "string",
      "const": "BASELINE_PROMOTION_REVIEW_ONLY"
    },
    "review_status": {
      "type": "string",
      "const": "HEAVY_TAIL_BASELINE_PROMOTION_REVIEW_COMPLETE"
    },
    "schema_version": {
      "type": "string",
      "const": "HeavyTailBaselinePromotionReview.v1"
    },
    "source_authorization_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_computation_receipt_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_pack_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "target_state_review": { "type": "object" }
  },
  "required": [
    "authority_locks",
    "authorization_review",
    "baseline_pack_update_review",
    "blocked_scopes",
    "canonical_hash",
    "computation_receipt_review",
    "created_at_utc",
    "current_pack_state_review",
    "intended_lane",
    "no_forecast_influence_review",
    "no_metric_emission_review",
    "no_p43_surface_lane_review",
    "operator_id",
    "operator_state_after_update",
    "parity_review",
    "recommended_next_step",
    "review_id",
    "review_stage",
    "review_status",
    "schema_version",
    "source_authorization_hash",
    "source_computation_receipt_hash",
    "source_pack_hash",
    "target_state_review"
  ],
