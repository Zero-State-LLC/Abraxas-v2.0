{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WassersteinTestVectorComputationCompleteReview.v1",
  "description": "Bounded review artifact verifying the completed Wasserstein test-vector computation receipt. Shadow-only. Confirms 5 valid shadow_transport_values, 9 rejected-input outcomes, no metric value emission, no forecast influence, no P43 surface lanes, and authority locks intact. No metric values emitted. SHADOW lane only.",
  "type": "object",
  "required": [
    "schema_version", "review_id", "review_type", "operator_id",
    "source_computation_receipt_hash", "source_computation_actual_pr_gate_hash",
    "intended_lane", "review_stage",
    "valid_fixture_result_review", "rejected_input_result_review",
    "shadow_transport_value_review",
    "no_metric_value_emission_review", "no_forecast_influence_review",
    "no_p43_surface_lane_review", "authority_lock_review",
    "computation_completion_summary",
    "blocked_scopes", "authority_locks",
    "recommended_next_step", "provenance", "created_at_utc", "canonical_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "WassersteinTestVectorComputationCompleteReview.v1" },
    "review_id": { "type": "string" },
    "review_type": { "type": "string", "const": "WASSERSTEIN_TEST_VECTOR_COMPUTATION_COMPLETE_REVIEW" },
    "operator_id": { "type": "string", "const": "WASSERSTEIN" },
    "source_computation_receipt_hash": { "type": "string" },
    "source_computation_actual_pr_gate_hash": { "type": "string" },
    "intended_lane": { "type": "string", "enum": ["SHADOW", "PROJECTION", "OBSERVATION_ONLY"] },
    "review_stage": { "type": "string", "enum": ["TEST_VECTOR_COMPUTATION_COMPLETE_REVIEW_ONLY", "BLOCKED_PENDING_GATE"] },
    "valid_fixture_result_review": {
      "type": "object",
      "required": ["total_reviewed", "all_shadow_computation_complete", "all_shadow_lane", "all_have_shadow_transport_value", "no_metric_values_emitted", "no_expected_distances_included", "fixture_reviews", "review_status"],
      "additionalProperties": false,
      "properties": {
        "total_reviewed": { "type": "integer", "const": 5 },
        "all_shadow_computation_complete": { "type": "boolean", "const": true },
        "all_shadow_lane": { "type": "boolean", "const": true },
        "all_have_shadow_transport_value": { "type": "boolean", "const": true },
        "no_metric_values_emitted": { "type": "boolean", "const": true },
        "no_expected_distances_included": { "type": "boolean", "const": true },
        "fixture_reviews": { "type": "array", "minItems": 5, "maxItems": 5 },
        "review_status": { "type": "string", "const": "VALID_FIXTURE_RESULTS_VERIFIED" }
      }
    },
    "rejected_input_result_review": {
      "type": "object",
      "required": ["total_reviewed", "invalid_reviewed", "not_computable_reviewed", "all_rejected_input", "no_metric_values_emitted", "fixture_reviews", "review_status"],
      "additionalProperties": false,
      "properties": {
        "total_reviewed": { "type": "integer", "const": 9 },
        "invalid_reviewed": { "type": "integer", "const": 5 },
        "not_computable_reviewed": { "type": "integer", "const": 4 },
        "all_rejected_input": { "type": "boolean", "const": true },
        "no_metric_values_emitted": { "type": "boolean", "const": true },
        "fixture_reviews": { "type": "array", "minItems": 9, "maxItems": 9 },
        "review_status": { "type": "string", "const": "REJECTED_INPUT_RESULTS_VERIFIED" }
      }
    },
    "shadow_transport_value_review": {
      "type": "object",
      "required": ["total_reviewed", "all_within_tolerance", "tolerance_used", "fixture_reviews", "no_metric_value_emitted", "no_expected_distance_added", "review_status"],
      "additionalProperties": false,
      "properties": {
        "total_reviewed": { "type": "integer", "const": 5 },
        "all_within_tolerance": { "type": "boolean", "const": true },
        "tolerance_used": { "type": "number" },
        "fixture_reviews": { "type": "array", "minItems": 5, "maxItems": 5 },
        "no_metric_value_emitted": { "type": "boolean", "const": true },
        "no_expected_distance_added": { "type": "boolean", "const": true },
        "review_status": { "type": "string", "const": "SHADOW_TRANSPORT_VALUES_VERIFIED" }
      }
    },
    "no_metric_value_emission_review": {
      "type": "object",
      "required": ["source_emits_metric_values", "source_fcr_no_metric_values_emitted", "all_valid_results_metric_value_emitted_false", "all_invalid_results_metric_value_emitted_false", "all_nc_results_metric_value_emitted_false", "review_status"],
      "additionalProperties": false,
      "properties": {
        "source_emits_metric_values": { "type": "boolean", "const": false },
        "source_fcr_no_metric_values_emitted": { "type": "boolean", "const": true },
        "all_valid_results_metric_value_emitted_false": { "type": "boolean", "const": true },
        "all_invalid_results_metric_value_emitted_false": { "type": "boolean", "const": true },
        "all_nc_results_metric_value_emitted_false": { "type": "boolean", "const": true },
        "review_status": { "type": "string", "const": "NO_METRIC_VALUES_EMITTED_VERIFIED" }
      }
    },
    "no_forecast_influence_review": {
      "type": "object",
      "required": ["source_forecast_influence", "source_scan_status", "source_scan_violations", "no_forecast_binding", "no_p43_output", "review_status"],
      "additionalProperties": false,
      "properties": {
        "source_forecast_influence": { "type": "boolean", "const": false },
        "source_scan_status": { "type": "string", "const": "CLEAN" },
        "source_scan_violations": { "type": "array", "maxItems": 0 },
        "no_forecast_binding": { "type": "boolean", "const": true },
        "no_p43_output": { "type": "boolean", "const": true },
        "review_status": { "type": "string", "const": "NO_FORECAST_INFLUENCE_VERIFIED" }
      }
    },
    "no_p43_surface_lane_review": {
      "type": "object",
      "required": ["source_p43_surface_lanes_authorized", "source_scan_status", "source_scan_violations", "no_p43_lanes_opened", "no_runtime_binding", "review_status"],
      "additionalProperties": false,
      "properties": {
        "source_p43_surface_lanes_authorized": { "type": "boolean", "const": false },
        "source_scan_status": { "type": "string", "const": "CLEAN" },
        "source_scan_violations": { "type": "array", "maxItems": 0 },
        "no_p43_lanes_opened": { "type": "boolean", "const": true },
        "no_runtime_binding": { "type": "boolean", "const": true },
        "review_status": { "type": "string", "const": "NO_P43_SURFACE_LANES_VERIFIED" }
      }
    },
    "authority_lock_review": {
      "type": "object",
      "required": ["source_advisory_only", "source_shadow_lane_only", "source_test_vector_computation_only", "source_wasserstein_computation_authorized", "source_emits_metric_values", "source_forecast_influence", "source_p43_surface_lanes_authorized", "source_production_activation", "source_canon_promotion", "source_runtime_mutation", "source_execution_authority", "source_inference_authority", "all_locks_intact", "review_status"],
      "additionalProperties": false,
      "properties": {
        "source_advisory_only": { "type": "boolean", "const": true },
        "source_shadow_lane_only": { "type": "boolean", "const": true },
        "source_test_vector_computation_only": { "type": "boolean", "const": true },
        "source_wasserstein_computation_authorized": { "type": "boolean", "const": true },
        "source_emits_metric_values": { "type": "boolean", "const": false },
        "source_forecast_influence": { "type": "boolean", "const": false },
        "source_p43_surface_lanes_authorized": { "type": "boolean", "const": false },
        "source_production_activation": { "type": "boolean", "const": false },
        "source_canon_promotion": { "type": "boolean", "const": false },
        "source_runtime_mutation": { "type": "boolean", "const": false },
        "source_execution_authority": { "type": "boolean", "const": false },
        "source_inference_authority": { "type": "boolean", "const": false },
        "all_locks_intact": { "type": "boolean", "const": true },
        "review_status": { "type": "string", "const": "AUTHORITY_LOCKS_VERIFIED" }
      }
    },
    "computation_completion_summary": {
      "type": "object",
      "required": ["computation_receipt_id", "computation_status", "total_fixtures", "valid_computed", "invalid_rejected", "not_computable_rejected", "all_shadow_lane", "no_metric_values_emitted", "no_expected_distances_included", "determinism_status", "source_intended_lane", "source_computation_stage", "review_completion_status"],
      "additionalProperties": false,
      "properties": {
        "computation_receipt_id": { "type": "string" },
        "computation_status": { "type": "string", "const": "WASSERSTEIN_TEST_VECTOR_COMPUTATION_COMPLETE" },
        "total_fixtures": { "type": "integer", "const": 14 },
        "valid_computed": { "type": "integer", "const": 5 },
        "invalid_rejected": { "type": "integer", "const": 5 },
        "not_computable_rejected": { "type": "integer", "const": 4 },
        "all_shadow_lane": { "type": "boolean", "const": true },
        "no_metric_values_emitted": { "type": "boolean", "const": true },
        "no_expected_distances_included": { "type": "boolean", "const": true },
        "determinism_status": { "type": "string", "const": "PASS" },
        "source_intended_lane": { "type": "string" },
        "source_computation_stage": { "type": "string" },
        "review_completion_status": { "type": "string", "const": "COMPUTATION_COMPLETION_VERIFIED" }
      }
    },
    "blocked_scopes": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "authority_locks": { "type": "object", "additionalProperties": true },
    "recommended_next_step": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["source", "evidence_refs", "generated_by", "upstream_schema_refs"],
      "additionalProperties": true,
      "properties": {
        "source": { "type": "string" },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "generated_by": { "type": "string" },
        "upstream_schema_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "created_at_utc": { "type": "string" },
    "canonical_hash": { "type": "string" }
  }
}
