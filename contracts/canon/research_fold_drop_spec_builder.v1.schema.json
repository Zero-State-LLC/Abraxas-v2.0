{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/research_fold_drop_spec_builder.v1.schema.json",
  "title": "Research Fold Drop Spec Builder",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lane_id",
    "artifact_type",
    "canonical_status",
    "spec_builder_status",
    "specs_ready",
    "built_specs",
    "missing_or_invalid_inputs",
    "provenance",
    "recommended_next_lane",
    "authority_locks",
    "packet_hash"
  ],
  "properties": {
    "lane_id": {"const": "P95_RESEARCH_FOLD_DROP_SPEC_BUILDER"},
    "artifact_type": {"const": "ResearchFoldDropSpecBuilder.v1"},
    "canonical_status": {"const": "ADVISORY_ONLY"},
    "spec_builder_status": {"enum": ["PASS", "NOT_COMPUTABLE"]},
    "specs_ready": {"type": "boolean"},
    "built_specs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "spec_id",
          "source_surface_id",
          "source_label",
          "source_type",
          "evidence_reference",
          "content_hash",
          "checksum_scope",
          "research_fold_family",
          "advisory_scope",
          "governance_posture",
          "status"
        ],
        "properties": {
          "spec_id": {"type": "string"},
          "source_surface_id": {"enum": ["canon_drop_006_research_folds", "canon_drop_007_research_folds"]},
          "source_label": {"type": "string"},
          "source_type": {"type": "string"},
          "evidence_reference": {"type": "string"},
          "content_hash": {"type": "string"},
          "checksum_scope": {"type": "string"},
          "research_fold_family": {"type": "string"},
          "advisory_scope": {"const": "research_fold_specification_only"},
          "governance_posture": {"const": "ADVISORY_ONLY"},
          "status": {"const": "SPEC_READY"}
        }
      }
    },
    "missing_or_invalid_inputs": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object"},
    "recommended_next_lane": {"type": "string"},
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_only",
        "projection_only",
        "planning_only",
        "evidence_only",
        "spec_only",
        "production_activation",
        "canon_promotion",
        "scheduler_mutation",
        "runtime_authority",
        "forecast_influence",
        "execution_authority",
        "repair_execution_authority",
        "regeneration_execution_authority",
        "token_minting_allowed",
        "valid_for_execution"
      ],
      "properties": {
        "advisory_only": {"const": true},
        "projection_only": {"const": true},
        "planning_only": {"const": true},
        "evidence_only": {"const": true},
        "spec_only": {"const": true},
        "production_activation": {"const": false},
        "canon_promotion": {"const": false},
        "scheduler_mutation": {"const": false},
        "runtime_authority": {"const": false},
        "forecast_influence": {"const": false},
        "execution_authority": {"const": false},
        "repair_execution_authority": {"const": false},
        "regeneration_execution_authority": {"const": false},
        "token_minting_allowed": {"const": false},
        "valid_for_execution": {"const": false}
      }
    },
    "packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
