{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/canon/research_fold_drop_spec_builder.v1.schema.json",
  "title": "Research Fold Drop Spec Builder",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "canonical_status",
    "advisory_only",
    "projection_only",
    "lane_id",
    "status",
    "generated_drop_specs",
    "authority_locks",
    "recommended_next_lane",
    "recommended_next_lane_reason",
    "not_computable_reasons",
    "provenance",
    "packet_hash"
  ],
  "properties": {
    "artifact_type": {"const": "ResearchFoldDropSpecBuilder.v1"},
    "canonical_status": {"const": "ADVISORY_ONLY"},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "lane_id": {"const": "P95_RESEARCH_FOLD_DROP_SPEC_BUILDER"},
    "status": {"enum": ["PASS", "NOT_COMPUTABLE"]},
    "generated_drop_specs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["drop_id", "spec_id", "source_candidate_id", "spec_mode", "executable"],
        "properties": {
          "drop_id": {"enum": ["DROP006", "DROP007"]},
          "spec_id": {"type": "string"},
          "source_candidate_id": {"type": "string"},
          "spec_mode": {"const": "ADVISORY_SPEC_ONLY"},
          "executable": {"const": false}
        }
      }
    },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_activation",
        "canon_promotion",
        "runtime_mutation",
        "forecast_influence",
        "forecast_weight_allowed",
        "shadow_to_forecast_leakage",
        "scheduler_mutation",
        "autonomous_execution",
        "operator_bypass",
        "hidden_intent_claim_authority"
      ],
      "properties": {
        "production_activation": {"const": false},
        "canon_promotion": {"const": false},
        "runtime_mutation": {"const": false},
        "forecast_influence": {"const": false},
        "forecast_weight_allowed": {"const": false},
        "shadow_to_forecast_leakage": {"const": false},
        "scheduler_mutation": {"const": false},
        "autonomous_execution": {"const": false},
        "operator_bypass": {"const": false},
        "hidden_intent_claim_authority": {"const": false}
      }
    },
    "recommended_next_lane": {"type": "string"},
    "recommended_next_lane_reason": {"type": "string"},
    "not_computable_reasons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "mapping_method",
        "drop_order",
        "spec_ordering",
        "p94_status",
        "p94_canon_alignment_status",
        "boundary_rules",
        "gated_recommendation_rule"
      ],
      "properties": {
        "source": {"type": "string"},
        "mapping_method": {"type": "string"},
        "drop_order": {"type": "array", "items": {"type": "string"}},
        "spec_ordering": {"type": "string"},
        "p94_status": {"type": ["string", "null"]},
        "p94_canon_alignment_status": {"type": ["string", "null"]},
        "boundary_rules": {"type": "array", "items": {"type": "string"}},
        "gated_recommendation_rule": {"type": "string"}
      }
    },
    "packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
