{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/outcomes/outcome_binding.v1.schema.json",
  "title": "OutcomeBinding.v1",
  "type": "object",
  "required": ["schema_version","binding_id","forecast_id","forecast_hash","criteria","resolution_sources","resolution_window","verdict_rule","binding_status","created_by_lane","authority_ref","binding_hash"],
  "properties": {
    "schema_version": {"const": "OutcomeBinding.v1"},
    "binding_id": {"type": "string", "minLength": 1},
    "forecast_id": {"type": "string", "minLength": 1},
    "forecast_hash": {"type": "string", "minLength": 1},
    "criteria": {"type": "array", "items": {"type": "object", "required": ["criterion_id","description"], "properties": {"criterion_id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "resolution_sources": {"type": "array", "items": {"type": "object", "required": ["source_type","source_id","label"], "properties": {"source_type": {"type": "string", "enum": ["OFFICIAL_API","PUBLIC_WEB","MANUAL_RECEIPT","MARKET_SOURCE","SPORTS_DATA_SOURCE","REPO_FIXTURE","NOT_COMPUTABLE"]}, "source_id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "resolution_window": {"type": "object", "required": ["opens_at_policy","closes_at_policy","timezone_policy"], "properties": {"opens_at_policy": {"type": "string", "minLength": 1}, "closes_at_policy": {"type": "string", "minLength": 1}, "timezone_policy": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "verdict_rule": {"type": "object", "required": ["rule_type","rule_value"], "properties": {"rule_type": {"type": "string", "enum": ["BOOLEAN_EVENT","THRESHOLD_NUMERIC","CATEGORICAL_MATCH","RANGE_INCLUSION","MANUAL_REVIEW_REQUIRED","NOT_COMPUTABLE"]}, "rule_value": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "binding_status": {"type": "string", "enum": ["DRAFT","BOUND","RESOLUTION_PENDING","RESOLVED","VOID","NOT_COMPUTABLE"]},
    "created_by_lane": {"type": "string", "enum": ["SHADOW","FORECAST","PROJECTION","CANON","OPERATOR"]},
    "authority_ref": {"type": ["object","null"], "required": ["authority_type","authority_id","label"], "properties": {"authority_type": {"type": "string", "minLength": 1}, "authority_id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "void_reason": {"type": ["string","null"]},
    "binding_hash": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
