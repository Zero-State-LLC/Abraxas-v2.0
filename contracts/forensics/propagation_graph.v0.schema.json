{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://abraxas.local/contracts/forensics/propagation_graph.v0.schema.json",
  "title": "PropagationGraph.v0",
  "description": "SHADOW dry-run propagation graph from EvidencePack sources/claims. No network; write_performed always false.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "pack_id",
    "nodes",
    "edges",
    "node_count",
    "edge_count",
    "write_performed",
    "network_calls",
    "authority",
    "advisory_only",
    "lane",
    "canonical_hash"
  ],
  "properties": {
    "schema_version": { "const": "PropagationGraph.v0" },
    "pack_id": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "kind", "register", "label"],
        "properties": {
          "node_id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["source", "meme_unit"]
          },
          "register": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edge_id", "from_id", "to_id", "kind"],
        "properties": {
          "edge_id": { "type": "string" },
          "from_id": { "type": "string" },
          "to_id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["observed_cite", "inferred_echo", "speculative_spread"]
          }
        }
      }
    },
    "node_count": { "type": "integer", "minimum": 0 },
    "edge_count": { "type": "integer", "minimum": 0 },
    "write_performed": { "const": false },
    "network_calls": { "const": false },
    "authority": {
      "type": "object",
      "required": [
        "execution_authority",
        "promotion_authorized",
        "forecast_routing_authorized",
        "canon_mutation_allowed",
        "publish_authorized"
      ],
      "properties": {
        "execution_authority": { "const": false },
        "promotion_authorized": { "const": false },
        "forecast_routing_authorized": { "const": false },
        "canon_mutation_allowed": { "const": false },
        "publish_authorized": { "const": false }
      }
    },
    "advisory_only": { "const": true },
    "lane": { "const": "SHADOW" },
    "canonical_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
