{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/belief_graph/belief_graph_packet.v1.schema.json",
  "title": "BeliefGraphPacket.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patch_id",
    "claims",
    "evidence",
    "theories",
    "signal_graph",
    "provenance",
    "shadow_forecast_separation",
    "authority_locks",
    "confidence_behavior",
    "not_computable_behavior",
    "FORECAST_ROUTING",
    "CANON_MUTATION",
    "RUNTIME_MUTATION",
    "EXECUTION_AUTHORITY",
    "TRUTH_ASSIGNMENT",
    "BELIEF_PROMOTION",
    "FINAL_STATUS"
  ],
  "$defs": {
    "claim_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "statement",
        "provenance",
        "evidence_refs",
        "confidence",
        "status"
      ],
      "properties": {
        "schema_version": { "const": "ClaimObject.v1" },
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "provenance": { "type": "object" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "confidence": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "const": "NOT_COMPUTABLE" }
          ]
        },
        "status": {
          "enum": [
            "OBSERVED",
            "INFERRED",
            "SPECULATIVE",
            "NOT_COMPUTABLE"
          ]
        }
      }
    },
    "evidence_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "provenance",
        "timestamp",
        "evidence_type",
        "hash"
      ],
      "properties": {
        "schema_version": { "const": "EvidenceObject.v1" },
        "source": { "type": "string", "minLength": 1 },
        "provenance": { "type": "object" },
        "timestamp": { "type": "string", "minLength": 1 },
        "evidence_type": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "minLength": 1 }
      }
    },
    "theory_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "supporting_claims",
        "conflicting_claims",
        "evidence_refs"
      ],
      "properties": {
        "schema_version": { "const": "TheoryObject.v1" },
        "id": { "type": "string", "minLength": 1 },
        "supporting_claims": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "conflicting_claims": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "signal_graph_relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "source_type",
        "target_ref",
        "target_type",
        "relationship"
      ],
      "properties": {
        "source_ref": { "type": "string", "minLength": 1 },
        "source_type": { "enum": ["claim", "evidence", "theory"] },
        "target_ref": { "type": "string", "minLength": 1 },
        "target_type": { "enum": ["claim", "evidence", "theory"] },
        "relationship": { "type": "string", "minLength": 1 }
      }
    },
    "signal_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "relationship_count",
        "relationships"
      ],
      "properties": {
        "schema_version": { "const": "SignalGraph.v1" },
        "relationship_count": { "type": "integer", "minimum": 0 },
        "relationships": {
          "type": "array",
          "items": { "$ref": "#/$defs/signal_graph_relationship" }
        }
      }
    }
  },
  "properties": {
    "schema_version": { "const": "BeliefGraphPacket.v1" },
    "patch_id": { "const": "PATCH-ABX-BELIEF-GRAPH-001" },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim_object" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_object" }
    },
    "theories": {
      "type": "array",
      "items": { "$ref": "#/$defs/theory_object" }
    },
    "signal_graph": { "$ref": "#/$defs/signal_graph" },
    "provenance": { "type": "object" },
    "shadow_forecast_separation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SHADOW_SURFACE",
        "FORECAST_SURFACE",
        "FORECAST_ROUTING"
      ],
      "properties": {
        "SHADOW_SURFACE": { "const": "SHADOW" },
        "FORECAST_SURFACE": { "const": "FORECAST" },
        "FORECAST_ROUTING": { "const": false }
      }
    },
    "authority_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "FORECAST_ROUTING",
        "CANON_MUTATION",
        "RUNTIME_MUTATION",
        "EXECUTION_AUTHORITY",
        "TRUTH_ASSIGNMENT",
        "BELIEF_PROMOTION"
      ],
      "properties": {
        "FORECAST_ROUTING": { "const": false },
        "CANON_MUTATION": { "const": false },
        "RUNTIME_MUTATION": { "const": false },
        "EXECUTION_AUTHORITY": { "const": false },
        "TRUTH_ASSIGNMENT": { "const": false },
        "BELIEF_PROMOTION": { "const": false }
      }
    },
    "confidence_behavior": { "const": "PRESERVE_INPUT" },
    "not_computable_behavior": { "const": "PRESERVE" },
    "FORECAST_ROUTING": { "const": false },
    "CANON_MUTATION": { "const": false },
    "RUNTIME_MUTATION": { "const": false },
    "EXECUTION_AUTHORITY": { "const": false },
    "TRUTH_ASSIGNMENT": { "const": false },
    "BELIEF_PROMOTION": { "const": false },
    "FINAL_STATUS": { "const": "BELIEF_GRAPH_SCAFFOLD_ADVISORY_ONLY" }
  }
}
