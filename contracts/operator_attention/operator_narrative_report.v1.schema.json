      "required": ["report_only","advisory_only","non_authoritative","source_linked","deterministic_template_only","inference_authority","prediction_allowed","forecast_authority","trend_prediction_allowed","readiness_claims_allowed","recommendation_authority","action_authority","mutation_allowed","authority_granted","execution_authority","routing_change_allowed","queue_mutation_allowed","canon_mutation_allowed","runtime_mutation_allowed","ui_command_authority","adaptive_behavior_allowed","psychological_claims_allowed","speculative_causation_allowed","auto_execute","auto_approve","command_channel","bidirectional_control"],
