    "source_hash_lineage": {
      "type": "object",
      "required": ["weather_hash","enhancer_hash","ledger_hash","corridor_hash","explainer_hash","summary_hash","registry_hash","motif_audit_hash","seasonality_hash","fusion_hash","fusion_audit_hash"]
    },
