    "report_posture": {"enum": ["CLEAR","WATCH","DEGRADED","BLOCKED","NOT_COMPUTABLE"]},
    "report_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_id","title","status","observed_fields","source_refs"],
        "properties": {
          "section_id": {"type": "string"},
          "title": {"type": "string"},
          "status": {"type": "string"},
          "observed_fields": {"type": "object"},
          "source_refs": {"type": "array", "items": {"type": "string"}}
