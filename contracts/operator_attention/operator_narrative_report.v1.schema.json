        "report_only": {"const": true},"advisory_only": {"const": true},"non_authoritative": {"const": true},"source_linked": {"const": true},"deterministic_template_only": {"const": true},
        "inference_authority": {"const": false},"prediction_allowed": {"const": false},"forecast_authority": {"const": false},"trend_prediction_allowed": {"const": false},"readiness_claims_allowed": {"const": false},"recommendation_authority": {"const": false},"action_authority": {"const": false},"mutation_allowed": {"const": false},"authority_granted": {"const": false},"execution_authority": {"const": false},"routing_change_allowed": {"const": false},"queue_mutation_allowed": {"const": false},"canon_mutation_allowed": {"const": false},"runtime_mutation_allowed": {"const": false},"ui_command_authority": {"const": false},"adaptive_behavior_allowed": {"const": false},"psychological_claims_allowed": {"const": false},"speculative_causation_allowed": {"const": false},"auto_execute": {"const": false},"auto_approve": {"const": false},"command_channel": {"const": false},"bidirectional_control": {"const": false}
      }
