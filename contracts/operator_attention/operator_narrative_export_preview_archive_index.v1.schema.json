{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/operator_attention/operator_narrative_export_preview_archive_index.v1.schema.json",
  "title": "Operator Narrative Export Preview Archive Index",
  "type": "object",
  "required": [
    "schema_version",
    "patch_id",
    "archive_index_id",
    "final_status",
    "archive_posture",
    "artifact_role_order",
    "archive_manifest",
    "hash_inventory",
    "source_hashes",
    "receipt_hashes",
    "status_summary",
    "governance_receipt_summary",
    "registry_classification_summary",
    "blocker_summary",
    "governance_flags",
    "provenance",
    "archive_index_hash"
  ],
  "properties": {
    "schema_version": {"const": "OperatorNarrativeExportPreviewArchiveIndex.v1"},
    "patch_id": {"const": "PATCH-P52-OPERATOR-NARRATIVE-EXPORT-PREVIEW-ARCHIVE-INDEX-001"},
    "archive_index_id": {"const": "operator_narrative_export_preview_archive_index_001"},
    "final_status": {"enum": ["ARCHIVE_INDEX_ONLY", "ARCHIVE_INDEX_DEGRADED", "NOT_COMPUTABLE"]},
    "archive_posture": {"enum": ["COMPLETE", "DEGRADED", "NOT_COMPUTABLE"]},
    "artifact_role_order": {
      "type": "array",
      "const": [
        "p46_export_bundle_json",
        "p46_export_bundle_markdown",
        "p47_export_bundle_governance_audit_json",
        "p47_export_bundle_governance_audit_markdown",
        "p48_static_preview_json",
        "p48_static_preview_markdown",
        "p49_static_preview_governance_audit_json",
        "p49_static_preview_governance_audit_markdown"
      ]
    },
    "archive_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "phase", "role", "path", "exists", "readable", "sha256", "classification", "receipt_kind", "status", "posture", "passive_reference_only"],
        "properties": {
          "artifact_id": {"type": "string"},
          "phase": {"type": "string"},
          "role": {"type": "string"},
          "path": {"type": "string"},
          "exists": {"type": "boolean"},
          "readable": {"type": "boolean"},
          "sha256": {"type": "string"},
          "classification": {"const": "SEALED_ARCHIVE_REFERENCE"},
          "receipt_kind": {"type": "string"},
          "status": {"type": "string"},
          "posture": {"type": "string"},
          "passive_reference_only": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "hash_inventory": {"type": "object"},
    "source_hashes": {"type": "object"},
    "receipt_hashes": {"type": "object"},
    "status_summary": {"type": "object"},
    "governance_receipt_summary": {"type": "object"},
    "registry_classification_summary": {"type": "object"},
    "blocker_summary": {"type": "array", "items": {"type": "string"}},
    "governance_flags": {
      "type": "object",
      "properties": {
        "archive_index_only": {"const": true},
        "passive_index_only": {"const": true},
        "read_only": {"const": true},
        "non_authoritative": {"const": true},
        "source_linked": {"const": true},
        "deterministic_manifest": {"const": true},
        "advisory_only": {"const": true},
        "package_created": {"const": false},
        "distribution_claims_allowed": {"const": false},
        "command_authority": {"const": false},
        "ui_command_authority": {"const": false},
        "action_authority": {"const": false},
        "recommendation_authority": {"const": false},
        "inference_authority": {"const": false},
        "prediction_allowed": {"const": false},
        "forecast_authority": {"const": false},
        "trend_prediction_allowed": {"const": false},
        "readiness_claims_allowed": {"const": false},
        "mutation_allowed": {"const": false},
        "authority_granted": {"const": false},
        "execution_authority": {"const": false},
        "routing_change_allowed": {"const": false},
        "queue_mutation_allowed": {"const": false},
        "canon_mutation_allowed": {"const": false},
        "runtime_mutation_allowed": {"const": false},
        "adaptive_behavior_allowed": {"const": false},
        "psychological_claims_allowed": {"const": false},
        "speculative_causation_allowed": {"const": false},
        "auto_execute": {"const": false},
        "auto_approve": {"const": false},
        "command_channel": {"const": false},
        "bidirectional_control": {"const": false},
        "script_allowed": {"const": false},
        "html_script_allowed": {"const": false},
        "external_fetch_allowed": {"const": false},
        "form_allowed": {"const": false},
        "button_allowed": {"const": false}
      },
      "additionalProperties": false
    },
    "provenance": {"type": "object"},
    "archive_index_hash": {"type": "string"}
  },
  "additionalProperties": false
}
