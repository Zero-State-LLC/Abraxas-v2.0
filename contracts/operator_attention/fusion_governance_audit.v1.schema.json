{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/operator_attention/fusion_governance_audit.v1.schema.json",
  "title": "Fusion Governance Audit Receipt",
  "type": "object",
  "required": ["schema_version", "patch_id", "audit_id", "final_status", "audit_posture", "checked_artifacts", "findings", "finding_counts", "primitive_integrity_summary", "lineage_integrity_summary", "governance_integrity_summary", "registry_classification_summary", "namespace_integrity_summary", "source_hashes", "blocker_summary", "governance_flags", "provenance", "audit_hash"],
  "properties": {
    "schema_version": {"const": "FusionGovernanceAudit.v1"},
    "patch_id": {"const": "PATCH-P41-FUSION-GOVERNANCE-AUDIT-001"},
    "audit_id": {"const": "fusion_governance_audit_001"},
    "final_status": {"enum": ["PASS", "WARN", "FAIL", "NOT_COMPUTABLE"]},
    "audit_posture": {"enum": ["CLEAN", "WARNING", "FAILED", "NOT_COMPUTABLE"]},
    "checked_artifacts": {"type": "object"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "severity", "category", "message", "evidence_refs"],
        "properties": {
          "finding_id": {"type": "string"},
          "severity": {"enum": ["PASS", "WARN", "FAIL"]},
          "category": {"enum": ["SOURCE", "NAMESPACE", "PRIMITIVE_ORDERING", "EDGE_INTEGRITY", "LINEAGE", "HASH_INTEGRITY", "GOVERNANCE", "REGISTRY_CLASSIFICATION"]},
          "message": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "finding_counts": {"type": "object"},
    "primitive_integrity_summary": {"type": "object"},
    "lineage_integrity_summary": {"type": "object"},
    "governance_integrity_summary": {"type": "object"},
    "registry_classification_summary": {"type": "object"},
    "namespace_integrity_summary": {"type": "object"},
    "source_hashes": {"type": "object"},
    "blocker_summary": {"type": "array", "items": {"type": "string"}},
    "governance_flags": {
      "type": "object",
      "required": ["audit_only", "advisory_only", "non_authoritative", "mutation_allowed", "authority_granted", "execution_authority", "inference_authority", "forecast_authority", "trend_prediction_allowed", "readiness_claims_allowed", "adaptive_behavior_allowed", "routing_change_allowed", "queue_mutation_allowed", "canon_mutation_allowed", "runtime_mutation_allowed", "ui_command_authority", "psychological_claims_allowed", "speculative_causation_allowed", "auto_execute", "auto_approve", "command_channel", "bidirectional_control"],
      "properties": {
        "audit_only": {"const": true},
        "advisory_only": {"const": true},
        "non_authoritative": {"const": true},
        "mutation_allowed": {"const": false},
        "authority_granted": {"const": false},
        "execution_authority": {"const": false},
        "inference_authority": {"const": false},
        "forecast_authority": {"const": false},
        "trend_prediction_allowed": {"const": false},
        "readiness_claims_allowed": {"const": false},
        "adaptive_behavior_allowed": {"const": false},
        "routing_change_allowed": {"const": false},
        "queue_mutation_allowed": {"const": false},
        "canon_mutation_allowed": {"const": false},
        "runtime_mutation_allowed": {"const": false},
        "ui_command_authority": {"const": false},
        "psychological_claims_allowed": {"const": false},
        "speculative_causation_allowed": {"const": false},
        "auto_execute": {"const": false},
        "auto_approve": {"const": false},
        "command_channel": {"const": false},
        "bidirectional_control": {"const": false}
      }
    },
    "provenance": {"type": "object"},
    "audit_hash": {"type": "string"}
  }
}
