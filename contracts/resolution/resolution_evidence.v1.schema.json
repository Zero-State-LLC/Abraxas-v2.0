{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/resolution/resolution_evidence.v1.schema.json",
  "title": "ResolutionEvidence.v1",
  "type": "object",
  "required": ["schema_version","evidence_packet_id","binding_id","forecast_id","forecast_hash","binding_hash","evidence_items","conflicts","evidence_status","created_by_lane","authority_ref","evidence_hash"],
  "properties": {
    "schema_version": {"const": "ResolutionEvidence.v1"},
    "evidence_packet_id": {"type": "string", "minLength": 1},
    "binding_id": {"type": "string", "minLength": 1},
    "forecast_id": {"type": "string", "minLength": 1},
    "forecast_hash": {"type": "string", "minLength": 1},
    "binding_hash": {"type": "string", "minLength": 1},
    "evidence_items": {"type": "array", "items": {"type": "object", "required": ["item_id","observation"], "properties": {"item_id": {"type": "string", "minLength": 1}, "observation": {"type": "object", "required": ["observation_id","observed_value","observation_type","source_ref","collection_policy","confidence_policy"], "properties": {"observation_id": {"type": "string", "minLength": 1}, "observed_value": {"type": "string", "minLength": 1}, "observation_type": {"type": "string", "minLength": 1}, "source_ref": {"type": "object", "required": ["source_type","source_id","label"], "properties": {"source_type": {"type": "string", "enum": ["OFFICIAL_API","PUBLIC_WEB","MANUAL_RECEIPT","MARKET_SOURCE","SPORTS_DATA_SOURCE","REPO_FIXTURE","OPERATOR_ATTESTATION","NOT_COMPUTABLE"]}, "source_id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}}, "additionalProperties": false}, "collection_policy": {"type": "string", "minLength": 1}, "confidence_policy": {"type": "string", "minLength": 1}}, "additionalProperties": false}}, "additionalProperties": false}},
    "conflicts": {"type": "array", "items": {"type": "object", "required": ["conflict_id","source_ids","conflict_type","severity","resolution_policy"], "properties": {"conflict_id": {"type": "string", "minLength": 1}, "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "conflict_type": {"type": "string", "minLength": 1}, "severity": {"type": "string", "minLength": 1}, "resolution_policy": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "evidence_status": {"type": "string", "enum": ["DRAFT","EVIDENCE_COLLECTED","CONFLICTING","INSUFFICIENT","SETTLEMENT_READY","VOID","NOT_COMPUTABLE"]},
    "created_by_lane": {"type": "string", "enum": ["SHADOW","FORECAST","PROJECTION","CANON","OPERATOR"]},
    "authority_ref": {"type": ["object","null"], "required": ["authority_type","authority_id","label"], "properties": {"authority_type": {"type": "string", "minLength": 1}, "authority_id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "void_reason": {"type": ["string","null"]},
    "evidence_hash": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
