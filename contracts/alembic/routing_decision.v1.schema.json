{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/alembic/routing_decision.v1.schema.json",
  "title": "RoutingDecision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "task_id",
    "run_id",
    "eligible_candidates",
    "rejected_candidates",
    "selected_candidates",
    "router_version",
    "timestamp",
    "FINAL_STATUS"
  ],
  "properties": {
    "schema_version": { "const": "RoutingDecision.v1" },
    "decision_id": { "type": "string" },
    "task_id": { "type": "string" },
    "run_id": { "type": "string" },
    "eligible_candidates": { "type": "array", "items": { "type": "string" } },
    "rejected_candidates": { "type": "array", "items": { "type": "object" } },
    "rejection_reasons": { "type": "object" },
    "candidate_scores": { "type": "array", "items": { "type": "object" } },
    "score_components": { "type": "object" },
    "selected_candidates": { "type": "array", "items": { "type": "string" } },
    "hybrid_plan": { "type": ["object", "null"] },
    "verification_plan": { "type": "array", "items": { "type": "string" } },
    "fusion_policy": { "type": "string" },
    "fallback_plan": { "type": "array", "items": { "type": "string" } },
    "abstention_reason": { "type": ["string", "null"] },
    "policy_refs": { "type": "array", "items": { "type": "string" } },
    "rune_bindings": { "type": "array", "items": { "type": "string" } },
    "router_version": { "type": "string" },
    "score_weight_version": { "type": "string" },
    "score_weights": { "type": "object" },
    "timestamp": { "type": "string" },
    "provenance": { "type": "object" },
    "authority_locks": { "type": "object" },
    "FINAL_STATUS": { "const": "ALEMBIC_SPINE_ADVISORY_ONLY" }
  }
}
