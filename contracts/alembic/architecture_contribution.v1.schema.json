{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/alembic/architecture_contribution.v1.schema.json",
  "title": "ArchitectureContribution.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contribution_id",
    "task_id",
    "run_id",
    "architecture_id",
    "adapter_id",
    "status",
    "output_contract"
  ],
  "properties": {
    "schema_version": { "const": "ArchitectureContribution.v1" },
    "contribution_id": { "type": "string" },
    "task_id": { "type": "string" },
    "run_id": { "type": "string" },
    "architecture_id": { "type": "string" },
    "adapter_id": { "type": "string" },
    "status": { "type": "string" },
    "output_payload": { "type": "object" },
    "output_contract": { "type": "string" },
    "claims": { "type": "array", "items": { "type": "object" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "uncertainty": { "type": ["number", "null"] },
    "confidence": { "type": ["number", "null"] },
    "calibrated_confidence": { "type": ["number", "null"] },
    "calibration_metadata": { "type": "object" },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "resource_usage": { "type": "object" },
    "latency_ms": { "type": "number" },
    "cost": { "type": "number" },
    "energy_usage": { "type": "number" },
    "verification_status": { "type": "string" },
    "policy_status": { "type": "string" },
    "provenance": { "type": "object" },
    "artifact_refs": { "type": "array", "items": { "type": "string" } },
    "error": { "type": ["string", "null"] },
    "is_stub": { "type": "boolean" },
    "lane": { "type": "string", "enum": ["ADVISORY", "SHADOW", "FORECAST"] }
  }
}
