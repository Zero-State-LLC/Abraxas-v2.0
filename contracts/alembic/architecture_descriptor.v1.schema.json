{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/alembic/architecture_descriptor.v1.schema.json",
  "title": "ArchitectureDescriptor.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "architecture_id",
    "architecture_family",
    "implementation_id",
    "version",
    "determinism_level",
    "governance_class",
    "authority_class",
    "adapter_id",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "ArchitectureDescriptor.v1" },
    "architecture_id": { "type": "string", "minLength": 1 },
    "architecture_family": { "type": "string", "minLength": 1 },
    "implementation_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "supported_modalities": { "type": "array", "items": { "type": "string" } },
    "supported_task_types": { "type": "array", "items": { "type": "string" } },
    "input_contracts": { "type": "array", "items": { "type": "string" } },
    "output_contracts": { "type": "array", "items": { "type": "string" } },
    "determinism_level": { "type": "string" },
    "uncertainty_support": { "type": "boolean" },
    "verification_support": { "type": "boolean" },
    "resource_profile": { "type": "object" },
    "latency_profile": { "type": "object" },
    "energy_profile": { "type": "object" },
    "cost_profile": { "type": "object" },
    "context_limits": { "type": "object" },
    "privacy_constraints": { "type": "array", "items": { "type": "string" } },
    "security_constraints": { "type": "array", "items": { "type": "string" } },
    "governance_class": { "type": "string" },
    "authority_class": { "type": "string" },
    "deployment_environment": { "type": "string" },
    "adapter_id": { "type": "string", "minLength": 1 },
    "calibration_profile_id": { "type": ["string", "null"] },
    "historical_metrics_ref": { "type": ["string", "null"] },
    "status": { "type": "string" },
    "is_stub": { "type": "boolean" },
    "provenance": { "type": "object" }
  }
}
