{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/operator_review/v2_hygiene_operator_authorization_evidence_validation_review.v1.schema.json",
  "title": "v2.0 Hygiene Operator Authorization Evidence Validation Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "review_id",
    "review_hash",
    "source_validation_plan_path",
    "source_validation_plan_observed",
    "source_validation_plan_ready",
    "source_validation_plan_file_hash",
    "source_validation_plan_packet_hash",
    "source_validation_plan_status",
    "source_readiness",
    "source_validation_blockers",
    "source_blockers",
    "source_bundle_group_check_count",
    "source_invariant_check_count",
    "source_authority_lock_check_count",
    "review_findings",
    "selected_operator_decision",
    "selected_follow_on_action",
    "terminal_hold_reason",
    "operator_review_required",
    "operator_input_required",
    "operator_attestations_present",
    "operator_evidence_bundle_created",
    "authorization_record_created",
    "authorization_record_creation_authorized",
    "implementation_authorized",
    "v2_module_registration_authorized",
    "rune_registration_authorized",
    "projection_surface_mutation_authorized",
    "schema_mutation_authorized",
    "advisory_only",
    "projection_only",
    "evidence_only",
    "non_authoritative",
    "execution_authority",
    "valid_for_authorization_record",
    "valid_for_execution",
    "valid_for_implementation",
    "recommended_next_action",
    "recommended_next_patch",
    "recommended_next_lane",
    "recommended_next_state",
    "notion_writeback_allowed",
    "github_writeback_allowed",
    "authority_locks"
  ],
  "properties": {
    "schema_version": {
      "const": "V2HygieneOperatorAuthorizationEvidenceValidationReview.v1"
    },
    "status": {
      "enum": [
        "V2_HYGIENE_OPERATOR_AUTHORIZATION_EVIDENCE_VALIDATION_REVIEW_HELD_FOR_OPERATOR",
        "V2_HYGIENE_OPERATOR_AUTHORIZATION_EVIDENCE_VALIDATION_REVIEW_BLOCKED",
        "NOT_COMPUTABLE"
      ]
    },
    "review_id": {
      "const": "v2_hygiene_operator_authorization_evidence_validation_review_001"
    },
    "review_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_validation_plan_path": {
      "const": "out/operator_review/v2_hygiene_operator_authorization_evidence_validation_plan_001.latest.json"
    },
    "source_validation_plan_observed": { "type": "boolean" },
    "source_validation_plan_ready": { "type": "boolean" },
    "source_validation_plan_file_hash": { "type": "string", "minLength": 1 },
    "source_validation_plan_packet_hash": { "type": "string", "minLength": 1 },
    "source_validation_plan_status": { "type": "string", "minLength": 1 },
    "source_readiness": {
      "enum": [
        "SOURCE_VALIDATION_PLAN_READY",
        "SOURCE_VALIDATION_PLAN_NOT_READY",
        "SOURCE_VALIDATION_PLAN_MISSING"
      ]
    },
    "source_validation_blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "source_blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "source_bundle_group_check_count": { "type": "integer", "minimum": 0 },
    "source_invariant_check_count": { "type": "integer", "minimum": 0 },
    "source_authority_lock_check_count": { "type": "integer", "minimum": 0 },
    "review_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "finding_status", "authority_granted"],
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "finding_status": { "type": "string", "minLength": 1 },
          "authority_granted": { "const": false }
        }
      }
    },
    "selected_operator_decision": {
      "enum": ["HOLD_FOR_OPERATOR_REVIEW", "NOT_COMPUTABLE"]
    },
    "selected_follow_on_action": {
      "enum": ["MAINTAIN_V2_HYGIENE_OPERATOR_AUTHORIZATION_HOLD", "NOT_COMPUTABLE"]
    },
    "terminal_hold_reason": { "type": "string", "minLength": 1 },
    "operator_review_required": { "const": true },
    "operator_input_required": { "const": true },
    "operator_attestations_present": { "const": false },
    "operator_evidence_bundle_created": { "const": false },
    "authorization_record_created": { "const": false },
    "authorization_record_creation_authorized": { "const": false },
    "implementation_authorized": { "const": false },
    "v2_module_registration_authorized": { "const": false },
    "rune_registration_authorized": { "const": false },
    "projection_surface_mutation_authorized": { "const": false },
    "schema_mutation_authorized": { "const": false },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "evidence_only": { "const": true },
    "non_authoritative": { "const": true },
    "execution_authority": { "const": false },
    "valid_for_authorization_record": { "const": false },
    "valid_for_execution": { "const": false },
    "valid_for_implementation": { "const": false },
    "recommended_next_action": { "type": "string", "minLength": 1 },
    "recommended_next_patch": { "const": "NOT_COMPUTABLE" },
    "recommended_next_lane": { "const": "NOT_COMPUTABLE" },
    "recommended_next_state": { "const": "hold" },
    "notion_writeback_allowed": { "const": false },
    "github_writeback_allowed": { "const": false },
    "authority_locks": {
      "type": "object",
      "additionalProperties": { "const": false }
    }
  }
}
