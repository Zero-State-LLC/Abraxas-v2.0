{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "adaptive_learning_authorized": { "const": false },
    "advisory_only": { "const": true },
    "authority_locks": {
      "additionalProperties": { "const": false },
      "minProperties": 1,
      "type": "object"
    },
    "authorization_record_created": { "const": false },
    "authorization_record_creation_authorized": { "const": false },
    "brier_resolution_authorized": { "const": false },
    "brier_scoring_contract": {
      "properties": {
        "adaptive_learning_authorized": { "const": false },
        "brier_score_formula": {
          "const": "(forecast_probability - binary_outcome)^2"
        },
        "execution_authority": { "const": false },
        "forecast_routing_authorized": { "const": false },
        "promotion_authorized": { "const": false },
        "resolution_allowed": { "const": false },
        "telemetry_only": { "const": true },
        "telemetry_hooks": {
          "items": {
            "properties": {
              "binary_outcome": { "type": ["integer", "string"] },
              "brier_score": { "type": ["number", "string"] },
              "claim_id": { "type": "string" },
              "forecast_probability": { "maximum": 1.0, "minimum": 0.0, "type": "number" },
              "resolution_allowed": { "const": false },
              "resolution_source": { "type": "string" }
            },
            "required": [
              "claim_id",
              "forecast_probability",
              "binary_outcome",
              "brier_score",
              "resolution_source",
              "resolution_allowed"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "contract_id",
        "telemetry_only",
        "required_fields",
        "brier_score_formula",
        "telemetry_hooks",
        "resolution_allowed",
        "adaptive_learning_authorized",
        "forecast_routing_authorized",
        "promotion_authorized",
        "execution_authority"
      ],
      "type": "object"
    },
    "canon_mutation": { "const": false },
    "completion_validation_claim_evaluation_performed": { "type": "boolean" },
    "decision_record_completed": { "const": false },
    "decision_record_completion_authorized": { "const": false },
    "decision_record_completion_validation_authorized": { "const": false },
    "decision_record_completion_validation_performed": { "const": false },
    "decision_record_created": { "const": false },
    "decision_record_creation_authorized": { "const": false },
    "decision_record_emission_authorized": { "const": false },
    "decision_record_emitted": { "const": false },
    "decision_record_finalization_authorized": { "const": false },
    "decision_record_finalized": { "const": false },
    "decision_record_materialization_authorized": { "const": false },
    "decision_record_materialized": { "const": false },
    "downstream": { "const": "NOT_COMPUTABLE" },
    "evidence_bundle_created": { "const": false },
    "evidence_bundle_creation_authorized": { "const": false },
    "execution_authority": { "const": false },
    "execution_packet": {
      "properties": {
        "authority_denials": {
          "additionalProperties": { "const": false },
          "minProperties": 1,
          "type": "object"
        },
        "claim_evaluation_count": { "minimum": 0, "type": "integer" },
        "claim_evaluation_performed": { "type": "boolean" },
        "claims_validated_count": { "minimum": 0, "type": "integer" },
        "completion_validation_authorized": { "const": false },
        "completion_validation_performed": { "const": false },
        "executed_validation_claims": {
          "items": {
            "properties": {
              "claim": { "type": "string" },
              "claim_id": { "type": "string" },
              "claim_validated": { "type": "boolean" },
              "execution_status": {
                "enum": ["CLAIM_VALIDATED", "BLOCKED"]
              },
              "expected_value": { "type": "string" },
              "fail_closed_blocker": { "type": "string" },
              "observed_value": { "type": "string" },
              "provenance": { "type": "string" },
              "risk_level": { "enum": ["LOW", "MEDIUM", "HIGH"] }
            },
            "required": [
              "claim_id",
              "claim",
              "provenance",
              "risk_level",
              "expected_value",
              "observed_value",
              "claim_validated",
              "execution_status",
              "fail_closed_blocker"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "execution_receipt_only": { "const": true },
        "record_id": { "type": "string" },
        "record_output_path": { "type": "string" },
        "source_packet_hashes": { "type": "object" }
      },
      "required": [
        "contract_id",
        "record_id",
        "record_output_path",
        "source_packet_hashes",
        "executed_validation_claims",
        "claim_evaluation_count",
        "claims_validated_count",
        "claim_evaluation_performed",
        "completion_validation_authorized",
        "completion_validation_performed",
        "authority_denials",
        "execution_receipt_only"
      ],
      "type": "object"
    },
    "execution_receipt_hash": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "execution_receipt_ready": { "type": "boolean" },
    "forecast_routing_authorized": { "const": false },
    "github_writeback_allowed": { "const": false },
    "implementation_authorized": { "const": false },
    "non_authoritative": { "const": true },
    "notion_writeback_allowed": { "const": false },
    "operator_attestation_created": { "const": false },
    "operator_evidence_bundle_created": { "const": false },
    "operator_evidence_bundle_creation_authorized": { "const": false },
    "package_lock_mutation_authorized": { "const": false },
    "projection_only": { "const": true },
    "promotion_authorized": { "const": false },
    "receipt_id": {
      "const": "v2_hygiene_phase1_stabilization_decision_record_completion_validation_execution_receipt_001"
    },
    "recommended_next_lane": {
      "enum": [
        "V2_HYGIENE_PHASE1_STABILIZATION_DECISION_RECORD_COMPLETION_VALIDATION_OPERATOR_REVIEW_GATE_001",
        "NOT_COMPUTABLE"
      ]
    },
    "rune_governance_mapping": {
      "items": {
        "properties": {
          "authority_granted": { "const": false },
          "governance_mapping": { "type": "string" },
          "risk_level": { "enum": ["LOW", "MEDIUM", "HIGH"] },
          "rune": { "type": "string" }
        },
        "required": [
          "rune",
          "governance_mapping",
          "authority_granted",
          "risk_level"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "runtime_mutation": { "const": false },
    "safe_to_auto_continue": { "const": false },
    "schema_version": {
      "const": "V2HygienePhase1StabilizationDecisionRecordCompletionValidationExecutionReceipt.v1"
    },
    "source_blockers": { "items": { "type": "string" }, "type": "array" },
    "source_readiness": {
      "enum": ["SOURCE_ARTIFACTS_READY", "SOURCE_ARTIFACTS_NOT_READY"]
    },
    "source_records": {
      "items": {
        "additionalProperties": true,
        "required": [
          "source_id",
          "path",
          "observed",
          "file_hash",
          "packet_hash",
          "status",
          "expected_status",
          "authority_locks_all_false"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "V2_HYGIENE_PHASE1_STABILIZATION_DECISION_RECORD_COMPLETION_VALIDATION_EXECUTION_RECEIPT_READY",
        "V2_HYGIENE_PHASE1_STABILIZATION_DECISION_RECORD_COMPLETION_VALIDATION_EXECUTION_RECEIPT_BLOCKED"
      ]
    },
    "valid_for_decision_record_completion": { "const": false },
    "valid_for_decision_record_completion_validation": { "const": false },
    "valid_for_decision_record_creation": { "const": false },
    "valid_for_decision_record_emission": { "const": false },
    "valid_for_decision_record_finalization": { "const": false },
    "valid_for_decision_record_materialization": { "const": false },
    "valid_for_execution": { "const": false },
    "valid_for_implementation": { "const": false },
    "valid_for_writeback": { "const": false }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "status",
    "sources_observed",
    "source_records",
    "source_blockers",
    "source_readiness",
    "execution_receipt_ready",
    "completion_validation_claim_evaluation_performed",
    "execution_packet",
    "brier_scoring_contract",
    "rune_governance_mapping",
    "recommended_next_lane",
    "downstream",
    "decision_record_created",
    "decision_record_creation_authorized",
    "decision_record_completed",
    "decision_record_completion_authorized",
    "decision_record_completion_validation_authorized",
    "decision_record_completion_validation_performed",
    "decision_record_emitted",
    "decision_record_emission_authorized",
    "decision_record_finalized",
    "decision_record_finalization_authorized",
    "decision_record_materialized",
    "decision_record_materialization_authorized",
    "authorization_record_created",
    "authorization_record_creation_authorized",
    "evidence_bundle_created",
    "evidence_bundle_creation_authorized",
    "operator_attestation_created",
    "operator_evidence_bundle_created",
    "operator_evidence_bundle_creation_authorized",
    "implementation_authorized",
    "notion_writeback_allowed",
    "github_writeback_allowed",
    "runtime_mutation",
    "canon_mutation",
    "execution_authority",
    "forecast_routing_authorized",
    "adaptive_learning_authorized",
    "promotion_authorized",
    "brier_resolution_authorized",
    "package_lock_mutation_authorized",
    "valid_for_decision_record_creation",
    "valid_for_decision_record_completion",
    "valid_for_decision_record_completion_validation",
    "valid_for_decision_record_emission",
    "valid_for_decision_record_finalization",
    "valid_for_decision_record_materialization",
    "valid_for_writeback",
    "valid_for_implementation",
    "valid_for_execution",
    "safe_to_auto_continue",
    "authority_locks",
    "execution_receipt_hash"
  ],
  "type": "object"
}
