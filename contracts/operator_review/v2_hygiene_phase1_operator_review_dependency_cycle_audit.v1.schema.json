{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/operator_review/v2_hygiene_phase1_operator_review_dependency_cycle_audit.v1.schema.json",
  "title": "v2.0 Hygiene Phase 1 Operator Review Dependency Cycle Audit",
  "type": "object",
  "required": [
    "schema_version",
    "audit_id",
    "audit_status",
    "source_records",
    "cycle_observed",
    "cycle_edges",
    "stabilization_decision",
    "naive_regeneration_safe",
    "recommended_next_action",
    "recommended_next_lane",
    "recommended_next_patch",
    "audit_findings",
    "advisory_only",
    "projection_only",
    "evidence_only",
    "non_authoritative",
    "authorization_granted",
    "authorization_record_created",
    "operator_attestation_created",
    "operator_evidence_bundle_created",
    "implementation_authorized",
    "valid_for_implementation",
    "valid_for_execution",
    "safe_to_prepare_patch",
    "safe_to_auto_continue",
    "hygiene_code_creation_authorized",
    "schema_file_creation_authorized",
    "rune_registration_authorized",
    "v2_module_registration_authorized",
    "strict_mode_enablement_authorized",
    "notion_writeback_allowed",
    "github_writeback_allowed",
    "runtime_mutation",
    "queue_mutation",
    "scheduler_mutation",
    "canon_mutation",
    "schema_mutation",
    "authority_locks",
    "downstream",
    "audit_hash"
  ],
  "properties": {
    "schema_version": {"const": "V2HygienePhase1OperatorReviewDependencyCycleAudit.v1"},
    "audit_id": {"const": "v2_hygiene_phase1_operator_review_dependency_cycle_audit_001"},
    "audit_status": {
      "enum": [
        "V2_HYGIENE_PHASE1_OPERATOR_REVIEW_DEPENDENCY_CYCLE_AUDIT_HELD_FOR_OPERATOR",
        "V2_HYGIENE_PHASE1_OPERATOR_REVIEW_DEPENDENCY_CYCLE_AUDIT_BLOCKED"
      ]
    },
    "source_records": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source_observed",
          "observed_status",
          "current_hash",
          "valid_for_execution",
          "implementation_authorized"
        ],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "source_observed": {"type": "boolean"},
          "observed_status": {"type": "string", "minLength": 1},
          "current_hash": {"type": "string", "minLength": 1},
          "valid_for_execution": {"const": false},
          "implementation_authorized": {"const": false}
        }
      }
    },
    "cycle_observed": {"type": "boolean"},
    "cycle_edges": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "from_path",
          "to_path",
          "recorded_hash",
          "current_hash",
          "hash_current"
        ],
        "properties": {
          "edge_id": {"type": "string", "minLength": 1},
          "from_path": {"type": "string", "minLength": 1},
          "to_path": {"type": "string", "minLength": 1},
          "recorded_hash": {"type": "string", "minLength": 1},
          "current_hash": {"type": "string", "minLength": 1},
          "hash_current": {"type": "boolean"}
        }
      }
    },
    "stabilization_decision": {"const": "HOLD_FOR_OPERATOR_STABILIZATION_STRATEGY"},
    "naive_regeneration_safe": {"const": false},
    "recommended_next_action": {"type": "string", "minLength": 1},
    "recommended_next_lane": {"const": "NOT_COMPUTABLE"},
    "recommended_next_patch": {"const": "NOT_COMPUTABLE"},
    "audit_findings": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "finding_status", "authority_granted"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "finding_status": {"type": "string", "minLength": 1},
          "authority_granted": {"const": false}
        }
      }
    },
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "evidence_only": {"const": true},
    "non_authoritative": {"const": true},
    "authorization_granted": {"const": false},
    "authorization_record_created": {"const": false},
    "operator_attestation_created": {"const": false},
    "operator_evidence_bundle_created": {"const": false},
    "implementation_authorized": {"const": false},
    "valid_for_implementation": {"const": false},
    "valid_for_execution": {"const": false},
    "safe_to_prepare_patch": {"const": false},
    "safe_to_auto_continue": {"const": false},
    "hygiene_code_creation_authorized": {"const": false},
    "schema_file_creation_authorized": {"const": false},
    "rune_registration_authorized": {"const": false},
    "v2_module_registration_authorized": {"const": false},
    "strict_mode_enablement_authorized": {"const": false},
    "notion_writeback_allowed": {"const": false},
    "github_writeback_allowed": {"const": false},
    "runtime_mutation": {"const": false},
    "queue_mutation": {"const": false},
    "scheduler_mutation": {"const": false},
    "canon_mutation": {"const": false},
    "schema_mutation": {"const": false},
    "authority_locks": {
      "type": "object",
      "additionalProperties": {"const": false},
      "minProperties": 1
    },
    "downstream": {"const": "NOT_COMPUTABLE"},
    "audit_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
