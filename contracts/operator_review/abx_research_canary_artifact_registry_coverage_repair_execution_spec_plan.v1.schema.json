{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/operator_review/abx_research_canary_artifact_registry_coverage_repair_execution_spec_plan.v1.schema.json",
  "title": "ABX Research Canary Registry Repair Execution Spec Plan",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "status",
    "spec_plan_id",
    "spec_plan_hash",
    "command",
    "authorization_scope",
    "execution_allowed",
    "repair_execution_performed",
    "registry_mutation_performed",
    "proposed_repair_steps",
    "blocked_actions",
    "downstream_status",
    "recommended_next_lane"
  ],
  "properties": {
    "schema_version": {
      "const": "AbxResearchCanaryArtifactRegistryCoverageRepairExecutionSpecPlan.v1"
    },
    "artifact_id": {
      "const": "ABX_RESEARCH_CANARY_ARTIFACT_REGISTRY_COVERAGE_REPAIR_EXECUTION_SPEC_PLAN_001"
    },
    "spec_plan_id": {
      "const": "ABX_RESEARCH_CANARY_ARTIFACT_REGISTRY_COVERAGE_REPAIR_EXECUTION_SPEC_PLAN_001"
    },
    "spec_plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "command": {
      "const": "BUILD_ABX_RESEARCH_CANARY_ARTIFACT_REGISTRY_COVERAGE_REPAIR_EXECUTION_SPEC_PLAN_001"
    },
    "status": {
      "enum": [
        "RESEARCH_CANARY_REGISTRY_COVERAGE_REPAIR_EXECUTION_SPEC_PLAN_READY",
        "RESEARCH_CANARY_REGISTRY_COVERAGE_REPAIR_EXECUTION_SPEC_PLAN_BLOCKED"
      ]
    },
    "authorization_scope": {
      "const": "RESEARCH_CANARY_REGISTRY_COVERAGE_REPAIR_EXECUTION_SPEC_AUTHORING_ONLY"
    },
    "execution_allowed": { "const": false },
    "repair_execution_performed": { "const": false },
    "registry_mutation_performed": { "const": false },
    "downstream_status": {
      "enum": ["READY_FOR_EXECUTION_AUTHORIZATION_GATE", "NOT_COMPUTABLE"]
    },
    "recommended_next_lane": {
      "enum": [
        "ABX_RESEARCH_CANARY_ARTIFACT_REGISTRY_COVERAGE_REPAIR_EXECUTION_AUTHORIZATION_GATE_001",
        "NOT_COMPUTABLE"
      ]
    },
    "proposed_repair_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "step_name", "execution_allowed", "repair_execution_performed"],
        "properties": {
          "execution_allowed": { "const": false },
          "repair_execution_performed": { "const": false }
        }
      }
    },
    "blocked_actions": {
      "type": "array",
      "contains": { "const": "DIRECT_REGISTRY_REPAIR_EXECUTION" }
    }
  },
  "additionalProperties": true
}
