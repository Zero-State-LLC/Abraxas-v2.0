{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/operator_review/abx_artifact_lineage_registry_direct_repair_execution_authorization_record.v1.schema.json",
  "title": "AbxArtifactLineageRegistryDirectRepairExecutionAuthorizationRecord.v1",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "status",
    "authorization_record_id",
    "authorization_record_hash",
    "command",
    "authorization_record_only",
    "source_authorization_gate",
    "operator_authorization",
    "authorization_scope",
    "authorization_granted",
    "execution_authority",
    "execution_allowed",
    "repair_execution_performed",
    "safe_to_prepare_execution_pr",
    "scoped_repair_actions",
    "blocked_actions",
    "required_pre_execution_validation",
    "validation_gates",
    "downstream_status",
    "recommended_next_lane",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "AbxArtifactLineageRegistryDirectRepairExecutionAuthorizationRecord.v1" },
    "artifact_id": { "const": "ABX_ARTIFACT_LINEAGE_REGISTRY_DIRECT_REPAIR_EXECUTION_AUTHORIZATION_RECORD" },
    "status": {
      "enum": [
        "ABX_ARTIFACT_LINEAGE_REGISTRY_DIRECT_REPAIR_EXECUTION_AUTHORIZATION_RECORD_GRANTED_FOR_SCOPED_EXECUTION_PR",
        "ABX_ARTIFACT_LINEAGE_REGISTRY_DIRECT_REPAIR_EXECUTION_AUTHORIZATION_RECORD_CONSUMED_BY_SCOPED_EXECUTION_RECEIPT",
        "ABX_ARTIFACT_LINEAGE_REGISTRY_DIRECT_REPAIR_EXECUTION_AUTHORIZATION_RECORD_BLOCKED"
      ]
    },
    "authorization_record_id": {
      "const": "abx_artifact_lineage_registry_direct_repair_execution_authorization_record_001"
    },
    "authorization_record_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "command": { "const": "BUILD_ABX_ARTIFACT_LINEAGE_REGISTRY_DIRECT_REPAIR_EXECUTION_AUTHORIZATION_RECORD_001" },
    "authorization_record_only": { "const": true },
    "source_authorization_gate": {
      "type": "object",
      "required": [
        "source_authorization_gate_path",
        "source_authorization_gate_hash",
        "source_status",
        "source_gate_ready"
      ],
      "properties": {
        "source_authorization_gate_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_status": {
          "const": "ABX_ARTIFACT_LINEAGE_REGISTRY_DIRECT_REPAIR_EXECUTION_AUTHORIZATION_GATE_HELD_FOR_OPERATOR"
        },
        "source_gate_ready": { "const": true }
      },
      "additionalProperties": true
    },
    "operator_authorization": {
      "type": "object",
      "required": [
        "operator_id",
        "operator_name",
        "operator_role",
        "operator_instruction_observed",
        "authorization_timestamp_utc",
        "authorization_scope_acknowledged",
        "execution_rationale",
        "runner_casing_policy_decision",
        "notion_mapping_evidence_disposition"
      ],
      "properties": {
        "operator_instruction_observed": { "const": "authorize" },
        "authorization_scope_acknowledged": { "const": "SCOPED_DIRECT_ARTIFACT_LINEAGE_REPAIR_EXECUTION_PR_ONLY" },
        "runner_casing_policy_decision": { "const": "NO_RUNNER_CASING_POLICY_OVERRIDE_AUTHORIZED" },
        "notion_mapping_evidence_disposition": { "const": "NO_NOTION_MAPPING_COMPLETENESS_CLAIM_AUTHORIZED" }
      },
      "additionalProperties": true
    },
    "authorization_scope": { "const": "SCOPED_DIRECT_ARTIFACT_LINEAGE_REPAIR_EXECUTION_PR_ONLY" },
    "authorization_granted": { "const": true },
    "execution_authority": { "const": true },
    "execution_allowed": { "const": false },
    "repair_execution_performed": { "const": false },
    "implementation_authorized": { "const": true },
    "valid_for_execution": { "const": false },
    "valid_for_repair": { "const": false },
    "safe_to_auto_continue": { "const": false },
    "safe_to_prepare_execution_pr": { "type": "boolean" },
    "runtime_mutation_allowed": { "const": false },
    "canon_mutation_allowed": { "const": false },
    "queue_mutation_allowed": { "const": false },
    "notion_completeness_claim_allowed": { "const": false },
    "runner_casing_policy_override_allowed": { "const": false },
    "github_writeback_allowed": { "const": false },
    "notion_writeback_allowed": { "const": false },
    "scoped_repair_actions": {
      "type": "array",
      "contains": { "const": "DIRECT_REGISTRY_REPAIR_EXECUTION_PR_PREPARATION" }
    },
    "blocked_actions": {
      "type": "array",
      "contains": { "const": "UNSCOPED_REPAIR_EXECUTION" }
    },
    "required_pre_execution_validation": {
      "type": "array",
      "contains": { "const": "fast_ci_before_pr" }
    },
    "validation_gates": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "scoped_execution_receipt": {
      "type": "object",
      "required": ["path", "hash", "status", "observed"],
      "properties": {
        "path": {
          "const": "out/operator_review/abx_artifact_lineage_registry_direct_repair_scoped_execution_receipt_001.latest.json"
        },
        "status": {
          "enum": [
            "ABX_ARTIFACT_LINEAGE_REGISTRY_DIRECT_REPAIR_SCOPED_EXECUTION_RECEIPT_EMITTED",
            "NOT_COMPUTABLE"
          ]
        },
        "observed": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "downstream_status": {
      "enum": [
        "READY_FOR_SCOPED_EXECUTION_PR_PREPARATION",
        "SCOPED_EXECUTION_RECEIPT_OBSERVED",
        "NOT_COMPUTABLE"
      ]
    },
    "recommended_next_lane": {
      "enum": [
        "ABX_ARTIFACT_LINEAGE_REGISTRY_DIRECT_REPAIR_SCOPED_EXECUTION_PR",
        "ABX_ARTIFACT_LINEAGE_REGISTRY_TRACEABILITY_AUDIT_REGENERATION",
        "NOT_COMPUTABLE"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_authorization_gate_path",
        "source_authorization_gate_hash",
        "source_authorization_gate_status",
        "source_recommended_next_action"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
