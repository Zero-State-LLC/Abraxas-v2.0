{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GlobalIngestOperatorDecisionEvidenceCollectionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "plan_id",
    "plan_hash",
    "command",
    "artifact_type",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "evidence_collection_only",
    "operator_input_required",
    "implementation_authorized",
    "execution_authority",
    "promotion_allowed",
    "forecast_weight_allowed",
    "runtime_mutation_allowed",
    "baseline_mutation_allowed",
    "canon_mutation_allowed",
    "valid_for_execution",
    "decision_scope",
    "target_pipeline_id",
    "target_display_name",
    "recommended_default_decision",
    "decision_options",
    "recommended_next_action",
    "recommended_next_patch",
    "recommended_next_state",
    "source_request_path",
    "source_request_observed",
    "source_request_id",
    "source_request_hash",
    "source_template_path",
    "source_template_observed",
    "source_template_hash",
    "evidence_bundle_groups",
    "required_review_artifacts",
    "future_record_output_candidates",
    "disallowed_follow_on_actions",
    "evidence_readiness_summary",
    "blockers",
    "source_hashes"
  ],
  "properties": {
    "schema_version": { "const": "GlobalIngestOperatorDecisionEvidenceCollectionPlan.v1" },
    "status": {
      "enum": [
        "GLOBAL_INGEST_OPERATOR_DECISION_EVIDENCE_COLLECTION_PLAN_READY",
        "NOT_COMPUTABLE"
      ]
    },
    "plan_id": { "const": "global_ingest_operator_decision_evidence_collection_plan_001" },
    "plan_hash": { "type": "string", "minLength": 1 },
    "command": { "const": "BUILD_GLOBAL_INGEST_OPERATOR_DECISION_EVIDENCE_COLLECTION_PLAN_001" },
    "artifact_type": { "const": "GlobalIngestOperatorDecisionEvidenceCollectionPlan.v1" },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "non_authoritative": { "const": true },
    "evidence_collection_only": { "const": true },
    "operator_input_required": { "const": true },
    "implementation_authorized": { "const": false },
    "execution_authority": { "const": false },
    "promotion_allowed": { "const": false },
    "forecast_weight_allowed": { "const": false },
    "runtime_mutation_allowed": { "const": false },
    "baseline_mutation_allowed": { "const": false },
    "canon_mutation_allowed": { "const": false },
    "valid_for_execution": { "const": false },
    "decision_scope": { "const": "IMPLEMENTATION_SPEC_DECISION_REQUIRED" },
    "target_pipeline_id": { "const": "oracle_signal" },
    "target_display_name": { "type": "string", "minLength": 1 },
    "recommended_default_decision": { "const": "HOLD" },
    "decision_options": {
      "type": "array",
      "items": {
        "enum": [
          "HOLD",
          "APPROVE_SEPARATE_IMPLEMENTATION_SPEC",
          "REQUEST_FRESH_NOTION_SPEC",
          "REJECT_IMPLEMENTATION_SPEC"
        ]
      },
      "minItems": 4,
      "uniqueItems": true
    },
    "recommended_next_action": { "type": "string", "minLength": 1 },
    "recommended_next_patch": { "const": "NOT_COMPUTABLE" },
    "recommended_next_state": { "const": "hold" },
    "source_request_path": { "const": "out/operator_review/global_ingest_operator_decision_request_001.latest.json" },
    "source_request_observed": { "type": "boolean" },
    "source_request_id": { "type": "string", "minLength": 1 },
    "source_request_hash": { "type": "string", "minLength": 1 },
    "source_template_path": { "const": "out/operator_review/global_ingest_operator_decision_record_template_001.latest.json" },
    "source_template_observed": { "type": "boolean" },
    "source_template_hash": { "type": "string", "minLength": 1 },
    "evidence_bundle_groups": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "required_fields", "collection_steps"],
        "properties": {
          "group_id": { "type": "string", "minLength": 1 },
          "required_fields": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "collection_steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["step_id", "field", "required"],
              "properties": {
                "step_id": { "type": "string", "minLength": 1 },
                "field": { "type": "string", "minLength": 1 },
                "required": { "const": true }
              }
            }
          }
        }
      }
    },
    "required_review_artifacts": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "future_record_output_candidates": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "disallowed_follow_on_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_readiness_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_observed",
        "template_observed",
        "required_group_count",
        "blocker_count"
      ],
      "properties": {
        "request_observed": { "type": "boolean" },
        "template_observed": { "type": "boolean" },
        "required_group_count": { "const": 5 },
        "blocker_count": { "type": "integer", "minimum": 0 }
      }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_ingest_operator_decision_request",
        "global_pipeline_gap_backlog",
        "global_ingest_alignment_plan",
        "oracle_signal_intake_boundary_implementation_plan",
        "notion_operator_decision_backlog",
        "notion_spec_completion_queue",
        "global_pipeline_doctrine_proof"
      ],
      "properties": {
        "global_ingest_operator_decision_request": { "type": "string", "minLength": 1 },
        "global_pipeline_gap_backlog": { "type": "string", "minLength": 1 },
        "global_ingest_alignment_plan": { "type": "string", "minLength": 1 },
        "oracle_signal_intake_boundary_implementation_plan": { "type": "string", "minLength": 1 },
        "notion_operator_decision_backlog": { "type": "string", "minLength": 1 },
        "notion_spec_completion_queue": { "type": "string", "minLength": 1 },
        "global_pipeline_doctrine_proof": { "type": "string", "minLength": 1 }
      }
    }
  }
}
