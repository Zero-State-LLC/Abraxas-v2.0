{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/operator_review/v2_hygiene_operator_authorization_evidence_validation_review_evidence_plan.v1.schema.json",
  "title": "v2.0 Hygiene Operator Authorization Evidence Validation Review Evidence Plan",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "plan_id",
    "plan_hash",
    "source_review_path",
    "source_review_observed",
    "source_review_ready",
    "source_review_status",
    "source_review_hash",
    "source_review_terminal_hold_reason",
    "source_validation_plan_hash",
    "source_validation_blockers",
    "source_blockers",
    "evidence_plan_only",
    "operator_input_required",
    "recommended_default_disposition",
    "recommended_next_lane",
    "recommended_next_patch",
    "recommended_next_state",
    "recommended_next_action",
    "safe_to_auto_continue",
    "operator_attestations_present",
    "operator_decision_attested",
    "evidence_bundle_created",
    "operator_evidence_bundle_created",
    "operator_attestation_created",
    "authorization_record_created",
    "authorization_record_creation_authorized",
    "implementation_authorized",
    "v2_module_registration_authorized",
    "rune_registration_authorized",
    "projection_surface_mutation_authorized",
    "schema_mutation_authorized",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "execution_authority",
    "valid_for_authorization_record",
    "valid_for_execution",
    "valid_for_implementation",
    "evidence_bundle_groups",
    "required_review_artifacts",
    "future_evidence_output_candidates",
    "future_record_output_candidates",
    "disallowed_follow_on_actions",
    "evidence_readiness_summary",
    "blockers",
    "authority_locks"
  ],
  "properties": {
    "schema_version": {
      "const": "V2HygieneOperatorAuthorizationEvidenceValidationReviewEvidencePlan.v1"
    },
    "status": {
      "enum": [
        "V2_HYGIENE_OPERATOR_AUTHORIZATION_EVIDENCE_VALIDATION_REVIEW_EVIDENCE_PLAN_READY",
        "V2_HYGIENE_OPERATOR_AUTHORIZATION_EVIDENCE_VALIDATION_REVIEW_EVIDENCE_PLAN_BLOCKED"
      ]
    },
    "plan_id": {
      "const": "v2_hygiene_operator_authorization_evidence_validation_review_evidence_plan_001"
    },
    "plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_review_path": {
      "const": "out/operator_review/v2_hygiene_operator_authorization_evidence_validation_review_001.latest.json"
    },
    "source_review_observed": { "type": "boolean" },
    "source_review_ready": { "type": "boolean" },
    "source_review_status": { "type": "string", "minLength": 1 },
    "source_review_hash": { "type": "string", "minLength": 1 },
    "source_review_terminal_hold_reason": { "type": "string", "minLength": 1 },
    "source_validation_plan_hash": { "type": "string", "minLength": 1 },
    "source_validation_blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "source_blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_plan_only": { "const": true },
    "operator_input_required": { "const": true },
    "recommended_default_disposition": { "const": "HOLD_FOR_OPERATOR_REVIEW" },
    "recommended_next_lane": { "const": "NOT_COMPUTABLE" },
    "recommended_next_patch": { "const": "NOT_COMPUTABLE" },
    "recommended_next_state": { "const": "hold" },
    "recommended_next_action": { "type": "string", "minLength": 1 },
    "safe_to_auto_continue": { "const": false },
    "operator_attestations_present": { "const": false },
    "operator_decision_attested": { "const": false },
    "evidence_bundle_created": { "const": false },
    "operator_evidence_bundle_created": { "const": false },
    "operator_attestation_created": { "const": false },
    "authorization_record_created": { "const": false },
    "authorization_record_creation_authorized": { "const": false },
    "implementation_authorized": { "const": false },
    "v2_module_registration_authorized": { "const": false },
    "rune_registration_authorized": { "const": false },
    "projection_surface_mutation_authorized": { "const": false },
    "schema_mutation_authorized": { "const": false },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "non_authoritative": { "const": true },
    "execution_authority": { "const": false },
    "valid_for_authorization_record": { "const": false },
    "valid_for_execution": { "const": false },
    "valid_for_implementation": { "const": false },
    "evidence_bundle_groups": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "required_fields", "collection_steps"],
        "properties": {
          "group_id": { "type": "string", "minLength": 1 },
          "required_fields": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "collection_steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["step_id", "field", "required", "attested"],
              "properties": {
                "step_id": { "type": "string", "minLength": 1 },
                "field": { "type": "string", "minLength": 1 },
                "required": { "const": true },
                "attested": { "const": false }
              }
            }
          }
        }
      }
    },
    "required_review_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "future_evidence_output_candidates": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "future_record_output_candidates": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "disallowed_follow_on_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_readiness_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_review_observed",
        "source_review_ready",
        "required_group_count",
        "source_validation_blocker_count",
        "blocker_count"
      ],
      "properties": {
        "source_review_observed": { "type": "boolean" },
        "source_review_ready": { "type": "boolean" },
        "required_group_count": { "const": 5 },
        "source_validation_blocker_count": { "type": "integer", "minimum": 0 },
        "blocker_count": { "type": "integer", "minimum": 0 }
      }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "authority_locks": {
      "type": "object",
      "additionalProperties": { "const": false },
      "minProperties": 1
    }
  },
  "additionalProperties": false
}
