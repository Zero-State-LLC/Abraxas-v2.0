      "const": true
    },
    "projection_only": {
      "const": true
    },
    "evidence_only": {
      "const": true
    },
    "non_authoritative": {
      "const": true
    },
    "authorization_granted": {
      "const": false
    },
    "implementation_authorized": {
      "const": false
