{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/operator_review/abx_artifact_lineage_registry_traceability_audit_regeneration_receipt.v1.schema.json",
  "title": "ABX Artifact Lineage Registry Traceability Audit Regeneration Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "status",
    "audit_regeneration_performed",
    "downstream_status",
    "recommended_next_lane",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "AbxArtifactLineageRegistryTraceabilityAuditRegenerationReceipt.v1"
    },
    "artifact_id": {
      "const": "ABX_ARTIFACT_LINEAGE_REGISTRY_TRACEABILITY_AUDIT_REGENERATION_001"
    },
    "status": {
      "enum": [
        "ABX_ARTIFACT_LINEAGE_REGISTRY_TRACEABILITY_AUDIT_REGENERATION_RECEIPT_EMITTED",
        "ABX_ARTIFACT_LINEAGE_REGISTRY_TRACEABILITY_AUDIT_REGENERATION_RECEIPT_BLOCKED"
      ]
    },
    "audit_regeneration_performed": { "const": true },
    "downstream_status": { "const": "TRACEABILITY_AUDIT_REGENERATION_COMPLETE" },
    "recommended_next_lane": { "const": "NOT_COMPUTABLE" },
    "receipt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
