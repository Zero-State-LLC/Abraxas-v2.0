{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/operator_review/abx_research_canary_orphan_output_registry_policy_operator_decision_record.v1.schema.json",
  "title": "ABX Research Canary Orphan Output Registry Policy Operator Decision Record",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "status",
    "decision_record_id",
    "selected_decision",
    "registry_mutation_performed",
    "orphan_count",
    "recommended_next_lane",
    "decision_record_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "AbxResearchCanaryOrphanOutputRegistryPolicyOperatorDecisionRecord.v1"
    },
    "artifact_id": {
      "const": "ABX_RESEARCH_CANARY_ORPHAN_OUTPUT_REGISTRY_POLICY_OPERATOR_DECISION_RECORD_001"
    },
    "status": {
      "enum": [
        "ABX_RESEARCH_CANARY_ORPHAN_OUTPUT_REGISTRY_POLICY_OPERATOR_DECISION_RECORD_EMITTED",
        "ABX_RESEARCH_CANARY_ORPHAN_OUTPUT_REGISTRY_POLICY_OPERATOR_DECISION_RECORD_BLOCKED"
      ]
    },
    "selected_decision": { "const": "MAINTAIN_EXCLUDE_FROM_CANONICAL_REPAIR" },
    "registry_mutation_performed": { "const": false },
    "orphan_count": { "const": 10 },
    "recommended_next_lane": {
      "enum": [
        "ABX_RESEARCH_CANARY_ORPHAN_OUTPUT_REGISTRY_POLICY_CHAIN_CLOSURE_RECEIPT_001",
        "NOT_COMPUTABLE"
      ]
    },
    "decision_record_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
