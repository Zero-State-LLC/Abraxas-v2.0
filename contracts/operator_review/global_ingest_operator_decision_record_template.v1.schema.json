    "required_operator_identity_fields": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "required_decision_fields": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "required_acknowledgement_fields": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "required_evidence_fields": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "required_output_fields": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "allowed_follow_on_actions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "disallowed_follow_on_actions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
