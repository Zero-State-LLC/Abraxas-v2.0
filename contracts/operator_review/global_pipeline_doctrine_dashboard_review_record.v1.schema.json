{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/operator_review/global_pipeline_doctrine_dashboard_review_record.v1.schema.json",
  "title": "GlobalPipelineDoctrineDashboardReviewRecord.v1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "record_id",
    "record_hash",
    "command",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "decision_scope",
    "selected_decision",
    "dashboard_review_accepted_as_reviewed_evidence",
    "doctrine_review_accepted_as_reviewed_evidence",
    "gap_backlog_accepted_as_reviewed_evidence",
    "observed_counts",
    "implementation_authorized",
    "execution_authority",
    "runtime_mutation_allowed",
    "scheduler_mutation_allowed",
    "ingest_runner_mutation_allowed",
    "pipeline_or_route_mutation_allowed",
    "queue_mutation_allowed",
    "canon_mutation_allowed",
    "forecast_weight_allowed",
    "notion_writeback_allowed",
    "github_writeback_allowed",
    "token_minting_allowed",
    "valid_for_execution",
    "safe_to_auto_continue",
    "safe_to_prepare_planning_pr",
    "authority_locks",
    "recommended_next_patch",
    "allowed_follow_on_actions",
    "blocked_actions"
  ],
  "properties": {
    "schema_version": { "const": "GlobalPipelineDoctrineDashboardReviewRecord.v1" },
    "status": {
      "enum": [
        "GLOBAL_PIPELINE_DOCTRINE_DASHBOARD_REVIEW_ACCEPTED",
        "GLOBAL_PIPELINE_DOCTRINE_DASHBOARD_REVIEW_BLOCKED"
      ]
    },
    "record_id": { "const": "global_pipeline_doctrine_dashboard_review_record_001" },
    "record_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "command": { "const": "BUILD_GLOBAL_PIPELINE_DOCTRINE_DASHBOARD_REVIEW_RECORD_001" },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "non_authoritative": { "const": true },
    "decision_scope": { "const": "DOCTRINE_DASHBOARD_REVIEW_ONLY" },
    "selected_decision": {
      "enum": ["ACCEPT_REVIEW_EVIDENCE_ONLY", "NOT_COMPUTABLE"]
    },
    "dashboard_review_accepted_as_reviewed_evidence": { "type": "boolean" },
    "doctrine_review_accepted_as_reviewed_evidence": { "type": "boolean" },
    "gap_backlog_accepted_as_reviewed_evidence": { "type": "boolean" },
    "observed_counts": { "type": "object" },
    "implementation_authorized": { "const": false },
    "execution_authority": { "const": false },
    "runtime_mutation_allowed": { "const": false },
    "scheduler_mutation_allowed": { "const": false },
    "ingest_runner_mutation_allowed": { "const": false },
    "pipeline_or_route_mutation_allowed": { "const": false },
    "queue_mutation_allowed": { "const": false },
    "canon_mutation_allowed": { "const": false },
    "forecast_weight_allowed": { "const": false },
    "notion_writeback_allowed": { "const": false },
    "github_writeback_allowed": { "const": false },
    "token_minting_allowed": { "const": false },
    "valid_for_execution": { "const": false },
    "safe_to_auto_continue": { "const": false },
    "safe_to_prepare_planning_pr": { "const": false },
    "authority_locks": {
      "type": "object",
      "additionalProperties": { "const": false }
    },
    "recommended_next_patch": { "const": "NOT_COMPUTABLE" },
    "allowed_follow_on_actions": {
      "type": "array",
      "contains": { "const": "REQUEST_GLOBAL_INGEST_OPERATOR_DECISION" }
    },
    "blocked_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
