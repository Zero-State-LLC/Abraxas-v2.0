{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas/contracts/operator_review/operator_review_queue.v1.schema.json",
  "title": "OperatorReviewQueue.v1",
  "type": "object",
  "required": ["schema_version", "queue_id", "items", "queue_status", "decision_policy", "created_by_lane", "mutation_allowed", "queue_hash"],
  "properties": {
    "schema_version": {"const": "OperatorReviewQueue.v1"},
    "queue_id": {"type": "string"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "source_ref", "review_type", "priority", "summary", "recommended_action", "mutation_allowed", "decision_status", "decision_receipt"],
        "properties": {
          "item_id": {"type": "string"},
          "source_ref": {"type": "object", "required": ["source_type", "source_id", "source_hash"], "properties": {"source_type": {"enum": ["SOURCE_RELIABILITY_ADVISORY", "CALIBRATION_LEDGER", "BRIER_LEDGER_ENTRY", "RUNTIME_AUDIT", "CANON_SYNC", "MANUAL_OPERATOR_NOTE", "NOT_COMPUTABLE"]}, "source_id": {"type": "string"}, "source_hash": {"type": "string"}}},
          "review_type": {"enum": ["RELIABILITY_REVIEW", "CALIBRATION_REVIEW", "RUNTIME_GOVERNANCE_REVIEW", "CANON_DRIFT_REVIEW", "ADAPTATION_PROPOSAL_REVIEW", "PROMOTION_PROPOSAL_REVIEW", "MANUAL_REVIEW", "NOT_COMPUTABLE"]},
          "priority": {"type": "string"},
          "summary": {"type": "string"},
          "recommended_action": {"type": "string"},
          "mutation_allowed": {"const": false},
          "decision_status": {"enum": ["PENDING", "APPROVED", "DENIED", "HELD", "VOID", "NOT_COMPUTABLE"]},
          "decision_receipt": {
            "type": ["object", "null"],
            "required": ["receipt_id", "decision_status", "operator_id_policy", "decision_reason", "decision_scope", "mutation_authorized", "receipt_hash"],
            "properties": {
              "receipt_id": {"type": "string"},
              "decision_status": {"enum": ["PENDING", "APPROVED", "DENIED", "HELD", "VOID", "NOT_COMPUTABLE"]},
              "operator_id_policy": {"type": "string"},
              "decision_reason": {"type": "string"},
              "decision_scope": {"type": "string"},
              "mutation_authorized": {"const": false},
              "receipt_hash": {"type": "string"}
            }
          }
        }
      }
    },
    "queue_status": {"enum": ["DRAFT", "READY_FOR_REVIEW", "PARTIALLY_REVIEWED", "REVIEW_COMPLETE", "VOID", "NOT_COMPUTABLE"]},
    "decision_policy": {"type": "object", "required": ["policy_id", "allow_autonomous_approval", "allow_mutation", "require_receipt_for_final_decision", "routing_policy"], "properties": {"policy_id": {"type": "string"}, "allow_autonomous_approval": {"const": false}, "allow_mutation": {"const": false}, "require_receipt_for_final_decision": {"const": true}, "routing_policy": {"const": "NO_ROUTING_CHANGE"}}},
    "created_by_lane": {"type": "string"},
    "authority_ref": {"type": ["object", "null"]},
    "mutation_allowed": {"const": false},
    "queue_hash": {"type": "string"}
  }
}
