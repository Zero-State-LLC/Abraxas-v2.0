      },
      "additionalProperties": true
    },
    "authorization_scope": { "const": "DIRECT_REPAIR_EXECUTION_AUTHORIZATION_GATE_ONLY" },
    "operator_authorization_required": { "const": true },
    "operator_authorization_observed": { "const": false },
    "authorization_granted": { "const": false },
    "execution_authority": { "const": false },
    "execution_allowed": { "const": false },
    "repair_execution_performed": { "const": false },
    "implementation_authorized": { "const": false },
    "runtime_mutation_allowed": { "const": false },
    "canon_mutation_allowed": { "const": false },
    "queue_mutation_allowed": { "const": false },
    "notion_completeness_claim_allowed": { "const": false },
    "runner_casing_policy_override_allowed": { "const": false },
    "valid_for_execution": { "const": false },
    "valid_for_repair": { "const": false },
    "safe_to_auto_continue": { "const": false },
    "safe_to_prepare_execution_pr": { "const": false },
    "required_operator_authorization_fields": {
      "type": "array",
      "contains": { "const": "authorization_scope_acknowledged" }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "validation_gates": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "blocked_actions": {
      "type": "array",
      "contains": { "const": "EXECUTION_AUTHORITY_GRANT_WITHOUT_OPERATOR_RECORD" }
    },
    "downstream_status": { "const": "NOT_COMPUTABLE" },
    "recommended_next_lane": { "const": "NOT_COMPUTABLE" },
    "provenance": {
      "type": "object",
      "required": [
        "source_spec_plan_path",
        "source_spec_plan_hash",
        "source_spec_plan_status",
        "source_recommended_next_action"
