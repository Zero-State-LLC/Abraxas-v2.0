{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "advisory_only": { "const": true },
    "attestation_group_records": {
      "items": {
        "additionalProperties": true,
        "required": [
          "group_id",
          "group_observed",
          "required_fields",
          "field_count",
          "field_blockers",
          "group_validated",
          "authority_granted"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "attestation_payload_observed": { "type": "boolean" },
    "authority_locks": {
      "additionalProperties": { "const": false },
      "minProperties": 1,
      "type": "object"
    },
    "canon_mutation": { "const": false },
    "decision_record_created": { "const": false },
    "decision_record_creation_authorized": { "const": false },
    "downstream": { "const": "NOT_COMPUTABLE" },
    "evidence_bundle_created": { "const": false },
    "evidence_bundle_creation_authorized": { "const": false },
    "execution_authority": { "const": false },
    "future_decision_record_gate_required": { "const": true },
    "gate_hash": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "gate_id": {
      "const": "v2_hygiene_phase1_stabilization_operator_attestation_intake_gate_001"
    },
    "github_writeback_allowed": { "const": false },
    "implementation_authorized": { "const": false },
    "intake_validated_for_future_decision_record_gate": { "type": "boolean" },
    "non_authoritative": { "const": true },
    "notion_writeback_allowed": { "const": false },
    "operator_attestation_created": { "const": false },
    "payload_readiness": {
      "enum": [
        "OPERATOR_ATTESTATION_PAYLOAD_VALIDATED",
        "OPERATOR_ATTESTATION_PAYLOAD_MISSING",
        "OPERATOR_ATTESTATION_PAYLOAD_NOT_VALIDATED"
      ]
    },
    "projection_only": { "const": true },
    "recommended_next_lane": { "const": "NOT_COMPUTABLE" },
    "runtime_mutation": { "const": false },
    "safe_to_auto_continue": { "const": false },
    "schema_version": {
      "const": "V2HygienePhase1StabilizationOperatorAttestationIntakeGate.v1"
    },
    "source_readiness": {
      "enum": ["SOURCE_ARTIFACTS_READY", "SOURCE_ARTIFACTS_NOT_READY"]
    },
    "status": {
      "enum": [
        "ATTESTATION_INTAKE_VALIDATED_FOR_FUTURE_DECISION_RECORD_GATE",
        "V2_HYGIENE_PHASE1_STABILIZATION_OPERATOR_ATTESTATION_INTAKE_GATE_BLOCKED",
        "NOT_COMPUTABLE"
      ]
    },
    "valid_for_decision_record": { "const": false },
    "valid_for_execution": { "const": false },
    "valid_for_implementation": { "const": false },
    "validation_blockers": { "items": { "type": "string" }, "type": "array" }
  },
  "required": [
    "schema_version",
    "gate_id",
    "status",
    "source_readiness",
    "source_blockers",
    "attestation_payload_path",
    "attestation_payload_observed",
    "payload_readiness",
    "required_attestation_groups",
    "attestation_group_records",
    "missing_group_blockers",
    "field_blockers",
    "authority_expansion_blockers",
    "validation_blockers",
    "intake_validated_for_future_decision_record_gate",
    "future_decision_record_gate_required",
    "decision_record_created",
    "decision_record_creation_authorized",
    "evidence_bundle_created",
    "evidence_bundle_creation_authorized",
    "operator_attestation_created",
    "implementation_authorized",
    "notion_writeback_allowed",
    "github_writeback_allowed",
    "runtime_mutation",
    "canon_mutation",
    "execution_authority",
    "valid_for_decision_record",
    "valid_for_implementation",
    "valid_for_execution",
    "safe_to_auto_continue",
    "recommended_next_lane",
    "authority_locks",
    "downstream",
    "gate_hash"
  ],
  "type": "object"
}
