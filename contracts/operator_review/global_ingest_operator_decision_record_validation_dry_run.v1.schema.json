{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GlobalIngestOperatorDecisionRecordValidationDryRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "validation_dry_run_id",
    "validation_dry_run_hash",
    "command",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "validation_dry_run_only",
    "validation_plan_only",
    "simulated_only",
    "execution_authority",
    "promotion_allowed",
    "forecast_weight_allowed",
    "runtime_mutation_allowed",
    "baseline_mutation_allowed",
    "canon_mutation_allowed",
    "operator_input_required",
    "valid_for_execution",
    "target_pipeline_id",
    "decision_scope",
    "recommended_next_action",
    "recommended_next_patch",
    "recommended_next_state",
    "source_validation_plan_path",
    "source_validation_plan_observed",
    "source_validation_plan_hash",
    "source_validation_plan_status",
    "source_request_id",
    "source_template_hash",
    "source_hashes",
    "source_review_artifacts",
    "executed_validation_checks",
    "required_operator_identity_results",
    "required_decision_field_results",
    "required_acknowledgement_field_results",
    "required_evidence_field_results",
    "required_output_field_results",
    "invariant_results",
    "source_validation_summary",
    "simulated_validation_execution",
    "validation_passed",
    "validation_blockers",
    "blockers"
  ],
  "properties": {
    "schema_version": { "const": "GlobalIngestOperatorDecisionRecordValidationDryRun.v1" },
    "status": {
      "enum": [
        "NOT_COMPUTABLE",
        "BLOCKED_BY_GLOBAL_INGEST_OPERATOR_DECISION_RECORD_VALIDATION_PLAN",
        "GLOBAL_INGEST_OPERATOR_DECISION_RECORD_VALIDATION_DRY_RUN_FAILED",
        "GLOBAL_INGEST_OPERATOR_DECISION_RECORD_VALIDATION_DRY_RUN_READY"
      ]
    },
    "validation_dry_run_id": { "const": "global_ingest_operator_decision_record_validation_dry_run_001" },
    "validation_dry_run_hash": { "type": "string", "minLength": 1 },
    "command": { "const": "BUILD_GLOBAL_INGEST_OPERATOR_DECISION_RECORD_VALIDATION_DRY_RUN_001" },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "non_authoritative": { "const": true },
    "validation_dry_run_only": { "const": true },
    "validation_plan_only": { "const": false },
    "simulated_only": { "const": true },
    "execution_authority": { "const": false },
    "promotion_allowed": { "const": false },
    "forecast_weight_allowed": { "const": false },
    "runtime_mutation_allowed": { "const": false },
    "baseline_mutation_allowed": { "const": false },
    "canon_mutation_allowed": { "const": false },
    "operator_input_required": { "const": true },
    "valid_for_execution": { "const": false },
    "target_pipeline_id": { "const": "oracle_signal" },
    "decision_scope": { "const": "IMPLEMENTATION_SPEC_DECISION_REQUIRED" },
    "recommended_next_action": { "type": "string", "minLength": 1 },
    "recommended_next_patch": { "const": "NOT_COMPUTABLE" },
    "recommended_next_state": { "const": "hold" },
    "source_validation_plan_path": { "const": "out/operator_review/global_ingest_operator_decision_record_validation_plan_001.latest.json" },
    "source_validation_plan_observed": { "type": "boolean" },
    "source_validation_plan_hash": { "type": "string", "minLength": 1 },
    "source_validation_plan_status": {
      "enum": [
        "NOT_COMPUTABLE",
        "GLOBAL_INGEST_OPERATOR_DECISION_RECORD_VALIDATION_PLAN_READY"
      ]
    },
    "source_request_id": { "type": "string", "minLength": 1 },
    "source_template_hash": { "type": "string", "minLength": 1 },
    "source_review_artifacts": { "type": "array", "items": { "type": "string" } },
    "source_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_ingest_operator_decision_request",
        "global_pipeline_gap_backlog",
        "global_ingest_alignment_plan",
        "oracle_signal_intake_boundary_implementation_plan",
        "oracle_confidence_calibration_contract_plan",
        "notion_operator_decision_backlog",
        "notion_spec_completion_queue",
        "global_pipeline_doctrine_proof"
      ],
      "properties": {
        "global_ingest_operator_decision_request": { "type": "string", "minLength": 1 },
        "global_pipeline_gap_backlog": { "type": "string", "minLength": 1 },
        "global_ingest_alignment_plan": { "type": "string", "minLength": 1 },
        "oracle_signal_intake_boundary_implementation_plan": { "type": "string", "minLength": 1 },
        "oracle_confidence_calibration_contract_plan": { "type": "string", "minLength": 1 },
        "notion_operator_decision_backlog": { "type": "string", "minLength": 1 },
        "notion_spec_completion_queue": { "type": "string", "minLength": 1 },
        "global_pipeline_doctrine_proof": { "type": "string", "minLength": 1 }
      }
    },
    "executed_validation_checks": { "type": "array", "items": { "$ref": "#/$defs/check_result" } },
    "required_operator_identity_results": { "type": "array", "items": { "$ref": "#/$defs/field_check" } },
    "required_decision_field_results": { "type": "array", "items": { "$ref": "#/$defs/field_check" } },
    "required_acknowledgement_field_results": { "type": "array", "items": { "$ref": "#/$defs/field_check" } },
    "required_evidence_field_results": { "type": "array", "items": { "$ref": "#/$defs/field_check" } },
    "required_output_field_results": { "type": "array", "items": { "$ref": "#/$defs/field_check" } },
    "invariant_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "observed", "expected", "passed"],
        "properties": {
          "check_id": { "type": "string", "minLength": 1 },
          "observed": {},
          "expected": {},
          "passed": { "type": "boolean" }
        }
      }
    },
    "source_validation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape_valid",
        "simulated_only",
        "operator_input_required",
        "decision_authority_granted",
        "execution_authority_granted",
        "valid_for_execution",
        "validation_blockers"
      ],
      "properties": {
        "shape_valid": { "type": "boolean" },
        "simulated_only": { "const": true },
        "operator_input_required": { "const": true },
        "decision_authority_granted": { "const": false },
        "execution_authority_granted": { "const": false },
        "valid_for_execution": { "const": false },
        "validation_blockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "simulated_validation_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simulated_only",
        "operator_input_required",
        "validation_passed",
        "valid_for_execution",
        "decision_authority_granted",
        "execution_authority_granted",
        "validation_blockers"
      ],
      "properties": {
        "simulated_only": { "const": true },
        "operator_input_required": { "const": true },
        "validation_passed": { "type": "boolean" },
        "valid_for_execution": { "const": false },
        "decision_authority_granted": { "const": false },
        "execution_authority_granted": { "const": false },
        "validation_blockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "validation_passed": { "type": "boolean" },
    "validation_blockers": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "field_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "field", "present"],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "present": { "type": "boolean" }
      }
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "passed"],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" }
      }
    }
  }
}
