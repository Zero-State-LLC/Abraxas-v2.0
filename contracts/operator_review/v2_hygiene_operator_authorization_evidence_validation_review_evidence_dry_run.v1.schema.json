{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/operator_review/v2_hygiene_operator_authorization_evidence_validation_review_evidence_dry_run.v1.schema.json",
  "title": "v2.0 Hygiene Operator Authorization Evidence Validation Review Evidence Dry Run",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "dry_run_id",
    "dry_run_hash",
    "source_validation_review_evidence_plan_path",
    "source_validation_review_evidence_plan_observed",
    "source_validation_review_evidence_plan_ready",
    "source_validation_review_evidence_plan_hash",
    "source_review_artifacts",
    "simulated_evidence_bundle",
    "readiness_summary",
    "evaluation_blockers",
    "simulated_only",
    "operator_input_required",
    "operator_attestations_present",
    "operator_decision_attested",
    "evidence_bundle_created",
    "operator_evidence_bundle_created",
    "operator_attestation_created",
    "authorization_record_created",
    "authorization_record_creation_authorized",
    "implementation_authorized",
    "v2_module_registration_authorized",
    "rune_registration_authorized",
    "projection_surface_mutation_authorized",
    "schema_mutation_authorized",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "execution_authority",
    "valid_for_authorization_record",
    "valid_for_execution",
    "valid_for_implementation",
    "recommended_next_action",
    "recommended_next_lane",
    "recommended_next_patch",
    "recommended_next_state",
    "disallowed_follow_on_actions",
    "authority_locks"
  ],
  "properties": {
    "schema_version": {
      "const": "V2HygieneOperatorAuthorizationEvidenceValidationReviewEvidenceDryRun.v1"
    },
    "status": {
      "enum": [
        "V2_HYGIENE_OPERATOR_AUTHORIZATION_EVIDENCE_VALIDATION_REVIEW_EVIDENCE_DRY_RUN_READY",
        "NOT_COMPUTABLE"
      ]
    },
    "dry_run_id": {
      "const": "v2_hygiene_operator_authorization_evidence_validation_review_evidence_dry_run_001"
    },
    "dry_run_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_validation_review_evidence_plan_path": {
      "const": "out/operator_review/v2_hygiene_operator_authorization_evidence_validation_review_evidence_plan_001.latest.json"
    },
    "source_validation_review_evidence_plan_observed": { "type": "boolean" },
    "source_validation_review_evidence_plan_ready": { "type": "boolean" },
    "source_validation_review_evidence_plan_hash": { "type": "string", "minLength": 1 },
    "source_review_artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "simulated_evidence_bundle": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "attested", "field_count", "missing_fields"],
        "properties": {
          "group_id": { "type": "string", "minLength": 1 },
          "attested": { "const": false },
          "field_count": { "type": "integer", "minimum": 0 },
          "missing_fields": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "readiness_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simulated_only",
        "operator_input_required",
        "groups_ready",
        "groups_total",
        "evidence_bundle_complete",
        "valid_for_authorization_record",
        "evaluation_blockers"
      ],
      "properties": {
        "simulated_only": { "const": true },
        "operator_input_required": { "const": true },
        "groups_ready": { "const": 0 },
        "groups_total": { "type": "integer", "minimum": 0 },
        "evidence_bundle_complete": { "const": false },
        "valid_for_authorization_record": { "const": false },
        "evaluation_blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evaluation_blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "simulated_only": { "const": true },
    "operator_input_required": { "const": true },
    "operator_attestations_present": { "const": false },
    "operator_decision_attested": { "const": false },
    "evidence_bundle_created": { "const": false },
    "operator_evidence_bundle_created": { "const": false },
    "operator_attestation_created": { "const": false },
    "authorization_record_created": { "const": false },
    "authorization_record_creation_authorized": { "const": false },
    "implementation_authorized": { "const": false },
    "v2_module_registration_authorized": { "const": false },
    "rune_registration_authorized": { "const": false },
    "projection_surface_mutation_authorized": { "const": false },
    "schema_mutation_authorized": { "const": false },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "non_authoritative": { "const": true },
    "execution_authority": { "const": false },
    "valid_for_authorization_record": { "const": false },
    "valid_for_execution": { "const": false },
    "valid_for_implementation": { "const": false },
    "recommended_next_action": { "type": "string", "minLength": 1 },
    "recommended_next_lane": { "const": "NOT_COMPUTABLE" },
    "recommended_next_patch": { "const": "NOT_COMPUTABLE" },
    "recommended_next_state": { "const": "hold" },
    "disallowed_follow_on_actions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "authority_locks": {
      "type": "object",
      "additionalProperties": { "const": false },
      "minProperties": 1
    }
  },
  "additionalProperties": false
}
