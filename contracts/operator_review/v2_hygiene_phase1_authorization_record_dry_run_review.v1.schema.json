{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/operator_review/v2_hygiene_phase1_authorization_record_dry_run_review.v1.schema.json",
  "title": "v2.0 Hygiene Phase 1 Authorization Record Dry Run Review",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "review_id",
    "source_authorization_record_dry_run_path",
    "source_authorization_record_dry_run_observed",
    "source_authorization_record_dry_run_file_hash",
    "source_authorization_record_dry_run_packet_hash",
    "source_authorization_record_dry_run_ready",
    "source_authorization_record_dry_run_status",
    "source_readiness",
    "source_validation_blockers",
    "source_simulated_field_group_ids",
    "review_findings",
    "selected_operator_decision",
    "selected_follow_on_action",
    "terminal_hold_reason",
    "operator_review_required",
    "operator_input_required",
    "operator_attestations_present",
    "operator_decision_attested",
    "operator_attestation_created",
    "evidence_bundle_created",
    "operator_evidence_bundle_created",
    "authorization_record_created",
    "authorization_record_creation_authorized",
    "implementation_authorized",
    "hygiene_code_creation_authorized",
    "schema_file_creation_authorized",
    "v2_module_registration_authorized",
    "rune_registration_authorized",
    "strict_mode_enablement_authorized",
    "projection_surface_mutation_authorized",
    "schema_mutation_authorized",
    "recommended_next_lane",
    "recommended_next_patch",
    "recommended_next_state",
    "recommended_next_action",
    "safe_to_auto_continue",
    "advisory_only",
    "projection_only",
    "evidence_only",
    "non_authoritative",
    "execution_authority",
    "valid_for_authorization_record",
    "valid_for_execution",
    "valid_for_implementation",
    "authority_locks",
    "review_hash"
  ],
  "properties": {
    "schema_version": {"const": "V2HygienePhase1AuthorizationRecordDryRunReview.v1"},
    "status": {
      "enum": [
        "V2_HYGIENE_PHASE1_AUTHORIZATION_RECORD_DRY_RUN_REVIEW_HELD_FOR_OPERATOR",
        "V2_HYGIENE_PHASE1_AUTHORIZATION_RECORD_DRY_RUN_REVIEW_BLOCKED",
        "NOT_COMPUTABLE"
      ]
    },
    "review_id": {"const": "v2_hygiene_phase1_authorization_record_dry_run_review_001"},
    "source_authorization_record_dry_run_path": {
      "const": "out/operator_review/v2_hygiene_phase1_authorization_record_dry_run_001.latest.json"
    },
    "source_authorization_record_dry_run_observed": {"type": "boolean"},
    "source_authorization_record_dry_run_file_hash": {"type": "string", "minLength": 1},
    "source_authorization_record_dry_run_packet_hash": {"type": "string", "minLength": 1},
    "source_authorization_record_dry_run_ready": {"type": "boolean"},
    "source_authorization_record_dry_run_status": {"type": "string", "minLength": 1},
    "source_readiness": {"type": "string", "minLength": 1},
    "source_validation_blockers": {"type": "array", "items": {"type": "string"}},
    "source_simulated_field_group_ids": {"type": "array", "items": {"type": "string"}},
    "review_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "finding_status", "authority_granted"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "finding_status": {
            "enum": ["OBSERVED", "HELD_FOR_OPERATOR", "ENFORCED", "BLOCKED", "NOT_COMPUTABLE"]
          },
          "authority_granted": {"const": false}
        }
      }
    },
    "selected_operator_decision": {
      "enum": ["HOLD_FOR_OPERATOR_REVIEW", "NOT_COMPUTABLE"]
    },
    "selected_follow_on_action": {
      "enum": ["MAINTAIN_V2_HYGIENE_PHASE1_AUTHORIZATION_HOLD", "NOT_COMPUTABLE"]
    },
    "terminal_hold_reason": {"type": "string", "minLength": 1},
    "operator_review_required": {"const": true},
    "operator_input_required": {"const": true},
    "operator_attestations_present": {"const": false},
    "operator_decision_attested": {"const": false},
    "operator_attestation_created": {"const": false},
    "evidence_bundle_created": {"const": false},
    "operator_evidence_bundle_created": {"const": false},
    "authorization_record_created": {"const": false},
    "authorization_record_creation_authorized": {"const": false},
    "implementation_authorized": {"const": false},
    "hygiene_code_creation_authorized": {"const": false},
    "schema_file_creation_authorized": {"const": false},
    "v2_module_registration_authorized": {"const": false},
    "rune_registration_authorized": {"const": false},
    "strict_mode_enablement_authorized": {"const": false},
    "projection_surface_mutation_authorized": {"const": false},
    "schema_mutation_authorized": {"const": false},
    "recommended_next_lane": {"const": "NOT_COMPUTABLE"},
    "recommended_next_patch": {"const": "NOT_COMPUTABLE"},
    "recommended_next_state": {"const": "hold"},
    "recommended_next_action": {"type": "string", "minLength": 1},
    "safe_to_auto_continue": {"const": false},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "evidence_only": {"const": true},
    "non_authoritative": {"const": true},
    "execution_authority": {"const": false},
    "valid_for_authorization_record": {"const": false},
    "valid_for_execution": {"const": false},
    "valid_for_implementation": {"const": false},
    "authority_locks": {
      "type": "object",
      "additionalProperties": {"const": false},
      "minProperties": 1
    },
    "review_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
