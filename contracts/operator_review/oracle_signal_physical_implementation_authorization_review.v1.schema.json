{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/operator_review/oracle_signal_physical_implementation_authorization_review.v1.schema.json",
  "title": "OracleSignalPhysicalImplementationAuthorizationReview.v1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "review_id",
    "review_hash",
    "command",
    "target_pipeline_id",
    "decision_scope",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "review_requested",
    "selected_decision",
    "implementation_authorized",
    "execution_authority",
    "valid_for_execution",
    "safe_to_auto_continue",
    "safe_to_prepare_implementation_pr",
    "authority_locks",
    "source_paths",
    "source_hashes",
    "review_findings",
    "allowed_follow_on_actions",
    "blocked_actions",
    "recommended_next_action",
    "recommended_next_patch"
  ],
  "properties": {
    "schema_version": { "const": "OracleSignalPhysicalImplementationAuthorizationReview.v1" },
    "status": {
      "enum": [
        "ORACLE_SIGNAL_PHYSICAL_IMPLEMENTATION_AUTHORIZATION_REVIEW_HELD_FOR_OPERATOR",
        "ORACLE_SIGNAL_PHYSICAL_IMPLEMENTATION_AUTHORIZATION_REVIEW_AUTHORIZATION_CONSUMED",
        "ORACLE_SIGNAL_PHYSICAL_IMPLEMENTATION_AUTHORIZATION_REVIEW_BLOCKED"
      ]
    },
    "review_id": { "const": "oracle_signal_physical_implementation_authorization_review_001" },
    "review_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "command": { "const": "BUILD_ORACLE_SIGNAL_PHYSICAL_IMPLEMENTATION_AUTHORIZATION_REVIEW_001" },
    "target_pipeline_id": { "const": "oracle_signal" },
    "decision_scope": { "const": "PHYSICAL_IMPLEMENTATION_AUTHORIZATION_REVIEW_ONLY" },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "non_authoritative": { "const": true },
    "review_requested": { "type": "boolean" },
    "selected_decision": {
      "enum": ["HOLD_FOR_OPERATOR", "AUTHORIZATION_RECORD_CONSUMED", "NOT_COMPUTABLE"]
    },
    "implementation_authorized": { "type": "boolean" },
    "execution_authority": { "const": false },
    "valid_for_execution": { "const": false },
    "safe_to_auto_continue": { "const": false },
    "safe_to_prepare_implementation_pr": { "const": false },
    "authority_locks": {
      "type": "object",
      "additionalProperties": { "const": false }
    },
    "source_paths": { "type": "object" },
    "source_hashes": { "type": "object" },
    "review_findings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "allowed_follow_on_actions": {
      "type": "array",
      "contains": { "const": "COLLECT_EXPLICIT_PHYSICAL_IMPLEMENTATION_OPERATOR_AUTHORIZATION" }
    },
    "blocked_actions": {
      "type": "array",
      "contains": { "const": "CORE_ORACLE_SIGNAL_IMPLEMENTATION" }
    },
    "recommended_next_action": { "type": "string" },
    "recommended_next_patch": { "const": "NOT_COMPUTABLE" }
  },
  "additionalProperties": true
}
