{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/operator_review/v2_hygiene_phase1_authorization_record_plan.v1.schema.json",
  "title": "v2.0 Hygiene Phase 1 Authorization Record Plan",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "plan_id",
    "source_records",
    "source_ready",
    "record_plan_only",
    "operator_input_required",
    "operator_attestations_present",
    "authorization_record_created",
    "authorization_record_creation_authorized",
    "authorization_record_creation_required_before_implementation",
    "recommended_default_decision",
    "recommended_next_action",
    "recommended_next_lane",
    "recommended_next_patch",
    "record_field_groups",
    "record_readiness_summary",
    "future_authorization_record_candidates",
    "disallowed_follow_on_actions",
    "advisory_only",
    "projection_only",
    "evidence_only",
    "non_authoritative",
    "implementation_authorized",
    "valid_for_authorization_record",
    "valid_for_implementation",
    "valid_for_execution",
    "safe_to_prepare_patch",
    "safe_to_auto_continue",
    "hygiene_code_creation_authorized",
    "schema_file_creation_authorized",
    "v2_module_registration_authorized",
    "rune_registration_authorized",
    "strict_mode_enablement_authorized",
    "notion_writeback_allowed",
    "github_writeback_allowed",
    "runtime_mutation",
    "queue_mutation",
    "scheduler_mutation",
    "canon_mutation",
    "schema_mutation",
    "execution_authority",
    "authority_locks",
    "blockers",
    "downstream",
    "plan_hash"
  ],
  "properties": {
    "schema_version": {"const": "V2HygienePhase1AuthorizationRecordPlan.v1"},
    "status": {
      "enum": [
        "V2_HYGIENE_PHASE1_AUTHORIZATION_RECORD_PLAN_READY",
        "V2_HYGIENE_PHASE1_AUTHORIZATION_RECORD_PLAN_BLOCKED"
      ]
    },
    "plan_id": {"const": "v2_hygiene_phase1_authorization_record_plan_001"},
    "source_records": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "status_field",
          "expected_status",
          "observed_status",
          "source_observed",
          "status_matches_expected",
          "source_hash"
        ],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "status_field": {"type": "string", "minLength": 1},
          "expected_status": {"type": "string", "minLength": 1},
          "observed_status": {"type": "string", "minLength": 1},
          "source_observed": {"type": "boolean"},
          "status_matches_expected": {"type": "boolean"},
          "source_hash": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_ready": {"type": "boolean"},
    "record_plan_only": {"const": true},
    "operator_input_required": {"const": true},
    "operator_attestations_present": {"const": false},
    "authorization_record_created": {"const": false},
    "authorization_record_creation_authorized": {"const": false},
    "authorization_record_creation_required_before_implementation": {"const": true},
    "recommended_default_decision": {"const": "HOLD_FOR_OPERATOR_REVIEW"},
    "recommended_next_action": {"type": "string", "minLength": 1},
    "recommended_next_lane": {"const": "NOT_COMPUTABLE"},
    "recommended_next_patch": {"const": "NOT_COMPUTABLE"},
    "record_field_groups": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group_id",
          "required_fields",
          "fields_attested",
          "field_count",
          "record_plan_steps"
        ],
        "properties": {
          "group_id": {"type": "string", "minLength": 1},
          "required_fields": {"type": "array", "items": {"type": "string"}},
          "fields_attested": {"const": false},
          "field_count": {"type": "integer", "minimum": 1},
          "record_plan_steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["step_id", "field", "required", "attested"],
              "properties": {
                "step_id": {"type": "string", "minLength": 1},
                "field": {"type": "string", "minLength": 1},
                "required": {"const": true},
                "attested": {"const": false}
              }
            }
          }
        }
      }
    },
    "record_readiness_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_count",
        "required_group_count",
        "required_field_count",
        "attested_group_count",
        "authorization_record_ready",
        "blocker_count"
      ],
      "properties": {
        "source_record_count": {"const": 3},
        "required_group_count": {"const": 5},
        "required_field_count": {"type": "integer", "minimum": 1},
        "attested_group_count": {"const": 0},
        "authorization_record_ready": {"const": false},
        "blocker_count": {"type": "integer", "minimum": 0}
      }
    },
    "future_authorization_record_candidates": {"type": "array", "items": {"type": "string"}},
    "disallowed_follow_on_actions": {"type": "array", "items": {"type": "string"}},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "evidence_only": {"const": true},
    "non_authoritative": {"const": true},
    "implementation_authorized": {"const": false},
    "valid_for_authorization_record": {"const": false},
    "valid_for_implementation": {"const": false},
    "valid_for_execution": {"const": false},
    "safe_to_prepare_patch": {"const": false},
    "safe_to_auto_continue": {"const": false},
    "hygiene_code_creation_authorized": {"const": false},
    "schema_file_creation_authorized": {"const": false},
    "v2_module_registration_authorized": {"const": false},
    "rune_registration_authorized": {"const": false},
    "strict_mode_enablement_authorized": {"const": false},
    "notion_writeback_allowed": {"const": false},
    "github_writeback_allowed": {"const": false},
    "runtime_mutation": {"const": false},
    "queue_mutation": {"const": false},
    "scheduler_mutation": {"const": false},
    "canon_mutation": {"const": false},
    "schema_mutation": {"const": false},
    "execution_authority": {"const": false},
    "authority_locks": {
      "type": "object",
      "additionalProperties": {"const": false},
      "minProperties": 1
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "downstream": {"const": "NOT_COMPUTABLE"},
    "plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
