{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GlobalIngestOperatorDecisionRecord",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "status",
    "decision_record_id",
    "decision_record_hash",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "selected_decision",
    "implementation_spec_authoring_approved",
    "implementation_authorized",
    "execution_authority",
    "runtime_mutation_allowed",
    "scheduler_mutation_allowed",
    "pipeline_or_route_mutation_allowed",
    "canon_mutation_allowed",
    "notion_writeback_allowed",
    "github_writeback_allowed",
    "token_minting_allowed",
    "valid_for_execution",
    "safe_to_prepare_planning_pr",
    "recommended_next_patch",
    "source_template_hash"
  ],
  "properties": {
    "schema_version": { "const": "GlobalIngestOperatorDecisionRecord.v1" },
    "status": {
      "enum": [
        "GLOBAL_INGEST_OPERATOR_DECISION_RECORDED",
        "GLOBAL_INGEST_OPERATOR_DECISION_CONSUMED_BY_SEPARATE_IMPLEMENTATION_SPEC_PLAN"
      ]
    },
    "decision_record_id": { "const": "global_ingest_operator_decision_record_001" },
    "decision_record_hash": { "type": "string", "minLength": 1 },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "non_authoritative": { "const": true },
    "selected_decision": { "const": "APPROVE_SEPARATE_IMPLEMENTATION_SPEC" },
    "implementation_spec_authoring_approved": { "const": true },
    "implementation_authorized": { "const": false },
    "execution_authority": { "const": false },
    "runtime_mutation_allowed": { "const": false },
    "scheduler_mutation_allowed": { "const": false },
    "pipeline_or_route_mutation_allowed": { "const": false },
    "canon_mutation_allowed": { "const": false },
    "notion_writeback_allowed": { "const": false },
    "github_writeback_allowed": { "const": false },
    "token_minting_allowed": { "const": false },
    "valid_for_execution": { "const": false },
    "safe_to_prepare_planning_pr": { "type": "boolean" },
    "separate_spec_plan_observed": { "type": "boolean" },
    "separate_spec_plan": {
      "type": "object",
      "required": ["path", "hash", "status", "observed"],
      "properties": {
        "path": { "const": "out/operator_review/global_ingest_separate_implementation_spec_plan_001.latest.json" },
        "status": {
          "enum": [
            "GLOBAL_INGEST_SEPARATE_IMPLEMENTATION_SPEC_PLAN_READY",
            "GLOBAL_INGEST_SEPARATE_IMPLEMENTATION_SPEC_PLAN_CONSUMED_BY_IMPLEMENTATION_SPEC",
            "NOT_COMPUTABLE"
          ]
        },
        "observed": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "recommended_next_patch": {
      "enum": [
        "GLOBAL_INGEST_ADAPTER_SPINE_SEPARATE_IMPLEMENTATION_SPEC_PLAN",
        "NOT_COMPUTABLE"
      ]
    },
    "source_template_hash": { "type": "string", "minLength": 1 }
  }
}
