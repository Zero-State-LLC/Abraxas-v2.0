      "const": "AbxResearchCanaryArtifactRegistryCoverageRepairOperatorDecisionRecord.v1"
    },
    "artifact_id": {
      "const": "ABX_RESEARCH_CANARY_ARTIFACT_REGISTRY_COVERAGE_REPAIR_OPERATOR_DECISION_RECORD_001"
