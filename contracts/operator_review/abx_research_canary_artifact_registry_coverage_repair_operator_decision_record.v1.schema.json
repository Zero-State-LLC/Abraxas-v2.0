{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/operator_review/abx_research_canary_artifact_registry_coverage_repair_operator_decision_record.v1.schema.json",
  "title": "ABX Research Canary Registry Repair Operator Decision Record",
  "type": "object",
