{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/operator_review/abx_harness_implementation_authorization_record.v1.schema.json",
  "title": "ABX Harness Implementation Authorization Record",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "status",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "implementation_authorized",
    "implementation_may_proceed",
    "execution_authority",
    "valid_for_execution",
    "safe_to_auto_continue",
    "safe_to_prepare_implementation_pr",
    "authority_locks",
    "record_hash"
  ],
  "properties": {
    "schema_version": {"const": "AbxHarnessImplementationAuthorizationRecord.v1"},
    "record_id": {"const": "abx_harness_implementation_authorization_record_001"},
    "status": {
      "enum": [
        "ABX_HARNESS_IMPLEMENTATION_AUTHORIZATION_RECORD_EMITTED",
        "ABX_HARNESS_IMPLEMENTATION_AUTHORIZATION_RECORD_BLOCKED",
        "ABX_HARNESS_IMPLEMENTATION_AUTHORIZATION_HOLD_MAINTAINED"
      ]
    },
    "target_surface_id": {"type": "string"},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "non_authoritative": {"const": true},
    "decision_value": {"type": "string"},
    "implementation_scope": {"type": "string"},
    "operator_id": {"type": "string"},
    "operator_role": {"type": "string"},
    "decision_date": {"type": "string"},
    "implementation_authorized": {"type": "boolean"},
    "implementation_may_proceed": {"type": "boolean"},
    "execution_authority": {"const": false},
    "runtime_execution_allowed": {"const": false},
    "repair_execution_allowed": {"const": false},
    "canon_promotion_allowed": {"const": false},
    "scheduler_mutation_allowed": {"const": false},
    "queue_mutation_allowed": {"const": false},
    "notion_writeback_allowed": {"const": false},
    "github_writeback_allowed": {"const": false},
    "downstream_authority_granted": {"const": false},
    "valid_for_execution": {"const": false},
    "safe_to_auto_continue": {"const": false},
    "safe_to_prepare_implementation_pr": {"type": "boolean"},
    "authority_locks": {"type": "object"},
    "source_intake_gate_path": {"type": "string"},
    "source_intake_gate_hash": {"type": "string"},
    "authorization_class": {"type": "string"},
    "execution_status": {"type": "string"},
    "decision_outcome_summary": {"type": "string"},
    "recommended_next_action": {"type": "string"},
    "recommended_next_patch": {"type": "string"},
    "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
