{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AbxArtifactLineageRunnerCasingPolicyReviewRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "artifact_id",
    "request_hash",
    "command",
    "advisory_only",
    "projection_only",
    "non_authoritative",
    "policy_review_request_only",
    "source_traceability_audit",
    "review_scope",
    "target_finding_id",
    "target_status",
    "impacted_runner_count",
    "sample_impacted_runners",
    "required_evidence",
    "decision_question",
    "decision_options",
    "recommended_decision",
    "runner_casing_policy_override_allowed",
    "runner_path_normalization_allowed",
    "script_discovery_semantics_change_allowed",
    "execution_authority",
    "execution_allowed",
    "runtime_mutation_allowed",
    "canon_mutation_allowed",
    "queue_mutation_allowed",
    "scheduler_mutation_allowed",
    "valid_for_execution",
    "valid_for_repair",
    "safe_to_auto_continue",
    "safe_to_prepare_normalization_pr",
    "blocked_actions",
    "acceptance_gates",
    "recommended_next_action",
    "recommended_next_lane",
    "downstream_status"
  ],
  "properties": {
    "schema_version": { "const": "AbxArtifactLineageRunnerCasingPolicyReviewRequest.v1" },
    "status": {
      "enum": [
        "ABX_ARTIFACT_LINEAGE_RUNNER_CASING_POLICY_REVIEW_REQUEST_HELD",
        "ABX_ARTIFACT_LINEAGE_RUNNER_CASING_POLICY_REVIEW_REQUEST_BLOCKED"
      ]
    },
    "artifact_id": { "const": "ABX_ARTIFACT_LINEAGE_RUNNER_CASING_POLICY_REVIEW_REQUEST_001" },
    "request_hash": { "type": "string", "minLength": 1 },
    "command": { "const": "BUILD_ABX_ARTIFACT_LINEAGE_RUNNER_CASING_POLICY_REVIEW_REQUEST_001" },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "non_authoritative": { "const": true },
    "policy_review_request_only": { "const": true },
    "source_traceability_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "packet_hash", "audit_id", "source_audit_ready"],
      "properties": {
        "path": { "const": "out/sync/abx_artifact_lineage_registry_traceability_audit/latest.json" },
        "packet_hash": { "type": "string", "minLength": 1 },
        "audit_id": { "type": "string", "minLength": 1 },
        "source_audit_ready": { "type": "boolean" }
      }
    },
    "review_scope": { "const": "RUNNER_CASING_POLICY_DECISION_ONLY" },
    "target_finding_id": { "const": "detect_uppercase_Scripts_runner_discovery_gaps" },
    "target_status": { "const": "NOT_COMPUTABLE" },
    "impacted_runner_count": { "type": "integer", "minimum": 0 },
    "sample_impacted_runners": { "type": "array", "items": { "type": "string" } },
    "required_evidence": { "type": "string", "minLength": 1 },
    "decision_question": { "type": "string", "minLength": 1 },
    "decision_options": {
      "type": "array",
      "items": {
        "enum": [
          "KEEP_CASE_SENSITIVE_RUNNER_DISCOVERY",
          "AUTHORIZE_CASE_INSENSITIVE_RUNNER_EQUIVALENCE_POLICY",
          "AUTHORIZE_REPO_WIDE_RUNNER_PATH_NORMALIZATION_PLAN",
          "REQUEST_ADDITIONAL_RUNNER_CASE_EVIDENCE"
        ]
      },
      "minItems": 4,
      "uniqueItems": true
    },
    "recommended_decision": { "const": "REQUEST_ADDITIONAL_RUNNER_CASE_EVIDENCE" },
    "runner_casing_policy_override_allowed": { "const": false },
    "runner_path_normalization_allowed": { "const": false },
    "script_discovery_semantics_change_allowed": { "const": false },
    "execution_authority": { "const": false },
    "execution_allowed": { "const": false },
    "runtime_mutation_allowed": { "const": false },
    "canon_mutation_allowed": { "const": false },
    "queue_mutation_allowed": { "const": false },
    "scheduler_mutation_allowed": { "const": false },
    "valid_for_execution": { "const": false },
    "valid_for_repair": { "const": false },
    "safe_to_auto_continue": { "const": false },
    "safe_to_prepare_normalization_pr": { "const": false },
    "blocked_actions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "acceptance_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "status", "required_before"],
        "properties": {
          "gate_id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "required_before": { "type": "string", "minLength": 1 }
        }
      },
      "minItems": 1
    },
    "recommended_next_action": { "type": "string", "minLength": 1 },
    "recommended_next_lane": { "const": "ABX_ARTIFACT_LINEAGE_RUNNER_CASING_POLICY_DECISION_PLAN" },
    "downstream_status": { "const": "HELD_FOR_OPERATOR_POLICY_DECISION" }
  }
}
