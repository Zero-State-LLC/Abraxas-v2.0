{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/operator_review/v2_hygiene_operator_authorization_evidence_validation_plan.v1.schema.json",
  "title": "v2.0 Hygiene Operator Authorization Evidence Validation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "validation_plan_id",
    "validation_plan_hash",
    "source_dry_run_path",
    "source_dry_run_observed",
    "source_dry_run_ready",
    "source_dry_run_file_hash",
    "source_dry_run_packet_hash",
    "source_dry_run_status",
    "source_review_artifacts",
    "bundle_group_checks",
    "invariant_checks",
    "authority_lock_checks",
    "validation_checks",
    "source_readiness_summary",
    "validation_blockers",
    "blockers",
    "validation_plan_only",
    "simulated_only",
    "operator_input_required",
    "operator_attestations_present",
    "operator_evidence_bundle_created",
    "authorization_record_created",
    "authorization_record_creation_authorized",
    "implementation_authorized",
    "v2_module_registration_authorized",
    "rune_registration_authorized",
    "projection_surface_mutation_authorized",
    "schema_mutation_authorized",
    "advisory_only",
    "projection_only",
    "evidence_only",
    "non_authoritative",
    "execution_authority",
    "valid_for_authorization_record",
    "valid_for_execution",
    "valid_for_implementation",
    "recommended_next_action",
    "recommended_next_patch",
    "recommended_next_lane",
    "recommended_next_state",
    "notion_writeback_allowed",
    "github_writeback_allowed",
    "authority_locks"
  ],
  "properties": {
    "schema_version": {"const": "V2HygieneOperatorAuthorizationEvidenceValidationPlan.v1"},
    "status": {
      "enum": [
        "V2_HYGIENE_OPERATOR_AUTHORIZATION_EVIDENCE_VALIDATION_PLAN_READY",
        "V2_HYGIENE_OPERATOR_AUTHORIZATION_EVIDENCE_VALIDATION_PLAN_BLOCKED_BY_DRY_RUN",
        "BLOCKED_BY_V2_HYGIENE_OPERATOR_AUTHORIZATION_EVIDENCE_DRY_RUN",
        "NOT_COMPUTABLE"
      ]
    },
    "validation_plan_id": {"const": "v2_hygiene_operator_authorization_evidence_validation_plan_001"},
    "validation_plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_dry_run_path": {
      "const": "out/operator_review/v2_hygiene_operator_authorization_evidence_dry_run_001.latest.json"
    },
    "source_dry_run_observed": {"type": "boolean"},
    "source_dry_run_ready": {"type": "boolean"},
    "source_dry_run_file_hash": {"type": "string", "minLength": 1},
    "source_dry_run_packet_hash": {"type": "string", "minLength": 1},
    "source_dry_run_status": {"type": "string", "minLength": 1},
    "source_review_artifacts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "bundle_group_checks": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "group_id",
          "attested",
          "field_count",
          "missing_field_count",
          "passed"
        ],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "group_id": {"type": "string", "minLength": 1},
          "attested": {"const": false},
          "field_count": {"type": "integer", "minimum": 0},
          "missing_field_count": {"type": "integer", "minimum": 0},
          "passed": {"type": "boolean"}
        }
      }
    },
    "invariant_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "observed", "expected", "passed"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "observed": {},
          "expected": {},
          "passed": {"type": "boolean"}
        }
      }
    },
    "authority_lock_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "lock_name", "observed", "expected", "passed"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "lock_name": {"type": "string", "minLength": 1},
          "observed": {},
          "expected": {"const": false},
          "passed": {"type": "boolean"}
        }
      }
    },
    "validation_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "passed"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"}
        }
      }
    },
    "source_readiness_summary": {"type": "object"},
    "validation_blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "validation_plan_only": {"const": true},
    "simulated_only": {"const": true},
    "operator_input_required": {"const": true},
    "operator_attestations_present": {"const": false},
    "operator_evidence_bundle_created": {"const": false},
    "authorization_record_created": {"const": false},
    "authorization_record_creation_authorized": {"const": false},
    "implementation_authorized": {"const": false},
    "v2_module_registration_authorized": {"const": false},
    "rune_registration_authorized": {"const": false},
    "projection_surface_mutation_authorized": {"const": false},
    "schema_mutation_authorized": {"const": false},
    "advisory_only": {"const": true},
    "projection_only": {"const": true},
    "evidence_only": {"const": true},
    "non_authoritative": {"const": true},
    "execution_authority": {"const": false},
    "valid_for_authorization_record": {"const": false},
    "valid_for_execution": {"const": false},
    "valid_for_implementation": {"const": false},
    "recommended_next_action": {"type": "string", "minLength": 1},
    "recommended_next_patch": {"const": "NOT_COMPUTABLE"},
    "recommended_next_lane": {"const": "NOT_COMPUTABLE"},
    "recommended_next_state": {"const": "hold"},
    "notion_writeback_allowed": {"const": false},
    "github_writeback_allowed": {"const": false},
    "authority_locks": {
      "type": "object",
      "additionalProperties": {"const": false}
    }
  }
}
