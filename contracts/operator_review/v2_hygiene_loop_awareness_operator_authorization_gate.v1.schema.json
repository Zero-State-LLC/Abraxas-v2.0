{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.local/contracts/operator_review/v2_hygiene_loop_awareness_operator_authorization_gate.v1.schema.json",
  "title": "v2.0 Hygiene Loop-Awareness Operator Authorization Gate",
  "type": "object",
  "required": [
    "artifact_type",
    "gate_id",
    "gate_status",
    "target_surface",
    "source_alignment_plan",
    "authorization_scope",
    "authorization_eligible",
    "requires_operator_decision",
    "selected_operator_decision",
    "allowed_operator_decisions",
    "required_operator_authorization_fields",
    "source_alignment_required_workstreams",
    "authorization_checks",
    "blocked_actions",
    "recommended_next_action",
    "recommended_next_lane",
    "recommended_next_patch",
    "operator_authorization_observed",
    "operator_authorization_record_created",
    "authorization_granted",
    "authorization_record_creation_authorized",
    "v2_module_registration_authorized",
    "rune_registration_authorized",
    "projection_surface_mutation_authorized",
    "schema_mutation_authorized",
    "implementation_authorized",
    "advisory_only",
    "projection_only",
    "evidence_only",
    "non_authoritative",
    "execution_authority",
    "valid_for_execution",
    "valid_for_implementation",
    "safe_to_prepare_patch",
    "safe_to_auto_continue",
    "notion_writeback_allowed",
    "github_writeback_allowed",
    "canon_mutation",
    "runtime_mutation",
    "queue_mutation",
    "scheduler_mutation",
    "forecast_routing",
    "authority_locks",
    "downstream",
    "gate_hash"
  ],
  "properties": {
    "artifact_type": { "const": "V2HygieneLoopAwarenessOperatorAuthorizationGate.v1" },
    "gate_id": { "const": "V2_HYGIENE_LOOP_AWARENESS_OPERATOR_AUTHORIZATION_GATE_001" },
    "gate_status": {
      "enum": [
        "V2_HYGIENE_LOOP_AWARENESS_OPERATOR_AUTHORIZATION_GATE_HELD_FOR_OPERATOR",
        "NOT_COMPUTABLE"
      ]
    },
    "target_surface": { "const": "V2_HYGIENE_LOOP_AWARENESS_ALIGNMENT" },
    "source_alignment_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash", "plan_status", "source_ready"],
      "properties": {
        "path": { "const": "out/sync/v2_hygiene_loop_awareness_alignment_plan/latest.json" },
        "hash": { "type": "string", "minLength": 1 },
        "plan_status": { "type": "string", "minLength": 1 },
        "source_ready": { "type": "boolean" }
      }
    },
    "authorization_scope": { "const": "V2_HYGIENE_ALIGNMENT_OPERATOR_REVIEW_ONLY" },
    "authorization_eligible": { "type": "boolean" },
    "requires_operator_decision": { "const": true },
    "selected_operator_decision": { "const": "HOLD" },
    "allowed_operator_decisions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "required_operator_authorization_fields": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "source_alignment_required_workstreams": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "authorization_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "check_status", "required_before", "grants_authority"],
        "properties": {
          "check_id": { "type": "string", "minLength": 1 },
          "check_status": { "type": "string", "minLength": 1 },
          "required_before": { "type": "string", "minLength": 1 },
          "grants_authority": { "const": false }
        }
      }
    },
    "blocked_actions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "recommended_next_action": { "type": "string", "minLength": 1 },
    "recommended_next_lane": { "const": "NOT_COMPUTABLE" },
    "recommended_next_patch": { "const": "NOT_COMPUTABLE" },
    "operator_authorization_observed": { "const": false },
    "operator_authorization_record_created": { "const": false },
    "authorization_granted": { "const": false },
    "authorization_record_creation_authorized": { "const": false },
    "v2_module_registration_authorized": { "const": false },
    "rune_registration_authorized": { "const": false },
    "projection_surface_mutation_authorized": { "const": false },
    "schema_mutation_authorized": { "const": false },
    "implementation_authorized": { "const": false },
    "advisory_only": { "const": true },
    "projection_only": { "const": true },
    "evidence_only": { "const": true },
    "non_authoritative": { "const": true },
    "execution_authority": { "const": false },
    "valid_for_execution": { "const": false },
    "valid_for_implementation": { "const": false },
    "safe_to_prepare_patch": { "const": false },
    "safe_to_auto_continue": { "const": false },
    "notion_writeback_allowed": { "const": false },
    "github_writeback_allowed": { "const": false },
    "canon_mutation": { "const": false },
    "runtime_mutation": { "const": false },
    "queue_mutation": { "const": false },
    "scheduler_mutation": { "const": false },
    "forecast_routing": { "const": false },
    "authority_locks": {
      "type": "object",
      "additionalProperties": { "const": false },
      "minProperties": 1
    },
    "downstream": { "const": "NOT_COMPUTABLE" },
    "gate_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
