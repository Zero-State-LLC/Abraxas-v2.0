{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hyperagent-agent-config.schema.json",
  "title": "HyperAgent Agent Config",
  "type": "object",
  "required": ["name", "version", "mission", "tools", "budget"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "mission": {"type": "string", "minLength": 1},
    "system_prompt": {"type": "string"},
    "trigger": {"type": "object"},
    "tools": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "budget": {
      "type": "object",
      "required": ["max_cost_usd", "max_steps"],
      "properties": {
        "max_cost_usd": {"type": "number", "minimum": 0},
        "max_steps": {"type": "integer", "minimum": 1},
        "model": {"type": "string"}
      }
    },
    "memory": {"type": "object"},
    "evals": {"type": "array"},
    "delivery": {"type": "object"}
  },
  "additionalProperties": true
}
