{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abraxas.dev/afe/schemas/AFETracePacket.v1.json",
  "title": "AFETracePacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_type",
    "status",
    "agent_id",
    "environment_id",
    "episode_id",
    "metrics",
    "shadow_diagnostic_candidates",
    "not_computable_reasons",
    "provenance_hash",
    "authority"
  ],
  "properties": {
    "packet_type": { "const": "AFETracePacket.v1" },
    "status": { "enum": ["OK", "NOT_COMPUTABLE"] },
    "agent_id": { "type": "string" },
    "environment_id": { "type": "string" },
    "episode_id": { "type": "string" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ACS", "MDI", "SES", "SLI", "ECI"],
      "properties": {
        "ACS": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "MDI": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "SES": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "SLI": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "ECI": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "shadow_diagnostic_candidates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "not_computable_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provenance_hash": { "type": "string" },
    "authority": { "const": "SHADOW_ONLY_TRACE" }
  }
}

